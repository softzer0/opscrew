context /api/ {
  type                    proxy
  handler                 kamal-proxy
  extraHeaders            <<<END_extraHeaders
Header set Cache-Control "no-store"
Header set Access-Control-Allow-Origin "https://app.example.com"
  END_extraHeaders
}
context /old/ {
  type                    proxy
  handler                 kamal-proxy
  rewrite {
    enable                1
    rules                 <<<END_rules
RewriteRule ^(.*)$ /new/$1 [R=301,L]
    END_rules
  }
}
