{
  "name": "opscrew",
  "version": "0.1.0",
  "private": true,
  "description": "OpsCrew \u2014 the ops crew you didn't hire. From a GitHub repo to a hardened production deployment on your own cloud.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "opscrew": "dist/opscrew.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "ignore": "^7.0.12",
    "libsodium-wrappers": "^0.8.4",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opscrew/agents": "workspace:*",
    "@opscrew/connector-cloudflare": "workspace:*",
    "@opscrew/connector-github": "workspace:*",
    "@opscrew/connector-hetzner": "workspace:*",
    "@opscrew/contracts": "workspace:*",
    "@opscrew/core": "workspace:*",
    "@opscrew/detect": "workspace:*",
    "@opscrew/iac-engine": "workspace:*",
    "@opscrew/iac-templates": "workspace:*",
    "@opscrew/mcp-server": "workspace:*",
    "@opscrew/plan-schema": "workspace:*",
    "@opscrew/runtime-claude": "workspace:*",
    "@opscrew/secops": "workspace:*",
    "tsup": "^8.5.1"
  }
}
