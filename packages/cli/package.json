{
  "name": "opscrew",
  "version": "0.1.0",
  "private": true,
  "description": "OpsCrew — the ops crew you didn't hire. From a GitHub repo to a hardened production deployment on your own cloud.",
  "keywords": [
    "devops",
    "secops",
    "deployment",
    "self-hosting",
    "opentofu",
    "terraform",
    "hetzner",
    "digitalocean",
    "cloudflare",
    "ai-agents",
    "claude",
    "cli"
  ],
  "homepage": "https://github.com/softzer0/opscrew#readme",
  "bugs": {
    "url": "https://github.com/softzer0/opscrew/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softzer0/opscrew.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "opscrew": "dist/opscrew.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE', 'NOTICE']) require('node:fs').copyFileSync('../../' + f, f)\"",
    "postpack": "node -e \"for (const f of ['README.md', 'LICENSE', 'NOTICE']) require('node:fs').rmSync(f, { force: true })\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "ignore": "^7.0.12",
    "libsodium-wrappers": "^0.8.4",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opscrew/agents": "workspace:*",
    "@opscrew/connector-cloudflare": "workspace:*",
    "@opscrew/connector-digitalocean": "workspace:*",
    "@opscrew/connector-github": "workspace:*",
    "@opscrew/connector-godaddy": "workspace:*",
    "@opscrew/connector-hetzner": "workspace:*",
    "@opscrew/connector-namecheap": "workspace:*",
    "@opscrew/connector-porkbun": "workspace:*",
    "@opscrew/connector-portainer": "workspace:*",
    "@opscrew/contracts": "workspace:*",
    "@opscrew/core": "workspace:*",
    "@opscrew/detect": "workspace:*",
    "@opscrew/iac-engine": "workspace:*",
    "@opscrew/iac-templates": "workspace:*",
    "@opscrew/mcp-server": "workspace:*",
    "@opscrew/plan-schema": "workspace:*",
    "@opscrew/runtime-claude": "workspace:*",
    "@opscrew/secops": "workspace:*",
    "tsup": "^8.5.1"
  }
}
