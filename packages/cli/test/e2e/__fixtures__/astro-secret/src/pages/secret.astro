---
// The serverless Docker pass's page: proves that the Worker's secret reached the app by showing
// its SHA-256, never the value itself.
import { getSecret } from "astro:env/server";

const value = getSecret("STRIPE_SECRET_KEY");
let digest = "not set";
if (value !== undefined) {
	const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
	digest = [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, "0")).join("");
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Secret</title>
	</head>
	<body>
		<p>The secret's SHA-256: {digest}</p>
	</body>
</html>
