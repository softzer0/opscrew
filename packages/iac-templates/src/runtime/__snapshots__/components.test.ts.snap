// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SQLite > keeps the database's folder in the volume sqlite, mounted in every container of the app's image 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
# \`release\` runs app.releaseCommand from opscrew/plan.yaml before each new version starts.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    volumes:
      - sqlite:/app/storage
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:'+process.env.PORT+'/api/health',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))
      interval: 5s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      mysql:
        condition: service_healthy
  release:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    profiles:
      - release
    env_file:
      - app.env
    environment:
      PORT: "3000"
    volumes:
      - sqlite:/app/storage
    command:
      - sh
      - -c
      - npm run migrate
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
  worker:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - sh
      - -c
      - exec node worker.js
    volumes:
      - sqlite:/app/storage
    stop_grace_period: 30s
    deploy:
      replicas: 1
    healthcheck:
      disable: true
    mem_limit: 256m
    memswap_limit: 256m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
  cron:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - supercronic
      - /etc/opscrew/crontab
    volumes:
      - ./crontab:/etc/opscrew/crontab:ro
      - sqlite:/app/storage
    labels:
      dev.opscrew.config-sha256: 385a2296e8bf2c2f382b58f61ff4b92a446b9f4da47c0c3f051aaf47ef727e01
    stop_grace_period: 10s
    healthcheck:
      disable: true
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
  mysql:
    image: <pin:IMAGES.mysql>
    restart: unless-stopped
    env_file:
      - mysql.env
    volumes:
      - /srv/data/shop/mysql:/var/lib/mysql
      - ./services/mysql/my.cnf:/etc/mysql/conf.d/opscrew.cnf:ro
    labels:
      dev.opscrew.config-sha256: 5e13a08c858ca68edc7c32a53a0c388d13d346a79dbc0822c5b539624d5cf20d
    healthcheck:
      test:
        - CMD
        - mysqladmin
        - ping
        - -h
        - 127.0.0.1
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 60s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
volumes:
  sqlite: {}
"
`;

exports[`the logins of Kafka, Redpanda and OpenSearch > each start with the login, its password only in the service's env file (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      kafka:
        condition: service_healthy
      redpanda:
        condition: service_healthy
      opensearch:
        condition: service_healthy
  sysctl:
    image: <pin:IMAGES.caddy>
    privileged: true
    network_mode: none
    command:
      - sh
      - -c
      - "set -e; echo '# Managed by OpsCrew: kernel settings the services of its apps need.' > /etc/sysctl.d/90-opscrew.conf.tmp; v=$$(sysctl -n vm.max_map_count); if [ \\"$$v\\" -lt 262144 ]; then v=262144; sysctl -w vm.max_map_count=$$v; fi; echo \\"vm.max_map_count = $$v\\" >> /etc/sysctl.d/90-opscrew.conf.tmp; mv /etc/sysctl.d/90-opscrew.conf.tmp /etc/sysctl.d/90-opscrew.conf"
    volumes:
      - /etc/sysctl.d:/etc/sysctl.d
    read_only: true
    mem_limit: 16m
    memswap_limit: 16m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  kafka:
    image: <pin:IMAGES.kafka>
    restart: unless-stopped
    command:
      - sh
      - -c
      - (until KAFKA_HEAP_OPTS=-Xmx64m /opt/kafka/bin/kafka-configs.sh --bootstrap-server localhost:9094 --alter --add-config "SCRAM-SHA-512=[password=$$SASL_PASSWORD]" --entity-type users --entity-name app; do sleep 2; done) & exec /etc/kafka/docker/run
    env_file:
      - kafka.env
    volumes:
      - kafka_data:/var/lib/kafka/data
      - kafka_secrets:/etc/kafka/secrets
      - kafka_config:/mnt/shared/config
    healthcheck:
      test:
        - CMD-SHELL
        - KAFKA_HEAP_OPTS=-Xmx64m /opt/kafka/bin/kafka-configs.sh --bootstrap-server localhost:9094 --describe --entity-type users --entity-name app | grep -q SCRAM-SHA-512
      interval: 10s
      timeout: 10s
      retries: 6
      start_period: 60s
    mem_limit: 1024m
    memswap_limit: 1024m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  redpanda:
    image: <pin:IMAGES.redpanda>
    restart: unless-stopped
    entrypoint:
      - sh
      - -c
    command:
      - login() { { rpk security user create app -p "$$RPK_PASS" --mechanism SCRAM-SHA-512 || rpk security user update app --new-password "$$RPK_PASS" --mechanism SCRAM-SHA-512; } && rpk cluster config set superusers '["app"]' && rpk cluster config set enable_sasl true && rpk cluster config set admin_api_require_auth true; }; (until login; do sleep 2; done) & exec /entrypoint.sh redpanda start --smp 1 --memory 1024M --reserve-memory 0M --overprovisioned --kafka-addr 0.0.0.0:9092 --advertise-kafka-addr redpanda:9092 --rpc-addr 127.0.0.1:33145 --schema-registry-addr 127.0.0.1:8081 --pandaproxy-addr 127.0.0.1:8082
    env_file:
      - redpanda.env
    volumes:
      - redpanda_data:/var/lib/redpanda/data
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://localhost:9644/v1/status/ready > /dev/null && rpk cluster config get admin_api_require_auth | grep -qx true
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 30s
    mem_limit: 1536m
    memswap_limit: 1536m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  opensearch:
    image: <pin:IMAGES.opensearch>
    restart: unless-stopped
    command:
      - bash
      - -c
      - "set -e; [ -f config/node.p12 ] || { k=\\"keytool -keystore config/node.p12 -storepass changeit\\"; $$k -genkeypair -alias node -keyalg RSA -keysize 2048 -dname CN=opensearch -validity 36500; $$k -exportcert -alias node -rfc | $$k -importcert -noprompt -alias trusted; }; h=$$(plugins/opensearch-security/tools/hash.sh -env OPENSEARCH_PASSWORD); printf '_meta:\\\\n  type: \\"internalusers\\"\\\\n  config_version: 2\\\\nadmin:\\\\n  hash: \\"%s\\"\\\\n  reserved: false\\\\n  backend_roles:\\\\n  - \\"admin\\"\\\\n' \\"$$h\\" > config/opensearch-security/internal_users.yml; exec ./opensearch-docker-entrypoint.sh opensearch"
    env_file:
      - opensearch.env
    volumes:
      - opensearch_data:/usr/share/opensearch/data
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS -u "admin:$$OPENSEARCH_PASSWORD" 'localhost:9200/_cluster/health?wait_for_status=yellow&timeout=5s' > /dev/null
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 90s
    mem_limit: 1024m
    memswap_limit: 1024m
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
    depends_on:
      sysctl:
        condition: service_completed_successfully
networks:
  internal: {}
  opscrew-edge:
    external: true
volumes:
  kafka_data: {}
  kafka_secrets: {}
  kafka_config: {}
  redpanda_data: {}
  opensearch_data: {}
"
`;

exports[`the search engines' host setting > is raised on a cloud server by one privileged one-shot container per app, which every engine that needs it waits for (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      opensearch:
        condition: service_healthy
      elasticsearch:
        condition: service_healthy
      meilisearch:
        condition: service_healthy
  sysctl:
    image: <pin:IMAGES.caddy>
    privileged: true
    network_mode: none
    command:
      - sh
      - -c
      - "set -e; echo '# Managed by OpsCrew: kernel settings the services of its apps need.' > /etc/sysctl.d/90-opscrew.conf.tmp; v=$$(sysctl -n vm.max_map_count); if [ \\"$$v\\" -lt 262144 ]; then v=262144; sysctl -w vm.max_map_count=$$v; fi; echo \\"vm.max_map_count = $$v\\" >> /etc/sysctl.d/90-opscrew.conf.tmp; mv /etc/sysctl.d/90-opscrew.conf.tmp /etc/sysctl.d/90-opscrew.conf"
    volumes:
      - /etc/sysctl.d:/etc/sysctl.d
    read_only: true
    mem_limit: 16m
    memswap_limit: 16m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
  opensearch:
    image: <pin:IMAGES.opensearch>
    restart: unless-stopped
    command:
      - bash
      - -c
      - "set -e; [ -f config/node.p12 ] || { k=\\"keytool -keystore config/node.p12 -storepass changeit\\"; $$k -genkeypair -alias node -keyalg RSA -keysize 2048 -dname CN=opensearch -validity 36500; $$k -exportcert -alias node -rfc | $$k -importcert -noprompt -alias trusted; }; h=$$(plugins/opensearch-security/tools/hash.sh -env OPENSEARCH_PASSWORD); printf '_meta:\\\\n  type: \\"internalusers\\"\\\\n  config_version: 2\\\\nadmin:\\\\n  hash: \\"%s\\"\\\\n  reserved: false\\\\n  backend_roles:\\\\n  - \\"admin\\"\\\\n' \\"$$h\\" > config/opensearch-security/internal_users.yml; exec ./opensearch-docker-entrypoint.sh opensearch"
    env_file:
      - opensearch.env
    volumes:
      - opensearch_data:/usr/share/opensearch/data
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS -u "admin:$$OPENSEARCH_PASSWORD" 'localhost:9200/_cluster/health?wait_for_status=yellow&timeout=5s' > /dev/null
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 90s
    mem_limit: 1024m
    memswap_limit: 1024m
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
    depends_on:
      sysctl:
        condition: service_completed_successfully
  elasticsearch:
    image: <pin:IMAGES.elasticsearch>
    restart: unless-stopped
    env_file:
      - elasticsearch.env
    volumes:
      - elasticsearch_data:/usr/share/elasticsearch/data
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS -u "elastic:$$ELASTIC_PASSWORD" 'localhost:9200/_cluster/health?wait_for_status=yellow&timeout=5s' > /dev/null
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 90s
    mem_limit: 1024m
    memswap_limit: 1024m
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
    depends_on:
      sysctl:
        condition: service_completed_successfully
  meilisearch:
    image: <pin:IMAGES.meilisearch>
    restart: unless-stopped
    env_file:
      - meilisearch.env
    volumes:
      - /srv/data/shop/meilisearch:/meili_data
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - -O-
        - http://127.0.0.1:7700/health
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
volumes:
  opensearch_data: {}
  elasticsearch_data: {}
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) > opscrew/runtime/crontab 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml (processes.cron); \`opscrew provision\` regenerates it.
# supercronic runs each job in the app's image and skips a run while the job's last one runs.
CRON_TZ=UTC

# cleanup
*/15 * * * * node scripts/cleanup.js

# report: GET /api/cron/report?full=1 with the CRON_SECRET bearer token
0 * * * * node -e "fetch('http://app:3000/api/cron/report?full=1',{headers:{Authorization:'Bearer '+process.env.CRON_SECRET}}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) > opscrew/runtime/services/mysql/my.cnf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# MySQL settings for its 512 MB memory limit.
[mysqld]
innodb_buffer_pool_size = 128M
innodb_buffer_pool_instances = 1
performance_schema = OFF
max_connections = 50
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) > opscrew/runtime/services/rabbitmq/rabbitmq.conf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# RabbitMQ settings for its 384 MB memory limit, loaded after the image's own.
# The memory alarm blocks publishers well before Docker's limit would stop the node.
vm_memory_high_watermark.absolute = 153MB
# The default user is \`app\` (RABBITMQ_DEFAULT_USER), so RabbitMQ never creates \`guest\`; were
# it there, it could log in only from inside the container.
loopback_users.guest = true
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:'+process.env.PORT+'/api/health',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))
      interval: 5s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    stop_grace_period: 35s
    mem_limit: 768m
    memswap_limit: 768m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
  worker:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - sh
      - -c
      - exec node worker.js
    stop_grace_period: 30s
    deploy:
      replicas: 2
    healthcheck:
      disable: true
    mem_limit: 256m
    memswap_limit: 256m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
  cron:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - supercronic
      - /etc/opscrew/crontab
    volumes:
      - ./crontab:/etc/opscrew/crontab:ro
    labels:
      dev.opscrew.config-sha256: 3244485c1c32d75e6e1996c40014371b9e5a0b761d3172f02ecf7eff4857fa04
    stop_grace_period: 10s
    healthcheck:
      disable: true
    mem_limit: 768m
    memswap_limit: 768m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
  mysql:
    image: <pin:IMAGES.mysql>
    restart: unless-stopped
    env_file:
      - mysql.env
    volumes:
      - /srv/data/shop/mysql:/var/lib/mysql
      - ./services/mysql/my.cnf:/etc/mysql/conf.d/opscrew.cnf:ro
    labels:
      dev.opscrew.config-sha256: 5e13a08c858ca68edc7c32a53a0c388d13d346a79dbc0822c5b539624d5cf20d
    healthcheck:
      test:
        - CMD
        - mysqladmin
        - ping
        - -h
        - 127.0.0.1
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 60s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  rabbitmq:
    image: <pin:IMAGES.rabbitmq>
    restart: unless-stopped
    hostname: rabbitmq
    env_file:
      - rabbitmq.env
    volumes:
      - /srv/data/shop/rabbitmq:/var/lib/rabbitmq
      - ./services/rabbitmq/rabbitmq.conf:/etc/rabbitmq/conf.d/90-opscrew.conf:ro
    labels:
      dev.opscrew.config-sha256: 3e8e5fe34debbbe6330bbaeb9532842c7dff98a4d9371339d16c323f9b4a7129
    healthcheck:
      test:
        - CMD
        - rabbitmq-diagnostics
        - -q
        - ping
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 30s
    mem_limit: 384m
    memswap_limit: 384m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
"
`;

exports[`the workers > start the way each builder's image needs (snapshot) 1`] = `
{
  "buildpacks": {
    "cron": {
      "command": [
        "supercronic",
        "/etc/opscrew/crontab",
      ],
      "entrypoint": [
        "/cnb/lifecycle/launcher",
        "--",
      ],
    },
    "queue": {
      "command": [
        "exec node queue.js",
      ],
      "entrypoint": [
        "/cnb/lifecycle/launcher",
      ],
    },
    "worker": {
      "command": [
        "exec node worker.js",
      ],
      "entrypoint": [
        "/cnb/lifecycle/launcher",
      ],
    },
  },
  "generated-dockerfile": {
    "cron": {
      "command": [
        "supercronic",
        "/etc/opscrew/crontab",
      ],
      "entrypoint": undefined,
