// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SQLite > keeps the database's folder in the volume sqlite, mounted in every container of the app's image 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
# \`release\` runs app.releaseCommand from opscrew/plan.yaml before each new version starts.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    volumes:
      - sqlite:/app/storage
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:'+process.env.PORT+'/api/health',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))
      interval: 5s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      mysql:
        condition: service_healthy
  release:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    profiles:
      - release
    env_file:
      - app.env
    environment:
      PORT: "3000"
    volumes:
      - sqlite:/app/storage
    command:
      - sh
      - -c
      - npm run migrate
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
  worker:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - sh
      - -c
      - exec node worker.js
    volumes:
      - sqlite:/app/storage
    stop_grace_period: 30s
    deploy:
      replicas: 1
    healthcheck:
      disable: true
    mem_limit: 256m
    memswap_limit: 256m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
  cron:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - supercronic
      - /etc/opscrew/crontab
    volumes:
      - ./crontab:/etc/opscrew/crontab:ro
      - sqlite:/app/storage
    labels:
      dev.opscrew.config-sha256: 385a2296e8bf2c2f382b58f61ff4b92a446b9f4da47c0c3f051aaf47ef727e01
    stop_grace_period: 10s
    healthcheck:
      disable: true
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
  mysql:
    image: mysql:8.4@sha256:24989179f58856db763f418010c1169fecc944e3ec1ea7e921572d83eb070f70
    restart: unless-stopped
    env_file:
      - mysql.env
    volumes:
      - /srv/data/shop/mysql:/var/lib/mysql
      - ./services/mysql/my.cnf:/etc/mysql/conf.d/opscrew.cnf:ro
    labels:
      dev.opscrew.config-sha256: 5e13a08c858ca68edc7c32a53a0c388d13d346a79dbc0822c5b539624d5cf20d
    healthcheck:
      test:
        - CMD
        - mysqladmin
        - ping
        - -h
        - 127.0.0.1
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 60s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
volumes:
  sqlite: {}
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) > opscrew/runtime/crontab 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml (processes.cron); \`opscrew provision\` regenerates it.
# supercronic runs each job in the app's image and skips a run while the job's last one runs.
CRON_TZ=UTC

# cleanup
*/15 * * * * node scripts/cleanup.js

# report: GET /api/cron/report?full=1 with the CRON_SECRET bearer token
0 * * * * node -e "fetch('http://app:3000/api/cron/report?full=1',{headers:{Authorization:'Bearer '+process.env.CRON_SECRET}}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) > opscrew/runtime/services/mysql/my.cnf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# MySQL settings for its 512 MB memory limit.
[mysqld]
innodb_buffer_pool_size = 128M
innodb_buffer_pool_instances = 1
performance_schema = OFF
max_connections = 50
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) > opscrew/runtime/services/rabbitmq/rabbitmq.conf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# RabbitMQ settings for its 384 MB memory limit, loaded after the image's own.
# The memory alarm blocks publishers well before Docker's limit would stop the node.
vm_memory_high_watermark.absolute = 153MB
# The default user is \`app\` (RABBITMQ_DEFAULT_USER), so RabbitMQ never creates \`guest\`; were
# it there, it could log in only from inside the container.
loopback_users.guest = true
"
`;

exports[`the services on a server > renders an app with a worker, cron, MySQL and RabbitMQ (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:'+process.env.PORT+'/api/health',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))
      interval: 5s
      timeout: 3s
      retries: 3
      start_period: 30s
      start_interval: 1s
    stop_grace_period: 35s
    mem_limit: 768m
    memswap_limit: 768m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
  worker:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - sh
      - -c
      - exec node worker.js
    stop_grace_period: 30s
    deploy:
      replicas: 2
    healthcheck:
      disable: true
    mem_limit: 256m
    memswap_limit: 256m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
  cron:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - supercronic
      - /etc/opscrew/crontab
    volumes:
      - ./crontab:/etc/opscrew/crontab:ro
    labels:
      dev.opscrew.config-sha256: 3244485c1c32d75e6e1996c40014371b9e5a0b761d3172f02ecf7eff4857fa04
    stop_grace_period: 10s
    healthcheck:
      disable: true
    mem_limit: 768m
    memswap_limit: 768m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
  mysql:
    image: mysql:8.4@sha256:24989179f58856db763f418010c1169fecc944e3ec1ea7e921572d83eb070f70
    restart: unless-stopped
    env_file:
      - mysql.env
    volumes:
      - /srv/data/shop/mysql:/var/lib/mysql
      - ./services/mysql/my.cnf:/etc/mysql/conf.d/opscrew.cnf:ro
    labels:
      dev.opscrew.config-sha256: 5e13a08c858ca68edc7c32a53a0c388d13d346a79dbc0822c5b539624d5cf20d
    healthcheck:
      test:
        - CMD
        - mysqladmin
        - ping
        - -h
        - 127.0.0.1
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 60s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  rabbitmq:
    image: rabbitmq:4.3@sha256:3e5cc23235b0eb850f604e8ace10d9a9b6d05be3e36730e53522ee9ead707a9e
    restart: unless-stopped
    hostname: rabbitmq
    env_file:
      - rabbitmq.env
    volumes:
      - /srv/data/shop/rabbitmq:/var/lib/rabbitmq
      - ./services/rabbitmq/rabbitmq.conf:/etc/rabbitmq/conf.d/90-opscrew.conf:ro
    labels:
      dev.opscrew.config-sha256: 3e8e5fe34debbbe6330bbaeb9532842c7dff98a4d9371339d16c323f9b4a7129
    healthcheck:
      test:
        - CMD
        - rabbitmq-diagnostics
        - -q
        - ping
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 30s
    mem_limit: 384m
    memswap_limit: 384m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
"
`;

exports[`the workers > start the way each builder's image needs (snapshot) 1`] = `
{
  "buildpacks": {
    "cron": {
      "command": [
        "supercronic",
        "/etc/opscrew/crontab",
      ],
      "entrypoint": [
        "/cnb/lifecycle/launcher",
        "--",
      ],
    },
    "queue": {
      "command": [
        "exec node queue.js",
      ],
      "entrypoint": [
        "/cnb/lifecycle/launcher",
      ],
    },
    "worker": {
      "command": [
        "exec node worker.js",
      ],
      "entrypoint": [
        "/cnb/lifecycle/launcher",
      ],
    },
  },
  "generated-dockerfile": {
    "cron": {
      "command": [
        "supercronic",
        "/etc/opscrew/crontab",
      ],
      "entrypoint": undefined,
    },
    "queue": {
      "command": [
        "sh",
        "-c",
        "exec node queue.js",
      ],
      "entrypoint": undefined,
    },
    "worker": {
      "command": [
        "sh",
        "-c",
        "exec node worker.js",
      ],
      "entrypoint": undefined,
    },
  },
  "own-dockerfile": {
