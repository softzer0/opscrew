// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`an extra server's Compose file > advertises Kafka at its private address (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server broker: the app's services placed there,
# each published only on the server's private address 10.200.4.2.
name: shop
services:
  events:
    image: <pin:IMAGES.kafka>
    restart: unless-stopped
    environment:
      CLUSTER_ID: lTQlTLE15zMQrR-kSsKvHg
      KAFKA_NODE_ID: "1"
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://localhost:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://10.200.4.2:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: "1"
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: "1"
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: "1"
      KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR: "1"
      KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR: "1"
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: "0"
      KAFKA_LOG_DIRS: /var/lib/kafka/data
      KAFKA_LOG_RETENTION_HOURS: "168"
      KAFKA_HEAP_OPTS: -Xmx512m -Xms512m
    volumes:
      - events_data:/var/lib/kafka/data
      - events_secrets:/etc/kafka/secrets
      - events_config:/mnt/shared/config
    ports:
      - 10.200.4.2:9092:9092
    healthcheck:
      test:
        - CMD-SHELL
        - KAFKA_HEAP_OPTS=-Xmx64m /opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 > /dev/null
      interval: 10s
      timeout: 10s
      retries: 6
      start_period: 60s
    mem_limit: 1024m
    memswap_limit: 1024m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
volumes:
  events_data: {}
  events_secrets: {}
  events_config: {}
"
`;

exports[`an extra server's Compose file > runs the services placed there in the app's project, published on its private address only (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server data: the app's services placed there,
# each published only on the server's private address 10.200.4.2.
name: shop
services:
  db:
    image: <pin:IMAGES.postgres>
    restart: unless-stopped
    env_file:
      - db.env
    volumes:
      - /srv/data/shop/db:/var/lib/postgresql/data
    ports:
      - 10.200.4.2:5432:5432
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $\${POSTGRES_USER} -d $\${POSTGRES_DB}
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
"
`;

exports[`the app's Compose file (the app's server) > leaves out a service placed on another server, and waits only for its own (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      cache:
        condition: service_healthy
  worker:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - sh
      - -c
      - exec node worker.js
    stop_grace_period: 30s
    deploy:
      replicas: 1
    healthcheck:
      disable: true
    mem_limit: 256m
    memswap_limit: 256m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      cache:
        condition: service_healthy
  cron:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    command:
      - supercronic
      - /etc/opscrew/crontab
    volumes:
      - ./crontab:/etc/opscrew/crontab:ro
    labels:
      dev.opscrew.config-sha256: 385a2296e8bf2c2f382b58f61ff4b92a446b9f4da47c0c3f051aaf47ef727e01
    stop_grace_period: 10s
    healthcheck:
      disable: true
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
    depends_on:
      cache:
        condition: service_healthy
  cache:
    image: <pin:IMAGES.valkey>
    restart: unless-stopped
    command:
      - sh
      - -c
      - umask 077 && printf 'requirepass %s\\n' "$$VALKEY_PASSWORD" > /tmp/opscrew-auth.conf && chown valkey:valkey /tmp/opscrew-auth.conf && exec docker-entrypoint.sh valkey-server /tmp/opscrew-auth.conf --save '' --appendonly no --maxmemory 96mb --maxmemory-policy allkeys-lru
    env_file:
      - cache.env
    volumes:
      - /srv/data/shop/cache:/data
    healthcheck:
      test:
        - CMD-SHELL
        - REDISCLI_AUTH="$$VALKEY_PASSWORD" valkey-cli ping | grep -q PONG
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 128m
    memswap_limit: 128m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
"
`;

exports[`the app's Compose file (the app's server) > publishes a service a device was granted on the app's private address, with its wrapper (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The deploy workflow copies it to /srv/apps/shop on the server.
name: shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      db:
        condition: service_healthy
      cache:
        condition: service_healthy
  db:
    image: <pin:IMAGES.postgres>
    restart: unless-stopped
    env_file:
      - db.env
    volumes:
      - /srv/data/shop/db:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $\${POSTGRES_USER} -d $\${POSTGRES_DB}
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
  cache:
    image: <pin:IMAGES.valkey>
    restart: unless-stopped
    command:
      - sh
      - -c
      - "umask 077 && { h=$$(printf %s \\"$$VALKEY_PASSWORD\\" | sha256sum | cut -d ' ' -f 1); printf 'user %s on #%s %s\\\\n' default \\"$$h\\" '~* &* +@all'; printf '%s\\\\n' \\"$$OPSCREW_ACL_USERS\\" | while IFS=: read -r name access hash; do case \\"$$access\\" in read-only) rules='~* &* +@read +ping +hello +client|setname +client|setinfo -@write' ;; full) rules='~* &* +@all -@admin' ;; *) continue ;; esac; printf 'user %s on #%s %s\\\\n' \\"$$name\\" \\"$$hash\\" \\"$$rules\\"; done; } > /tmp/opscrew-users.acl && chown valkey:valkey /tmp/opscrew-users.acl && exec docker-entrypoint.sh valkey-server --aclfile /tmp/opscrew-users.acl --save '' --appendonly no --maxmemory 96mb --maxmemory-policy allkeys-lru"
    env_file:
      - cache.env
    volumes:
      - /srv/data/shop/cache:/data
    ports:
      - 10.200.4.1:6379:6379
    healthcheck:
      test:
        - CMD-SHELL
        - REDISCLI_AUTH="$$VALKEY_PASSWORD" valkey-cli ping | grep -q PONG
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 128m
    memswap_limit: 128m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
"
`;
