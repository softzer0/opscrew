// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderNextTunnelConnectorCompose > renders the connector as its own Compose project in cloudflared-next 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. While this app moves to another Cloudflare account,
# that account's tunnel connector, beside the app's own: it runs on the host network as that one does,
# and it opens no port. tunnel.env next to this file holds TUNNEL_TOKEN (root-only; never committed).
name: shop-tunnel-next
services:
  cloudflared:
    image: <pin:IMAGES.cloudflared>
    restart: unless-stopped
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 127.0.0.1:0
      - run
    env_file:
      - tunnel.env
    network_mode: host
    mem_limit: 32m
    memswap_limit: 32m
    read_only: true
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
"
`;
