exports[`renderDependabot > adds Maven or Gradle for a Java app when the caller names its build tool 1`] = `
"# Generated by OpsCrew: weekly dependency updates, with minor and patch versions grouped per
# ecosystem. Major versions of the runtime images and of the databases, queues and brokers are
# left to you: change them when your code and data are ready for them. You own this file;
# OpsCrew only creates it when missing.
version: 2
updates:
  - package-ecosystem: maven
    directory: /
    schedule:
      interval: weekly
    groups:
      maven-minor-and-patch:
        patterns:
          - "*"
        update-types:
          - minor
          - patch
  - package-ecosystem: docker-compose
    directories:
      - /opscrew/runtime
      - /opscrew/runtime/cloudflared
      - /opscrew/runtime/portainer
    schedule:
      interval: weekly
    groups:
      docker-compose-minor-and-patch:
        patterns:
          - "*"
        update-types:
          - minor
          - patch
    ignore:
      - dependency-name: apache/kafka
        update-types:
          - version-update:semver-major
      - dependency-name: caddy
        update-types:
          - version-update:semver-major
      - dependency-name: clickhouse
        update-types:
          - version-update:semver-major
      - dependency-name: dragonflydb/dragonfly
        update-types:
          - version-update:semver-major
      - dependency-name: dxflrs/garage
        update-types:
          - version-update:semver-major
      - dependency-name: elasticsearch
        update-types:
          - version-update:semver-major
      - dependency-name: getmeili/meilisearch
        update-types:
          - version-update:semver-major
          - version-update:semver-minor
      - dependency-name: mariadb
        update-types:
          - version-update:semver-major
      - dependency-name: mongo
        update-types:
          - version-update:semver-major
      - dependency-name: mysql
        update-types:
          - version-update:semver-major
      - dependency-name: nats
        update-types:
          - version-update:semver-major
      - dependency-name: node
        update-types:
          - version-update:semver-major
      - dependency-name: opensearchproject/opensearch
        update-types:
          - version-update:semver-major
      - dependency-name: postgres
        update-types:
          - version-update:semver-major
      - dependency-name: python
        update-types:
          - version-update:semver-major
      - dependency-name: rabbitmq
        update-types:
          - version-update:semver-major
      - dependency-name: redis
        update-types:
          - version-update:semver-major
      - dependency-name: redpandadata/redpanda
        update-types:
          - version-update:semver-major
      - dependency-name: typesense/typesense
        update-types:
          - version-update:semver-major
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    groups:
      github-actions-minor-and-patch:
        patterns:
          - "*"
        update-types:
          - minor
          - patch
"
`;

