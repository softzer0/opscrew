// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots > one app on caddy 1`] = `
{
  "opscrew/runtime/compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The local deploy copies it to the app's folder on this computer.
name: opscrew-shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    pull_policy: missing
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
    restart: unless-stopped
    env_file:
      - db.env
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $\${POSTGRES_USER} -d $\${POSTGRES_DB}
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
volumes:
  db_data: {}
",
  "opscrew/runtime/edge/compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's shared edge on this computer (Compose project opscrew-edge), in front of
# every OpsCrew app there: Caddy and kamal-proxy. It listens on 127.0.0.1 only.
name: opscrew-edge
x-opscrew-edge-version: 2026102103
x-opscrew-edge-proxy: caddy
services:
  kamal-proxy:
    image: basecamp/kamal-proxy:v0.10.2@sha256:a686220c2aa42c4f9bbcfe851b1d21b2cedee0b5c389890c29d205282379da7c
    restart: unless-stopped
    volumes:
      - kamal-proxy-config:/home/kamal-proxy/.config/kamal-proxy
    mem_limit: 32m
    memswap_limit: 32m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
  caddy:
    image: caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
    restart: unless-stopped
    mem_limit: 64m
    memswap_limit: 64m
    ports:
      - 127.0.0.1:80:80
      - 127.0.0.1:443:443
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    volumes:
      - ./sites:/etc/caddy/sites:ro
      - ./tls:/etc/caddy/tls:ro
      - caddy_data:/data
      - caddy_config:/config
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - -O
        - /dev/null
        - http://127.0.0.1:2019/config/
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    labels:
      dev.opscrew.caddyfile-sha256: 2709b11e2a5b667bb0f2071019a06d4795d5736e86fe4be86950816909a38aba
    depends_on:
      - kamal-proxy
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - opscrew-edge
configs:
  caddyfile:
    content: |
      # OpsCrew's shared edge: each OpsCrew app on this server has its site in /srv/edge/sites/<app>.caddy.
      # No HTTP/3: the edge on this computer publishes no UDP port.
      {
      	servers {
      		protocols h1 h2
      	}
      }

      import /etc/caddy/sites/*.caddy

      # Requests for any other hostname are refused.
      http:// {
      	abort
      }
      https:// {
      	abort
      }
networks:
  opscrew-edge:
    external: true
volumes:
  caddy_data: {}
  caddy_config: {}
  kamal-proxy-config: {}
",
  "opscrew/runtime/edge/sites/shop.caddy": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop's site on this computer's shared edge: the local deploy copies it to the edge's sites.
http://shop.localhost {
	redir https://{host}{uri} 308
}

shop.localhost {
	tls /etc/caddy/tls/shop/local.pem /etc/caddy/tls/shop/local.key
	encode zstd gzip
	reverse_proxy kamal-proxy:80
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	handle_errors {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
",
}
`;

exports[`snapshots > one app on nginx 1`] = `
{
  "opscrew/runtime/compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# The local deploy copies it to the app's folder on this computer.
name: opscrew-shop
services:
  app:
    image: \${APP_IMAGE:?APP_IMAGE is not set; deploy with the OpsCrew workflow}
    pull_policy: missing
    restart: unless-stopped
    env_file:
      - app.env
    environment:
      PORT: "3000"
    stop_grace_period: 35s
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
      - opscrew-edge
    depends_on:
      db:
        condition: service_healthy
  db:
    image: postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
    restart: unless-stopped
    env_file:
      - db.env
    volumes:
      - db_data:/var/lib/postgresql/data
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U $\${POSTGRES_USER} -d $\${POSTGRES_DB}
      interval: 10s
      timeout: 5s
      retries: 6
    mem_limit: 512m
    memswap_limit: 512m
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - internal
networks:
  internal: {}
  opscrew-edge:
    external: true
volumes:
  db_data: {}
",
  "opscrew/runtime/edge/compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's shared edge on this computer (Compose project opscrew-edge), in front of
# every OpsCrew app there: nginx and kamal-proxy. It listens on 127.0.0.1 only.
name: opscrew-edge
x-opscrew-edge-version: 2026102103
x-opscrew-edge-proxy: nginx
services:
  kamal-proxy:
    image: basecamp/kamal-proxy:v0.10.2@sha256:a686220c2aa42c4f9bbcfe851b1d21b2cedee0b5c389890c29d205282379da7c
    restart: unless-stopped
    volumes:
      - kamal-proxy-config:/home/kamal-proxy/.config/kamal-proxy
    mem_limit: 32m
    memswap_limit: 32m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
  nginx:
    image: nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
    restart: unless-stopped
    user: \${OPSCREW_DEPLOY_UID:?the OpsCrew deploy writes it to /srv/edge/.env}:\${OPSCREW_DEPLOY_GID:?the OpsCrew deploy writes it to /srv/edge/.env}
    init: true
    mem_limit: 64m
    memswap_limit: 64m
    ports:
      - 127.0.0.1:80:8080
      - 127.0.0.1:443:8443
    configs:
      - source: nginx-conf
        target: /etc/nginx/nginx.conf
    entrypoint:
      - sh
      - -c
      - |-
        rm -f /tmp/nginx.pid
        nginx -g 'daemon off;' &
        pid=$$!
        trap 'kill -QUIT "$$pid"; wait "$$pid"; exit 0' TERM INT QUIT
        while kill -0 "$$pid" 2> /dev/null; do
          sleep 5 &
          wait $$!
          if [ -e /var/www/reload/flag ]; then
            rm -f /var/www/reload/flag
            if nginx -t -q; then nginx -s reload; fi
          fi
        done
        exit 1
    volumes:
      - ./sites:/etc/nginx/sites:ro
      - ./tls:/etc/nginx/tls:ro
    healthcheck:
      test:
        - CMD-SHELL
        - test -s /tmp/nginx.pid
      interval: 30s
      timeout: 5s
      start_period: 30s
      start_interval: 1s
    labels:
      dev.opscrew.nginx-conf-sha256: eaf4074db9ee26a473f1aa40e7581545320392afc2b0972d1a480945b959ed17
    depends_on:
      - kamal-proxy
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
configs:
  nginx-conf:
    content: |
      # OpsCrew's shared edge: each OpsCrew app on this server has its site in /srv/edge/sites/<app>.conf.
      worker_processes auto;
      pid /tmp/nginx.pid;
      error_log stderr notice;

      events {
      	worker_connections 1024;
      }

      http {
      	include /etc/nginx/mime.types;
      	default_type application/octet-stream;
      	access_log off;
      	server_tokens off;
      	http2 on;
      	# A block with headers of its own (the user's additions) keeps the site's: HSTS and the rest.
      	add_header_inherit merge;
      	# nginx runs as the deploy user, who can write only /tmp in the container.
      	client_body_temp_path /tmp/client_temp;
      	proxy_temp_path /tmp/proxy_temp;
      	fastcgi_temp_path /tmp/fastcgi_temp;
      	uwsgi_temp_path /tmp/uwsgi_temp;
      	scgi_temp_path /tmp/scgi_temp;

      	# Mozilla's intermediate configuration (version 6.0).
      	ssl_protocols TLSv1.2 TLSv1.3;
      	ssl_ecdh_curve X25519MLKEM768:X25519:prime256v1:secp384r1;
      	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
      	ssl_prefer_server_ciphers off;
      	ssl_session_timeout 1d;
      	ssl_session_cache shared:opscrew_tls:10m;
      	ssl_session_tickets off;

      	# WebSockets: an Upgrade request reaches the app as one.
      	map $$http_upgrade $$connection_upgrade {
      		default upgrade;
      		"" close;
      	}

      	# kamal-proxy, looked up again in Docker's DNS every 10 seconds, and never set aside after a
      	# failed request: it is the only upstream.
      	resolver 127.0.0.11 valid=10s ipv6=off;
      	upstream kamal-proxy {
      		zone kamal-proxy 64k;
      		server kamal-proxy:80 resolve max_fails=0;
      	}

      	# Requests for any other hostname are refused: the connection is closed, and a TLS handshake
      	# for a name no site serves fails.
      	server {
      		listen 8080 default_server;
      		listen 8443 ssl default_server;
      		listen 8443 quic reuseport default_server;
      		ssl_reject_handshake on;
      		return 444;
      	}

      	include /etc/nginx/sites/*.conf;
      }
networks:
  opscrew-edge:
    external: true
volumes:
  kamal-proxy-config: {}
",
  "opscrew/runtime/edge/sites/shop.conf": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop's site on this computer's shared edge (nginx): the local deploy copies it to the edge's sites.
# Your additions can limit requests with \`limit_req zone=opscrew_shop;\`.
limit_req_zone $binary_remote_addr zone=opscrew_shop:1m rate=10r/s;

server {
	listen 8080;
	server_name shop.localhost;
	location / {
		return 308 https://$host$request_uri;
	}
}

server {
	listen 8443 ssl;
	server_name shop.localhost;
	ssl_certificate /etc/nginx/tls/shop/local.pem;
	ssl_certificate_key /etc/nginx/tls/shop/local.key;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	client_max_body_size 100m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
	proxy_buffering off;
	proxy_request_buffering off;
	location / {
		proxy_pass http://kamal-proxy;
	}
}
",
}
`;

exports[`snapshots > two localhost environments of the app on one caddy edge 1`] = `
{
  "edge": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's shared edge on this computer (Compose project opscrew-edge), in front of
# every OpsCrew app there: Caddy and kamal-proxy. It listens on 127.0.0.1 only.
name: opscrew-edge
x-opscrew-edge-version: 2026102103
x-opscrew-edge-proxy: caddy
services:
  kamal-proxy:
    image: basecamp/kamal-proxy:v0.10.2@sha256:a686220c2aa42c4f9bbcfe851b1d21b2cedee0b5c389890c29d205282379da7c
    restart: unless-stopped
    volumes:
      - kamal-proxy-config:/home/kamal-proxy/.config/kamal-proxy
    mem_limit: 32m
    memswap_limit: 32m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
  caddy:
    image: caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
    restart: unless-stopped
    mem_limit: 64m
    memswap_limit: 64m
    ports:
      - 127.0.0.1:80:80
      - 127.0.0.1:443:443
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    volumes:
      - ./sites:/etc/caddy/sites:ro
      - ./tls:/etc/caddy/tls:ro
      - caddy_data:/data
      - caddy_config:/config
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - -O
        - /dev/null
        - http://127.0.0.1:2019/config/
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
      start_interval: 1s
    labels:
      dev.opscrew.caddyfile-sha256: 2709b11e2a5b667bb0f2071019a06d4795d5736e86fe4be86950816909a38aba
    depends_on:
      - kamal-proxy
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    networks:
      - opscrew-edge
configs:
  caddyfile:
    content: |
      # OpsCrew's shared edge: each OpsCrew app on this server has its site in /srv/edge/sites/<app>.caddy.
      # No HTTP/3: the edge on this computer publishes no UDP port.
      {
      	servers {
      		protocols h1 h2
      	}
      }

      import /etc/caddy/sites/*.caddy

      # Requests for any other hostname are refused.
      http:// {
      	abort
      }
      https:// {
      	abort
      }
networks:
  opscrew-edge:
    external: true
volumes:
  caddy_data: {}
  caddy_config: {}
  kamal-proxy-config: {}
",
  "sites": {
    "shop-staging.caddy": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop-staging's site on this computer's shared edge: the local deploy copies it to the edge's sites.
http://staging.shop.localhost {
	redir https://{host}{uri} 308
}

staging.shop.localhost {
	tls /etc/caddy/tls/shop-staging/local.pem /etc/caddy/tls/shop-staging/local.key
	encode zstd gzip
	reverse_proxy kamal-proxy:80
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	handle_errors {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
",
    "shop.caddy": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop's site on this computer's shared edge: the local deploy copies it to the edge's sites.
http://prod.shop.localhost {
	redir https://{host}{uri} 308
}

prod.shop.localhost {
	tls /etc/caddy/tls/shop/local.pem /etc/caddy/tls/shop/local.key
	encode zstd gzip
	reverse_proxy kamal-proxy:80
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	handle_errors {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
",
  },
}
`;

