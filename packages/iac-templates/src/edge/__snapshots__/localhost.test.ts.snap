{
  "edge": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's shared edge on this computer (Compose project opscrew-edge), in front of
# every OpsCrew app there: nginx and kamal-proxy. It listens on 127.0.0.1 only.
