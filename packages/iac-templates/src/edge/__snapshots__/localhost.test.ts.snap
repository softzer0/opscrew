        target: /etc/nginx/nginx.conf
    entrypoint:
      - sh
      - -c
      - |-
        rm -f /tmp/nginx.pid
        nginx -g 'daemon off;' &
        pid=$$!
        trap 'kill -QUIT "$$pid"; wait "$$pid"; exit 0' TERM INT QUIT
        while kill -0 "$$pid" 2> /dev/null; do
          sleep 5 &
          wait $$!
          if [ -e /var/www/reload/flag ]; then
            rm -f /var/www/reload/flag
            if nginx -t -q; then nginx -s reload; fi
          fi
        done
        exit 1
    volumes:
      - ./sites:/etc/nginx/sites:ro
      - ./tls:/etc/nginx/tls:ro
    healthcheck:
      test:
        - CMD-SHELL
        - test -s /tmp/nginx.pid
      interval: 30s
      timeout: 5s
      start_period: 30s
      start_interval: 1s
    labels:
      dev.opscrew.nginx-conf-sha256: eaf4074db9ee26a473f1aa40e7581545320392afc2b0972d1a480945b959ed17
    depends_on:
      - kamal-proxy
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
configs:
  nginx-conf:
    content: |
      # OpsCrew's shared edge: each OpsCrew app on this server has its site in /srv/edge/sites/<app>.conf.
      worker_processes auto;
      pid /tmp/nginx.pid;
      error_log stderr notice;

      events {
      	worker_connections 1024;
      }

      http {
      	include /etc/nginx/mime.types;
      	default_type application/octet-stream;
      	access_log off;
      	server_tokens off;
      	http2 on;
      	# A block with headers of its own (the user's additions) keeps the site's: HSTS and the rest.
      	add_header_inherit merge;
      	# nginx runs as the deploy user, who can write only /tmp in the container.
      	client_body_temp_path /tmp/client_temp;
      	proxy_temp_path /tmp/proxy_temp;
      	fastcgi_temp_path /tmp/fastcgi_temp;
      	uwsgi_temp_path /tmp/uwsgi_temp;
      	scgi_temp_path /tmp/scgi_temp;

      	# Mozilla's intermediate configuration (version 6.0).
      	ssl_protocols TLSv1.2 TLSv1.3;
      	ssl_ecdh_curve X25519MLKEM768:X25519:prime256v1:secp384r1;
      	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
      	ssl_prefer_server_ciphers off;
      	ssl_session_timeout 1d;
      	ssl_session_cache shared:opscrew_tls:10m;
      	ssl_session_tickets off;

      	# WebSockets: an Upgrade request reaches the app as one.
      	map $$http_upgrade $$connection_upgrade {
      		default upgrade;
      		"" close;
      	}

      	# kamal-proxy, looked up again in Docker's DNS every 10 seconds, and never set aside after a
      	# failed request: it is the only upstream.
      	resolver 127.0.0.11 valid=10s ipv6=off;
      	upstream kamal-proxy {
      		zone kamal-proxy 64k;
      		server kamal-proxy:80 resolve max_fails=0;
      	}

      	# Requests for any other hostname are refused: the connection is closed, and a TLS handshake
      	# for a name no site serves fails.
      	server {
      		listen 8080 default_server;
      		listen 8443 ssl default_server;
      		listen 8443 quic reuseport default_server;
      		ssl_reject_handshake on;
      		return 444;
      	}

      	include /etc/nginx/sites/*.conf;
      }
networks:
  opscrew-edge:
    external: true
volumes:
  kamal-proxy-config: {}
",
  "sites": {
    "shop-staging.conf": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop-staging's site on this computer's shared edge (nginx): the local deploy copies it to the edge's sites.
# Your additions can limit requests with \`limit_req zone=opscrew_shop-staging;\`.
limit_req_zone $binary_remote_addr zone=opscrew_shop-staging:1m rate=10r/s;

server {
	listen 8080;
	server_name staging.shop.localhost;
	location / {
		return 308 https://$host$request_uri;
	}
}

server {
	listen 8443 ssl;
	server_name staging.shop.localhost;
	ssl_certificate /etc/nginx/tls/shop-staging/local.pem;
	ssl_certificate_key /etc/nginx/tls/shop-staging/local.key;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	client_max_body_size 100m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
	proxy_buffering off;
	proxy_request_buffering off;
	location / {
		proxy_pass http://kamal-proxy;
	}
}
",
    "shop.conf": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop's site on this computer's shared edge (nginx): the local deploy copies it to the edge's sites.
# Your additions can limit requests with \`limit_req zone=opscrew_shop;\`.
limit_req_zone $binary_remote_addr zone=opscrew_shop:1m rate=10r/s;

server {
	listen 8080;
	server_name prod.shop.localhost;
	location / {
		return 308 https://$host$request_uri;
	}
}

server {
	listen 8443 ssl;
	server_name prod.shop.localhost;
	ssl_certificate /etc/nginx/tls/shop/local.pem;
	ssl_certificate_key /etc/nginx/tls/shop/local.key;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	client_max_body_size 100m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
	proxy_buffering off;
	proxy_request_buffering off;
	location / {
		proxy_pass http://kamal-proxy;
	}
}
",
  },
}
`;
