// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshots > a DNS-only app's site, and before its first certificate 1`] = `
{
  "blog.conf": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# blog's site on the server's shared edge (nginx): the deploy copies it to /srv/edge/sites/blog.conf.
# Your additions can limit requests with \`limit_req zone=opscrew_blog;\`.
limit_req_zone $binary_remote_addr zone=opscrew_blog:1m rate=10r/s;

server {
	listen 8080;
	server_name blog.example.com;
	location /.well-known/acme-challenge/ {
		root /var/www/acme;
	}
	location / {
		return 308 https://$host$request_uri;
	}
}

server {
	listen 8443 ssl;
	listen 8443 quic;
	server_name blog.example.com;
	ssl_certificate /etc/letsencrypt/live/blog/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/blog/privkey.pem;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Alt-Svc 'h3=":443"; ma=2592000' always;
	client_max_body_size 100m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
	proxy_buffering off;
	proxy_request_buffering off;
	location / {
		proxy_pass http://kamal-proxy;
	}
}
",
  "blog.http.conf": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# blog's site on the server's shared edge (nginx): the deploy copies it to /srv/edge/sites/blog.conf.
# Your additions can limit requests with \`limit_req zone=opscrew_blog;\`.
limit_req_zone $binary_remote_addr zone=opscrew_blog:1m rate=10r/s;

# HTTP only until certbot has the first certificate; the deploy then installs the HTTPS site.
server {
	listen 8080;
	server_name blog.example.com;
	location /.well-known/acme-challenge/ {
		root /var/www/acme;
	}
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	client_max_body_size 100m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
	proxy_buffering off;
	proxy_request_buffering off;
	location / {
		proxy_pass http://kamal-proxy;
	}
}
",
}
`;

exports[`snapshots > a proxied app's site with origin TLS and its own additions 1`] = `
{
  "shop.conf": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# shop's site on the server's shared edge (nginx): the deploy copies it to /srv/edge/sites/shop.conf.
# Your additions can limit requests with \`limit_req zone=opscrew_shop;\`.
limit_req_zone $binary_remote_addr zone=opscrew_shop:1m rate=10r/s;

server {
	listen 8080;
	server_name example.com www.example.com;
	location / {
		return 308 https://$host$request_uri;
	}
}

server {
	listen 8443 ssl;
	listen 8443 quic;
	server_name example.com;
	ssl_certificate /etc/nginx/tls/shop/origin.pem;
	ssl_certificate_key /etc/nginx/tls/shop/origin.key;
	ssl_verify_client on;
	ssl_client_certificate /etc/nginx/tls/shop/pull.pem;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Alt-Svc 'h3=":443"; ma=2592000' always;
	client_max_body_size 100m;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;
	proxy_set_header X-Forwarded-For $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
	proxy_buffering off;
	proxy_request_buffering off;
	location / {
		proxy_pass http://kamal-proxy;
	}
	# Your own additions (opscrew/proxy/additions.nginx).
	include /etc/nginx/sites/shop.additions;
}

server {
	listen 8443 ssl;
	listen 8443 quic;
	server_name www.example.com;
	ssl_certificate /etc/nginx/tls/shop/origin.pem;
	ssl_certificate_key /etc/nginx/tls/shop/origin.key;
	ssl_verify_client on;
	ssl_client_certificate /etc/nginx/tls/shop/pull.pem;
	return 308 https://example.com$request_uri;
}
",
}
`;

exports[`snapshots > the nginx edge 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's shared edge on the server (/srv/edge, Compose project opscrew-edge), in front of
# every OpsCrew app there: nginx, certbot and kamal-proxy. Each app's deploy brings this file and puts it
# in /srv/edge only when its x-opscrew-edge-version is larger than the server's, or when its
# x-opscrew-edge-proxy differs (the switch, while the server holds one OpsCrew app).
name: opscrew-edge
x-opscrew-edge-version: 2026102103
x-opscrew-edge-proxy: nginx
services:
  kamal-proxy:
    image: basecamp/kamal-proxy:v0.10.2@sha256:a686220c2aa42c4f9bbcfe851b1d21b2cedee0b5c389890c29d205282379da7c
    restart: unless-stopped
    volumes:
      - kamal-proxy-config:/home/kamal-proxy/.config/kamal-proxy
    mem_limit: 32m
    memswap_limit: 32m
    security_opt: &a1
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
  nginx:
    image: nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
    restart: unless-stopped
    user: \${OPSCREW_DEPLOY_UID:?the OpsCrew deploy writes it to /srv/edge/.env}:\${OPSCREW_DEPLOY_GID:?the OpsCrew deploy writes it to /srv/edge/.env}
    init: true
    mem_limit: 64m
    memswap_limit: 64m
    ports:
      - 80:8080
      - 443:8443
      - 443:8443/udp
    configs:
      - source: nginx-conf
        target: /etc/nginx/nginx.conf
    entrypoint:
      - sh
      - -c
      - |-
        rm -f /tmp/nginx.pid
        nginx -g 'daemon off;' &
        pid=$$!
        trap 'kill -QUIT "$$pid"; wait "$$pid"; exit 0' TERM INT QUIT
        while kill -0 "$$pid" 2> /dev/null; do
          sleep 5 &
          wait $$!
          if [ -e /var/www/reload/flag ]; then
            rm -f /var/www/reload/flag
            if nginx -t -q; then nginx -s reload; fi
          fi
        done
        exit 1
    volumes:
      - ./sites:/etc/nginx/sites:ro
      - ./tls:/etc/nginx/tls:ro
      - letsencrypt:/etc/letsencrypt:ro
      - acme-webroot:/var/www/acme:ro
      - reload:/var/www/reload
    healthcheck:
      test:
        - CMD-SHELL
        - test -s /tmp/nginx.pid
      interval: 30s
      timeout: 5s
      start_period: 30s
      start_interval: 1s
    labels:
      dev.opscrew.nginx-conf-sha256: eaf4074db9ee26a473f1aa40e7581545320392afc2b0972d1a480945b959ed17
    depends_on:
      - kamal-proxy
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
  certbot:
    image: certbot/certbot:v5.8.0@sha256:f70ad0adbb7e117f0fe42a63c553f28ea451edabc0148757b6efcd9735acaa20
    restart: unless-stopped
    user: \${OPSCREW_DEPLOY_UID:?the OpsCrew deploy writes it to /srv/edge/.env}:\${OPSCREW_DEPLOY_GID:?the OpsCrew deploy writes it to /srv/edge/.env}
    init: true
    mem_limit: 64m
    memswap_limit: 64m
    entrypoint:
      - sh
      - -c
      - |-
        trap 'exit 0' TERM INT
        while :; do
          sleep $$((43200 + RANDOM % 3600)) &
          wait $$!
          certbot renew --config-dir /etc/letsencrypt --work-dir /tmp/certbot/work --logs-dir /tmp/certbot/logs --no-random-sleep-on-renew
        done
    volumes:
      - letsencrypt:/etc/letsencrypt
      - acme-webroot:/var/www/acme
      - reload:/var/www/reload
    security_opt: *a1
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - opscrew-edge
configs:
  nginx-conf:
    content: |
      # OpsCrew's shared edge: each OpsCrew app on this server has its site in /srv/edge/sites/<app>.conf.
      worker_processes auto;
      pid /tmp/nginx.pid;
      error_log stderr notice;

      events {
      	worker_connections 1024;
      }

      http {
      	include /etc/nginx/mime.types;
      	default_type application/octet-stream;
      	access_log off;
      	server_tokens off;
      	http2 on;
      	# A block with headers of its own (the user's additions) keeps the site's: HSTS and the rest.
      	add_header_inherit merge;
      	# nginx runs as the deploy user, who can write only /tmp in the container.
      	client_body_temp_path /tmp/client_temp;
      	proxy_temp_path /tmp/proxy_temp;
      	fastcgi_temp_path /tmp/fastcgi_temp;
      	uwsgi_temp_path /tmp/uwsgi_temp;
      	scgi_temp_path /tmp/scgi_temp;

      	# Mozilla's intermediate configuration (version 6.0).
      	ssl_protocols TLSv1.2 TLSv1.3;
      	ssl_ecdh_curve X25519MLKEM768:X25519:prime256v1:secp384r1;
      	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
      	ssl_prefer_server_ciphers off;
      	ssl_session_timeout 1d;
      	ssl_session_cache shared:opscrew_tls:10m;
      	ssl_session_tickets off;

      	# WebSockets: an Upgrade request reaches the app as one.
      	map $$http_upgrade $$connection_upgrade {
      		default upgrade;
      		"" close;
      	}

      	# kamal-proxy, looked up again in Docker's DNS every 10 seconds, and never set aside after a
      	# failed request: it is the only upstream.
      	resolver 127.0.0.11 valid=10s ipv6=off;
      	upstream kamal-proxy {
      		zone kamal-proxy 64k;
      		server kamal-proxy:80 resolve max_fails=0;
      	}

      	# Requests for any other hostname are refused: the connection is closed, and a TLS handshake
      	# for a name no site serves fails.
      	server {
      		listen 8080 default_server;
      		listen 8443 ssl default_server;
      		listen 8443 quic reuseport default_server;
      		ssl_reject_handshake on;
      		return 444;
      	}

      	include /etc/nginx/sites/*.conf;
      }
networks:
  opscrew-edge:
    external: true
volumes:
  letsencrypt: {}
  acme-webroot: {}
  reload: {}
  kamal-proxy-config: {}
"
`;

