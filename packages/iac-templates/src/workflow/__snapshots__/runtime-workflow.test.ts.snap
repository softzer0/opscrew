// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderWorkflow > is valid YAML with least-privilege permissions and a concurrency group 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app image, pushes it to GitHub Container Registry and deploys it to your server
# over SSH. Secrets are set by \`opscrew provision\`; their values never appear in this file.
name: OpsCrew deploy

on:
  push:
    branches: ["main"]
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"

  deploy:
    name: Deploy to the server
    needs: build
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
          OPSCREW_SERVICE_CACHE_ENV: \${{ secrets.OPSCREW_SERVICE_CACHE_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_CACHE_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/cache.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          set -eu
          export DOCKER_CONFIG=/srv/apps/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd /srv/apps/shop
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f /srv/edge/compose.yaml "$@"; }
          docker compose pull
          mkdir -p /srv/edge/sites
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' /srv/edge/compose.yaml 2> /dev/null || true)"
            if [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml /srv/edge/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml /srv/edge/compose.yaml; then
              cp edge/compose.yaml /srv/edge/compose.yaml
              echo "OpsCrew's shared edge on this server now publishes the ports for how this app is served."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            rm -f .site.previous
            if [ -f /srv/edge/sites/shop.caddy ]; then cp /srv/edge/sites/shop.caddy .site.previous; fi
            cp edge/sites/shop.caddy /srv/edge/sites/shop.caddy
            if ! edge up -d --wait || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous /srv/edge/sites/shop.caddy; else rm -f /srv/edge/sites/shop.caddy; fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in /srv/edge) did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
          ) 9> /srv/edge/.lock
          docker compose up -d --no-deps --wait db cache
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          set -eu
          cd /srv/apps/shop
          edge() { docker compose -p opscrew-edge -f /srv/edge/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1

  prune:
    name: Delete old images
    needs: [build, deploy]
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Keep the newest 10 images and delete older ones
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
          KEEP: "10"
        run: |
          // OpsCrew image retention (opscrew/plan.yaml, cicd.imageRetention): deletes old versions of
          // this repository's image from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions: [{ id, digest, tags, created }], as the GitHub API lists them.
           * children: by digest, the digests an image index lists (its platform manifests and attestations).
           * keep: how many <commit> versions to keep, newest first; undefined (retention off) deletes only
           * the build-<commit> intermediates and what only they list.
           * protect: digests never deleted: the running and the previous image.
           *
           * Kept: the protected digests, the newest keep <commit> versions, versions with a tag OpsCrew did
           * not push (yours, or Buildpacks' buildcache), signatures of kept images, and whatever a kept index
           * lists, tagged or not. Deleted: build-<commit> intermediates, older <commit> versions with their
           * signatures, and untagged versions nothing kept lists.
           */
          function prunable(versions, children, keep, protect) {
            const commit = (tag) => /^[0-9a-f]{40}$/.test(tag);
            const build = (tag) => /^build-[0-9a-f]{40}$/.test(tag);
            const subject = (tag) => {
              const match = /^sha256-([0-9a-f]{64})(\\.[a-z]+)?$/.exec(tag);
              return match ? "sha256:" + match[1] : undefined;
            };
            const ours = (tag) => commit(tag) || build(tag) || subject(tag) !== undefined;
            const listed = (digests) => new Set([...digests].flatMap((digest) => children[digest] || []));

            const kept = new Set(protect);
            if (keep === undefined) {
              for (const v of versions) if (!v.tags.every(build)) kept.add(v.digest);
            } else {
              const deployed = versions
                .filter((v) => v.tags.some(commit))
                .sort((a, b) => b.created.localeCompare(a.created) || b.id - a.id);
              for (const v of deployed.slice(0, keep)) kept.add(v.digest);
              for (const v of versions) if (!v.tags.every(ours)) kept.add(v.digest);
              for (const v of versions) if (v.tags.some((tag) => kept.has(subject(tag)))) kept.add(v.digest);
            }

            // Everything a kept version lists, and what that lists in turn, stays.
            const reachable = new Set(kept);
            const queue = [...kept];
            while (queue.length > 0) {
              for (const digest of children[queue.pop()] || []) {
                if (!reachable.has(digest)) {
                  reachable.add(digest);
                  queue.push(digest);
                }
              }
            }
            const goes = (v) => !reachable.has(v.digest);
            const listedByDeleted = listed(versions.filter((v) => v.tags.length > 0 && goes(v)).map((v) => v.digest));
            return versions
              .filter((v) => goes(v) && (v.tags.length > 0 || keep !== undefined || listedByDeleted.has(v.digest)))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const digestOf = (ref) => (digestRef.test(ref) ? ref.split("@")[1] : undefined);
            const running = digestOf(process.env.IMAGE || "");
            const previous = process.env.PREVIOUS ? digestOf(process.env.PREVIOUS) : null;
            if (running === undefined || previous === undefined) {
              fail("OpsCrew could not tell which images the server runs, so it deleted none. The deploy itself succeeded.");
              return;
            }
            const protect = previous === null ? [running] : [running, previous];
            const keep = process.env.KEEP ? Number(process.env.KEEP) : undefined;
            const [owner, name] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) throw new Error(what + " answered HTTP " + response.status);
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });

            let deleting = false;
            try {
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              const base =
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions";
              const versions = [];
              for (let page = 1; ; page++) {
                const batch = await read(await github("GET", base + "?per_page=100&page=" + page), "The GitHub packages API");
                for (const v of batch) {
                  versions.push({ id: v.id, digest: v.name, tags: v.metadata.container.tags, created: v.created_at });
                }
                if (batch.length < 100) break;
              }

              const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
              const scope = "repository:" + owner + "/" + name + ":pull";
              const login = await read(
                await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                "GitHub Container Registry",
              );
              const children = {};
              const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
              for (const digest of new Set([...protect, ...tagged])) {
                const manifest = await read(
                  await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                    headers: {
                      Authorization: "Bearer " + login.token,
                      Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                    },
                  }),
                  "GitHub Container Registry",
                );
                children[digest] = (manifest.manifests || []).map((m) => m.digest);
              }

              const ids = new Set(prunable(versions, children, keep, protect));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + ".");
              deleting = true;
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              if (failed > 0) {
                fail(failed + " image versions were not deleted; the next deploy tries again. The deploy itself succeeded.");
              }
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting old images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The deploy itself succeeded; the next deploy tries again.",
              );
            }
          }
          main();
"
`;

exports[`renderWorkflow > with a release command > matches the snapshot 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app image, pushes it to GitHub Container Registry and deploys it to your server
# over SSH. Secrets are set by \`opscrew provision\`; their values never appear in this file.
name: OpsCrew deploy

on:
  push:
    branches: ["main"]
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"

  deploy:
    name: Deploy to the server
    needs: build
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
          OPSCREW_SERVICE_CACHE_ENV: \${{ secrets.OPSCREW_SERVICE_CACHE_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_CACHE_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/cache.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          set -eu
          export DOCKER_CONFIG=/srv/apps/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd /srv/apps/shop
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f /srv/edge/compose.yaml "$@"; }
          docker compose pull
          mkdir -p /srv/edge/sites
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' /srv/edge/compose.yaml 2> /dev/null || true)"
            if [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml /srv/edge/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml /srv/edge/compose.yaml; then
              cp edge/compose.yaml /srv/edge/compose.yaml
              echo "OpsCrew's shared edge on this server now publishes the ports for how this app is served."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            rm -f .site.previous
            if [ -f /srv/edge/sites/shop.caddy ]; then cp /srv/edge/sites/shop.caddy .site.previous; fi
            cp edge/sites/shop.caddy /srv/edge/sites/shop.caddy
            if ! edge up -d --wait || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous /srv/edge/sites/shop.caddy; else rm -f /srv/edge/sites/shop.caddy; fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in /srv/edge) did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
          ) 9> /srv/edge/.lock
          docker compose up -d --no-deps --wait db cache
          if ! (umask 077; docker compose run --rm --no-deps -T release < /dev/null > /srv/apps/shop/release.log 2>&1); then
            echo '::error::The release command (app.releaseCommand in opscrew/plan.yaml) failed, so the new version was not started and the previous version keeps serving. Its output stays on the server in /srv/apps/shop/release.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command): fix the command or the app and push again.'
            exit 1
          fi
          echo 'The release command finished; its output is in /srv/apps/shop/release.log on the server.'
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          set -eu
          cd /srv/apps/shop
          edge() { docker compose -p opscrew-edge -f /srv/edge/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1

  prune:
    name: Delete old images
    needs: [build, deploy]
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Keep the newest 10 images and delete older ones
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
          KEEP: "10"
        run: |
          // OpsCrew image retention (opscrew/plan.yaml, cicd.imageRetention): deletes old versions of
          // this repository's image from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions: [{ id, digest, tags, created }], as the GitHub API lists them.
           * children: by digest, the digests an image index lists (its platform manifests and attestations).
           * keep: how many <commit> versions to keep, newest first; undefined (retention off) deletes only
           * the build-<commit> intermediates and what only they list.
           * protect: digests never deleted: the running and the previous image.
           *
           * Kept: the protected digests, the newest keep <commit> versions, versions with a tag OpsCrew did
           * not push (yours, or Buildpacks' buildcache), signatures of kept images, and whatever a kept index
           * lists, tagged or not. Deleted: build-<commit> intermediates, older <commit> versions with their
           * signatures, and untagged versions nothing kept lists.
           */
          function prunable(versions, children, keep, protect) {
            const commit = (tag) => /^[0-9a-f]{40}$/.test(tag);
            const build = (tag) => /^build-[0-9a-f]{40}$/.test(tag);
            const subject = (tag) => {
              const match = /^sha256-([0-9a-f]{64})(\\.[a-z]+)?$/.exec(tag);
              return match ? "sha256:" + match[1] : undefined;
            };
            const ours = (tag) => commit(tag) || build(tag) || subject(tag) !== undefined;
            const listed = (digests) => new Set([...digests].flatMap((digest) => children[digest] || []));

            const kept = new Set(protect);
            if (keep === undefined) {
              for (const v of versions) if (!v.tags.every(build)) kept.add(v.digest);
            } else {
              const deployed = versions
                .filter((v) => v.tags.some(commit))
                .sort((a, b) => b.created.localeCompare(a.created) || b.id - a.id);
              for (const v of deployed.slice(0, keep)) kept.add(v.digest);
              for (const v of versions) if (!v.tags.every(ours)) kept.add(v.digest);
              for (const v of versions) if (v.tags.some((tag) => kept.has(subject(tag)))) kept.add(v.digest);
            }

            // Everything a kept version lists, and what that lists in turn, stays.
            const reachable = new Set(kept);
            const queue = [...kept];
            while (queue.length > 0) {
              for (const digest of children[queue.pop()] || []) {
                if (!reachable.has(digest)) {
                  reachable.add(digest);
                  queue.push(digest);
                }
              }
            }
            const goes = (v) => !reachable.has(v.digest);
            const listedByDeleted = listed(versions.filter((v) => v.tags.length > 0 && goes(v)).map((v) => v.digest));
            return versions
              .filter((v) => goes(v) && (v.tags.length > 0 || keep !== undefined || listedByDeleted.has(v.digest)))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const digestOf = (ref) => (digestRef.test(ref) ? ref.split("@")[1] : undefined);
            const running = digestOf(process.env.IMAGE || "");
            const previous = process.env.PREVIOUS ? digestOf(process.env.PREVIOUS) : null;
            if (running === undefined || previous === undefined) {
              fail("OpsCrew could not tell which images the server runs, so it deleted none. The deploy itself succeeded.");
              return;
            }
            const protect = previous === null ? [running] : [running, previous];
            const keep = process.env.KEEP ? Number(process.env.KEEP) : undefined;
            const [owner, name] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) throw new Error(what + " answered HTTP " + response.status);
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });

            let deleting = false;
            try {
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              const base =
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions";
              const versions = [];
              for (let page = 1; ; page++) {
                const batch = await read(await github("GET", base + "?per_page=100&page=" + page), "The GitHub packages API");
                for (const v of batch) {
                  versions.push({ id: v.id, digest: v.name, tags: v.metadata.container.tags, created: v.created_at });
                }
                if (batch.length < 100) break;
              }

              const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
              const scope = "repository:" + owner + "/" + name + ":pull";
              const login = await read(
                await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                "GitHub Container Registry",
              );
              const children = {};
              const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
              for (const digest of new Set([...protect, ...tagged])) {
                const manifest = await read(
                  await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                    headers: {
                      Authorization: "Bearer " + login.token,
                      Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                    },
                  }),
                  "GitHub Container Registry",
                );
                children[digest] = (manifest.manifests || []).map((m) => m.digest);
              }

              const ids = new Set(prunable(versions, children, keep, protect));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + ".");
              deleting = true;
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              if (failed > 0) {
                fail(failed + " image versions were not deleted; the next deploy tries again. The deploy itself succeeded.");
              }
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting old images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The deploy itself succeeded; the next deploy tries again.",
              );
            }
          }
          main();
"
`;
