// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderGithubPagesWorkflow > matches the snapshots > Hugo 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the site and publishes it on GitHub Pages. Secrets are set by \`opscrew provision\`; their
# values never appear in this file, but whatever the build puts into the site is public.
name: OpsCrew deploy

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - ".github/workflows/opscrew-deploy.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  build:
    name: Build the site
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - name: Install Hugo <pin:TOOLS.hugo.version>
        run: |
          set -euo pipefail
          curl -fsSL --retry 3 -o "$RUNNER_TEMP/hugo.tar.gz" <pin:TOOLS.hugo.url>
          echo "<pin:TOOLS.hugo.sha256>  $RUNNER_TEMP/hugo.tar.gz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/hugo"
          tar -xzf "$RUNNER_TEMP/hugo.tar.gz" -C "$RUNNER_TEMP/hugo"
          sudo install -m 0755 "$RUNNER_TEMP/hugo/hugo" /usr/local/bin/hugo
          hugo version
      - name: Build the site
        working-directory: "."
        run: |
          set -euo pipefail
          hugo --minify
      - name: Check the site against GitHub Pages' limit
        run: |
          set -euo pipefail
          if [[ ! -d 'public' ]]; then
            echo "::error::The build left no folder public, where opscrew/plan.yaml expects the site's files (target.site.outputDir): change target.site in opscrew/plan.yaml to what the build writes, then run \\\`opscrew provision\\\` again."
            exit 1
          fi
          bytes="$(du -sb 'public' | cut -f 1)"
          if [[ "$bytes" -gt 1073741824 ]]; then
            echo "::error::The site in public is $(( bytes / 1048576 )) MB, over the 1 GB GitHub Pages publishes. Leave out the files the site does not need, or host it on Cloudflare (\\\`opscrew design\\\`), then push again."
            exit 1
          fi
      - uses: <pin:ACTIONS.configurePages>
      - name: Keep the built site for GitHub Pages
        uses: <pin:ACTIONS.uploadPagesArtifact>
        with:
          path: "public"
          # Keeps files such as .well-known, which the action leaves out otherwise.
          include-hidden-files: true

  deploy:
    name: Publish on GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    environment: github-pages
    permissions:
      pages: write
      id-token: write
    steps:
      - name: Publish the site
        uses: <pin:ACTIONS.deployPages>
      - name: Check that the site answers
        env:
          URL: https://docs.example.com/
        run: |
          set -uo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            curl -fsS --max-time 10 -o /dev/null "$URL" || code=$?
            if [[ "$code" -eq 0 ]]; then
              echo "The site answers after $attempt attempt(s)."
              exit 0
            fi
            case "$code" in 35 | 51 | 60) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [[ "$tls_only" -eq 1 ]]; then
            echo "::warning::GitHub has not issued the certificate for docs.example.com yet, so this run could not check the site over HTTPS. GitHub issues it once it has checked the domain's DNS records, which can take up to 24 hours; \\\`opscrew verify\\\` says when it is there. Then run \\\`opscrew provision\\\` to enforce HTTPS."
            exit 0
          fi
          echo "::error::The site did not answer at $URL."
          exit 1
"
`;

exports[`renderGithubPagesWorkflow > matches the snapshots > build job, pnpm 1`] = `
"  build:
    name: Build the site
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "24"
      - name: Install pnpm
        working-directory: "."
        run: |
          set -euo pipefail
          spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@<pin:PACKAGE_MANAGERS.pnpm>");process.exit(1)}const v=m?m[1]:"<pin:PACKAGE_MANAGERS.pnpm>";console.log("pnpm@"+v)')"
          npm install -g --no-audit --no-fund "$spec"
      - name: Install the site's dependencies
        working-directory: "."
        run: |
          set -euo pipefail
          if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
      - name: Build the site
        working-directory: "."
        run: |
          set -euo pipefail
          pnpm run build
      - name: Check the site against GitHub Pages' limit
        run: |
          set -euo pipefail
          if [[ ! -d 'dist' ]]; then
            echo "::error::The build left no folder dist, where opscrew/plan.yaml expects the site's files (target.site.outputDir): change target.site in opscrew/plan.yaml to what the build writes, then run \\\`opscrew provision\\\` again."
            exit 1
          fi
          bytes="$(du -sb 'dist' | cut -f 1)"
          if [[ "$bytes" -gt 1073741824 ]]; then
            echo "::error::The site in dist is $(( bytes / 1048576 )) MB, over the 1 GB GitHub Pages publishes. Leave out the files the site does not need, or host it on Cloudflare (\\\`opscrew design\\\`), then push again."
            exit 1
          fi
      - uses: <pin:ACTIONS.configurePages>
      - name: Keep the built site for GitHub Pages
        uses: <pin:ACTIONS.uploadPagesArtifact>
        with:
          path: "dist"
          # Keeps files such as .well-known, which the action leaves out otherwise.
          include-hidden-files: true"
`;

exports[`renderGithubPagesWorkflow > matches the snapshots > npm 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the site and publishes it on GitHub Pages. Secrets are set by \`opscrew provision\`; their
# values never appear in this file, but whatever the build puts into the site is public.
name: OpsCrew deploy

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - ".github/workflows/opscrew-deploy.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  build:
    name: Build the site
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "24"
      - name: Install the site's dependencies
        working-directory: "."
        run: |
          set -euo pipefail
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
      - name: Build the site
        working-directory: "."
        env:
          PUBLIC_API_URL: \${{ secrets.OPSCREW_ENV_PUBLIC_API_URL }}
        run: |
          set -euo pipefail
          npm run build
      - name: Check the site against GitHub Pages' limit
        run: |
          set -euo pipefail
          if [[ ! -d 'dist' ]]; then
            echo "::error::The build left no folder dist, where opscrew/plan.yaml expects the site's files (target.site.outputDir): change target.site in opscrew/plan.yaml to what the build writes, then run \\\`opscrew provision\\\` again."
            exit 1
          fi
          bytes="$(du -sb 'dist' | cut -f 1)"
          if [[ "$bytes" -gt 1073741824 ]]; then
            echo "::error::The site in dist is $(( bytes / 1048576 )) MB, over the 1 GB GitHub Pages publishes. Leave out the files the site does not need, or host it on Cloudflare (\\\`opscrew design\\\`), then push again."
            exit 1
          fi
      - uses: <pin:ACTIONS.configurePages>
      - name: Keep the built site for GitHub Pages
        uses: <pin:ACTIONS.uploadPagesArtifact>
        with:
          path: "dist"
          # Keeps files such as .well-known, which the action leaves out otherwise.
          include-hidden-files: true

  deploy:
    name: Publish on GitHub Pages
    needs: build
    runs-on: ubuntu-latest
    environment: github-pages
    permissions:
      pages: write
      id-token: write
    steps:
      - name: Publish the site
        uses: <pin:ACTIONS.deployPages>
      - name: Check that the site answers
        env:
          URL: https://docs.example.com/
        run: |
          set -uo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            curl -fsS --max-time 10 -o /dev/null "$URL" || code=$?
            if [[ "$code" -eq 0 ]]; then
              echo "The site answers after $attempt attempt(s)."
              exit 0
            fi
            case "$code" in 35 | 51 | 60) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [[ "$tls_only" -eq 1 ]]; then
            echo "::warning::GitHub has not issued the certificate for docs.example.com yet, so this run could not check the site over HTTPS. GitHub issues it once it has checked the domain's DNS records, which can take up to 24 hours; \\\`opscrew verify\\\` says when it is there. Then run \\\`opscrew provision\\\` to enforce HTTPS."
            exit 0
          fi
          echo "::error::The site did not answer at $URL."
          exit 1
"
`;
