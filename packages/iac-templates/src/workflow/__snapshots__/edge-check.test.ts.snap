// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the deploy job's check of the edge with the proxy's own checker > matches the snapshot 1`] = `
{
  "caddy": "set -euo pipefail
mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
cp opscrew/proxy/additions.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.additions
mkdir -p "$RUNNER_TEMP/opscrew-edge"/tls/shop
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 1 -subj /CN=opscrew-placeholder -keyout "$RUNNER_TEMP/opscrew-edge"/tls/shop/origin.key -out "$RUNNER_TEMP/opscrew-edge"/tls/shop/origin.pem 2> /dev/null
cp opscrew/runtime/edge/tls/pull.pem "$RUNNER_TEMP/opscrew-edge"/tls/shop/pull.pem
docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
  echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy with your additions in opscrew/proxy/additions.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
  exit 1
fi
",
  "nginx": "set -euo pipefail
mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites "$RUNNER_TEMP/opscrew-edge"/letsencrypt
cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
cp opscrew/proxy/additions.nginx "$RUNNER_TEMP/opscrew-edge"/sites/shop.additions
mkdir -p "$RUNNER_TEMP/opscrew-edge"/tls/shop
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 1 -subj /CN=opscrew-placeholder -keyout "$RUNNER_TEMP/opscrew-edge"/tls/shop/origin.key -out "$RUNNER_TEMP/opscrew-edge"/tls/shop/origin.pem 2> /dev/null
cp opscrew/runtime/edge/tls/pull.pem "$RUNNER_TEMP/opscrew-edge"/tls/shop/pull.pem
mkdir -p "$RUNNER_TEMP/opscrew-edge"/letsencrypt/live/shop
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 1 -subj /CN=opscrew-placeholder -keyout "$RUNNER_TEMP/opscrew-edge"/letsencrypt/live/shop/privkey.pem -out "$RUNNER_TEMP/opscrew-edge"/letsencrypt/live/shop/fullchain.pem 2> /dev/null
export OPSCREW_DEPLOY_UID="$(id -u)" OPSCREW_DEPLOY_GID="$(id -g)"
docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
cp opscrew/runtime/edge/sites/shop.conf "$RUNNER_TEMP/opscrew-edge"/sites/shop.conf
if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T -v "$RUNNER_TEMP/opscrew-edge"/letsencrypt:/etc/letsencrypt:ro --entrypoint nginx nginx -t < /dev/null; then
  echo '::error::nginx refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.conf with your additions in opscrew/proxy/additions.nginx) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
  exit 1
fi
cp opscrew/runtime/edge/sites/shop.http.conf "$RUNNER_TEMP/opscrew-edge"/sites/shop.conf
if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T -v "$RUNNER_TEMP/opscrew-edge"/letsencrypt:/etc/letsencrypt:ro --entrypoint nginx nginx -t < /dev/null; then
  echo '::error::nginx refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.http.conf with your additions in opscrew/proxy/additions.nginx) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
  exit 1
fi
",
  "tunnel": "set -euo pipefail
mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites "$RUNNER_TEMP/opscrew-edge"/letsencrypt
cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
cp opscrew/proxy/additions.nginx "$RUNNER_TEMP/opscrew-edge"/sites/shop.additions
export OPSCREW_DEPLOY_UID="$(id -u)" OPSCREW_DEPLOY_GID="$(id -g)"
docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
cp opscrew/runtime/edge/sites/shop.conf "$RUNNER_TEMP/opscrew-edge"/sites/shop.conf
if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T -v "$RUNNER_TEMP/opscrew-edge"/letsencrypt:/etc/letsencrypt:ro --entrypoint nginx nginx -t < /dev/null; then
  echo '::error::nginx refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.conf with your additions in opscrew/proxy/additions.nginx) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
  exit 1
fi
",
}
`;
