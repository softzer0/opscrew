// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the deploy with origin TLS > matches the snapshot 1`] = `
{
  "start": "set -euo pipefail
if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
  echo "::error::The build job did not report the image digest; re-run the workflow."
  exit 1
fi
echo "Deploying \${TAG:-the new image} as $IMAGE"
ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
echo "previous=$previous" >> "$GITHUB_OUTPUT"
printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
set -eu
export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
cd "$APPS_DIR"/shop
echo started > .start.outcome
export APP_IMAGE="$1"
RUN_IMAGE="$1"
MODE="\${2:-deploy}"
rm -f .database.changed
database=keep
target="\${1##*@sha256:}"
running="$(sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env 2> /dev/null || true)"
if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
  approved=""; choice=""; expiry=""
  read -r approved choice expiry < .rollback-database || true
  rm -f .rollback-database
  if [ "$approved" != "$target" ]; then
    echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
  else
    case "$choice" in snapshot) ;; *)
      echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
      exit 1 ;;
    esac
    case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
    if [ "$expiry" -le "$(date +%s)" ]; then
      echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
      exit 1
    fi
    database="$choice"
  fi
fi
keep_failed() {
  (
    umask 077
    grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
    mkdir -p "$APPS_DIR"/shop/.failed-deploy
    docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
    printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
    echo kept > .start.outcome
  ) || true
}
edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
snapshot_room() {
  if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
  printf '::warning::The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew takes no snapshot of the databases this time, and a rollback can'\\''t restore them to this moment. Free some space, or keep fewer snapshots (deploy.keepSnapshots in opscrew/plan.yaml).\\n' "$APPS_DIR"/shop
  rm -rf .snapshots/*.partial
  return 1
}
snapshot_run() {
  (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
}
snapshot_take() {
  (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial && mkdir .snapshots/"$1".partial && : > .snapshots/snapshot.log) || return 1
  snapshot_room || return 2
  snapshot_run "$1".partial rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app' || { rm -rf .snapshots/"$1".partial; return 1; }
  snapshot_room || return 2
  (umask 077 && date -u +%Y-%m-%dT%H:%M:%SZ > .snapshots/"$1".partial/taken) || return 1
  rm -rf .snapshots/"$1" && mv .snapshots/"$1".partial .snapshots/"$1"
}
snapshot_complete() {
  [ -f .snapshots/"$1"/taken ] && [ -f .snapshots/"$1"/db.dump ]
}
snapshot_restore() {
  snapshot_run "$1" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump' || return 1
}
docker compose pull
mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
(
  flock 9
  docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
  uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
  current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
  proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
  rm -f .edge.previous
  if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
    echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
    cp "$EDGE_DIR"/compose.yaml .edge.previous
    cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
  elif [ "$uploaded" -gt "\${current:-0}" ]; then
    cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
    echo "OpsCrew's shared edge on this server is now version $uploaded."
  elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
    cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
    echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
  elif [ "$uploaded" -lt "\${current:-0}" ]; then
    echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
  fi
  cp edge/tls/pull.pem "$EDGE_DIR"/tls/shop/pull.pem.new
  for f in origin.pem origin.key pull.pem; do
    if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
    mv -f "$EDGE_DIR"/tls/shop/$f.new "$EDGE_DIR"/tls/shop/$f
  done
  rm -f .site.previous .additions.previous
  if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
  if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
  cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
  cp additions.caddy "$EDGE_DIR"/sites/shop.additions
  if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
    if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
    if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
    for f in origin.pem origin.key pull.pem; do
      if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
    done
    if [ -f .edge.previous ]; then
      cp .edge.previous "$EDGE_DIR"/compose.yaml
      edge up -d --wait --remove-orphans || true
      echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
    fi
    echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy) or your additions (opscrew/proxy/additions.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
    exit 1
  fi
  rm -f "$EDGE_DIR"/sites/shop.conf
  rm -f "$EDGE_DIR"/tls/shop/origin.pem.previous "$EDGE_DIR"/tls/shop/origin.key.previous "$EDGE_DIR"/tls/shop/pull.pem.previous
) 9> "$EDGE_DIR"/.lock
docker compose up -d --no-deps --wait db
if [ "$database" != keep ]; then
  if [ -z "$running" ] || [ "$running" = "$target" ]; then
    echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
    exit 1
  fi
  if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
    echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
    exit 1
  fi
  echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
  saved=""
  before="$(sed -n 's/^APP_IMAGE=//p' .env)"
  (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
  trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
  edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
  docker compose stop app
  snap=0
  snapshot_take "$running" || snap=$?
  if [ "$snap" -eq 1 ]; then
    printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop
    rm -f .database.changed; docker compose start app; exit 1
  fi
  if [ "$snap" -eq 2 ]; then
    echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
    rm -f .database.changed; docker compose start app; exit 1
  fi
  saved="$running"
  (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
  failed=0
  case "$database" in
    snapshot)
      what="Restoring the snapshot of the database"
      if snapshot_restore "$target"; then
        echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
      else
        failed=1
      fi ;;
  esac
  if [ "$failed" -ne 0 ]; then
    if snapshot_restore "$saved"; then
      printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop
      rm -f .database.changed; docker compose start app; exit 1
    fi
    printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
    exit 1
  fi
fi
if [ "$database" = keep ]; then
  old="$(docker compose ps -aq app | tr '\\n' ' ')"
  docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
  new=""
  for id in $(docker compose ps -aq app); do
    case " $old " in *" $id "*) ;; *) new="$id" ;; esac
  done
  name="$(docker inspect --format '{{.Name}}' "$new")"
  if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
    keep_failed app "$new" health
    echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
    docker rm -f "$new" > /dev/null
    exit 1
  fi
  printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
  for id in $old; do
    docker stop "$id" > /dev/null
    docker rm "$id" > /dev/null
  done
else
  trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
  edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
  printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
  docker compose up -d --no-deps --remove-orphans app
  new="$(docker compose ps -aq app)"
  name="$(docker inspect --format '{{.Name}}' "$new")"
  if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
    keep_failed app "$new" health
    echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
    docker rm -f "$new" > /dev/null
    exit 1
  fi
  edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
fi
echo finished > .start.outcome
REMOTE
",
  "upload": {
    "env": {
      "HOST": "\${{ secrets.OPSCREW_HOST }}",
      "OPSCREW_APP_ENV": "\${{ secrets.OPSCREW_APP_ENV }}",
      "OPSCREW_ORIGIN_TLS": "\${{ secrets.OPSCREW_ORIGIN_TLS }}",
      "OPSCREW_SERVICE_DB_ENV": "\${{ secrets.OPSCREW_SERVICE_DB_ENV }}",
    },
    "name": "Upload runtime files and environment",
    "run": "set -euo pipefail
ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge opscrew/proxy/additions.caddy "deploy@\${HOST}:/srv/apps/shop/"
printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
case "\${OPSCREW_ORIGIN_TLS:-}" in
  *"-----BEGIN CERTIFICATE-----"*"PRIVATE KEY-----"*) ;;
  *) echo "::error::The deploy secret OPSCREW_ORIGIN_TLS must hold the app's Cloudflare origin certificate, then its private key. Run \\\`opscrew provision\\\` again to set it, then deploy again."; exit 1 ;;
esac
printf '%s\\n' "$OPSCREW_ORIGIN_TLS" | sed '/-BEGIN [A-Z ]*PRIVATE KEY-/,$d' | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && mkdir -p /srv/edge/tls/shop && chmod 700 /srv/edge/tls/shop && cat > /srv/edge/tls/shop/origin.pem.new'
printf '%s\\n' "$OPSCREW_ORIGIN_TLS" | sed -n '/-BEGIN [A-Z ]*PRIVATE KEY-/,$p' | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/edge/tls/shop/origin.key.new'
",
  },
}
`;
