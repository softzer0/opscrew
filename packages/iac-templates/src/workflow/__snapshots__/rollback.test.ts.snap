// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the deploy job per strategy > matches the snapshot for recreate 1`] = `
"  deploy:
    name: Deploy to the server
    needs: build
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
          edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          docker compose up -d --no-deps --remove-orphans app
          new="$(docker compose ps -aq app)"
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built with Buildpacks (app.build.builder: buildpacks in opscrew/plan.yaml).'
            exit 1
          fi
          edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: http://\${{ secrets.OPSCREW_HOST }}/api/health
        run: |
          set -euo pipefail
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1"
`;

exports[`the deploy job per strategy > matches the snapshot for rolling 1`] = `
"  deploy:
    name: Deploy to the server
    needs: build
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built with Buildpacks (app.build.builder: buildpacks in opscrew/plan.yaml).'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: http://\${{ secrets.OPSCREW_HOST }}/api/health
        run: |
          set -euo pipefail
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1"
`;

exports[`the deploy job per strategy > matches the snapshot with services, workers and cron 1`] = `
"  deploy:
    name: Deploy to the server
    needs: build
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
          OPSCREW_SERVICE_CACHE_ENV: \${{ secrets.OPSCREW_SERVICE_CACHE_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/crontab opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_CACHE_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/cache.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db cache
          if ! (umask 077; docker compose run --rm --no-deps -T release < /dev/null > "$APPS_DIR"/shop/release.log 2>&1); then
            echo '::error::The release command (app.releaseCommand in opscrew/plan.yaml) failed, so the new version was not started and the previous version keeps serving. Its output stays on the server in '"$APPS_DIR"'/shop/release.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command): fix the command or the app and push again.'
            exit 1
          fi
          echo 'The release command finished; its output is in '"$APPS_DIR"'/shop/release.log on the server.'
          for service in worker beat cron; do
            if [ -n "$(docker compose ps -q "$service")" ]; then echo "$service"; fi
          done > .processes.previous
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          docker compose up -d --no-deps worker beat cron
          started=""
          for service in worker beat cron; do
            for id in $(docker compose ps -aq "$service"); do
              started="$started $id=running:$(docker inspect --format '{{.RestartCount}}' "$id")"
            done
          done
          sleep 30
          for service in worker beat cron; do
            for id in $(docker compose ps -aq "$service"); do
              now="$id=$(docker inspect --format '{{.State.Status}}:{{.RestartCount}}' "$id")"
              case " $started " in *" $now "*) continue ;; esac
              printf '::error::The %s container did not keep running for 30 seconds after it started with the new version, so the deploy failed and OpsCrew puts the web and the workers back on the previous version, if there is one. Read its log on the server with \`docker compose logs %s\` in '"$APPS_DIR"'/shop (opscrew/RUNBOOK.md has the SSH command), fix its command (processes in opscrew/plan.yaml) or the app, and push again.\\n' "$service" "$service"
              exit 1
            done
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: http://\${{ secrets.OPSCREW_HOST }}/api/health
        run: |
          set -euo pipefail
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
            up=""
            stop=""
            for service in worker beat cron; do
              if grep -qxF "$service" .processes.previous 2> /dev/null; then up="$up $service"; else stop="$stop $service"; fi
            done
            if [ -n "$up" ]; then docker compose up -d --no-deps $up; fi
            if [ -n "$stop" ]; then docker compose stop $stop; fi
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1"
`;
