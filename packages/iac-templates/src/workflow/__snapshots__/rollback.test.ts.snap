// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the deploy job per strategy > matches the snapshot for recreate 1`] = `
"  deploy:
    name: Deploy to the server
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"')) }}
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/snapshot.sh.new && mv -f /srv/apps/shop/snapshot.sh.new /srv/apps/shop/snapshot.sh' <<'SNAPSHOT'
          # OpsCrew's snapshots of shop's data on the app's server, generated from opscrew/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db'
          SNAPSHOT_ONLINE='db'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop "$1" "$APPS_DIR"/shop >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              docker compose start app
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              docker compose start app
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              docker compose start app
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s), and the app starts again: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$APPS_DIR"/shop >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop "$_saved" "$_saved" "$APPS_DIR"/shop >&2
            return 5
          }
          snapshot_cmd_hold() {
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
          }
          snapshot_cmd_resume() {
            docker compose start app
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              flock 7
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock 7
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          if crontab -l 2> /dev/null | grep -q ' # opscrew-snapshots shop$'; then crontab -l | grep -v ' # opscrew-snapshots shop$' | crontab -; fi
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app; exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app; exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app; exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
              exit 1
            fi
          fi
          trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
          edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          docker compose up -d --no-deps --remove-orphans app
          new="$(docker compose ps -aq app)"
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            keep_failed app "$new" health
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built with Buildpacks (app.build.builder: buildpacks in opscrew/plan.yaml).'
            docker rm -f "$new" > /dev/null
            exit 1
          fi
          edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: http://\${{ secrets.OPSCREW_HOST }}/api/health
        run: |
          set -euo pipefail
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1"
`;

exports[`the deploy job per strategy > matches the snapshot for rolling 1`] = `
"  deploy:
    name: Deploy to the server
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"')) }}
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/snapshot.sh.new && mv -f /srv/apps/shop/snapshot.sh.new /srv/apps/shop/snapshot.sh' <<'SNAPSHOT'
          # OpsCrew's snapshots of shop's data on the app's server, generated from opscrew/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db'
          SNAPSHOT_ONLINE='db'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop "$1" "$APPS_DIR"/shop >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              docker compose start app
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              docker compose start app
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              docker compose start app
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s), and the app starts again: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$APPS_DIR"/shop >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop "$_saved" "$_saved" "$APPS_DIR"/shop >&2
            return 5
          }
          snapshot_cmd_hold() {
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
          }
          snapshot_cmd_resume() {
            docker compose start app
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              flock 7
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock 7
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          if crontab -l 2> /dev/null | grep -q ' # opscrew-snapshots shop$'; then crontab -l | grep -v ' # opscrew-snapshots shop$' | crontab -; fi
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app; exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app; exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app; exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
              exit 1
            fi
          fi
          if [ "$database" = keep ]; then
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built with Buildpacks (app.build.builder: buildpacks in opscrew/plan.yaml).'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          else
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built with Buildpacks (app.build.builder: buildpacks in opscrew/plan.yaml).'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
          fi
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: http://\${{ secrets.OPSCREW_HOST }}/api/health
        run: |
          set -euo pipefail
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1"
`;

exports[`the deploy job per strategy > matches the snapshot with services, workers and cron 1`] = `
"  deploy:
    name: Deploy to the server
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"')) }}
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
          OPSCREW_SERVICE_CACHE_ENV: \${{ secrets.OPSCREW_SERVICE_CACHE_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/crontab opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_CACHE_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/cache.env'
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/snapshot.sh.new && mv -f /srv/apps/shop/snapshot.sh.new /srv/apps/shop/snapshot.sh' <<'SNAPSHOT'
          # OpsCrew's snapshots of shop's data on the app's server, generated from opscrew/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db cache'
          SNAPSHOT_ONLINE='db cache'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              cache)
                echo cache.rdb
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              cache)
                echo valkey
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              cache)
                echo '<pin:IMAGES.valkey>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop "$1" "$APPS_DIR"/shop >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              cache)
                snapshot_run "$2" rw cache 'umask 077 && export REDISCLI_AUTH="$VALKEY_PASSWORD" && valkey-cli -h cache --rdb /snapshot/cache.rdb'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              cache)
                docker compose stop -t 120 cache >> .snapshots/snapshot.log 2>&1 || return 1
                snapshot_box rw cache 'o="$(stat -c %u:%g /data)" && cat > /data/dump.rdb && chown "$o" /data/dump.rdb' < .snapshots/"$2"/cache.rdb || return 1
                snapshot_start cache || return 1
                snapshot_box rw cache 'rm -f /data/dump.rdb' < /dev/null
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            if [ -n "$(docker compose ps -q app)" ]; then
              for service in worker beat cron; do
                if [ -n "$(docker compose ps -q "$service")" ]; then echo "$service"; fi
              done > .processes.previous
            fi
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app worker beat cron
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              docker compose start app $(cat .processes.previous 2> /dev/null || true)
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              docker compose start app $(cat .processes.previous 2> /dev/null || true)
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              docker compose start app $(cat .processes.previous 2> /dev/null || true)
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s), and the app starts again: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$APPS_DIR"/shop >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop "$_saved" "$_saved" "$APPS_DIR"/shop >&2
            return 5
          }
          snapshot_cmd_hold() {
            if [ -n "$(docker compose ps -q app)" ]; then
              for service in worker beat cron; do
                if [ -n "$(docker compose ps -q "$service")" ]; then echo "$service"; fi
              done > .processes.previous
            fi
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app worker beat cron
          }
          snapshot_cmd_resume() {
            docker compose start app $(cat .processes.previous 2> /dev/null || true)
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              flock 7
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock 7
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db cache
          if crontab -l 2> /dev/null | grep -q ' # opscrew-snapshots shop$'; then crontab -l | grep -v ' # opscrew-snapshots shop$' | crontab -; fi
          if [ "$MODE" = rollback ]; then
            if [ "$database" = keep ]; then echo 'A rollback runs no release command: the data and the schema stay as they are.'; else echo 'A rollback runs no release command.'; fi
          else
            if ! (umask 077; docker compose run --rm --no-deps -T release < /dev/null > "$APPS_DIR"/shop/release.log 2>&1); then
              echo '::error::The release command (app.releaseCommand in opscrew/plan.yaml) failed, so the new version was not started and the previous version keeps serving. Its output stays on the server in '"$APPS_DIR"'/shop/release.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). A migration that stopped partway may have applied some of its changes, and the previous version now runs with them: read release.log to see how far it got, then fix the migration and push again to deploy forward, or restore a backup taken before this deploy.'
              exit 1
            fi
            echo 'The release command finished; its output is in '"$APPS_DIR"'/shop/release.log on the server.'
          fi
          for service in worker beat cron; do
            if [ -n "$(docker compose ps -q "$service")" ]; then echo "$service"; fi
          done > .processes.previous
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app worker beat cron
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app $(cat .processes.previous 2> /dev/null || true); exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app $(cat .processes.previous 2> /dev/null || true); exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app $(cat .processes.previous 2> /dev/null || true); exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
              exit 1
            fi
          fi
          if [ "$database" = keep ]; then
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          else
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
          fi
          docker compose up -d --no-deps worker beat cron
          started=""
          for service in worker beat cron; do
            for id in $(docker compose ps -aq "$service"); do
              started="$started $id=running:$(docker inspect --format '{{.RestartCount}}' "$id")"
            done
          done
          sleep 30
          for service in worker beat cron; do
            for id in $(docker compose ps -aq "$service"); do
              now="$id=$(docker inspect --format '{{.State.Status}}:{{.RestartCount}}' "$id")"
              case " $started " in *" $now "*) continue ;; esac
              printf '::error::The %s container did not keep running for 30 seconds after it started with the new version, so the deploy failed and OpsCrew puts the web and the workers back on the previous version, if there is one. Read its last lines, from before OpsCrew put the previous version back, with \`opscrew logs --failed --service %s\`, then fix its command (processes in opscrew/plan.yaml) or the app, and push again.\\n' "$service" "$service"
              keep_failed "$service" "$id" "process $service"
              exit 1
            done
          done
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: http://\${{ secrets.OPSCREW_HOST }}/api/health
        run: |
          set -euo pipefail
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app worker beat cron
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
              up=""
              stop=""
              for service in worker beat cron; do
                if grep -qxF "$service" .processes.previous 2> /dev/null; then up="$up $service"; else stop="$stop $service"; fi
              done
              if [ -n "$up" ]; then docker compose up -d --no-deps $up; fi
              if [ -n "$stop" ]; then docker compose stop $stop; fi
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
            up=""
            stop=""
            for service in worker beat cron; do
              if grep -qxF "$service" .processes.previous 2> /dev/null; then up="$up $service"; else stop="$stop $service"; fi
            done
            if [ -n "$up" ]; then docker compose up -d --no-deps $up; fi
            if [ -n "$stop" ]; then docker compose stop $stop; fi
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1"
`;
