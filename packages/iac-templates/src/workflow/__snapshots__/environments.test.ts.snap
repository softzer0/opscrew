// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a workflow per environment > matches the snapshots of staging following main and prod promoted from it 1`] = `
"# Generated by OpsCrew from opscrew/environments/staging/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app image, pushes it to GitHub Container Registry and deploys it to your server
# over SSH. Secrets are set by \`opscrew provision\`; their values never appear in this file.
name: OpsCrew deploy (staging)

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - "Dockerfile"
      - "opscrew/environments/staging/runtime/compose.yaml"
      - "opscrew/environments/staging/runtime/edge/**"
      - ".github/workflows/opscrew-deploy-staging.yml"
  workflow_dispatch:
    inputs:
      digest:
        description: For a rollback, the image to deploy, by its digest (sha256:…); \`opscrew rollback\` fills it in.
        required: false
        type: string
        default: ""
      tag:
        description: For a rollback, the image's commit tag (<commit>, or <commit>-<env> outside prod); \`opscrew rollback\` fills it in.
        required: false
        type: string
        default: ""
      rollback:
        description: Deploy the image without running the release command, for a rollback; \`opscrew rollback\` sets it.
        required: false
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: opscrew-deploy-shop-staging
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ !(inputs.rollback) && contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/staging"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --env staging --resume --deploy\\\` deploys the branch's latest commit."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision --env staging\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the image
    if: \${{ !inputs.rollback }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}-staging" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_STAGING_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_STAGING_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA-staging\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi

  verify:
    name: Check where the image was built
    if: \${{ inputs.rollback }}
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: read
    outputs:
      image: \${{ steps.provenance.outputs.image }}
      tag: \${{ steps.provenance.outputs.tag }}
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: provenance
        name: Check the image's provenance
        env:
          DIGEST: \${{ inputs.digest }}
          TAG: \${{ inputs.tag }}
          BUILD_BRANCH: "main"
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The digest input is not an image digest (sha256: and 64 hexadecimal digits). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          name="ghcr.io/\${GITHUB_REPOSITORY,,}"
          image="$name@$DIGEST"
          if ! provenance="$(docker buildx imagetools inspect "$image" --format '{{json .Provenance}}')"; then
            echo "::error::GitHub Container Registry has no image $image. Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which choose an image that is there."
            exit 1
          fi
          # buildx names the run that built the image in runDetails.builder.id (per platform).
          mapfile -t runs < <(jq -r '.. | .runDetails?.builder?.id? // empty' <<< "$provenance" | sort -u)
          if [[ "\${#runs[@]}" -ne 1 || ! "\${runs[0]}" =~ ^https://github\\.com/([^/]+/[^/]+)/actions/runs/([0-9]+)/attempts/[0-9]+$ ]]; then
            echo "::error::The image's build provenance does not name one GitHub Actions run, so OpsCrew cannot tell where it was built. OpsCrew deploys a digest only when this repository's deploy workflow built it."
            exit 1
          fi
          built_in="\${BASH_REMATCH[1]}"
          run_id="\${BASH_REMATCH[2]}"
          if [[ "\${built_in,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built by a run of $built_in, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if ! record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" --jq '"\\(.event) \\(.head_repository.full_name) \\(.head_branch) \\(.head_sha) \\(.path)"')"; then
            echo "::error::GitHub shows no run $run_id in this repository, which the image's provenance names as its build. OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          read -r event head_repo branch commit workflow <<< "$record"
          # The run's path can end with @<ref>, which the signing identity carries separately.
          workflow="\${workflow%%@*}"
          # A fork's pull request runs in this repository too, with its own branch name: only a push, or a
          # run started by hand, which takes write access (ADR 0023 D1), counts.
          if [[ "$event" != "push" && "$event" != "workflow_dispatch" ]]; then
            echo "::error::The image was built by a $event run, not by a push or a run started by hand. OpsCrew deploys a digest only when a push to $BUILD_BRANCH, or a run started by hand there, built it."
            exit 1
          fi
          if [[ "\${head_repo,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built from the commits of $head_repo, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if [[ "$branch" != "$BUILD_BRANCH" ]]; then
            echo "::error::The image was built from the branch $branch, not from $BUILD_BRANCH, the branch that builds this environment's images. OpsCrew deploys a digest only when a build on $BUILD_BRANCH made it."
            exit 1
          fi
          # prod's build tags its commit, another environment's <commit>-<env>.
          if [[ "$TAG" != "$commit" && ! "$TAG" =~ ^$commit-[a-z][a-z0-9-]*$ ]]; then
            echo "::error::The tag input is not a commit tag of the image's build ($commit, or $commit-<environment>). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          if [[ "$(docker buildx imagetools inspect "$name:$TAG" --format '{{.Manifest.Digest}}')" != "$DIGEST" ]]; then
            echo "::error::The image is not the one tagged with its build's commit ($TAG): a later build of that commit replaced the tag, or the image was pushed another way. \\\`opscrew rollback --list\\\` shows the versions to roll back to, and \\\`opscrew promote\\\` takes the image another environment runs."
            exit 1
          fi
          {
            echo "image=$image"
            echo "tag=$name:$TAG"
            echo "identity=https://github.com/$GITHUB_REPOSITORY/$workflow@refs/heads/$branch"
          } >> "$GITHUB_OUTPUT"
          echo "Deploying \\\`$image\\\`, built by run $run_id from \\\`$commit\\\` on \\\`$branch\\\`." >> "$GITHUB_STEP_SUMMARY"

  deploy:
    name: Deploy to the server
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"')) }}
    runs-on: ubuntu-latest
    environment: staging
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/staging/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-staging.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env staging renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_STAGING_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_STAGING_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_STAGING_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_STAGING_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_STAGING_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop-staging'
          scp -r "\${ssh_opts[@]}" opscrew/environments/staging/runtime/compose.yaml opscrew/environments/staging/runtime/edge "deploy@\${HOST}:/srv/apps/shop-staging/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-staging/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-staging/db.env'
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-staging/snapshot.sh.new && mv -f /srv/apps/shop-staging/snapshot.sh.new /srv/apps/shop-staging/snapshot.sh' <<'SNAPSHOT'
          # OpsCrew's snapshots of shop-staging's data on the app's server, generated from opscrew/environments/staging/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-staging
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db'
          SNAPSHOT_ONLINE='db'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop-staging/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop-staging "$1" "$APPS_DIR"/shop-staging >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/environments/staging/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/environments/staging/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/environments/staging/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop-staging >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-staging >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            _held=""; if [ -f .snapshots/.held ]; then _held=1; fi
            _starts=", and the app starts again"
            if [ -n "$_held" ]; then _starts=", and the app stays stopped while opscrew restore holds it"; fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            if [ -z "$_held" ]; then
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            fi
            docker compose stop app
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              if [ -z "$_held" ]; then docker compose start app; fi
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop-staging >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-staging >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s)%s: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$_starts" "$APPS_DIR"/shop-staging >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop-staging "$_saved" "$_saved" "$APPS_DIR"/shop-staging >&2
            return 5
          }
          snapshot_cmd_hold() {
            (umask 077 && mkdir -p .snapshots && : > .snapshots/.held)
            edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
          }
          snapshot_cmd_resume() {
            docker compose start app
            edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true
            rm -f .snapshots/.held
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              flock 7
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop-staging && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop-staging/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-staging/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-staging
          exec 7> .start.lock
          flock 7
          if [ -f .snapshots/.held ]; then echo '::error::OpsCrew changed nothing on the server: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app'\\''s folder as the deploy user, then try again.' >&2; exit 1; fi
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-staging/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-staging/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-staging/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-staging/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/staging/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop-staging/$f ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f "$EDGE_DIR"/tls/shop-staging/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-staging/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-staging.caddy ]; then cp "$EDGE_DIR"/sites/shop-staging.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-staging.additions ]; then cp "$EDGE_DIR"/sites/shop-staging.additions .additions.previous; fi
            cp edge/sites/shop-staging.caddy "$EDGE_DIR"/sites/shop-staging.caddy
            rm -f "$EDGE_DIR"/sites/shop-staging.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-staging.caddy; else rm -f "$EDGE_DIR"/sites/shop-staging.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-staging.additions; else rm -f "$EDGE_DIR"/sites/shop-staging.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop-staging/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f.previous "$EDGE_DIR"/tls/shop-staging/$f; else rm -f "$EDGE_DIR"/tls/shop-staging/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-staging.conf
            rm -rf "$EDGE_DIR"/tls/shop-staging
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          if crontab -l 2> /dev/null | grep -q ' # opscrew-snapshots shop-staging$'; then crontab -l | grep -v ' # opscrew-snapshots shop-staging$' | crontab -; fi
          if [ "$MODE" = deploy ] && [ -n "$running" ] && [ "$running" != "$target" ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            snap=0
            snapshot_cmd_take release > /dev/null || snap=$?
            if [ "$snap" -eq 1 ]; then
              printf '::error::The snapshot of the data before this release failed, so the new version was not started and the previous version keeps serving. The copies'\\'' output stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command). Fix its cause and push again, or set deploy.snapshots: false in opscrew/environments/staging/plan.yaml to deploy without snapshots.\\n' "$APPS_DIR"/shop-staging
              exit 1
            fi
            if [ "$snap" -eq 2 ]; then
              printf '::warning::The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew takes no snapshot of the data this time, and a rollback can'\\''t restore it to this moment. Free some space, or keep fewer snapshots (deploy.keepSnapshots in opscrew/environments/staging/plan.yaml).\\n' "$APPS_DIR"/shop-staging
            fi
            if [ "$snap" -eq 0 ]; then
              echo 'OpsCrew took a snapshot of the data before this release: a rollback to the previous version can restore it.'
            fi
          fi
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop-staging
                rm -f .database.changed; docker compose start app; exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app; exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop-staging
                rm -f .database.changed; docker compose start app; exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop-staging "$saved" "$APPS_DIR"/shop-staging
              exit 1
            fi
          fi
          if [ "$database" = keep ]; then
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed --env staging\`. Check that the app listens on port 3000 (app.port in opscrew/environments/staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          else
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed --env staging\`. Check that the app listens on port 3000 (app.port in opscrew/environments/staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null
          fi
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://staging-shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-staging
          exec 7> .start.lock
          flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/environments/staging/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }
          if [ -f .snapshots/.held ]; then echo held; exit 0; fi
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-staging/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-staging/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-staging/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-staging/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop-staging "$saved" "$APPS_DIR"/shop-staging
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            *:held) echo "::error::This run stopped before changing anything: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app's folder as the deploy user, then try again." ;;
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop-staging." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop-staging." ;;
          esac
          exit 1

  prune:
    name: Delete old images
    needs: [build, deploy]
    if: \${{ !cancelled() && needs.build.result == 'success' && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: write
    steps:
      - name: Keep the newest 10 images; delete older, intermediate and old pull request images
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
          KEEP: "10"
        run: |
          // OpsCrew image retention (opscrew/environments/staging/plan.yaml, cicd.imageRetention): deletes old versions of
          // this repository's image from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions: [{ id, digest, tags, created }], as the GitHub API lists them.
           * children: by digest, the digests an image index lists (its platform manifests and attestations).
           * keep: how many <commit>-staging versions to keep, newest first; undefined (retention off) deletes only
           * the build-<commit>-staging intermediates, old pull requests' images and what only they list.
           * protect: digests never deleted: the running and the previous image.
           * recent: a time (milliseconds since 1970): an untagged version created since then stays unless
           * a version deleted here lists it, since another environment's build may be pushing it right now.
           * environments: the names of the app's environments (prod and each one beside it).
           * previewsBefore: a time (milliseconds since 1970): a version whose every tag is a pull request's
           * (pr-<n>-<commit>, build-pr-<n>-<commit>) created before then goes, retention on or off.
           *
           * Kept: the protected digests, every version the label tags of one of the environments mark
           * (opscrew-<env>, the image it runs, and opscrew-<env>-previous, the one before), the newest keep
           * <commit>-staging versions, versions with a tag this environment's builds did not push and that is no
           * other opscrew-* tag (yours, Buildpacks' caches, another environment's images, pull requests'
           * images until previewsBefore), signatures of kept images, and whatever a kept index lists, tagged
           * or not. Deleted: build-<commit>-staging intermediates, older <commit>-staging versions with their
           * signatures, old pull requests' images, and untagged versions nothing kept lists, once they are
           * older than recent.
           */
          function prunable(versions, children, keep, protect, recent, environments, previewsBefore) {
            const commit = (tag) => /^[0-9a-f]{40}-staging$/.test(tag);
            const build = (tag) => /^build-[0-9a-f]{40}-staging$/.test(tag);
            const pull = (tag) => /^(?:build-)?pr-([1-9][0-9]{0,5})-[0-9a-f]{40}$/.test(tag);
            const oldPull = (v) => v.tags.length > 0 && v.tags.every(pull) && Date.parse(v.created) < previewsBefore;
            const labels = new Set(environments.flatMap((env) => ["opscrew-" + env, "opscrew-" + env + "-previous"]));
            const label = (tag) => labels.has(tag);
            // An opscrew-* tag that labels none of the environments (one removed since, a stray one).
            const strayLabel = (tag) => /^opscrew-[a-z][a-z0-9-]*$/.test(tag) && !label(tag);
            const subject = (tag) => {
              const match = /^sha256-([0-9a-f]{64})(\\.[a-z]+)?$/.exec(tag);
              return match ? "sha256:" + match[1] : undefined;
            };
            const ours = (tag) => commit(tag) || build(tag) || subject(tag) !== undefined || strayLabel(tag);
            const listed = (digests) => new Set([...digests].flatMap((digest) => children[digest] || []));

            const kept = new Set(protect);
            for (const v of versions) if (v.tags.some(label)) kept.add(v.digest);
            if (keep === undefined) {
              for (const v of versions) if (!v.tags.every(build) && !oldPull(v)) kept.add(v.digest);
            } else {
              const deployed = versions
                .filter((v) => v.tags.some(commit))
                .sort((a, b) => b.created.localeCompare(a.created) || b.id - a.id);
              for (const v of deployed.slice(0, keep)) kept.add(v.digest);
              for (const v of versions) if (!v.tags.every(ours) && !oldPull(v)) kept.add(v.digest);
              for (const v of versions) if (v.tags.some((tag) => kept.has(subject(tag)))) kept.add(v.digest);
            }

            // Everything a kept version lists, and what that lists in turn, stays.
            const reach = (digests) => {
              const seen = new Set(digests);
              const queue = [...digests];
              while (queue.length > 0) {
                for (const digest of children[queue.pop()] || []) {
                  if (!seen.has(digest)) {
                    seen.add(digest);
                    queue.push(digest);
                  }
                }
              }
              return seen;
            };
            const reachable = reach(kept);
            const goes = (v) => !reachable.has(v.digest);
            const listedByDeleted = listed(versions.filter((v) => v.tags.length > 0 && goes(v)).map((v) => v.digest));
            // Another environment's build pushes its platform manifests and attestations untagged, moments
            // before the index that lists them: until then nothing lists them, so a recent one stays.
            const old = (v) => Date.parse(v.created) < recent;
            return versions
              .filter((v) => goes(v) && (v.tags.length > 0 || listedByDeleted.has(v.digest) || (keep !== undefined && old(v))))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const digestOf = (ref) => (digestRef.test(ref) ? ref.split("@")[1] : undefined);
            const running = digestOf(process.env.IMAGE || "");
            const previous = process.env.PREVIOUS ? digestOf(process.env.PREVIOUS) : null;
            if (running === undefined || previous === undefined) {
              fail("OpsCrew could not tell which images the server runs, so it deleted none. The deploy itself succeeded.");
              return;
            }
            const protect = previous === null ? [running] : [running, previous];
            const keep = process.env.KEEP ? Number(process.env.KEEP) : undefined;
            // Untagged versions younger than 30 minutes stay: another environment may be pushing them.
            const recent = Date.now() - 30 * 60 * 1000;
            // Pull requests' images older than this go: no preview runs one that old.
            const previewsBefore = Date.now() - 31 * 24 * 60 * 60 * 1000;
            const [owner, repo] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            // The app's own package: ghcr.io/<owner>/<repo>.
            const name = repo;
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) {
                throw Object.assign(new Error(what + " answered HTTP " + response.status), { status: response.status });
              }
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });
            const pages = async (path, what, field) => {
              const all = [];
              for (let page = 1; ; page++) {
                const body = await read(await github("GET", path + (path.includes("?") ? "&" : "?") + "per_page=100&page=" + page), what);
                const batch = field === undefined ? body : body[field];
                all.push(...batch);
                if (batch.length < 100) return all;
              }
            };
            const packageVersions = async () => {
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              return (
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions"
              );
            };
            // The package's versions, and what each tagged or protected one lists.
            const survey = async (base, protect) => {
              const versions = (await pages(base, "The GitHub packages API")).map((v) => ({
                id: v.id,
                digest: v.name,
                tags: v.metadata.container.tags,
                created: v.created_at,
              }));
              const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
              const scope = "repository:" + owner + "/" + name + ":pull";
              const login = await read(
                await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                "GitHub Container Registry",
              );
              const children = {};
              const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
              for (const digest of new Set([...protect, ...tagged])) {
                const manifest = await read(
                  await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                    headers: {
                      Authorization: "Bearer " + login.token,
                      Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                    },
                  }),
                  "GitHub Container Registry",
                );
                children[digest] = (manifest.manifests || []).map((m) => m.digest);
              }
              return { versions, children };
            };
            // Another run may delete versions while this one reads them (one merge runs several
            // environments' workflows): the registry then answers 404 for a version the list still has.
            // Read it all again; a 404 that stays still stops, so nothing is deleted on a guess.
            const readPackage = async (base, protect) => {
              for (let attempt = 1; ; attempt++) {
                try {
                  return await survey(base, protect);
                } catch (error) {
                  if (error.status !== 404 || attempt === 3) throw error;
                  console.log("A version went while OpsCrew read the package (HTTP 404); reading it again in 20 s.");
                  await new Promise((resolve) => setTimeout(resolve, 20000));
                }
              }
            };
            const deleteVersions = async (base, versions, ids) => {
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else if (response.status === 404) {
                  // Another run deleted it first.
                  console.log("Already deleted: " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              return failed;
            };

            let deleting = false;
            try {
              // The app's environments: each has its OpsCrew deploy workflow, named "OpsCrew deploy" (prod)
              // or "OpsCrew deploy (<env>)".
              const environments = [];
              const workflows = await pages("/repos/" + owner + "/" + repo + "/actions/workflows", "The GitHub workflows API", "workflows");
              for (const w of workflows) {
                const match = /^OpsCrew deploy(?: \\(([a-z][a-z0-9-]*)\\))?$/.exec(w.name);
                if (match && w.state !== "deleted") environments.push(match[1] || "prod");
              }
              // None found means the workflows were renamed: no environment's labels could be kept.
              if (environments.length === 0) {
                fail(
                  'OpsCrew found no workflow named "OpsCrew deploy" in this repository, so it cannot tell which images the environments run, and it deleted none. The deploy itself succeeded; run "opscrew provision" to write the deploy workflow again.',
                );
                return;
              }
              const base = await packageVersions();
              const { versions, children } = await readPackage(base, protect);
              const ids = new Set(prunable(versions, children, keep, protect, recent, environments, previewsBefore));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + ".");
              deleting = true;
              const failed = await deleteVersions(base, versions, ids);
              if (failed > 0) {
                fail(failed + " image versions were not deleted; the next deploy tries again. The deploy itself succeeded.");
              }
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting old images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The deploy itself succeeded; the next deploy tries again.",
              );
            }
          }
          main();

  label:
    name: Label the deployed image
    needs: [build, verify, deploy]
    if: \${{ !cancelled() && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-staging, and the one before it opscrew-staging-previous
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-staging" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-staging\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-staging-previous" "$PREVIOUS"
          fi
"
`;

exports[`a workflow per environment > matches the snapshots of staging following main and prod promoted from it 2`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# \`opscrew promote --to prod\` starts this workflow with the digest of an image the staging
# environment runs. It checks that a push to main in this repository built that image, then
# deploys it to your server over SSH, without building. Secrets are set by \`opscrew provision\`;
# their values never appear in this file.
name: OpsCrew deploy

on:
  workflow_dispatch:
    inputs:
      digest:
        description: The image to deploy, by its digest (sha256:…); \`opscrew promote\` or \`opscrew rollback\` fills it in.
        required: true
        type: string
      tag:
        description: The image's commit tag (<commit>, or <commit>-<env> when another environment than prod built it); \`opscrew promote\` or \`opscrew rollback\` fills it in.
        required: true
        type: string
      rollback:
        description: Deploy the image without running the release command, for a rollback; \`opscrew rollback\` sets it.
        required: false
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ !(inputs.rollback) && contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/prod"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run didn't deploy. \\\`opscrew rollback --resume\\\` resumes them; then \\\`opscrew promote --to prod\\\` deploys."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  verify:
    name: Check where the image was built
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: read
    outputs:
      image: \${{ steps.provenance.outputs.image }}
      tag: \${{ steps.provenance.outputs.tag }}
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: provenance
        name: Check the image's provenance
        env:
          DIGEST: \${{ inputs.digest }}
          TAG: \${{ inputs.tag }}
          BUILD_BRANCH: "main"
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The digest input is not an image digest (sha256: and 64 hexadecimal digits). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          name="ghcr.io/\${GITHUB_REPOSITORY,,}"
          image="$name@$DIGEST"
          if ! provenance="$(docker buildx imagetools inspect "$image" --format '{{json .Provenance}}')"; then
            echo "::error::GitHub Container Registry has no image $image. Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which choose an image that is there."
            exit 1
          fi
          # buildx names the run that built the image in runDetails.builder.id (per platform).
          mapfile -t runs < <(jq -r '.. | .runDetails?.builder?.id? // empty' <<< "$provenance" | sort -u)
          if [[ "\${#runs[@]}" -ne 1 || ! "\${runs[0]}" =~ ^https://github\\.com/([^/]+/[^/]+)/actions/runs/([0-9]+)/attempts/[0-9]+$ ]]; then
            echo "::error::The image's build provenance does not name one GitHub Actions run, so OpsCrew cannot tell where it was built. OpsCrew deploys a digest only when this repository's deploy workflow built it."
            exit 1
          fi
          built_in="\${BASH_REMATCH[1]}"
          run_id="\${BASH_REMATCH[2]}"
          if [[ "\${built_in,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built by a run of $built_in, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if ! record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" --jq '"\\(.event) \\(.head_repository.full_name) \\(.head_branch) \\(.head_sha) \\(.path)"')"; then
            echo "::error::GitHub shows no run $run_id in this repository, which the image's provenance names as its build. OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          read -r event head_repo branch commit workflow <<< "$record"
          # The run's path can end with @<ref>, which the signing identity carries separately.
          workflow="\${workflow%%@*}"
          # A fork's pull request runs in this repository too, with its own branch name: only a push, or a
          # run started by hand, which takes write access (ADR 0023 D1), counts.
          if [[ "$event" != "push" && "$event" != "workflow_dispatch" ]]; then
            echo "::error::The image was built by a $event run, not by a push or a run started by hand. OpsCrew deploys a digest only when a push to $BUILD_BRANCH, or a run started by hand there, built it."
            exit 1
          fi
          if [[ "\${head_repo,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built from the commits of $head_repo, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if [[ "$branch" != "$BUILD_BRANCH" ]]; then
            echo "::error::The image was built from the branch $branch, not from $BUILD_BRANCH, the branch that builds this environment's images. OpsCrew deploys a digest only when a build on $BUILD_BRANCH made it."
            exit 1
          fi
          # prod's build tags its commit, another environment's <commit>-<env>.
          if [[ "$TAG" != "$commit" && ! "$TAG" =~ ^$commit-[a-z][a-z0-9-]*$ ]]; then
            echo "::error::The tag input is not a commit tag of the image's build ($commit, or $commit-<environment>). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          if [[ "$(docker buildx imagetools inspect "$name:$TAG" --format '{{.Manifest.Digest}}')" != "$DIGEST" ]]; then
            echo "::error::The image is not the one tagged with its build's commit ($TAG): a later build of that commit replaced the tag, or the image was pushed another way. \\\`opscrew rollback --list\\\` shows the versions to roll back to, and \\\`opscrew promote\\\` takes the image another environment runs."
            exit 1
          fi
          {
            echo "image=$image"
            echo "tag=$name:$TAG"
            echo "identity=https://github.com/$GITHUB_REPOSITORY/$workflow@refs/heads/$branch"
          } >> "$GITHUB_OUTPUT"
          echo "Deploying \\\`$image\\\`, built by run $run_id from \\\`$commit\\\` on \\\`$branch\\\`." >> "$GITHUB_STEP_SUMMARY"

  deploy:
    name: Deploy to the server
    needs: verify
    if: \${{ !cancelled() && (needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"')) }}
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/snapshot.sh.new && mv -f /srv/apps/shop/snapshot.sh.new /srv/apps/shop/snapshot.sh' <<'SNAPSHOT'
          # OpsCrew's snapshots of shop's data on the app's server, generated from opscrew/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db'
          SNAPSHOT_ONLINE='db'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop "$1" "$APPS_DIR"/shop >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            _held=""; if [ -f .snapshots/.held ]; then _held=1; fi
            _starts=", and the app starts again"
            if [ -n "$_held" ]; then _starts=", and the app stays stopped while opscrew restore holds it"; fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            if [ -z "$_held" ]; then
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            fi
            docker compose stop app
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              if [ -z "$_held" ]; then docker compose start app; fi
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s)%s: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$_starts" "$APPS_DIR"/shop >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop "$_saved" "$_saved" "$APPS_DIR"/shop >&2
            return 5
          }
          snapshot_cmd_hold() {
            (umask 077 && mkdir -p .snapshots && : > .snapshots/.held)
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
          }
          snapshot_cmd_resume() {
            docker compose start app
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true
            rm -f .snapshots/.held
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              flock 7
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.verify.outputs.image }}
          TAG: \${{ needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock 7
          if [ -f .snapshots/.held ]; then echo '::error::OpsCrew changed nothing on the server: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app'\\''s folder as the deploy user, then try again.' >&2; exit 1; fi
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          if crontab -l 2> /dev/null | grep -q ' # opscrew-snapshots shop$'; then crontab -l | grep -v ' # opscrew-snapshots shop$' | crontab -; fi
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app; exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app; exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop
                rm -f .database.changed; docker compose start app; exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
              exit 1
            fi
          fi
          if [ "$database" = keep ]; then
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          else
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed\`. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
          fi
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.verify.outputs.image }}
          TAG: \${{ needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          exec 7> .start.lock
          flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }
          if [ -f .snapshots/.held ]; then echo held; exit 0; fi
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop/.failed-deploy
              mkdir -p "$APPS_DIR"/shop/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop "$saved" "$APPS_DIR"/shop
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop < /dev/null
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            *:held) echo "::error::This run stopped before changing anything: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app's folder as the deploy user, then try again." ;;
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1

  label:
    name: Label the deployed image
    needs: [verify, deploy]
    if: \${{ !cancelled() && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-prod, and the one before it opscrew-prod-previous
        env:
          IMAGE: \${{ needs.verify.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-prod" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-prod\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-prod-previous" "$PREVIOUS"
          fi
"
`;

exports[`the deploy job > reads OPSCREW_<ENV>_* repository secrets with prefixed secrets, and today's names for prod 1`] = `
"  deploy:
    name: Deploy to the server
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/eu-staging"')) }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/eu-staging/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/eu-staging/runtime/edge/sites/shop-eu-staging.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-eu-staging.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/eu-staging/runtime/edge/sites/shop-eu-staging.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env eu-staging renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_EU_STAGING_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_EU_STAGING_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_EU_STAGING_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_EU_STAGING_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_EU_STAGING_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop-eu-staging'
          scp -r "\${ssh_opts[@]}" opscrew/environments/eu-staging/runtime/compose.yaml opscrew/environments/eu-staging/runtime/edge "deploy@\${HOST}:/srv/apps/shop-eu-staging/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-eu-staging/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-eu-staging/db.env'
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-eu-staging/snapshot.sh.new && mv -f /srv/apps/shop-eu-staging/snapshot.sh.new /srv/apps/shop-eu-staging/snapshot.sh' <<'SNAPSHOT'
          # OpsCrew's snapshots of shop-eu-staging's data on the app's server, generated from opscrew/environments/eu-staging/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-eu-staging
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db'
          SNAPSHOT_ONLINE='db'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop-eu-staging/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop-eu-staging "$1" "$APPS_DIR"/shop-eu-staging >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/environments/eu-staging/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/environments/eu-staging/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/environments/eu-staging/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop-eu-staging >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-eu-staging >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            _held=""; if [ -f .snapshots/.held ]; then _held=1; fi
            _starts=", and the app starts again"
            if [ -n "$_held" ]; then _starts=", and the app stays stopped while opscrew restore holds it"; fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            if [ -z "$_held" ]; then
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-eu-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            fi
            docker compose stop app
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              if [ -z "$_held" ]; then docker compose start app; fi
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop-eu-staging >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-eu-staging >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s)%s: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$_starts" "$APPS_DIR"/shop-eu-staging >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop-eu-staging "$_saved" "$_saved" "$APPS_DIR"/shop-eu-staging >&2
            return 5
          }
          snapshot_cmd_hold() {
            (umask 077 && mkdir -p .snapshots && : > .snapshots/.held)
            edge exec -T kamal-proxy kamal-proxy pause shop-eu-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
          }
          snapshot_cmd_resume() {
            docker compose start app
            edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null > /dev/null 2>&1 || true
            rm -f .snapshots/.held
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              flock 7
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_EU_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop-eu-staging && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop-eu-staging/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-eu-staging/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-eu-staging
          exec 7> .start.lock
          flock 7
          if [ -f .snapshots/.held ]; then echo '::error::OpsCrew changed nothing on the server: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app'\\''s folder as the deploy user, then try again.' >&2; exit 1; fi
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-eu-staging/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-eu-staging/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-eu-staging/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-eu-staging/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/eu-staging/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop-eu-staging/$f ]; then mv -f "$EDGE_DIR"/tls/shop-eu-staging/$f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-eu-staging.caddy ]; then cp "$EDGE_DIR"/sites/shop-eu-staging.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-eu-staging.additions ]; then cp "$EDGE_DIR"/sites/shop-eu-staging.additions .additions.previous; fi
            cp edge/sites/shop-eu-staging.caddy "$EDGE_DIR"/sites/shop-eu-staging.caddy
            rm -f "$EDGE_DIR"/sites/shop-eu-staging.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-eu-staging.caddy; else rm -f "$EDGE_DIR"/sites/shop-eu-staging.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-eu-staging.additions; else rm -f "$EDGE_DIR"/sites/shop-eu-staging.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous "$EDGE_DIR"/tls/shop-eu-staging/$f; else rm -f "$EDGE_DIR"/tls/shop-eu-staging/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/eu-staging/runtime/edge/sites/shop-eu-staging.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-eu-staging.conf
            rm -rf "$EDGE_DIR"/tls/shop-eu-staging
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          if crontab -l 2> /dev/null | grep -q ' # opscrew-snapshots shop-eu-staging$'; then crontab -l | grep -v ' # opscrew-snapshots shop-eu-staging$' | crontab -; fi
          if [ "$MODE" = deploy ] && [ -n "$running" ] && [ "$running" != "$target" ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            snap=0
            snapshot_cmd_take release > /dev/null || snap=$?
            if [ "$snap" -eq 1 ]; then
              printf '::error::The snapshot of the data before this release failed, so the new version was not started and the previous version keeps serving. The copies'\\'' output stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/eu-staging/RUNBOOK.md has the SSH command). Fix its cause and push again, or set deploy.snapshots: false in opscrew/environments/eu-staging/plan.yaml to deploy without snapshots.\\n' "$APPS_DIR"/shop-eu-staging
              exit 1
            fi
            if [ "$snap" -eq 2 ]; then
              printf '::warning::The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew takes no snapshot of the data this time, and a rollback can'\\''t restore it to this moment. Free some space, or keep fewer snapshots (deploy.keepSnapshots in opscrew/environments/eu-staging/plan.yaml).\\n' "$APPS_DIR"/shop-eu-staging
            fi
            if [ "$snap" -eq 0 ]; then
              echo 'OpsCrew took a snapshot of the data before this release: a rollback to the previous version can restore it.'
            fi
          fi
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-eu-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/eu-staging/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop-eu-staging
                rm -f .database.changed; docker compose start app; exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app; exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/eu-staging/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop-eu-staging
                rm -f .database.changed; docker compose start app; exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/eu-staging/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop-eu-staging "$saved" "$APPS_DIR"/shop-eu-staging
              exit 1
            fi
          fi
          if [ "$database" = keep ]; then
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-eu-staging --target "\${name#/}:3000" --host eu-staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed --env eu-staging\`. Check that the app listens on port 3000 (app.port in opscrew/environments/eu-staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          else
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-eu-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-eu-staging --target "\${name#/}:3000" --host eu-staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed --env eu-staging\`. Check that the app listens on port 3000 (app.port in opscrew/environments/eu-staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null
          fi
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://eu-staging-shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_EU_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-eu-staging
          exec 7> .start.lock
          flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/environments/eu-staging/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }
          if [ -f .snapshots/.held ]; then echo held; exit 0; fi
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-eu-staging/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-eu-staging/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-eu-staging/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-eu-staging/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-eu-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/eu-staging/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop-eu-staging "$saved" "$APPS_DIR"/shop-eu-staging
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-eu-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop-eu-staging --target "\${name#/}:3000" --host eu-staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop-eu-staging < /dev/null
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-eu-staging --target "\${name#/}:3000" --host eu-staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            *:held) echo "::error::This run stopped before changing anything: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app's folder as the deploy user, then try again." ;;
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop-eu-staging." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop-eu-staging." ;;
          esac
          exit 1"
`;

exports[`the deploy job on a self-hosted runner > deploys on the runner's own machine: no SSH, no host, key or known hosts 1`] = `
"  deploy:
    name: Deploy to the server
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"')) }}
    runs-on: [self-hosted, opscrew-shop-staging]
    defaults:
      run:
        shell: bash
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/staging/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-staging.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env staging renders the site again), then push again.'
            exit 1
          fi
      - name: Copy the runtime files and environment into the app's folder
        env:
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_STAGING_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_STAGING_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          dir=/srv/apps/shop-staging
          mkdir -p "$dir"
          cp -r opscrew/environments/staging/runtime/compose.yaml opscrew/environments/staging/runtime/edge "$dir"/
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | (umask 077 && cat > "$dir"/app.env)
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | (umask 077 && cat > "$dir"/db.env)
          (umask 077 && cat > "$dir"/snapshot.sh.new && mv -f "$dir"/snapshot.sh.new "$dir"/snapshot.sh) <<'SNAPSHOT'
          # OpsCrew's snapshots of shop-staging's data on the app's server, generated from opscrew/environments/staging/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-staging
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db'
          SNAPSHOT_ONLINE='db'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop-staging/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop-staging "$1" "$APPS_DIR"/shop-staging >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/environments/staging/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/environments/staging/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/environments/staging/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop-staging >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-staging >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            _held=""; if [ -f .snapshots/.held ]; then _held=1; fi
            _starts=", and the app starts again"
            if [ -n "$_held" ]; then _starts=", and the app stays stopped while opscrew restore holds it"; fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            if [ -z "$_held" ]; then
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            fi
            docker compose stop app
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              if [ -z "$_held" ]; then docker compose start app; fi
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop-staging >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-staging >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s)%s: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$_starts" "$APPS_DIR"/shop-staging >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop-staging "$_saved" "$_saved" "$APPS_DIR"/shop-staging >&2
            return 5
          }
          snapshot_cmd_hold() {
            (umask 077 && mkdir -p .snapshots && : > .snapshots/.held)
            edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
          }
          snapshot_cmd_resume() {
            docker compose start app
            edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true
            rm -f .snapshots/.held
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              flock 7
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          dir=/srv/apps/shop-staging
          previous="$(cd "$dir" && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi)"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | DOCKER_CONFIG="$dir"/.docker docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
          unset REGISTRY_TOKEN
          sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-staging/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-staging
          exec 7> .start.lock
          flock 7
          if [ -f .snapshots/.held ]; then echo '::error::OpsCrew changed nothing on the server: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app'\\''s folder as the deploy user, then try again.' >&2; exit 1; fi
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-staging/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-staging/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-staging/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-staging/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/staging/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop-staging/$f ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f "$EDGE_DIR"/tls/shop-staging/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-staging/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-staging.caddy ]; then cp "$EDGE_DIR"/sites/shop-staging.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-staging.additions ]; then cp "$EDGE_DIR"/sites/shop-staging.additions .additions.previous; fi
            cp edge/sites/shop-staging.caddy "$EDGE_DIR"/sites/shop-staging.caddy
            rm -f "$EDGE_DIR"/sites/shop-staging.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-staging.caddy; else rm -f "$EDGE_DIR"/sites/shop-staging.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-staging.additions; else rm -f "$EDGE_DIR"/sites/shop-staging.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop-staging/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f.previous "$EDGE_DIR"/tls/shop-staging/$f; else rm -f "$EDGE_DIR"/tls/shop-staging/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-staging.conf
            rm -rf "$EDGE_DIR"/tls/shop-staging
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          if crontab -l 2> /dev/null | grep -q ' # opscrew-snapshots shop-staging$'; then crontab -l | grep -v ' # opscrew-snapshots shop-staging$' | crontab -; fi
          if [ "$MODE" = deploy ] && [ -n "$running" ] && [ "$running" != "$target" ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            snap=0
            snapshot_cmd_take release > /dev/null || snap=$?
            if [ "$snap" -eq 1 ]; then
              printf '::error::The snapshot of the data before this release failed, so the new version was not started and the previous version keeps serving. The copies'\\'' output stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command). Fix its cause and push again, or set deploy.snapshots: false in opscrew/environments/staging/plan.yaml to deploy without snapshots.\\n' "$APPS_DIR"/shop-staging
              exit 1
            fi
            if [ "$snap" -eq 2 ]; then
              printf '::warning::The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew takes no snapshot of the data this time, and a rollback can'\\''t restore it to this moment. Free some space, or keep fewer snapshots (deploy.keepSnapshots in opscrew/environments/staging/plan.yaml).\\n' "$APPS_DIR"/shop-staging
            fi
            if [ "$snap" -eq 0 ]; then
              echo 'OpsCrew took a snapshot of the data before this release: a rollback to the previous version can restore it.'
            fi
          fi
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop-staging
                rm -f .database.changed; docker compose start app; exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app; exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop-staging
                rm -f .database.changed; docker compose start app; exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop-staging "$saved" "$APPS_DIR"/shop-staging
              exit 1
            fi
          fi
          if [ "$database" = keep ]; then
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed --env staging\`. Check that the app listens on port 3000 (app.port in opscrew/environments/staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          else
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed --env staging\`. Check that the app listens on port 3000 (app.port in opscrew/environments/staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null
          fi
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://staging-shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          dir=/srv/apps/shop-staging
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-staging
          exec 7> .start.lock
          flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/environments/staging/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }
          if [ -f .snapshots/.held ]; then echo held; exit 0; fi
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-staging/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-staging/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-staging/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-staging/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/staging/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop-staging "$saved" "$APPS_DIR"/shop-staging
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-staging --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop-staging < /dev/null
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            *:held) echo "::error::This run stopped before changing anything: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app's folder as the deploy user, then try again." ;;
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Run \\\`docker compose ps\\\` in $dir, on the machine this runner runs on." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Run \\\`docker compose ps\\\` in $dir, on the machine this runner runs on." ;;
          esac
          exit 1"
`;

exports[`the deploy job on a self-hosted runner > deploys on the runner's own machine: no SSH, no host, key or known hosts 2`] = `
"  deploy:
    name: Deploy to the server
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/dev"')) }}
    runs-on: [self-hosted, opscrew-shop-dev]
    defaults:
      run:
        shell: bash
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - name: Use this computer's Docker daemon
        run: |
          set -euo pipefail
          docker_host="$(docker context inspect --format '{{.Endpoints.docker.Host}}')"
          echo "DOCKER_HOST=$docker_host" >> "$GITHUB_ENV"
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/dev/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          if [[ -z "\${OPSCREW_EDGE_DIR:-}" || ! -f "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.pem || ! -f "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.key ]]; then
            echo '::error::This runner finds no leaf certificate for the app in this computer'\\''s edge (tls/shop-dev/local.pem and local.key in OPSCREW_EDGE_DIR). Run \`opscrew provision --env dev\`, which issues it, and start the runner with \`opscrew runner start --env dev\`, which sets OPSCREW_EDGE_DIR; then run the workflow again.'
            exit 1
          fi
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/tls/shop-dev
          cp "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.pem "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.key "$RUNNER_TEMP/opscrew-edge"/tls/shop-dev/
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/dev/runtime/edge/sites/shop-dev.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-dev.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/dev/runtime/edge/sites/shop-dev.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env dev renders the site again), then push again.'
            exit 1
          fi
      - name: Copy the runtime files and environment into the app's folder
        env:
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_DEV_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_DEV_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          if [[ -z "\${OPSCREW_APPS_DIR:-}" || -z "\${OPSCREW_EDGE_DIR:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_APPS_DIR and OPSCREW_EDGE_DIR, the folders of this computer's stack. Start it with \\\`opscrew runner start --env dev\\\`, which sets them."
            exit 1
          fi
          dir="$OPSCREW_APPS_DIR/shop-dev"
          mkdir -p "$dir"
          cp -r opscrew/environments/dev/runtime/compose.yaml opscrew/environments/dev/runtime/edge "$dir"/
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | (umask 077 && cat > "$dir"/app.env)
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | (umask 077 && cat > "$dir"/db.env)
          (umask 077 && cat > "$dir"/snapshot.sh.new && mv -f "$dir"/snapshot.sh.new "$dir"/snapshot.sh) <<'SNAPSHOT'
          # OpsCrew's snapshots of shop-dev's data on the app's server, generated from opscrew/environments/dev/plan.yaml; each deploy uploads it.
          #   sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>]
          #   sh snapshot.sh restore <id> [--only <service>]
          #   sh snapshot.sh hold
          #   sh snapshot.sh resume
          #   sh snapshot.sh list
          #   sh snapshot.sh delete <id>
          #   sh snapshot.sh offsite <id>
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-dev
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          SNAPSHOT_PARTS='db'
          SNAPSHOT_ONLINE='db'
          part_file() {
            case "$1" in
              db)
                echo db.dump
                ;;
              *) return 1 ;;
            esac
          }
          part_kind() {
            case "$1" in
              db)
                echo postgres
                ;;
              *) return 1 ;;
            esac
          }
          part_image() {
            case "$1" in
              db)
                echo '<pin:IMAGES.postgres>'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_room() {
            if df -Pk . | awk 'NR == 2 { exit !($4 >= 1048576 && $4 * 10 >= $2) }'; then return 0; fi
            rm -rf .snapshots/*.partial .snapshots/*.taking
            return 1
          }
          snapshot_run() {
            (umask 077; docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" -v "$APPS_DIR"/shop-dev/.snapshots/"$1":/snapshot:"$2" --entrypoint sh "$3" -c "$4" < /dev/null >> .snapshots/snapshot.log 2>&1)
          }
          snapshot_box() {
            _box="$(docker compose ps -aq "$2")"
            [ -n "$_box" ] || return 1
            docker run --rm -i --network none --volumes-from "$_box:$1" <pin:IMAGES.busybox> sh -c "$3" 2>> .snapshots/snapshot.log
          }
          snapshot_stop() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            for _stopped in $(docker compose ps -aq "$1"); do
              case "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$_stopped")" in
                "exited 137") return 1 ;;
                "exited "* | "created "*) ;;
                *) return 1 ;;
              esac
            done
          }
          snapshot_start() {
            docker compose up -d --no-deps --no-recreate --wait "$1" >> .snapshots/snapshot.log 2>&1
          }
          snapshot_tar() {
            _ran="$(docker compose ps -q "$1")"
            _copied=1
            if ! snapshot_stop "$1"; then
              printf '%s did not stop cleanly within 120 seconds (Docker killed it when the time ran out, or it ran out of memory), so OpsCrew did not copy its files.\\n' "$1" >&2
            elif snapshot_box ro "$1" "tar -C / -cf - $3" < /dev/null > .snapshots/"$2"/"$1".tar; then
              _copied=0
            fi
            if [ -n "$_ran" ] && ! snapshot_start "$1"; then
              printf '%s did not start again after its copy. Its output is in %s/.snapshots/snapshot.log; start it with docker compose up -d %s in %s.\\n' "$1" "$APPS_DIR"/shop-dev "$1" "$APPS_DIR"/shop-dev >&2
              return 1
            fi
            return "$_copied"
          }
          snapshot_untar() {
            docker compose stop -t 120 "$1" >> .snapshots/snapshot.log 2>&1 || return 1
            snapshot_box rw "$1" "$3" < .snapshots/"$2"/"$1".tar || return 1
            snapshot_start "$1"
          }
          part_take() {
            case "$1" in
              db)
                snapshot_run "$2" rw db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && pg_dump -h db -U app -Fc -f /snapshot/db.dump app'
                ;;
              *) return 1 ;;
            esac
          }
          part_restore() {
            case "$1" in
              db)
                snapshot_run "$2" ro db 'umask 077 && export PGPASSWORD="$POSTGRES_PASSWORD" && psql -X -q -h db -U app -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS app WITH (FORCE)" -c "CREATE DATABASE app OWNER app" && pg_restore -h db -U app -d app --no-owner --single-transaction /snapshot/db.dump'
                ;;
              *) return 1 ;;
            esac
          }
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          snapshot_version() {
            _version="$(snapshot_running)"
            if [ -z "$_version" ] && [ -f .env ]; then
              _version_image="$(sed -n 's/^APP_IMAGE=//p' .env)"
              case "$_version_image" in
                "" | *@sha256:*) ;;
                *) _version="$(docker image inspect --format '{{.Id}}' "$_version_image" 2> /dev/null | sed -n 's/^sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p')" ;;
              esac
            fi
            echo "$_version"
          }
          snapshot_about() {
            _about_version=""
            if [ -n "$4" ]; then _about_version="sha256:$4"; fi
            printf '{"id":"%s","kind":"%s","taken":"%s","version":"%s","services":[' "$1" "$2" "$3" "$_about_version"
            _about_folder="$5"
            shift 5
            _about_sep=""
            for _about_part in $SNAPSHOT_PARTS; do
              printf %s "$_about_sep"
              _about_sep=","
              case " $* " in
                *" $_about_part "*)
                  _about_file="$(part_file "$_about_part")"
                  _about_image="$(part_image "$_about_part")"
                  if [ -n "$_about_image" ]; then _about_image=",\\"image\\":\\"$_about_image\\""; fi
                  printf '{"name":"%s","kind":"%s","file":"%s","size":%s%s}' "$_about_part" "$(part_kind "$_about_part")" "$_about_file" "$(wc -c < "$_about_folder/$_about_file" | tr -d ' ')" "$_about_image" ;;
                *) printf '{"name":"%s","kind":"%s","skipped":true}' "$_about_part" "$(part_kind "$_about_part")" ;;
              esac
            done
            printf ']}\\n'
          }
          snapshot_take() {
            _take_id="$1"; _take_kind="$2"; _take_version="$3"; shift 3
            _take_folder="$_take_id.partial"
            if [ "$_take_kind" = manual ]; then _take_folder="$_take_id.taking"; fi
            _take_in=.snapshots/"$_take_folder"
            (umask 077 && mkdir -p .snapshots && rm -rf .snapshots/*.partial .snapshots/*.taking && mkdir "$_take_in" && : > .snapshots/snapshot.log) || return 1
            snapshot_room || return 2
            _take_done=""
            for _take_part in "$@"; do
              _take_rc=0
              (umask 077; part_take "$_take_part" "$_take_folder") || _take_rc=$?
              if [ "$_take_rc" -eq 3 ]; then
                rm -f "$_take_in"/"$(part_file "$_take_part")"
              elif [ "$_take_rc" -ne 0 ]; then
                printf 'The copy of %s failed.\\n' "$_take_part" >&2
                rm -rf "$_take_in"
                return 1
              else
                _take_done="$_take_done $_take_part"
              fi
              snapshot_room || return 2
            done
            _taken="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            (umask 077 && echo "$_taken" > "$_take_in"/taken && snapshot_about "$_take_id" "$_take_kind" "$_taken" "$_take_version" "$_take_in" $_take_done > "$_take_in"/about.json) || return 1
            rm -rf .snapshots/"$_take_id" && mv "$_take_in" .snapshots/"$_take_id"
          }
          snapshot_complete() {
            [ -f .snapshots/"$1"/about.json ] || return 1
            for _complete_file in $(grep -o '"file":"[^"]*"' .snapshots/"$1"/about.json | cut -d '"' -f 4); do
              [ -f .snapshots/"$1"/"$_complete_file" ] || return 1
            done
          }
          snapshot_parts() {
            for _listed in $SNAPSHOT_PARTS; do
              if [ -f .snapshots/"$1"/"$(part_file "$_listed")" ]; then echo "$_listed"; fi
            done
          }
          snapshot_restore() {
            _restore_id="$1"; shift
            if [ "$#" -eq 0 ]; then set -- $(snapshot_parts "$_restore_id"); fi
            for _restore_part in "$@"; do
              part_restore "$_restore_part" "$_restore_id" || return 1
            done
          }
          snapshot_usage() {
            echo 'Usage: sh snapshot.sh take <manual|release|scheduled> [--skip <service>]... [--stop <service>]... [--id <id>] [--version sha256:<hex>] | restore <id> [--only <service>] | hold | resume | list | delete <id> | offsite <id>' >&2
          }
          snapshot_id() {
            case "$1" in
              "" | *[!0-9A-Za-z]*) echo 'A snapshot'\\''s id has only letters and digits.' >&2; return 1 ;;
            esac
          }
          snapshot_known() {
            case " $SNAPSHOT_PARTS " in *" $1 "*) return 0 ;; esac
            printf '%s is no service with data on the app'\\''s server.\\n' "$1" >&2
            return 1
          }
          snapshot_new_id() {
            _new="$(date -u +%Y%m%dT%H%M%SZ)"
            while [ -e .snapshots/"$_new" ]; do sleep 1; _new="$(date -u +%Y%m%dT%H%M%SZ)"; done
            echo "$_new"
          }
          snapshot_cmd_take() {
            _kind="\${1:-}"
            case "$_kind" in manual | release | scheduled) shift ;; *) snapshot_usage; return 1 ;; esac
            case "$_kind" in
              release) _stop='' ;;
              scheduled) _stop='' ;;
              *) _stop="" ;;
            esac
            _skip=""; _id=""; _hex="$(snapshot_version)"
            while [ "$#" -gt 0 ]; do
              [ "$#" -ge 2 ] || { snapshot_usage; return 1; }
              case "$1" in
                --skip) snapshot_known "$2" || return 1; _skip="$_skip $2" ;;
                --stop)
                  snapshot_known "$2" || return 1
                  case " $SNAPSHOT_ONLINE " in *" $2 "*)
                    printf '%s is copied while it runs, so it never stops: leave out --stop %s.\\n' "$2" "$2" >&2
                    return 1 ;;
                  esac
                  _stop="$_stop $2" ;;
                --id) snapshot_id "$2" || return 1; _id="$2" ;;
                --version)
                  case "$2" in sha256:*) _hex="\${2#sha256:}" ;; *) _hex="" ;; esac
                  case "$_hex" in *[!0-9a-f]*) _hex="" ;; esac
                  if [ "\${#_hex}" -ne 64 ]; then
                    echo '--version needs an image digest: sha256: and 64 lower-case hexadecimal digits.' >&2
                    return 1
                  fi ;;
                *) snapshot_usage; return 1 ;;
              esac
              shift 2
            done
            case "$_kind" in
              release)
                if [ -z "$_hex" ]; then
                  echo 'No version runs here by its image digest (the app'\\''s .env, or .running on an extra server), and no --version names one, so there is no release to take a snapshot of.' >&2
                  return 1
                fi
                _id="\${_id:-$_hex}" ;;
              scheduled)
                echo 'Scheduled snapshots are off (snapshots.schedule in opscrew/environments/dev/plan.yaml).' >&2
                return 1 ;;
              *)
                if [ -n "$_id" ] && [ -e .snapshots/"$_id" ]; then
                  printf 'There is already a snapshot %s on the app'\\''s server.\\n' "$_id" >&2
                  return 1
                fi
                _id="\${_id:-$(snapshot_new_id)}" ;;
            esac
            _parts=""
            for _each in $SNAPSHOT_PARTS; do
              case " $_skip " in *" $_each "*) continue ;; esac
              case " $SNAPSHOT_ONLINE $_stop " in *" $_each "*) _parts="$_parts $_each"; continue ;; esac
              case "$_kind" in
                manual) printf '%s was left out: it must stop for its copy. Name it with --stop %s to stop it for its copy.\\n' "$_each" "$_each" >&2 ;;
                release) printf '%s was left out of the snapshot before this release: it must stop for its copy. Name it in deploy.snapshotStop in opscrew/environments/dev/plan.yaml to copy it before each release.\\n' "$_each" >&2 ;;
                scheduled) printf '%s was left out of the scheduled snapshot: it must stop for its copy. Name it in snapshots.schedule.stop in opscrew/environments/dev/plan.yaml to copy it on the schedule.\\n' "$_each" >&2 ;;
              esac
            done
            _rc=0
            snapshot_take "$_id" "$_kind" "$_hex" $_parts || _rc=$?
            if [ "$_rc" -eq 2 ]; then
              printf 'The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew took no snapshot. Free some space, or delete snapshots you no longer need (opscrew snapshot delete).\\n' "$APPS_DIR"/shop-dev >&2
              return 2
            fi
            if [ "$_rc" -ne 0 ]; then
              printf 'OpsCrew took no snapshot. The output of the copies stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-dev >&2
              return 1
            fi
            case "$_kind" in
              release)
                for _each in .snapshots/*/taken; do
                  _folder="\${_each%/taken}"
                  case "\${_folder#.snapshots/}" in *[!0-9a-f]*) continue ;; esac
                  if [ -f "$_each" ]; then echo "$(cat "$_each") $_folder"; fi
                done | sort -r | sed '1,3d' | while read -r _ _folder; do rm -rf "$_folder"; done
                ;;
            esac
            echo "$_id"
          }
          snapshot_cmd_restore() {
            [ "$#" -ge 1 ] || { snapshot_usage; return 1; }
            _id="$1"
            shift
            snapshot_id "$_id" || return 1
            _only=""
            if [ "$#" -gt 0 ]; then
              if [ "$#" -ne 2 ] || [ "$1" != --only ]; then snapshot_usage; return 1; fi
              snapshot_known "$2" || return 1
              _only="$2"
            fi
            if [ ! -f .restore-snapshot ]; then
              echo 'A restore needs its one-time approval on this server (.restore-snapshot), which opscrew restore writes once you approve it, so nothing was changed. Run opscrew restore.' >&2
              return 1
            fi
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .restore-snapshot || true
            rm -f .restore-snapshot
            if [ "$approved" != "$_id" ] || [ "$choice" != "\${_only:--}" ]; then
              echo 'The one-time approval on this server (.restore-snapshot) is for another restore, so OpsCrew removed it and changed nothing. Run opscrew restore again.' >&2
              return 1
            fi
            case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
            if [ "$expiry" -le "$(date +%s)" ]; then
              echo 'The one-time approval of this restore expired before it started, so nothing was changed. Run opscrew restore again.' >&2
              return 1
            fi
            if ! snapshot_complete "$_id"; then
              printf 'The snapshot %s is not complete on this server, so nothing was changed.\\n' "$_id" >&2
              return 1
            fi
            if [ -z "$_only" ]; then
              _parts="$(snapshot_parts "$_id")"
            elif [ -f .snapshots/"$_id"/"$(part_file "$_only")" ]; then
              _parts="$_only"
            else
              printf 'The snapshot %s holds no copy of %s, so nothing was changed.\\n' "$_id" "$_only" >&2
              return 1
            fi
            _held=""; if [ -f .snapshots/.held ]; then _held=1; fi
            _starts=", and the app starts again"
            if [ -n "$_held" ]; then _starts=", and the app stays stopped while opscrew restore holds it"; fi
            printf 'OpsCrew restores the snapshot %s: the app'\\''s requests wait, and the app stops until its data is back.\\n' "$_id" >&2
            if [ -z "$_held" ]; then
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-dev --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            fi
            docker compose stop app
            _saved="$(snapshot_new_id)"
            _rc=0
            snapshot_take "$_saved" manual "$(snapshot_version)" $_parts || _rc=$?
            if [ "$_rc" -ne 0 ]; then
              if [ -z "$_held" ]; then docker compose start app; fi
              if [ "$_rc" -eq 2 ]; then
                printf 'The disk that holds %s has too little free space to copy the current data before the restore, so nothing was changed. Free some space and run opscrew restore again.\\n' "$APPS_DIR"/shop-dev >&2
              else
                printf 'OpsCrew could not copy the current data before the restore, so nothing was changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$APPS_DIR"/shop-dev >&2
              fi
              return 1
            fi
            echo "saved $_saved"
            if snapshot_restore "$_id" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'OpsCrew restored the snapshot %s. The data from just before the restore is the snapshot %s.\\n' "$_id" "$_saved" >&2
              return 0
            fi
            if snapshot_restore "$_saved" $_parts; then
              if [ -z "$_held" ]; then docker compose start app; fi
              printf 'Restoring the snapshot %s failed, so OpsCrew put the data back as it was before the restore (the snapshot %s)%s: nothing changed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$_saved" "$_starts" "$APPS_DIR"/shop-dev >&2
              return 1
            fi
            printf 'Restoring the snapshot %s failed, and putting the data back as it was before the restore failed too, so it may be partly changed, and the app was not started. The copy from just before the restore stays in %s/.snapshots/%s: restore it with opscrew restore %s once the cause is fixed. The output of the copies and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data, so it is not printed here).\\n' "$_id" "$APPS_DIR"/shop-dev "$_saved" "$_saved" "$APPS_DIR"/shop-dev >&2
            return 5
          }
          snapshot_cmd_hold() {
            (umask 077 && mkdir -p .snapshots && : > .snapshots/.held)
            edge exec -T kamal-proxy kamal-proxy pause shop-dev --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
          }
          snapshot_cmd_resume() {
            docker compose start app
            edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null > /dev/null 2>&1 || true
            rm -f .snapshots/.held
          }
          if [ "\${OPSCREW_SNAPSHOT_FUNCTIONS:-}" = 1 ]; then return 0; fi
          case "\${1:-}" in
            list)
              for _each in .snapshots/*/about.json; do
                case "$_each" in *.partial/* | *.taking/*) continue ;; esac
                if [ -f "$_each" ]; then cat "$_each"; fi
              done ;;
            offsite)
              [ "$#" -eq 2 ] || { snapshot_usage; exit 1; }
              snapshot_id "$2" ;;
            take | restore | delete | hold | resume)
              exec 7> .start.lock
              if command -v flock > /dev/null 2>&1; then flock 7; fi
              _command="$1"
              shift
              case "$_command" in
                take) snapshot_cmd_take "$@" ;;
                restore) snapshot_cmd_restore "$@" ;;
                hold) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_hold ;;
                resume) [ "$#" -eq 0 ] || { snapshot_usage; exit 1; }; snapshot_cmd_resume ;;
                delete)
                  [ "$#" -eq 1 ] || { snapshot_usage; exit 1; }
                  snapshot_id "$1"
                  if [ ! -d .snapshots/"$1" ]; then
                    printf 'There is no snapshot %s on the app'\\''s server.\\n' "$1" >&2
                    exit 1
                  fi
                  rm -rf .snapshots/"$1" ;;
              esac ;;
            *)
              snapshot_usage
              exit 1 ;;
          esac
          SNAPSHOT
      - id: start
        name: Start the new version
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          if [[ -z "\${OPSCREW_LOCAL_LOCK:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_LOCAL_LOCK, OpsCrew's deploy lock on this computer. Start it with \\\`opscrew runner start --env dev\\\`, which sets it."
            exit 1
          fi
          mkdir -p "$(dirname "$OPSCREW_LOCAL_LOCK")"
          holder=$$
          if [[ -r /proc/$$/winpid ]]; then holder="$(cat /proc/$$/winpid)"; fi
          for attempt in $(seq 1 300); do
            if (set -o noclobber; echo "$holder" > "$OPSCREW_LOCAL_LOCK") 2> /dev/null; then break; fi
            if [[ "$attempt" -eq 300 ]]; then
              echo "::error::Another OpsCrew deploy on this computer has held the local stack for over 10 minutes, so this one did not start. If no other OpsCrew command runs, delete $OPSCREW_LOCAL_LOCK, then run the deploy again."
              exit 1
            fi
            sleep 2
          done
          trap 'rm -f "$OPSCREW_LOCAL_LOCK"' EXIT
          dir="$OPSCREW_APPS_DIR/shop-dev"
          previous="$(cd "$dir" && rm -f .env.previous .database.changed && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi)"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          if [[ ! -f "$dir"/.docker/config.json ]]; then
            mkdir -p "$dir"/.docker
            printf '{"auths":{"ghcr.io":{}}}\\n' > "$dir"/.docker/config.json
          fi
          printf '%s\\n' "$REGISTRY_TOKEN" | DOCKER_CONFIG="$dir"/.docker docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
          unset REGISTRY_TOKEN
          sh -s -- "$IMAGE" "$MODE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-dev/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-dev
          exec 7> .start.lock
          if command -v flock > /dev/null 2>&1; then flock 7; fi
          if [ -f .snapshots/.held ]; then echo '::error::OpsCrew changed nothing on the server: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app'\\''s folder as the deploy user, then try again.' >&2; exit 1; fi
          echo started > .start.outcome
          export APP_IMAGE="$1"
          RUN_IMAGE="$1"
          MODE="\${2:-deploy}"
          rm -f .database.changed
          database=keep
          target="\${1##*@sha256:}"
          snapshot_running() {
            if [ -f .env ]; then
              sed -n 's/^APP_IMAGE=.*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .env
            elif [ -f .running ]; then
              sed -n 's/^[^=]*@sha256:\\([0-9a-f]\\{64\\}\\)$/\\1/p' .running
            fi
          }
          running="$(snapshot_running)"
          if [ "$MODE" = rollback ] && [ -f .rollback-database ]; then
            approved=""; choice=""; expiry=""
            read -r approved choice expiry < .rollback-database || true
            rm -f .rollback-database
            if [ "$approved" != "$target" ]; then
              echo '::warning::The approval to change the database on a rollback (.rollback-database on the server) is for another version, so OpsCrew removed it: this rollback keeps the database as it is.'
            else
              case "$choice" in snapshot) ;; *)
                echo '::error::The one-time approval to change the database on this rollback (.rollback-database on the server) names a choice this server can'\\''t carry out, so nothing was changed. Run opscrew rollback again.'
                exit 1 ;;
              esac
              case "$expiry" in "" | *[!0-9]* | ???????????*) expiry=0 ;; esac
              if [ "$expiry" -le "$(date +%s)" ]; then
                echo '::error::The one-time approval to restore or migrate the database on this rollback expired before the run started, so nothing was changed. Run opscrew rollback again.'
                exit 1
              fi
              database="$choice"
            fi
          fi
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-dev/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-dev/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-dev/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-dev/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            if command -v flock > /dev/null 2>&1; then flock 9; fi
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/dev/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in local.pem local.key; do
              if [ -f "$EDGE_DIR"/tls/shop-dev/$f ]; then cp "$EDGE_DIR"/tls/shop-dev/$f "$EDGE_DIR"/tls/shop-dev/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-dev/$f.previous; fi
              if [ -f "$EDGE_DIR"/tls/shop-dev/$f.new ]; then mv -f "$EDGE_DIR"/tls/shop-dev/$f.new "$EDGE_DIR"/tls/shop-dev/$f; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-dev.caddy ]; then cp "$EDGE_DIR"/sites/shop-dev.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-dev.additions ]; then cp "$EDGE_DIR"/sites/shop-dev.additions .additions.previous; fi
            cp edge/sites/shop-dev.caddy "$EDGE_DIR"/sites/shop-dev.caddy
            rm -f "$EDGE_DIR"/sites/shop-dev.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-dev.caddy; else rm -f "$EDGE_DIR"/sites/shop-dev.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-dev.additions; else rm -f "$EDGE_DIR"/sites/shop-dev.additions; fi
              for f in local.pem local.key; do
                if [ -f "$EDGE_DIR"/tls/shop-dev/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-dev/$f.previous "$EDGE_DIR"/tls/shop-dev/$f; else rm -f "$EDGE_DIR"/tls/shop-dev/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/dev/runtime/edge/sites/shop-dev.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-dev.conf
            rm -f "$EDGE_DIR"/tls/shop-dev/local.pem.previous "$EDGE_DIR"/tls/shop-dev/local.key.previous
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          if [ "$MODE" = deploy ] && [ -n "$running" ] && [ "$running" != "$target" ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            snap=0
            snapshot_cmd_take release > /dev/null || snap=$?
            if [ "$snap" -eq 1 ]; then
              printf '::error::The snapshot of the data before this release failed, so the new version was not started and the previous version keeps serving. The copies'\\'' output stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/dev/RUNBOOK.md has the SSH command). Fix its cause and push again, or set deploy.snapshots: false in opscrew/environments/dev/plan.yaml to deploy without snapshots.\\n' "$APPS_DIR"/shop-dev
              exit 1
            fi
            if [ "$snap" -eq 2 ]; then
              printf '::warning::The disk that holds %s has less than 1 GiB or 10%% free, so OpsCrew takes no snapshot of the data this time, and a rollback can'\\''t restore it to this moment. Free some space, or keep fewer snapshots (deploy.keepSnapshots in opscrew/environments/dev/plan.yaml).\\n' "$APPS_DIR"/shop-dev
            fi
            if [ "$snap" -eq 0 ]; then
              echo 'OpsCrew took a snapshot of the data before this release: a rollback to the previous version can restore it.'
            fi
          fi
          if [ "$database" != keep ]; then
            if [ -z "$running" ] || [ "$running" = "$target" ]; then
              echo '::error::The server'\\''s .env names no other version by its image digest, so OpsCrew can'\\''t save its database before changing it, and the rollback changed nothing. Run opscrew rollback again and keep the database as it is.'
              exit 1
            fi
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            if [ "$database" = snapshot ] && ! snapshot_complete "$target"; then
              echo '::error::The snapshot this rollback was approved to restore is no longer complete on the server (in .snapshots), so the rollback changed nothing. Run opscrew rollback again to choose again.'
              exit 1
            fi
            echo 'The rollback changes the database: the app'\\''s requests wait, and the app stops until the earlier version starts.'
            saved=""
            before="$(sed -n 's/^APP_IMAGE=//p' .env)"
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 0 > .database.changed)
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-dev --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            docker compose stop app
            parts=""
            case "$database" in
              snapshot) parts="$(snapshot_parts "$target")" ;;
            esac
            if [ -n "$parts" ]; then
              snap=0
              snapshot_take "$running" release "$running" $parts || snap=$?
              if [ "$snap" -eq 1 ]; then
                printf '::error::OpsCrew could not save the current database before changing it, so the rollback changed nothing and the running version starts again. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/dev/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again, or keep the database as it is.\\n' "$APPS_DIR"/shop-dev
                rm -f .database.changed; docker compose start app; exit 1
              fi
              if [ "$snap" -eq 2 ]; then
                echo '::error::The server has too little free disk to save the current database before changing it, so the rollback changed nothing and the running version starts again. Free some space and run opscrew rollback again.'
                rm -f .database.changed; docker compose start app; exit 1
              fi
              saved="$running"
            fi
            (umask 077; printf 'target=%s\\nAPP_IMAGE=%s\\nsaved=%s\\nchanged=%s\\n' "$target" "$before" "$saved" 1 > .database.changed)
            failed=0
            case "$database" in
              snapshot)
                what="Restoring the snapshot of the database"
                if snapshot_restore "$target" $parts; then
                  echo "OpsCrew restored the database from the snapshot taken $(cat .snapshots/"$target"/taken)."
                else
                  failed=1
                fi ;;
            esac
            if [ "$failed" -ne 0 ]; then
              if snapshot_restore "$saved" $parts; then
                printf '::error::%s failed, so OpsCrew put the database back as it was before the rollback, and the running version starts again: the rollback changed nothing. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/dev/RUNBOOK.md has the SSH command). Fix the cause and run opscrew rollback again.\\n' "$what" "$APPS_DIR"/shop-dev
                rm -f .database.changed; docker compose start app; exit 1
              fi
              printf '::error::%s failed, and putting the database back as it was before the rollback failed too, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: the rollback step tries once more to restore it. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/dev/RUNBOOK.md has the SSH command).\\n' "$what" "$APPS_DIR"/shop-dev "$saved" "$APPS_DIR"/shop-dev
              exit 1
            fi
          fi
          if [ "$database" = keep ]; then
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-dev --target "\${name#/}:3000" --host shop.localhost --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Its last lines are kept on the server: \`opscrew logs --failed --env dev\`. Check that the app listens on port 3000 (app.port in opscrew/environments/dev/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          else
            trap 'edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null > /dev/null 2>&1 || true; docker logout ghcr.io > /dev/null 2>&1' EXIT
            edge exec -T kamal-proxy kamal-proxy pause shop-dev --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            docker compose up -d --no-deps --remove-orphans app
            new="$(docker compose ps -aq app)"
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-dev --target "\${name#/}:3000" --host shop.localhost --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              keep_failed app "$new" health
              echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. Its last lines are kept on the server: \`opscrew logs --failed --env dev\`. Check that the app listens on port 3000 (app.port in opscrew/environments/dev/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null
          fi
          echo finished > .start.outcome
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://shop.localhost:8443/api/health
        run: |
          set -euo pipefail
          if [[ -z "\${OPSCREW_LOCAL_CA_FILE:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_LOCAL_CA_FILE, the certificate of OpsCrew's local CA that the app's HTTPS is checked with. Start it with \\\`opscrew runner start --env dev\\\`, which sets it."
            exit 1
          fi
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 --resolve shop.localhost:8443:127.0.0.1 --cacert "$OPSCREW_LOCAL_CA_FILE" --ssl-no-revoke "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Say what the rollback went back to
        if: inputs.rollback
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          TAG: \${{ needs.build.outputs.tag || needs.verify.outputs.tag }}
        run: |
          set -euo pipefail
          # The commit tag is <commit>, or <commit>-<env> outside prod.
          commit="\${TAG##*:}"
          echo "Rolled back to \\\`$IMAGE\\\` (built from \\\`\${commit%%-*}\\\`): no build, no release command." >> "$GITHUB_STEP_SUMMARY"
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && (steps.start.outcome == 'failure' || steps.start.outcome == 'cancelled' || steps.health.outcome == 'failure')
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -uo pipefail
          if [[ -z "\${OPSCREW_LOCAL_LOCK:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_LOCAL_LOCK, OpsCrew's deploy lock on this computer. Start it with \\\`opscrew runner start --env dev\\\`, which sets it."
            exit 1
          fi
          mkdir -p "$(dirname "$OPSCREW_LOCAL_LOCK")"
          holder=$$
          if [[ -r /proc/$$/winpid ]]; then holder="$(cat /proc/$$/winpid)"; fi
          for attempt in $(seq 1 300); do
            if (set -o noclobber; echo "$holder" > "$OPSCREW_LOCAL_LOCK") 2> /dev/null; then break; fi
            if [[ "$attempt" -eq 300 ]]; then
              echo "::error::Another OpsCrew deploy on this computer has held the local stack for over 10 minutes, so this one did not start. If no other OpsCrew command runs, delete $OPSCREW_LOCAL_LOCK, then run the deploy again."
              exit 1
            fi
            sleep 2
          done
          trap 'rm -f "$OPSCREW_LOCAL_LOCK"' EXIT
          dir="$OPSCREW_APPS_DIR/shop-dev"
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-dev
          exec 7> .start.lock
          if command -v flock > /dev/null 2>&1; then flock -w 900 7 || { echo '::error::The start script of this run is still running on the server after 15 minutes, so the rollback step changed nothing. Check the app on the server (opscrew/environments/dev/RUNBOOK.md has the SSH command), then run the deploy or opscrew rollback again.' >&2; exit 1; }; fi
          if [ -f .snapshots/.held ]; then echo held; exit 0; fi
          RUN_IMAGE="$1"
          keep_failed() {
            (
              umask 077
              grep -qxF kept .start.outcome 2> /dev/null || rm -rf "$APPS_DIR"/shop-dev/.failed-deploy
              mkdir -p "$APPS_DIR"/shop-dev/.failed-deploy
              docker logs --timestamps --tail 500 "$2" > "$APPS_DIR"/shop-dev/.failed-deploy/"$1".log 2>&1
              printf 'image=%s\\ntime=%s\\nfailed=%s\\n' "$RUN_IMAGE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$3" > "$APPS_DIR"/shop-dev/.failed-deploy/about
              echo kept > .start.outcome
            ) || true
          }
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if [ -f .database.changed ]; then
            marked="$(sed -n 's/^target=//p' .database.changed)"
            before="$(sed -n 's/^APP_IMAGE=//p' .database.changed)"
            if [ "$marked" != "\${1##*@sha256:}" ] || ! grep -qxF "APP_IMAGE=$before" .env.previous 2> /dev/null; then
              rm -f .database.changed
            fi
          fi
          if [ -f .database.changed ]; then
            OPSCREW_SNAPSHOT_FUNCTIONS=1 . ./snapshot.sh
            result=unchanged
            if grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then
              result=restored
              outcome="$(cat .start.outcome 2> /dev/null || true)"
              if [ "$outcome" != kept ]; then
                why=start; if [ "$outcome" = finished ]; then why=check; fi
                for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
              fi
            fi
            saved="$(sed -n 's/^saved=//p' .database.changed)"
            changed="$(sed -n 's/^changed=//p' .database.changed)"
            APP_IMAGE="$before"
            export APP_IMAGE
            {
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-dev --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              docker compose stop app
              if [ "$changed" = 1 ]; then
                if [ -z "$saved" ]; then
                  echo '::warning::The earlier version failed after the rollback changed the database, and no copy of the database from before the rollback was saved, so it stays as the rollback left it while the version that ran before starts again. The next deploy'\\''s release command migrates it up again.'
                elif snapshot_restore "$saved"; then
                  echo 'The earlier version failed after the rollback changed the database, so OpsCrew put the database back as it was before the rollback.'
                else
                  printf '::error::The earlier version failed after the rollback changed the database, and putting the database back as it was before the rollback failed, so it may be partly changed, and no version of the app starts on it. Its copy from before the rollback stays in %s/.snapshots/%s: restore it, then start the app. The output of the dumps and restores stays on the server in %s/.snapshots/snapshot.log (it can quote data from the database, so it is not printed here; opscrew/environments/dev/RUNBOOK.md has the SSH command).\\n' "$APPS_DIR"/shop-dev "$saved" "$APPS_DIR"/shop-dev
                  exit 1
                fi
              fi
              rm -f .database.changed
              trap 'edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null > /dev/null 2>&1 || true' EXIT
              edge exec -T kamal-proxy kamal-proxy pause shop-dev --drain-timeout 30s --max-pause 90s < /dev/null > /dev/null 2>&1 || true
              printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
              docker compose up -d --no-deps --remove-orphans app
              new="$(docker compose ps -aq app)"
              name="$(docker inspect --format '{{.Name}}' "$new")"
              if ! edge exec -T kamal-proxy kamal-proxy deploy shop-dev --target "\${name#/}:3000" --host shop.localhost --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
                echo '::error::The previous version did not pass its health check either.'
                docker rm -f "$new" > /dev/null
                exit 1
              fi
              edge exec -T kamal-proxy kamal-proxy resume shop-dev < /dev/null
            } >&2
            rm -f .env.previous .processes.previous
            echo "$result"
            exit 0
          fi
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          outcome="$(cat .start.outcome 2> /dev/null || true)"
          if [ "$outcome" != kept ]; then
            why=start; if [ "$outcome" = finished ]; then why=check; fi
            for id in $(docker compose ps -aq app); do keep_failed app "$id" "$why"; done
          fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-dev --target "\${name#/}:3000" --host shop.localhost --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              echo '::error::The previous version did not pass its health check either.'
              docker rm -f "$new" > /dev/null
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$MODE:$outcome" in
            *:held) echo "::error::This run stopped before changing anything: a restore holds the app (.snapshots/.held in its folder), so its data may be partly restored: finish the restore with opscrew restore <copy>, or run sh snapshot.sh resume in the app's folder as the deploy user, then try again." ;;
            rollback:restored)
              echo "::error::The rollback failed: the earlier version did not pass its checks, so OpsCrew put back the version that ran before the rollback." ;;
            rollback:unchanged)
              echo "::error::The rollback failed before the earlier version took traffic; the server still runs the version it had." ;;
            rollback:*)
              echo "::error::The rollback failed and OpsCrew could not put back the version that ran before it. Run \\\`docker compose ps\\\` in $dir, on the machine this runner runs on." ;;
            *:restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            *:unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            *:no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Run \\\`docker compose ps\\\` in $dir, on the machine this runner runs on." ;;
          esac
          exit 1"
`;

exports[`the label job > runs after a healthy deploy, with only packages: write 1`] = `
"  label:
    name: Label the deployed image
    needs: [build, verify, deploy]
    if: \${{ !cancelled() && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-staging, and the one before it opscrew-staging-previous
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-staging" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-staging\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-staging-previous" "$PREVIOUS"
          fi"
`;

exports[`the verify job > runs the provenance check with the job's token and the branch that builds the images 1`] = `
"  verify:
    name: Check where the image was built
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: read
    outputs:
      image: \${{ steps.provenance.outputs.image }}
      tag: \${{ steps.provenance.outputs.tag }}
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: provenance
        name: Check the image's provenance
        env:
          DIGEST: \${{ inputs.digest }}
          TAG: \${{ inputs.tag }}
          BUILD_BRANCH: "main"
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The digest input is not an image digest (sha256: and 64 hexadecimal digits). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          name="ghcr.io/\${GITHUB_REPOSITORY,,}"
          image="$name@$DIGEST"
          if ! provenance="$(docker buildx imagetools inspect "$image" --format '{{json .Provenance}}')"; then
            echo "::error::GitHub Container Registry has no image $image. Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which choose an image that is there."
            exit 1
          fi
          # buildx names the run that built the image in runDetails.builder.id (per platform).
          mapfile -t runs < <(jq -r '.. | .runDetails?.builder?.id? // empty' <<< "$provenance" | sort -u)
          if [[ "\${#runs[@]}" -ne 1 || ! "\${runs[0]}" =~ ^https://github\\.com/([^/]+/[^/]+)/actions/runs/([0-9]+)/attempts/[0-9]+$ ]]; then
            echo "::error::The image's build provenance does not name one GitHub Actions run, so OpsCrew cannot tell where it was built. OpsCrew deploys a digest only when this repository's deploy workflow built it."
            exit 1
          fi
          built_in="\${BASH_REMATCH[1]}"
          run_id="\${BASH_REMATCH[2]}"
          if [[ "\${built_in,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built by a run of $built_in, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if ! record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" --jq '"\\(.event) \\(.head_repository.full_name) \\(.head_branch) \\(.head_sha) \\(.path)"')"; then
            echo "::error::GitHub shows no run $run_id in this repository, which the image's provenance names as its build. OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          read -r event head_repo branch commit workflow <<< "$record"
          # The run's path can end with @<ref>, which the signing identity carries separately.
          workflow="\${workflow%%@*}"
          # A fork's pull request runs in this repository too, with its own branch name: only a push, or a
          # run started by hand, which takes write access (ADR 0023 D1), counts.
          if [[ "$event" != "push" && "$event" != "workflow_dispatch" ]]; then
            echo "::error::The image was built by a $event run, not by a push or a run started by hand. OpsCrew deploys a digest only when a push to $BUILD_BRANCH, or a run started by hand there, built it."
            exit 1
          fi
          if [[ "\${head_repo,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built from the commits of $head_repo, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if [[ "$branch" != "$BUILD_BRANCH" ]]; then
            echo "::error::The image was built from the branch $branch, not from $BUILD_BRANCH, the branch that builds this environment's images. OpsCrew deploys a digest only when a build on $BUILD_BRANCH made it."
            exit 1
          fi
          # prod's build tags its commit, another environment's <commit>-<env>.
          if [[ "$TAG" != "$commit" && ! "$TAG" =~ ^$commit-[a-z][a-z0-9-]*$ ]]; then
            echo "::error::The tag input is not a commit tag of the image's build ($commit, or $commit-<environment>). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          if [[ "$(docker buildx imagetools inspect "$name:$TAG" --format '{{.Manifest.Digest}}')" != "$DIGEST" ]]; then
            echo "::error::The image is not the one tagged with its build's commit ($TAG): a later build of that commit replaced the tag, or the image was pushed another way. \\\`opscrew rollback --list\\\` shows the versions to roll back to, and \\\`opscrew promote\\\` takes the image another environment runs."
            exit 1
          fi
          {
            echo "image=$image"
            echo "tag=$name:$TAG"
            echo "identity=https://github.com/$GITHUB_REPOSITORY/$workflow@refs/heads/$branch"
          } >> "$GITHUB_OUTPUT"
          echo "Deploying \\\`$image\\\`, built by run $run_id from \\\`$commit\\\` on \\\`$branch\\\`." >> "$GITHUB_STEP_SUMMARY""
`;
