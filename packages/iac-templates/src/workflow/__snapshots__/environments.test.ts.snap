// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a workflow per environment > matches the snapshots of staging following main and prod promoted from it 1`] = `
"# Generated by OpsCrew from opscrew/environments/staging/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app image, pushes it to GitHub Container Registry and deploys it to your server
# over SSH. Secrets are set by \`opscrew provision\`; their values never appear in this file.
name: OpsCrew deploy (staging)

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "Dockerfile"
      - "opscrew/environments/staging/runtime/compose.yaml"
      - "opscrew/environments/staging/runtime/edge/**"
      - ".github/workflows/opscrew-deploy-staging.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy-shop-staging
  cancel-in-progress: false

jobs:
  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}-staging" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_STAGING_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_STAGING_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA-staging\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi

  deploy:
    name: Deploy to the server
    needs: build
    runs-on: ubuntu-latest
    environment: staging
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/staging/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-staging.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env staging renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_STAGING_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_STAGING_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_STAGING_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_STAGING_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_STAGING_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop-staging'
          scp -r "\${ssh_opts[@]}" opscrew/environments/staging/runtime/compose.yaml opscrew/environments/staging/runtime/edge "deploy@\${HOST}:/srv/apps/shop-staging/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-staging/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-staging/db.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop-staging && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop-staging/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-staging/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-staging
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/staging/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop-staging/$f ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f "$EDGE_DIR"/tls/shop-staging/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-staging/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-staging.caddy ]; then cp "$EDGE_DIR"/sites/shop-staging.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-staging.additions ]; then cp "$EDGE_DIR"/sites/shop-staging.additions .additions.previous; fi
            cp edge/sites/shop-staging.caddy "$EDGE_DIR"/sites/shop-staging.caddy
            rm -f "$EDGE_DIR"/sites/shop-staging.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-staging.caddy; else rm -f "$EDGE_DIR"/sites/shop-staging.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-staging.additions; else rm -f "$EDGE_DIR"/sites/shop-staging.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop-staging/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f.previous "$EDGE_DIR"/tls/shop-staging/$f; else rm -f "$EDGE_DIR"/tls/shop-staging/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-staging.conf
            rm -rf "$EDGE_DIR"/tls/shop-staging
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/environments/staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://staging-shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-staging
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop-staging." ;;
          esac
          exit 1

  prune:
    name: Delete old images
    needs: [build, deploy]
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: write
    steps:
      - name: Keep the newest 10 images and delete older ones
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
          KEEP: "10"
        run: |
          // OpsCrew image retention (opscrew/environments/staging/plan.yaml, cicd.imageRetention): deletes old versions of
          // this repository's image from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions: [{ id, digest, tags, created }], as the GitHub API lists them.
           * children: by digest, the digests an image index lists (its platform manifests and attestations).
           * keep: how many <commit>-staging versions to keep, newest first; undefined (retention off) deletes only
           * the build-<commit>-staging intermediates and what only they list.
           * protect: digests never deleted: the running and the previous image.
           * recent: a time (milliseconds since 1970): an untagged version created since then stays unless
           * a version deleted here lists it, since another environment's build may be pushing it right now.
           * environments: the names of the app's environments (prod and each one beside it).
           *
           * Kept: the protected digests, every version the label tags of one of the environments mark
           * (opscrew-<env>, the image it runs, and opscrew-<env>-previous, the one before), the newest keep
           * <commit>-staging versions, versions with a tag this environment's builds did not push and that is no
           * other opscrew-* tag (yours, Buildpacks' caches, another environment's images), signatures of
           * kept images, and whatever a kept index lists, tagged or not. Deleted: build-<commit>-staging
           * intermediates, older <commit>-staging versions with their signatures, and untagged versions
           * nothing kept lists, once they are older than recent.
           */
          function prunable(versions, children, keep, protect, recent, environments) {
            const commit = (tag) => /^[0-9a-f]{40}-staging$/.test(tag);
            const build = (tag) => /^build-[0-9a-f]{40}-staging$/.test(tag);
            const labels = new Set(environments.flatMap((env) => ["opscrew-" + env, "opscrew-" + env + "-previous"]));
            const label = (tag) => labels.has(tag);
            // An opscrew-* tag that labels none of the environments (one removed since, a stray one).
            const strayLabel = (tag) => /^opscrew-[a-z][a-z0-9-]*$/.test(tag) && !label(tag);
            const subject = (tag) => {
              const match = /^sha256-([0-9a-f]{64})(\\.[a-z]+)?$/.exec(tag);
              return match ? "sha256:" + match[1] : undefined;
            };
            const ours = (tag) => commit(tag) || build(tag) || subject(tag) !== undefined || strayLabel(tag);
            const listed = (digests) => new Set([...digests].flatMap((digest) => children[digest] || []));

            const kept = new Set(protect);
            for (const v of versions) if (v.tags.some(label)) kept.add(v.digest);
            if (keep === undefined) {
              for (const v of versions) if (!v.tags.every(build)) kept.add(v.digest);
            } else {
              const deployed = versions
                .filter((v) => v.tags.some(commit))
                .sort((a, b) => b.created.localeCompare(a.created) || b.id - a.id);
              for (const v of deployed.slice(0, keep)) kept.add(v.digest);
              for (const v of versions) if (!v.tags.every(ours)) kept.add(v.digest);
              for (const v of versions) if (v.tags.some((tag) => kept.has(subject(tag)))) kept.add(v.digest);
            }

            // Everything a kept version lists, and what that lists in turn, stays.
            const reachable = new Set(kept);
            const queue = [...kept];
            while (queue.length > 0) {
              for (const digest of children[queue.pop()] || []) {
                if (!reachable.has(digest)) {
                  reachable.add(digest);
                  queue.push(digest);
                }
              }
            }
            const goes = (v) => !reachable.has(v.digest);
            const listedByDeleted = listed(versions.filter((v) => v.tags.length > 0 && goes(v)).map((v) => v.digest));
            // Another environment's build pushes its platform manifests and attestations untagged, moments
            // before the index that lists them: until then nothing lists them, so a recent one stays.
            const old = (v) => Date.parse(v.created) < recent;
            return versions
              .filter((v) => goes(v) && (v.tags.length > 0 || listedByDeleted.has(v.digest) || (keep !== undefined && old(v))))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const digestOf = (ref) => (digestRef.test(ref) ? ref.split("@")[1] : undefined);
            const running = digestOf(process.env.IMAGE || "");
            const previous = process.env.PREVIOUS ? digestOf(process.env.PREVIOUS) : null;
            if (running === undefined || previous === undefined) {
              fail("OpsCrew could not tell which images the server runs, so it deleted none. The deploy itself succeeded.");
              return;
            }
            const protect = previous === null ? [running] : [running, previous];
            const keep = process.env.KEEP ? Number(process.env.KEEP) : undefined;
            // Untagged versions younger than 30 minutes stay: another environment may be pushing them.
            const recent = Date.now() - 30 * 60 * 1000;
            const [owner, name] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) {
                throw Object.assign(new Error(what + " answered HTTP " + response.status), { status: response.status });
              }
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });

            let deleting = false;
            try {
              // The app's environments: each has its OpsCrew deploy workflow, named "OpsCrew deploy" (prod)
              // or "OpsCrew deploy (<env>)".
              const environments = [];
              for (let page = 1; ; page++) {
                const batch = await read(
                  await github("GET", "/repos/" + owner + "/" + name + "/actions/workflows?per_page=100&page=" + page),
                  "The GitHub workflows API",
                );
                for (const w of batch.workflows) {
                  const match = /^OpsCrew deploy(?: \\(([a-z][a-z0-9-]*)\\))?$/.exec(w.name);
                  if (match && w.state !== "deleted") environments.push(match[1] || "prod");
                }
                if (batch.workflows.length < 100) break;
              }
              // None found means the workflows were renamed: no environment's labels could be kept.
              if (environments.length === 0) {
                fail(
                  'OpsCrew found no workflow named "OpsCrew deploy" in this repository, so it cannot tell which images the environments run, and it deleted none. The deploy itself succeeded; run "opscrew provision" to write the deploy workflow again.',
                );
                return;
              }
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              const base =
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions";
              // The package's versions, and what each tagged or protected one lists.
              const survey = async () => {
                const versions = [];
                for (let page = 1; ; page++) {
                  const batch = await read(await github("GET", base + "?per_page=100&page=" + page), "The GitHub packages API");
                  for (const v of batch) {
                    versions.push({ id: v.id, digest: v.name, tags: v.metadata.container.tags, created: v.created_at });
                  }
                  if (batch.length < 100) break;
                }
                const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
                const scope = "repository:" + owner + "/" + name + ":pull";
                const login = await read(
                  await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                  "GitHub Container Registry",
                );
                const children = {};
                const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
                for (const digest of new Set([...protect, ...tagged])) {
                  const manifest = await read(
                    await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                      headers: {
                        Authorization: "Bearer " + login.token,
                        Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                      },
                    }),
                    "GitHub Container Registry",
                  );
                  children[digest] = (manifest.manifests || []).map((m) => m.digest);
                }
                return { versions, children };
              };
              // Another environment's deploy may delete versions while this one reads them (one merge runs
              // several environments' workflows): the registry then answers 404 for a version the list still
              // has. Read it all again; a 404 that stays still stops, so nothing is deleted on a guess.
              let versions = [];
              let children = {};
              for (let attempt = 1; ; attempt++) {
                try {
                  ({ versions, children } = await survey());
                  break;
                } catch (error) {
                  if (error.status !== 404 || attempt === 3) throw error;
                  console.log("A version went while OpsCrew read the package (HTTP 404); reading it again in 20 s.");
                  await new Promise((resolve) => setTimeout(resolve, 20000));
                }
              }

              const ids = new Set(prunable(versions, children, keep, protect, recent, environments));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + ".");
              deleting = true;
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else if (response.status === 404) {
                  // Another environment's deploy deleted it first.
                  console.log("Already deleted: " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              if (failed > 0) {
                fail(failed + " image versions were not deleted; the next deploy tries again. The deploy itself succeeded.");
              }
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting old images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The deploy itself succeeded; the next deploy tries again.",
              );
            }
          }
          main();

  label:
    name: Label the deployed image
    needs: [build, deploy]
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-staging, and the one before it opscrew-staging-previous
        env:
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-staging" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-staging\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-staging-previous" "$PREVIOUS"
          fi
"
`;

exports[`a workflow per environment > matches the snapshots of staging following main and prod promoted from it 2`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# \`opscrew promote --to prod\` starts this workflow with the digest of an image the staging
# environment runs. It checks that a push to main in this repository built that image, then
# deploys it to your server over SSH, without building. Secrets are set by \`opscrew provision\`;
# their values never appear in this file.
name: OpsCrew deploy

on:
  workflow_dispatch:
    inputs:
      digest:
        description: The image to deploy, by its digest (sha256:…); \`opscrew promote\` fills it in.
        required: true
        type: string
      tag:
        description: The image's commit tag (<commit>, or <commit>-<env> when another environment than prod built it); \`opscrew promote\` fills it in.
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  verify:
    name: Check where the image was built
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: read
    outputs:
      image: \${{ steps.provenance.outputs.image }}
      tag: \${{ steps.provenance.outputs.tag }}
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: provenance
        name: Check the image's provenance
        env:
          DIGEST: \${{ inputs.digest }}
          TAG: \${{ inputs.tag }}
          BUILD_BRANCH: "main"
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The digest input is not an image digest (sha256: and 64 hexadecimal digits). Start this workflow with \\\`opscrew promote\\\`, which fills it in."
            exit 1
          fi
          name="ghcr.io/\${GITHUB_REPOSITORY,,}"
          image="$name@$DIGEST"
          if ! provenance="$(docker buildx imagetools inspect "$image" --format '{{json .Provenance}}')"; then
            echo "::error::GitHub Container Registry has no image $image. Promote an image another environment runs: \\\`opscrew promote\\\` reads it from that environment's label."
            exit 1
          fi
          # buildx names the run that built the image in runDetails.builder.id (per platform).
          mapfile -t runs < <(jq -r '.. | .runDetails?.builder?.id? // empty' <<< "$provenance" | sort -u)
          if [[ "\${#runs[@]}" -ne 1 || ! "\${runs[0]}" =~ ^https://github\\.com/([^/]+/[^/]+)/actions/runs/([0-9]+)/attempts/[0-9]+$ ]]; then
            echo "::error::The image's build provenance does not name one GitHub Actions run, so OpsCrew cannot tell where it was built. Promote only an image this repository's deploy workflow built."
            exit 1
          fi
          built_in="\${BASH_REMATCH[1]}"
          run_id="\${BASH_REMATCH[2]}"
          if [[ "\${built_in,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built by a run of $built_in, not of this repository ($GITHUB_REPOSITORY). OpsCrew promotes only images this repository built."
            exit 1
          fi
          if ! record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" --jq '"\\(.event) \\(.head_repository.full_name) \\(.head_branch) \\(.head_sha) \\(.path)"')"; then
            echo "::error::GitHub shows no run $run_id in this repository, which the image's provenance names as its build. OpsCrew promotes only images this repository built."
            exit 1
          fi
          read -r event head_repo branch commit workflow <<< "$record"
          # The run's path can end with @<ref>, which the signing identity carries separately.
          workflow="\${workflow%%@*}"
          # A fork's pull request runs in this repository too, with its own branch name: only a push counts.
          if [[ "$event" != "push" ]]; then
            echo "::error::The image was built by a $event run, not by a push. OpsCrew promotes only images a push to $BUILD_BRANCH built."
            exit 1
          fi
          if [[ "\${head_repo,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built from the commits of $head_repo, not of this repository ($GITHUB_REPOSITORY). OpsCrew promotes only images this repository built."
            exit 1
          fi
          if [[ "$branch" != "$BUILD_BRANCH" ]]; then
            echo "::error::The image was built from the branch $branch, not from $BUILD_BRANCH, the branch whose pushes build the images this environment is promoted with. OpsCrew promotes only images a push to $BUILD_BRANCH built."
            exit 1
          fi
          # prod's build tags its commit, another environment's <commit>-<env>.
          if [[ "$TAG" != "$commit" && ! "$TAG" =~ ^$commit-[a-z][a-z0-9-]*$ ]]; then
            echo "::error::The tag input is not a commit tag of the image's build ($commit, or $commit-<environment>). Start this workflow with \\\`opscrew promote\\\`, which fills it in."
            exit 1
          fi
          if [[ "$(docker buildx imagetools inspect "$name:$TAG" --format '{{.Manifest.Digest}}')" != "$DIGEST" ]]; then
            echo "::error::The image is not the one tagged with its build's commit ($TAG): a later build of that commit replaced the tag, or the image was pushed another way. Promote the image another environment runs."
            exit 1
          fi
          {
            echo "image=$image"
            echo "tag=$name:$TAG"
            echo "identity=https://github.com/$GITHUB_REPOSITORY/$workflow@refs/heads/$branch"
          } >> "$GITHUB_OUTPUT"
          echo "Deploying \\\`$image\\\`, built by run $run_id from \\\`$commit\\\` on \\\`$branch\\\`." >> "$GITHUB_STEP_SUMMARY"

  deploy:
    name: Deploy to the server
    needs: verify
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/runtime/edge/sites/shop.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/runtime/edge/sites/shop.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop'
          scp -r "\${ssh_opts[@]}" opscrew/runtime/compose.yaml opscrew/runtime/edge "deploy@\${HOST}:/srv/apps/shop/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop/db.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.verify.outputs.image }}
          TAG: \${{ needs.verify.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop/$f ]; then mv -f "$EDGE_DIR"/tls/shop/$f "$EDGE_DIR"/tls/shop/$f.previous; else rm -f "$EDGE_DIR"/tls/shop/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop.caddy ]; then cp "$EDGE_DIR"/sites/shop.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop.additions ]; then cp "$EDGE_DIR"/sites/shop.additions .additions.previous; fi
            cp edge/sites/shop.caddy "$EDGE_DIR"/sites/shop.caddy
            rm -f "$EDGE_DIR"/sites/shop.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop.caddy; else rm -f "$EDGE_DIR"/sites/shop.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop.additions; else rm -f "$EDGE_DIR"/sites/shop.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop/$f.previous "$EDGE_DIR"/tls/shop/$f; else rm -f "$EDGE_DIR"/tls/shop/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/runtime/edge/sites/shop.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop.conf
            rm -rf "$EDGE_DIR"/tls/shop
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_HOST }}
          IMAGE: \${{ needs.verify.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop --target "\${name#/}:3000" --host shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop." ;;
          esac
          exit 1

  label:
    name: Label the deployed image
    needs: [verify, deploy]
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-prod, and the one before it opscrew-prod-previous
        env:
          IMAGE: \${{ needs.verify.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-prod" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-prod\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-prod-previous" "$PREVIOUS"
          fi
"
`;

exports[`the deploy job > reads OPSCREW_<ENV>_* repository secrets with prefixed secrets, and today's names for prod 1`] = `
"  deploy:
    name: Deploy to the server
    needs: build
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/eu-staging/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/eu-staging/runtime/edge/sites/shop-eu-staging.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-eu-staging.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/eu-staging/runtime/edge/sites/shop-eu-staging.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env eu-staging renders the site again), then push again.'
            exit 1
          fi
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_EU_STAGING_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_EU_STAGING_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Upload runtime files and environment
        env:
          HOST: \${{ secrets.OPSCREW_EU_STAGING_HOST }}
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_EU_STAGING_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_EU_STAGING_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'mkdir -p /srv/apps/shop-eu-staging'
          scp -r "\${ssh_opts[@]}" opscrew/environments/eu-staging/runtime/compose.yaml opscrew/environments/eu-staging/runtime/edge "deploy@\${HOST}:/srv/apps/shop-eu-staging/"
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-eu-staging/app.env'
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'umask 077 && cat > /srv/apps/shop-eu-staging/db.env'
      - id: start
        name: Start the new version
        env:
          HOST: \${{ secrets.OPSCREW_EU_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          previous="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" 'cd /srv/apps/shop-eu-staging && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi')"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "DOCKER_CONFIG=/srv/apps/shop-eu-staging/.docker docker login ghcr.io -u '\${GITHUB_ACTOR}' --password-stdin"
          ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-eu-staging/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-eu-staging
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/eu-staging/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop-eu-staging/$f ]; then mv -f "$EDGE_DIR"/tls/shop-eu-staging/$f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-eu-staging.caddy ]; then cp "$EDGE_DIR"/sites/shop-eu-staging.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-eu-staging.additions ]; then cp "$EDGE_DIR"/sites/shop-eu-staging.additions .additions.previous; fi
            cp edge/sites/shop-eu-staging.caddy "$EDGE_DIR"/sites/shop-eu-staging.caddy
            rm -f "$EDGE_DIR"/sites/shop-eu-staging.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-eu-staging.caddy; else rm -f "$EDGE_DIR"/sites/shop-eu-staging.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-eu-staging.additions; else rm -f "$EDGE_DIR"/sites/shop-eu-staging.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-eu-staging/$f.previous "$EDGE_DIR"/tls/shop-eu-staging/$f; else rm -f "$EDGE_DIR"/tls/shop-eu-staging/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/eu-staging/runtime/edge/sites/shop-eu-staging.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-eu-staging.conf
            rm -rf "$EDGE_DIR"/tls/shop-eu-staging
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop-eu-staging --target "\${name#/}:3000" --host eu-staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/environments/eu-staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://eu-staging-shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          HOST: \${{ secrets.OPSCREW_EU_STAGING_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-eu-staging
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-eu-staging --target "\${name#/}:3000" --host eu-staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Connect to the server and run \\\`docker compose ps\\\` in /srv/apps/shop-eu-staging." ;;
          esac
          exit 1"
`;

exports[`the deploy job on a self-hosted runner > deploys on the runner's own machine: no SSH, no host, key or known hosts 1`] = `
"  deploy:
    name: Deploy to the server
    needs: build
    runs-on: [self-hosted, opscrew-shop-staging]
    defaults:
      run:
        shell: bash
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/staging/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-staging.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env staging renders the site again), then push again.'
            exit 1
          fi
      - name: Copy the runtime files and environment into the app's folder
        env:
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_STAGING_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_STAGING_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          dir=/srv/apps/shop-staging
          mkdir -p "$dir"
          cp -r opscrew/environments/staging/runtime/compose.yaml opscrew/environments/staging/runtime/edge "$dir"/
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | (umask 077 && cat > "$dir"/app.env)
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | (umask 077 && cat > "$dir"/db.env)
      - id: start
        name: Start the new version
        env:
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          dir=/srv/apps/shop-staging
          previous="$(cd "$dir" && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi)"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          printf '%s\\n' "$REGISTRY_TOKEN" | DOCKER_CONFIG="$dir"/.docker docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
          unset REGISTRY_TOKEN
          sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-staging/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-staging
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            flock 9
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/staging/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in origin.pem origin.key pull.pem; do
              if [ -f "$EDGE_DIR"/tls/shop-staging/$f ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f "$EDGE_DIR"/tls/shop-staging/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-staging/$f.previous; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-staging.caddy ]; then cp "$EDGE_DIR"/sites/shop-staging.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-staging.additions ]; then cp "$EDGE_DIR"/sites/shop-staging.additions .additions.previous; fi
            cp edge/sites/shop-staging.caddy "$EDGE_DIR"/sites/shop-staging.caddy
            rm -f "$EDGE_DIR"/sites/shop-staging.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-staging.caddy; else rm -f "$EDGE_DIR"/sites/shop-staging.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-staging.additions; else rm -f "$EDGE_DIR"/sites/shop-staging.additions; fi
              for f in origin.pem origin.key pull.pem; do
                if [ -f "$EDGE_DIR"/tls/shop-staging/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-staging/$f.previous "$EDGE_DIR"/tls/shop-staging/$f; else rm -f "$EDGE_DIR"/tls/shop-staging/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/staging/runtime/edge/sites/shop-staging.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-staging.conf
            rm -rf "$EDGE_DIR"/tls/shop-staging
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/environments/staging/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://staging-shop.example.com/api/health
        run: |
          set -euo pipefail
          tls_only=1
          for attempt in $(seq 1 30); do
            code=0
            status="$(curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' "$URL")" || code=$?
            if [ "$code" -eq 0 ]; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            case "$code:$status" in 35:* | 60:* | 22:525 | 22:526) ;; *) tls_only=0 ;; esac
            sleep 6
          done
          if [ "$tls_only" -eq 1 ]; then
            echo "::error::The new version did not answer at $URL: every attempt failed the TLS handshake, so the server has no certificate for this domain yet. Let's Encrypt issues at most 5 certificates per week for the same set of names, so a server rebuilt many times can reach that limit. Wait (one more becomes available about every 34 hours) or use another hostname, then deploy again."
          else
            echo "::error::The new version did not answer at $URL."
          fi
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          dir=/srv/apps/shop-staging
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-staging
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-staging --target "\${name#/}:3000" --host staging-shop.example.com --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Run \\\`docker compose ps\\\` in $dir, on the machine this runner runs on." ;;
          esac
          exit 1"
`;

exports[`the deploy job on a self-hosted runner > deploys on the runner's own machine: no SSH, no host, key or known hosts 2`] = `
"  deploy:
    name: Deploy to the server
    needs: build
    runs-on: [self-hosted, opscrew-shop-dev]
    defaults:
      run:
        shell: bash
    permissions:
      contents: read
      packages: read
    outputs:
      previous: \${{ steps.start.outputs.previous }}
    steps:
      - name: Use this computer's Docker daemon
        run: |
          set -euo pipefail
          docker_host="$(docker context inspect --format '{{.Endpoints.docker.Host}}')"
          echo "DOCKER_HOST=$docker_host" >> "$GITHUB_ENV"
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - name: Validate the edge's configuration with Caddy
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/sites
          cp opscrew/environments/dev/runtime/edge/compose.yaml "$RUNNER_TEMP/opscrew-edge"/compose.yaml
          if [[ -z "\${OPSCREW_EDGE_DIR:-}" || ! -f "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.pem || ! -f "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.key ]]; then
            echo '::error::This runner finds no leaf certificate for the app in this computer'\\''s edge (tls/shop-dev/local.pem and local.key in OPSCREW_EDGE_DIR). Run \`opscrew provision --env dev\`, which issues it, and start the runner with \`opscrew runner start --env dev\`, which sets OPSCREW_EDGE_DIR; then run the workflow again.'
            exit 1
          fi
          mkdir -p "$RUNNER_TEMP/opscrew-edge"/tls/shop-dev
          cp "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.pem "$OPSCREW_EDGE_DIR"/tls/shop-dev/local.key "$RUNNER_TEMP/opscrew-edge"/tls/shop-dev/
          remove_check_volumes() {
            for volume in $(docker volume ls -q --filter label=com.docker.compose.project=opscrew-edge-check); do
              docker volume rm "$volume" > /dev/null 2>&1 || true
            done
          }
          trap remove_check_volumes EXIT
          docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
          cp opscrew/environments/dev/runtime/edge/sites/shop-dev.caddy "$RUNNER_TEMP/opscrew-edge"/sites/shop-dev.caddy
          if ! docker compose -p opscrew-edge-check -f "$RUNNER_TEMP/opscrew-edge"/compose.yaml run --rm --no-deps -T caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
            echo '::error::Caddy refused this app'\\''s edge configuration (opscrew/environments/dev/runtime/edge/sites/shop-dev.caddy) for the reason above. Nothing was sent to the server, which keeps serving the previous version: fix the cause (opscrew provision --env dev renders the site again), then push again.'
            exit 1
          fi
      - name: Copy the runtime files and environment into the app's folder
        env:
          OPSCREW_APP_ENV: \${{ secrets.OPSCREW_DEV_APP_ENV }}
          OPSCREW_SERVICE_DB_ENV: \${{ secrets.OPSCREW_DEV_SERVICE_DB_ENV }}
        run: |
          set -euo pipefail
          if [[ -z "\${OPSCREW_APPS_DIR:-}" || -z "\${OPSCREW_EDGE_DIR:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_APPS_DIR and OPSCREW_EDGE_DIR, the folders of this computer's stack. Start it with \\\`opscrew runner start --env dev\\\`, which sets them."
            exit 1
          fi
          dir="$OPSCREW_APPS_DIR/shop-dev"
          mkdir -p "$dir"
          cp -r opscrew/environments/dev/runtime/compose.yaml opscrew/environments/dev/runtime/edge "$dir"/
          printf '%s\\n' "\${OPSCREW_APP_ENV:-}" | (umask 077 && cat > "$dir"/app.env)
          printf '%s\\n' "\${OPSCREW_SERVICE_DB_ENV:-}" | (umask 077 && cat > "$dir"/db.env)
      - id: start
        name: Start the new version
        env:
          IMAGE: \${{ needs.build.outputs.image }}
          TAG: \${{ needs.build.outputs.tag }}
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          echo "Deploying \${TAG:-the new image} as $IMAGE"
          if [[ -z "\${OPSCREW_LOCAL_LOCK:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_LOCAL_LOCK, OpsCrew's deploy lock on this computer. Start it with \\\`opscrew runner start --env dev\\\`, which sets it."
            exit 1
          fi
          mkdir -p "$(dirname "$OPSCREW_LOCAL_LOCK")"
          holder=$$
          if [[ -r /proc/$$/winpid ]]; then holder="$(cat /proc/$$/winpid)"; fi
          for attempt in $(seq 1 300); do
            if (set -o noclobber; echo "$holder" > "$OPSCREW_LOCAL_LOCK") 2> /dev/null; then break; fi
            if [[ "$attempt" -eq 300 ]]; then
              echo "::error::Another OpsCrew deploy on this computer has held the local stack for over 10 minutes, so this one did not start. If no other OpsCrew command runs, delete $OPSCREW_LOCAL_LOCK, then run the deploy again."
              exit 1
            fi
            sleep 2
          done
          trap 'rm -f "$OPSCREW_LOCAL_LOCK"' EXIT
          dir="$OPSCREW_APPS_DIR/shop-dev"
          previous="$(cd "$dir" && rm -f .env.previous && if [ -f .env ]; then cp .env .env.previous && sed -n "s/^APP_IMAGE=//p" .env; fi)"
          if [[ "$previous" == opscrew-local/* ]]; then previous=; fi
          if [[ -n "$previous" && ! "$previous" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then previous=unknown; fi
          echo "previous=$previous" >> "$GITHUB_OUTPUT"
          if [[ ! -f "$dir"/.docker/config.json ]]; then
            mkdir -p "$dir"/.docker
            printf '{"auths":{"ghcr.io":{}}}\\n' > "$dir"/.docker/config.json
          fi
          printf '%s\\n' "$REGISTRY_TOKEN" | DOCKER_CONFIG="$dir"/.docker docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
          unset REGISTRY_TOKEN
          sh -s -- "$IMAGE" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          export DOCKER_CONFIG="$APPS_DIR"/shop-dev/.docker
          trap 'docker logout ghcr.io > /dev/null 2>&1' EXIT
          cd "$APPS_DIR"/shop-dev
          export APP_IMAGE="$1"
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          docker compose pull
          mkdir -p "$EDGE_DIR"/sites "$EDGE_DIR"/tls
          (
            if command -v flock > /dev/null 2>&1; then flock 9; fi
            docker network inspect opscrew-edge > /dev/null 2>&1 || docker network create opscrew-edge > /dev/null
            uploaded="$(sed -n 's/^x-opscrew-edge-version: //p' edge/compose.yaml)"
            current="$(sed -n 's/^x-opscrew-edge-version: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            proxy="$(sed -n 's/^x-opscrew-edge-proxy: //p' "$EDGE_DIR"/compose.yaml 2> /dev/null || true)"
            rm -f .edge.previous
            if [ -n "$proxy" ] && [ "$proxy" != caddy ]; then
              echo '::notice::OpsCrew switches this server'\\''s proxy from nginx to Caddy (target.edge in opscrew/environments/dev/plan.yaml). kamal-proxy and the apps keep running; the sites stop for a few seconds while Caddy starts, and hostnames not proxied by Cloudflare have no HTTPS for under a minute while Caddy gets their certificates.'
              cp "$EDGE_DIR"/compose.yaml .edge.previous
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
            elif [ "$uploaded" -gt "\${current:-0}" ]; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server is now version $uploaded."
            elif [ "$uploaded" -eq "\${current:-0}" ] && ! cmp -s edge/compose.yaml "$EDGE_DIR"/compose.yaml; then
              cp edge/compose.yaml "$EDGE_DIR"/compose.yaml
              echo "OpsCrew's shared edge on this server now has this app's settings (its ports, and the Cloudflare addresses it trusts)."
            elif [ "$uploaded" -lt "\${current:-0}" ]; then
              echo "The server's shared edge (version $current) is newer than this app's ($uploaded), so it stays."
            fi
            for f in local.pem local.key; do
              if [ -f "$EDGE_DIR"/tls/shop-dev/$f ]; then cp "$EDGE_DIR"/tls/shop-dev/$f "$EDGE_DIR"/tls/shop-dev/$f.previous; else rm -f "$EDGE_DIR"/tls/shop-dev/$f.previous; fi
              if [ -f "$EDGE_DIR"/tls/shop-dev/$f.new ]; then mv -f "$EDGE_DIR"/tls/shop-dev/$f.new "$EDGE_DIR"/tls/shop-dev/$f; fi
            done
            rm -f .site.previous .additions.previous
            if [ -f "$EDGE_DIR"/sites/shop-dev.caddy ]; then cp "$EDGE_DIR"/sites/shop-dev.caddy .site.previous; fi
            if [ -f "$EDGE_DIR"/sites/shop-dev.additions ]; then cp "$EDGE_DIR"/sites/shop-dev.additions .additions.previous; fi
            cp edge/sites/shop-dev.caddy "$EDGE_DIR"/sites/shop-dev.caddy
            rm -f "$EDGE_DIR"/sites/shop-dev.additions
            if ! edge up -d --wait --remove-orphans || ! edge exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile < /dev/null; then
              if [ -f .site.previous ]; then cp .site.previous "$EDGE_DIR"/sites/shop-dev.caddy; else rm -f "$EDGE_DIR"/sites/shop-dev.caddy; fi
              if [ -f .additions.previous ]; then cp .additions.previous "$EDGE_DIR"/sites/shop-dev.additions; else rm -f "$EDGE_DIR"/sites/shop-dev.additions; fi
              for f in local.pem local.key; do
                if [ -f "$EDGE_DIR"/tls/shop-dev/$f.previous ]; then mv -f "$EDGE_DIR"/tls/shop-dev/$f.previous "$EDGE_DIR"/tls/shop-dev/$f; else rm -f "$EDGE_DIR"/tls/shop-dev/$f; fi
              done
              if [ -f .edge.previous ]; then
                cp .edge.previous "$EDGE_DIR"/compose.yaml
                edge up -d --wait --remove-orphans || true
                echo '::error::The switch to Caddy did not work, so the server keeps nginx as its proxy.'
              fi
              echo '::error::OpsCrew'\\''s shared edge on the server (Caddy and kamal-proxy, in '"$EDGE_DIR"') did not start or did not accept this app'\\''s site (opscrew/environments/dev/runtime/edge/sites/shop-dev.caddy), so the new version was not started, the previous version keeps serving and Caddy keeps the site it had. The error is above: fix its cause (for example a port another program uses, or a hostname another app on the server serves) and push again.'
              exit 1
            fi
            rm -f "$EDGE_DIR"/sites/shop-dev.conf
            rm -f "$EDGE_DIR"/tls/shop-dev/local.pem.previous "$EDGE_DIR"/tls/shop-dev/local.key.previous
          ) 9> "$EDGE_DIR"/.lock
          docker compose up -d --no-deps --wait db
          old="$(docker compose ps -aq app | tr '\\n' ' ')"
          docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
          new=""
          for id in $(docker compose ps -aq app); do
            case " $old " in *" $id "*) ;; *) new="$id" ;; esac
          done
          name="$(docker inspect --format '{{.Name}}' "$new")"
          if ! edge exec -T kamal-proxy kamal-proxy deploy shop-dev --target "\${name#/}:3000" --host shop.localhost --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
            docker rm -f "$new" > /dev/null
            echo '::error::The new version did not pass its health check (GET /api/health on port 3000) within 60 seconds, so OpsCrew removed it. It received no traffic: the previous version keeps serving. Check that the app listens on port 3000 (app.port in opscrew/environments/dev/plan.yaml, passed to the app as PORT) and answers /api/health. It was built from Dockerfile; to let OpsCrew choose a builder, run opscrew design, opscrew adapt and opscrew provision.'
            exit 1
          fi
          printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
          for id in $old; do
            docker stop "$id" > /dev/null
            docker rm "$id" > /dev/null
          done
          REMOTE
      - id: health
        name: Check that the app is healthy
        env:
          URL: https://shop.localhost:8443/api/health
        run: |
          set -euo pipefail
          if [[ -z "\${OPSCREW_LOCAL_CA_FILE:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_LOCAL_CA_FILE, the certificate of OpsCrew's local CA that the app's HTTPS is checked with. Start it with \\\`opscrew runner start --env dev\\\`, which sets it."
            exit 1
          fi
          for attempt in $(seq 1 30); do
            if curl -fsS --max-time 10 --resolve shop.localhost:8443:127.0.0.1 --cacert "$OPSCREW_LOCAL_CA_FILE" --ssl-no-revoke "$URL" > /dev/null; then
              echo "Healthy after $attempt attempt(s)."
              exit 0
            fi
            sleep 6
          done
          echo "::error::The new version did not answer at $URL."
          exit 1
      - name: Roll back to the previous version
        if: failure() && (steps.start.outcome == 'failure' || steps.health.outcome == 'failure')
        env:
          IMAGE: \${{ needs.build.outputs.image }}
        run: |
          set -uo pipefail
          if [[ -z "\${OPSCREW_LOCAL_LOCK:-}" ]]; then
            echo "::error::This runner does not set OPSCREW_LOCAL_LOCK, OpsCrew's deploy lock on this computer. Start it with \\\`opscrew runner start --env dev\\\`, which sets it."
            exit 1
          fi
          mkdir -p "$(dirname "$OPSCREW_LOCAL_LOCK")"
          holder=$$
          if [[ -r /proc/$$/winpid ]]; then holder="$(cat /proc/$$/winpid)"; fi
          for attempt in $(seq 1 300); do
            if (set -o noclobber; echo "$holder" > "$OPSCREW_LOCAL_LOCK") 2> /dev/null; then break; fi
            if [[ "$attempt" -eq 300 ]]; then
              echo "::error::Another OpsCrew deploy on this computer has held the local stack for over 10 minutes, so this one did not start. If no other OpsCrew command runs, delete $OPSCREW_LOCAL_LOCK, then run the deploy again."
              exit 1
            fi
            sleep 2
          done
          trap 'rm -f "$OPSCREW_LOCAL_LOCK"' EXIT
          dir="$OPSCREW_APPS_DIR/shop-dev"
          cat > "$RUNNER_TEMP/rollback.sh" <<'REMOTE'
          APPS_DIR="\${OPSCREW_APPS_DIR:-/srv/apps}"
          EDGE_DIR="\${OPSCREW_EDGE_DIR:-/srv/edge}"
          set -eu
          cd "$APPS_DIR"/shop-dev
          edge() { docker compose -p opscrew-edge -f "$EDGE_DIR"/compose.yaml "$@"; }
          if ! grep -qxF "APP_IMAGE=$1" .env 2> /dev/null; then echo unchanged; exit 0; fi
          if [ ! -f .env.previous ] || cmp -s .env .env.previous; then echo no-previous; exit 0; fi
          APP_IMAGE="$(sed -n 's/^APP_IMAGE=//p' .env.previous)"
          export APP_IMAGE
          {
            old="$(docker compose ps -aq app | tr '\\n' ' ')"
            docker compose up -d --no-deps --no-recreate --remove-orphans --scale "app=$(( $(echo $old | wc -w) + 1 ))" app
            new=""
            for id in $(docker compose ps -aq app); do
              case " $old " in *" $id "*) ;; *) new="$id" ;; esac
            done
            name="$(docker inspect --format '{{.Name}}' "$new")"
            if ! edge exec -T kamal-proxy kamal-proxy deploy shop-dev --target "\${name#/}:3000" --host shop.localhost --health-check-path '/api/health' --deploy-timeout 60s --drain-timeout 30s --target-timeout 300s < /dev/null; then
              docker rm -f "$new" > /dev/null
              echo '::error::The previous version did not pass its health check either.'
              exit 1
            fi
            printf 'APP_IMAGE=%s\\n' "$APP_IMAGE" > .env
            for id in $old; do
              docker stop "$id" > /dev/null
              docker rm "$id" > /dev/null
            done
          } >&2
          rm -f .env.previous .processes.previous
          echo restored
          REMOTE
          outcome=unchanged
          if [[ "\${IMAGE:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            outcome="$(sh -s -- "$IMAGE" < "$RUNNER_TEMP/rollback.sh")"
          fi
          case "$outcome" in
            restored)
              echo "::error::The deploy failed; OpsCrew restored the previous version." ;;
            unchanged)
              echo "::error::The deploy failed before the new version took traffic; the server still runs the version it had." ;;
            no-previous)
              echo "::error::The deploy failed and there is no earlier version to restore (first deploy, or the same image was already running). Fix the problem and push again." ;;
            *)
              echo "::error::The deploy failed and OpsCrew could not restore the previous version. Run \\\`docker compose ps\\\` in $dir, on the machine this runner runs on." ;;
          esac
          exit 1"
`;

exports[`the label job > runs after a healthy deploy, with only packages: write 1`] = `
"  label:
    name: Label the deployed image
    needs: [build, deploy]
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-staging, and the one before it opscrew-staging-previous
        env:
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-staging" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-staging\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-staging-previous" "$PREVIOUS"
          fi"
`;

exports[`the verify job > runs the provenance check with the job's token and the branch that builds the images 1`] = `
"  verify:
    name: Check where the image was built
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: read
    outputs:
      image: \${{ steps.provenance.outputs.image }}
      tag: \${{ steps.provenance.outputs.tag }}
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: provenance
        name: Check the image's provenance
        env:
          DIGEST: \${{ inputs.digest }}
          TAG: \${{ inputs.tag }}
          BUILD_BRANCH: "main"
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The digest input is not an image digest (sha256: and 64 hexadecimal digits). Start this workflow with \\\`opscrew promote\\\`, which fills it in."
            exit 1
          fi
          name="ghcr.io/\${GITHUB_REPOSITORY,,}"
          image="$name@$DIGEST"
          if ! provenance="$(docker buildx imagetools inspect "$image" --format '{{json .Provenance}}')"; then
            echo "::error::GitHub Container Registry has no image $image. Promote an image another environment runs: \\\`opscrew promote\\\` reads it from that environment's label."
            exit 1
          fi
          # buildx names the run that built the image in runDetails.builder.id (per platform).
          mapfile -t runs < <(jq -r '.. | .runDetails?.builder?.id? // empty' <<< "$provenance" | sort -u)
          if [[ "\${#runs[@]}" -ne 1 || ! "\${runs[0]}" =~ ^https://github\\.com/([^/]+/[^/]+)/actions/runs/([0-9]+)/attempts/[0-9]+$ ]]; then
            echo "::error::The image's build provenance does not name one GitHub Actions run, so OpsCrew cannot tell where it was built. Promote only an image this repository's deploy workflow built."
            exit 1
          fi
          built_in="\${BASH_REMATCH[1]}"
          run_id="\${BASH_REMATCH[2]}"
          if [[ "\${built_in,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built by a run of $built_in, not of this repository ($GITHUB_REPOSITORY). OpsCrew promotes only images this repository built."
            exit 1
          fi
          if ! record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" --jq '"\\(.event) \\(.head_repository.full_name) \\(.head_branch) \\(.head_sha) \\(.path)"')"; then
            echo "::error::GitHub shows no run $run_id in this repository, which the image's provenance names as its build. OpsCrew promotes only images this repository built."
            exit 1
          fi
          read -r event head_repo branch commit workflow <<< "$record"
          # The run's path can end with @<ref>, which the signing identity carries separately.
          workflow="\${workflow%%@*}"
          # A fork's pull request runs in this repository too, with its own branch name: only a push counts.
          if [[ "$event" != "push" ]]; then
            echo "::error::The image was built by a $event run, not by a push. OpsCrew promotes only images a push to $BUILD_BRANCH built."
            exit 1
          fi
          if [[ "\${head_repo,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built from the commits of $head_repo, not of this repository ($GITHUB_REPOSITORY). OpsCrew promotes only images this repository built."
            exit 1
          fi
          if [[ "$branch" != "$BUILD_BRANCH" ]]; then
            echo "::error::The image was built from the branch $branch, not from $BUILD_BRANCH, the branch whose pushes build the images this environment is promoted with. OpsCrew promotes only images a push to $BUILD_BRANCH built."
            exit 1
          fi
          # prod's build tags its commit, another environment's <commit>-<env>.
          if [[ "$TAG" != "$commit" && ! "$TAG" =~ ^$commit-[a-z][a-z0-9-]*$ ]]; then
            echo "::error::The tag input is not a commit tag of the image's build ($commit, or $commit-<environment>). Start this workflow with \\\`opscrew promote\\\`, which fills it in."
            exit 1
          fi
          if [[ "$(docker buildx imagetools inspect "$name:$TAG" --format '{{.Manifest.Digest}}')" != "$DIGEST" ]]; then
            echo "::error::The image is not the one tagged with its build's commit ($TAG): a later build of that commit replaced the tag, or the image was pushed another way. Promote the image another environment runs."
            exit 1
          fi
          {
            echo "image=$image"
            echo "tag=$name:$TAG"
            echo "identity=https://github.com/$GITHUB_REPOSITORY/$workflow@refs/heads/$branch"
          } >> "$GITHUB_OUTPUT"
          echo "Deploying \\\`$image\\\`, built by run $run_id from \\\`$commit\\\` on \\\`$branch\\\`." >> "$GITHUB_STEP_SUMMARY""
`;
