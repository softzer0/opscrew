// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderPreviewWorkflow > matches the snapshot 1`] = `
"# Generated by OpsCrew from opscrew/environments/preview/plan.yaml; \`opscrew provision --env preview\` regenerates it.
# Builds each pull request from a branch of this repository on GitHub's machines and asks the
# preview server to start, update or remove its preview at pr-<number>-<random>.example.net, a
# name the server draws. The server holds the recipe you approved and refuses anything outside it;
# the key this workflow has can do nothing else there. Secrets are set by \`opscrew provision\`;
# their values never appear here.
name: OpsCrew preview

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review, closed]
    # A pull request gets a preview only when it changes one of these paths, which the build reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - "Dockerfile"
      - ".github/workflows/opscrew-preview.yml"

permissions:
  contents: read

concurrency:
  group: opscrew-preview-\${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  skipped:
    name: Say why there is no preview
    if: \${{ !(github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'dependabot[bot]') && github.event.action != 'closed' }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why there is no preview
        run: |
          set -euo pipefail
          echo "No preview for this pull request: OpsCrew makes previews only of pull requests from branches of this repository, never from forks or Dependabot, whose runs get no secrets." >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the image
    if: \${{ github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'dependabot[bot]' && github.event.action != 'closed' && !github.event.pull_request.draft }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:pr-\${{ github.event.pull_request.number }}-\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_PREVIEW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_PREVIEW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:pr-\${{ github.event.pull_request.number }}-$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi

  deploy:
    name: Start or update the preview
    needs: build
    if: \${{ github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'dependabot[bot]' && github.event.action != 'closed' && !github.event.pull_request.draft }}
    runs-on: ubuntu-latest
    environment:
      name: preview
      url: \${{ steps.up.outputs.url }}
    permissions:
      contents: read
      packages: read
    outputs:
      state: \${{ steps.up.outputs.state }}
      detail: \${{ steps.up.outputs.detail }}
    steps:
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_PREVIEW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_PREVIEW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - id: up
        name: Ask the preview server to start or update the preview
        env:
          HOST: \${{ secrets.OPSCREW_PREVIEW_HOST }}
          IMAGE: \${{ needs.build.outputs.image }}
          NUMBER: \${{ github.event.pull_request.number }}
          COMMIT: \${{ github.event.pull_request.head.sha }}
          HEALTH_PATH: /api/health
          REGISTRY_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -uo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          code=0
          # The registry token goes on stdin, never in a command line; the server keeps it only while
          # up runs. The server's answer is read, never shown.
          out="$(printf '%s\\n' "$REGISTRY_TOKEN" | ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "up $NUMBER $IMAGE $COMMIT")" || code=$?
          unset REGISTRY_TOKEN
          state=error
          detail=
          last="\${out##*$'\\n'}"
          known='^(2 refused (request|number|image|commit|token|command)|6 busy [0-9]{1,6}|3 cap [0-9]{1,2}/[0-9]{1,2}|4 failed (pull|release|start|health|edge))$'
          if [[ "$code" -eq 255 ]]; then
            state=unreachable
          elif [[ "$last" == 'opscrew-preview: '* ]]; then
            answer="$code \${last#opscrew-preview: }"
            site='^(0 running|5 seed-failed) pr-'"$NUMBER"'-[a-z0-9]{10}\\.example\\.net$'
            if [[ "$answer" =~ $site || "$answer" =~ $known ]]; then
              answer="\${answer#* }"
              state="\${answer%% *}"
              detail="\${answer#* }"
            fi
          fi
          url=
          if [[ "$state" == running || "$state" == seed-failed ]]; then
            url="https://$detail"
            deadline=$((SECONDS + 180))
            until curl -fsS --max-time 10 -o /dev/null "$url$HEALTH_PATH"; do
              if (( SECONDS >= deadline )); then
                state=unanswered
                break
              fi
              sleep 6
            done
          fi
          echo "url=$url" >> "$GITHUB_OUTPUT"
          { echo "state=$state"; echo "detail=$detail"; } >> "$GITHUB_OUTPUT"
          echo "The preview server answered: $state $detail"
      - name: Stop unless the preview runs
        if: steps.up.outputs.state != 'running' && steps.up.outputs.state != 'seed-failed'
        env:
          STATE: \${{ steps.up.outputs.state }}
        run: |
          echo "::error::The preview did not start ($STATE); the pull request's comment says why."
          exit 1

  report:
    name: Report on the pull request
    needs: [build, deploy]
    if: \${{ !cancelled() && github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'dependabot[bot]' && github.event.action != 'closed' && !github.event.pull_request.draft }}
    runs-on: ubuntu-latest
    permissions:
      packages: write
      pull-requests: write
    steps:
      - name: Update the preview's comment
        env:
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          NUMBER: \${{ github.event.pull_request.number }}
          COMMIT: \${{ github.event.pull_request.head.sha }}
          STATE: \${{ needs.deploy.outputs.state || (needs.build.result == 'failure' && 'build-failed') || 'error' }}
          DETAIL: \${{ needs.deploy.outputs.detail }}
          RUN_URL: \${{ github.server_url }}/\${{ github.repository }}/actions/runs/\${{ github.run_id }}
        run: |
          set -euo pipefail
          address='^pr-'"$NUMBER"'-[a-z0-9]{10}\\.example\\.net$'
          site=""
          if [[ "$DETAIL" =~ $address ]]; then site="https://$DETAIL"; fi
          state="$STATE"
          if [[ -z "$site" && ( "$state" == running || "$state" == seed-failed || "$state" == unanswered ) ]]; then
            state=unknown
          fi
          commit="\${COMMIT:0:12}"
          [[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || commit=unknown
          case "$state" in
            running)
              text="The preview of this pull request runs at $site (commit \\\`$commit\\\`)." ;;
            seed-failed)
              text="The preview of this pull request runs at $site (commit \\\`$commit\\\`), but its seed command failed, so its data may be missing. The next push tries the seed again; \\\`opscrew preview logs $NUMBER --env preview\\\` shows why it failed." ;;
            refused)
              case "$DETAIL" in
                image) why="the image is not the app's own image the recipe allows" ;;
                token) why="the registry token was missing or too long" ;;
                command) why="the preview key may only start, update, remove and list previews" ;;
                *) why="the request did not have the form the recipe accepts" ;;
              esac
              text="No preview: the preview server refused the request ($why), and nothing changed there. If this workflow file was changed, \\\`opscrew provision --env preview\\\` writes it again." ;;
            cap)
              if [[ "$DETAIL" =~ ^[0-9]{1,2}/[0-9]{1,2}$ ]]; then
                text="No preview: the preview server already runs \${DETAIL%/*} previews, its limit of \${DETAIL#*/}. Close or merge another pull request that has one, or wait until one has had no push for 7 days, then push again. Nothing running was stopped."
              else
                text="OpsCrew could not tell what happened to this pull request's preview: the preview server gave an answer it does not know. \\\`opscrew preview list --env preview\\\` shows the previews; re-run this workflow to try again."
              fi
              ;;
            failed)
              case "$DETAIL" in
                pull) step="pulling the image" ;;
                release) step="the release command" ;;
                start) step="starting the app" ;;
                health) step="the app's health check" ;;
                edge) step="routing the address to the app" ;;
                *) step="one of its steps" ;;
              esac
              text="The preview failed at $step (commit \\\`$commit\\\`). A preview that ran before keeps its earlier version; a new one is not served. \\\`opscrew preview logs $NUMBER --env preview\\\` shows the app's logs." ;;
            busy)
              text="The preview server was busy with another request for more than 10 minutes, so nothing changed. Re-run this workflow, or push again." ;;
            unreachable)
              text="OpsCrew could not reach the preview server over SSH, so nothing changed. Check that the server runs (\\\`opscrew status --env preview\\\`), then re-run this workflow." ;;
            unanswered)
              text="The preview started but did not answer at $site within 3 minutes. Re-run this workflow, or see \\\`opscrew preview logs $NUMBER --env preview\\\`." ;;
            build-failed)
              text="No preview: the image did not build. The workflow run says why: $RUN_URL" ;;
            removed)
              text="The preview was removed with its data: the pull request was closed or merged." ;;
            remove-failed)
              text="OpsCrew could not remove the preview: the preview server did not confirm it. The server removes it after 7 days without a push." ;;
            *)
              text="OpsCrew could not tell what happened to this pull request's preview: the preview server gave an answer it does not know. \\\`opscrew preview list --env preview\\\` shows the previews; re-run this workflow to try again." ;;
          esac
          body='<!-- opscrew-preview:shop-preview -->'$'\\n\\n'"$text"
          ids="$(gh api --paginate "repos/$GITHUB_REPOSITORY/issues/$NUMBER/comments" --jq ".[] | select(.user.login == \\"github-actions[bot]\\" and (.body | startswith(\\"<!-- opscrew-preview:shop-preview -->\\"))) | .id")"
          id="\${ids%%$'\\n'*}"
          if [[ -n "$id" ]]; then
            gh api --method PATCH "repos/$GITHUB_REPOSITORY/issues/comments/$id" -f body="$body" > /dev/null
          else
            gh api "repos/$GITHUB_REPOSITORY/issues/$NUMBER/comments" -f body="$body" > /dev/null
          fi
      - name: Delete the images of pull requests no longer open
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          NUMBER: \${{ github.event.pull_request.number }}
          RUNNING: \${{ (needs.deploy.outputs.state == 'running' || needs.deploy.outputs.state == 'seed-failed') && needs.build.outputs.image || '' }}
        run: |
          // OpsCrew preview images (opscrew/environments/preview/plan.yaml, environment.previews): deletes the images of pull
          // requests no longer open, and this pull request's older ones, from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions, children: as the image retention reads them (each version's id, digest, tags and
           * creation time; by digest, what an image index lists).
           * open: the numbers of the repository's open pull requests.
           * number: this pull request's; running: the digest its preview runs, or null when none is known.
           */
          function previewPrunable(versions, children, open, number, running) {
            const pullOf = (tag) => {
              const match = /^(?:build-)?pr-([1-9][0-9]{0,5})-[0-9a-f]{40}$/.exec(tag);
              return match ? Number(match[1]) : undefined;
            };
            const goes = (v) => {
              const pulls = new Set(v.tags.map(pullOf));
              if (v.tags.length === 0 || pulls.size !== 1 || pulls.has(undefined)) return false;
              const [pull] = pulls;
              if (!open.includes(pull)) return true;
              if (pull !== number) return false;
              return v.tags.every((tag) => tag.startsWith("build-")) || (running !== null && v.digest !== running);
            };
            const reach = (digests) => {
              const seen = new Set(digests);
              const queue = [...digests];
              while (queue.length > 0) {
                for (const digest of children[queue.pop()] || []) {
                  if (!seen.has(digest)) {
                    seen.add(digest);
                    queue.push(digest);
                  }
                }
              }
              return seen;
            };
            // Every tagged version that stays, and the running image, keep what they list.
            const kept = reach([
              ...versions.filter((v) => v.tags.length > 0 && !goes(v)).map((v) => v.digest),
              ...(running === null ? [] : [running]),
            ]);
            const deleted = reach(versions.filter(goes).map((v) => v.digest));
            return versions
              .filter((v) => (v.tags.length === 0 || goes(v)) && deleted.has(v.digest) && !kept.has(v.digest))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const number = Number(process.env.NUMBER);
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const ref = process.env.RUNNING || "";
            const running = ref === "" ? null : digestRef.test(ref) ? ref.split("@")[1] : undefined;
            if (!/^[1-9][0-9]{0,5}$/.test(process.env.NUMBER || "") || running === undefined) {
              fail("OpsCrew could not tell which pull request or image this run is about, so it deleted no image.");
              return;
            }
            const [owner, repo] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            // The app's own package: ghcr.io/<owner>/<repo>.
            const name = repo;
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) {
                throw Object.assign(new Error(what + " answered HTTP " + response.status), { status: response.status });
              }
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });
            const pages = async (path, what, field) => {
              const all = [];
              for (let page = 1; ; page++) {
                const body = await read(await github("GET", path + (path.includes("?") ? "&" : "?") + "per_page=100&page=" + page), what);
                const batch = field === undefined ? body : body[field];
                all.push(...batch);
                if (batch.length < 100) return all;
              }
            };
            const packageVersions = async () => {
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              return (
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions"
              );
            };
            // The package's versions, and what each tagged or protected one lists.
            const survey = async (base, protect) => {
              const versions = (await pages(base, "The GitHub packages API")).map((v) => ({
                id: v.id,
                digest: v.name,
                tags: v.metadata.container.tags,
                created: v.created_at,
              }));
              const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
              const scope = "repository:" + owner + "/" + name + ":pull";
              const login = await read(
                await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                "GitHub Container Registry",
              );
              const children = {};
              const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
              for (const digest of new Set([...protect, ...tagged])) {
                const manifest = await read(
                  await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                    headers: {
                      Authorization: "Bearer " + login.token,
                      Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                    },
                  }),
                  "GitHub Container Registry",
                );
                children[digest] = (manifest.manifests || []).map((m) => m.digest);
              }
              return { versions, children };
            };
            // Another run may delete versions while this one reads them (one merge runs several
            // environments' workflows): the registry then answers 404 for a version the list still has.
            // Read it all again; a 404 that stays still stops, so nothing is deleted on a guess.
            const readPackage = async (base, protect) => {
              for (let attempt = 1; ; attempt++) {
                try {
                  return await survey(base, protect);
                } catch (error) {
                  if (error.status !== 404 || attempt === 3) throw error;
                  console.log("A version went while OpsCrew read the package (HTTP 404); reading it again in 20 s.");
                  await new Promise((resolve) => setTimeout(resolve, 20000));
                }
              }
            };
            const deleteVersions = async (base, versions, ids) => {
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else if (response.status === 404) {
                  // Another run deleted it first.
                  console.log("Already deleted: " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              return failed;
            };

            let deleting = false;
            try {
              const base = await packageVersions();
              const { versions, children } = await readPackage(base, running === null ? [] : [running]);
              const pulls = await pages("/repos/" + owner + "/" + repo + "/pulls?state=open", "The GitHub pull requests API");
              const open = pulls.map((pull) => pull.number);
              const ids = new Set(previewPrunable(versions, children, open, number, running));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + " of pull requests' images.");
              deleting = true;
              const failed = await deleteVersions(base, versions, ids);
              if (failed > 0) fail(failed + " image versions were not deleted; the next preview run tries again.");
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting pull requests' images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The next preview run tries again.",
              );
            }
          }
          main();

  remove:
    name: Remove the preview
    if: \${{ github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'dependabot[bot]' && github.event.action == 'closed' }}
    runs-on: ubuntu-latest
    environment:
      name: preview
      deployment: false
    permissions:
      deployments: write
      packages: write
      pull-requests: write
    steps:
      - name: Configure SSH with the pinned host key
        env:
          SSH_KEY: \${{ secrets.OPSCREW_PREVIEW_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_PREVIEW_SSH_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\\n' "$SSH_KEY" > ~/.ssh/opscrew
          chmod 600 ~/.ssh/opscrew
          printf '%s\\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - id: down
        name: Ask the preview server to remove the preview
        env:
          HOST: \${{ secrets.OPSCREW_PREVIEW_HOST }}
          NUMBER: \${{ github.event.pull_request.number }}
        run: |
          set -uo pipefail
          ssh_opts=(-i ~/.ssh/opscrew -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=20)
          code=0
          out="$(ssh "\${ssh_opts[@]}" "deploy@\${HOST}" "down $NUMBER" < /dev/null)" || code=$?
          state=error
          detail=
          last="\${out##*$'\\n'}"
          known='^(2 refused (request|number|image|commit|token|command)|6 busy [0-9]{1,6})$'
          if [[ "$code" -eq 255 ]]; then
            state=unreachable
          elif [[ "$last" == 'opscrew-preview: '* ]]; then
            answer="$code \${last#opscrew-preview: }"
            if [[ "$answer" == "0 removed $NUMBER" || "$answer" =~ $known ]]; then
              answer="\${answer#* }"
              state="\${answer%% *}"
              detail="\${answer#* }"
            fi
          fi
          { echo "state=$state"; echo "detail=$detail"; } >> "$GITHUB_OUTPUT"
          echo "The preview server answered: $state $detail"
      - name: Mark the pull request's deployments inactive
        env:
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          HEAD_REF: \${{ github.head_ref }}
        run: |
          set -euo pipefail
          ids="$(gh api --method GET --paginate "repos/$GITHUB_REPOSITORY/deployments" -f environment=preview -f ref="$HEAD_REF" --jq '.[].id')"
          for id in $ids; do
            gh api "repos/$GITHUB_REPOSITORY/deployments/$id/statuses" -f state=inactive > /dev/null
          done
      - name: Delete the images of pull requests no longer open
        if: \${{ !cancelled() }}
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          NUMBER: \${{ github.event.pull_request.number }}
        run: |
          // OpsCrew preview images (opscrew/environments/preview/plan.yaml, environment.previews): deletes the images of pull
          // requests no longer open, and this pull request's older ones, from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions, children: as the image retention reads them (each version's id, digest, tags and
           * creation time; by digest, what an image index lists).
           * open: the numbers of the repository's open pull requests.
           * number: this pull request's; running: the digest its preview runs, or null when none is known.
           */
          function previewPrunable(versions, children, open, number, running) {
            const pullOf = (tag) => {
              const match = /^(?:build-)?pr-([1-9][0-9]{0,5})-[0-9a-f]{40}$/.exec(tag);
              return match ? Number(match[1]) : undefined;
            };
            const goes = (v) => {
              const pulls = new Set(v.tags.map(pullOf));
              if (v.tags.length === 0 || pulls.size !== 1 || pulls.has(undefined)) return false;
              const [pull] = pulls;
              if (!open.includes(pull)) return true;
              if (pull !== number) return false;
              return v.tags.every((tag) => tag.startsWith("build-")) || (running !== null && v.digest !== running);
            };
            const reach = (digests) => {
              const seen = new Set(digests);
              const queue = [...digests];
              while (queue.length > 0) {
                for (const digest of children[queue.pop()] || []) {
                  if (!seen.has(digest)) {
                    seen.add(digest);
                    queue.push(digest);
                  }
                }
              }
              return seen;
            };
            // Every tagged version that stays, and the running image, keep what they list.
            const kept = reach([
              ...versions.filter((v) => v.tags.length > 0 && !goes(v)).map((v) => v.digest),
              ...(running === null ? [] : [running]),
            ]);
            const deleted = reach(versions.filter(goes).map((v) => v.digest));
            return versions
              .filter((v) => (v.tags.length === 0 || goes(v)) && deleted.has(v.digest) && !kept.has(v.digest))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const number = Number(process.env.NUMBER);
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const ref = process.env.RUNNING || "";
            const running = ref === "" ? null : digestRef.test(ref) ? ref.split("@")[1] : undefined;
            if (!/^[1-9][0-9]{0,5}$/.test(process.env.NUMBER || "") || running === undefined) {
              fail("OpsCrew could not tell which pull request or image this run is about, so it deleted no image.");
              return;
            }
            const [owner, repo] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            // The app's own package: ghcr.io/<owner>/<repo>.
            const name = repo;
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) {
                throw Object.assign(new Error(what + " answered HTTP " + response.status), { status: response.status });
              }
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });
            const pages = async (path, what, field) => {
              const all = [];
              for (let page = 1; ; page++) {
                const body = await read(await github("GET", path + (path.includes("?") ? "&" : "?") + "per_page=100&page=" + page), what);
                const batch = field === undefined ? body : body[field];
                all.push(...batch);
                if (batch.length < 100) return all;
              }
            };
            const packageVersions = async () => {
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              return (
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions"
              );
            };
            // The package's versions, and what each tagged or protected one lists.
            const survey = async (base, protect) => {
              const versions = (await pages(base, "The GitHub packages API")).map((v) => ({
                id: v.id,
                digest: v.name,
                tags: v.metadata.container.tags,
                created: v.created_at,
              }));
              const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
              const scope = "repository:" + owner + "/" + name + ":pull";
              const login = await read(
                await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                "GitHub Container Registry",
              );
              const children = {};
              const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
              for (const digest of new Set([...protect, ...tagged])) {
                const manifest = await read(
                  await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                    headers: {
                      Authorization: "Bearer " + login.token,
                      Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                    },
                  }),
                  "GitHub Container Registry",
                );
                children[digest] = (manifest.manifests || []).map((m) => m.digest);
              }
              return { versions, children };
            };
            // Another run may delete versions while this one reads them (one merge runs several
            // environments' workflows): the registry then answers 404 for a version the list still has.
            // Read it all again; a 404 that stays still stops, so nothing is deleted on a guess.
            const readPackage = async (base, protect) => {
              for (let attempt = 1; ; attempt++) {
                try {
                  return await survey(base, protect);
                } catch (error) {
                  if (error.status !== 404 || attempt === 3) throw error;
                  console.log("A version went while OpsCrew read the package (HTTP 404); reading it again in 20 s.");
                  await new Promise((resolve) => setTimeout(resolve, 20000));
                }
              }
            };
            const deleteVersions = async (base, versions, ids) => {
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else if (response.status === 404) {
                  // Another run deleted it first.
                  console.log("Already deleted: " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              return failed;
            };

            let deleting = false;
            try {
              const base = await packageVersions();
              const { versions, children } = await readPackage(base, running === null ? [] : [running]);
              const pulls = await pages("/repos/" + owner + "/" + repo + "/pulls?state=open", "The GitHub pull requests API");
              const open = pulls.map((pull) => pull.number);
              const ids = new Set(previewPrunable(versions, children, open, number, running));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + " of pull requests' images.");
              deleting = true;
              const failed = await deleteVersions(base, versions, ids);
              if (failed > 0) fail(failed + " image versions were not deleted; the next preview run tries again.");
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting pull requests' images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The next preview run tries again.",
              );
            }
          }
          main();
      - name: Update the preview's comment
        if: \${{ !cancelled() }}
        env:
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          NUMBER: \${{ github.event.pull_request.number }}
          COMMIT: \${{ github.event.pull_request.head.sha }}
          STATE: \${{ steps.down.outputs.state == 'removed' && 'removed' || 'remove-failed' }}
          DETAIL: ''
        run: |
          set -euo pipefail
          address='^pr-'"$NUMBER"'-[a-z0-9]{10}\\.example\\.net$'
          site=""
          if [[ "$DETAIL" =~ $address ]]; then site="https://$DETAIL"; fi
          state="$STATE"
          if [[ -z "$site" && ( "$state" == running || "$state" == seed-failed || "$state" == unanswered ) ]]; then
            state=unknown
          fi
          commit="\${COMMIT:0:12}"
          [[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || commit=unknown
          case "$state" in
            running)
              text="The preview of this pull request runs at $site (commit \\\`$commit\\\`)." ;;
            seed-failed)
              text="The preview of this pull request runs at $site (commit \\\`$commit\\\`), but its seed command failed, so its data may be missing. The next push tries the seed again; \\\`opscrew preview logs $NUMBER --env preview\\\` shows why it failed." ;;
            refused)
              case "$DETAIL" in
                image) why="the image is not the app's own image the recipe allows" ;;
                token) why="the registry token was missing or too long" ;;
                command) why="the preview key may only start, update, remove and list previews" ;;
                *) why="the request did not have the form the recipe accepts" ;;
              esac
              text="No preview: the preview server refused the request ($why), and nothing changed there. If this workflow file was changed, \\\`opscrew provision --env preview\\\` writes it again." ;;
            cap)
              if [[ "$DETAIL" =~ ^[0-9]{1,2}/[0-9]{1,2}$ ]]; then
                text="No preview: the preview server already runs \${DETAIL%/*} previews, its limit of \${DETAIL#*/}. Close or merge another pull request that has one, or wait until one has had no push for 7 days, then push again. Nothing running was stopped."
              else
                text="OpsCrew could not tell what happened to this pull request's preview: the preview server gave an answer it does not know. \\\`opscrew preview list --env preview\\\` shows the previews; re-run this workflow to try again."
              fi
              ;;
            failed)
              case "$DETAIL" in
                pull) step="pulling the image" ;;
                release) step="the release command" ;;
                start) step="starting the app" ;;
                health) step="the app's health check" ;;
                edge) step="routing the address to the app" ;;
                *) step="one of its steps" ;;
              esac
              text="The preview failed at $step (commit \\\`$commit\\\`). A preview that ran before keeps its earlier version; a new one is not served. \\\`opscrew preview logs $NUMBER --env preview\\\` shows the app's logs." ;;
            busy)
              text="The preview server was busy with another request for more than 10 minutes, so nothing changed. Re-run this workflow, or push again." ;;
            unreachable)
              text="OpsCrew could not reach the preview server over SSH, so nothing changed. Check that the server runs (\\\`opscrew status --env preview\\\`), then re-run this workflow." ;;
            unanswered)
              text="The preview started but did not answer at $site within 3 minutes. Re-run this workflow, or see \\\`opscrew preview logs $NUMBER --env preview\\\`." ;;
            build-failed)
              text="No preview: the image did not build. The workflow run says why: $RUN_URL" ;;
            removed)
              text="The preview was removed with its data: the pull request was closed or merged." ;;
            remove-failed)
              text="OpsCrew could not remove the preview: the preview server did not confirm it. The server removes it after 7 days without a push." ;;
            *)
              text="OpsCrew could not tell what happened to this pull request's preview: the preview server gave an answer it does not know. \\\`opscrew preview list --env preview\\\` shows the previews; re-run this workflow to try again." ;;
          esac
          body='<!-- opscrew-preview:shop-preview -->'$'\\n\\n'"$text"
          ids="$(gh api --paginate "repos/$GITHUB_REPOSITORY/issues/$NUMBER/comments" --jq ".[] | select(.user.login == \\"github-actions[bot]\\" and (.body | startswith(\\"<!-- opscrew-preview:shop-preview -->\\"))) | .id")"
          id="\${ids%%$'\\n'*}"
          if [[ -n "$id" ]]; then
            gh api --method PATCH "repos/$GITHUB_REPOSITORY/issues/comments/$id" -f body="$body" > /dev/null
          fi
      - name: Stop unless the preview was removed
        if: steps.down.outputs.state != 'removed'
        env:
          STATE: \${{ steps.down.outputs.state }}
        run: |
          echo "::error::The preview server did not confirm the removal ($STATE); it removes the preview once it has been idle for its lifetime."
          exit 1
"
`;
