exports[`the build job > matches the snapshot for railpack 1`] = `
"  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Install Railpack <pin:TOOLS.railpack.version>
        run: |
          set -euo pipefail
          curl -fsSL --retry 3 -o "$RUNNER_TEMP/railpack.tar.gz" https://github.com/railwayapp/railpack/releases/download/v0.42.0/railpack-v0.42.0-x86_64-unknown-linux-musl.tar.gz
          echo "<pin:TOOLS.railpack.sha256.amd64>  $RUNNER_TEMP/railpack.tar.gz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/railpack"
          tar -xzf "$RUNNER_TEMP/railpack.tar.gz" -C "$RUNNER_TEMP/railpack"
          sudo install -m 0755 "$(find "$RUNNER_TEMP/railpack" -type f -name railpack | head -n 1)" /usr/local/bin/railpack
      - id: prepare
        name: Plan the Railpack build
        env:
          BUILD_ENV: \${{ secrets.OPSCREW_BUILD_ENV }}
          BUILD_SECRETS: \${{ secrets.OPSCREW_BUILD_SECRETS }}
        run: |
          set -euo pipefail
          # The plan lists the names; the build reads the values as BuildKit secrets. Railpack
          # never sees a secret value here, only its name.
          values=(--env RAILPACK_RUBY_VERSION=1.26)
          while IFS= read -r line; do
            [[ -z "$line" || "$line" == \\#* ]] && continue
            values+=(--env "$line")
          done <<< "\${BUILD_ENV:-}"
          while IFS= read -r line; do
            [[ -z "$line" || "$line" == \\#* ]] && continue
            values+=(--env "\${line%%=*}=")
          done <<< "\${BUILD_SECRETS:-}"
          for attempt in 1 2 3; do
            code=0
            railpack prepare "." --plan-out "$RUNNER_TEMP/railpack-plan.json" --info-out "$RUNNER_TEMP/railpack-info.json" "\${values[@]}" || code=$?
            # 75 is a temporary failure, such as a download; anything else is final.
            if [[ "$code" -ne 75 ]]; then break; fi
            sleep 10
          done
          if [[ "$code" -ne 0 ]]; then
            echo "::error::Railpack could not plan the build (exit code $code); its output above says why."
            exit 1
          fi
          echo "hash=$(printf '%s' "\${BUILD_ENV:-}" | sha256sum | cut -d ' ' -f 1)" >> "$GITHUB_OUTPUT"
      - id: railpack
        name: Build the image with Railpack
        uses: <pin:ACTIONS.buildPush>
        with:
          context: "."
          file: \${{ runner.temp }}/railpack-plan.json
          push: true
          tags: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}
          provenance: false
          build-args: |
            BUILDKIT_SYNTAX=<pin:IMAGES.railpackFrontend>
            secrets-hash=\${{ steps.prepare.outputs.hash }}
          # The frontend reads every value the plan lists as a secret, the runtime version too.
          secrets: |
            RAILPACK_RUBY_VERSION=1.26
            \${{ secrets.OPSCREW_BUILD_ENV }}
            \${{ secrets.OPSCREW_BUILD_SECRETS }}
          cache-from: type=gha,scope=railpack
          cache-to: type=gha,mode=min,scope=railpack
      - name: Write the seal Dockerfile
        env:
          BASE: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}@\${{ steps.railpack.outputs.digest }}
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/seal"
          printf '%s\\n' "FROM $BASE" 'RUN mkdir -p /app/tmp /app/log /app/storage /app/db && chown -R 10001:10001 /app/tmp /app/log /app/storage /app/db' 'USER 10001:10001' > "$RUNNER_TEMP/seal/Dockerfile"
      - id: push
        name: Seal and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          # The checkout is the context, so the provenance names its repository and commit; the
          # seal copies nothing from it.
          context: "."
          file: \${{ runner.temp }}/seal/Dockerfile
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha,scope=seal
          cache-to: type=gha,mode=min,scope=seal
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi"
`;

