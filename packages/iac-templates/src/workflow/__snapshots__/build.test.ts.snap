// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the build job > matches the snapshot for buildpacks 1`] = `
"  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Install pack 0.40.9
        run: |
          set -euo pipefail
          curl -fsSL --retry 3 -o "$RUNNER_TEMP/pack.tar.gz" https://github.com/buildpacks/pack/releases/download/v0.40.9/pack-v0.40.9-linux.tgz
          echo "dc0ee1e931cf8a106d7555a01a214864f9acb60b77adf15d69b74df4404758e9  $RUNNER_TEMP/pack.tar.gz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/pack"
          tar -xzf "$RUNNER_TEMP/pack.tar.gz" -C "$RUNNER_TEMP/pack"
          sudo install -m 0755 "$(find "$RUNNER_TEMP/pack" -type f -name pack | head -n 1)" /usr/local/bin/pack
      - name: Keep secret files out of the Buildpacks build
        run: |
          set -euo pipefail
          while IFS= read -r -d '' file; do
            rm -f -- "$file"
            echo "removed \${file#./} from the build: Buildpacks does not read .dockerignore"
          done < <(find "." \\( -name node_modules -o -name .git \\) -prune -o -type f \\( -name '.env' -o -name '.env.*' -o -name '*.pem' -o -name '*.key' \\) ! -name '.env.example' -print0)
      - id: pack
        name: Build the image with Buildpacks
        env:
          NAME: \${{ steps.image.outputs.name }}
          BUILD_ENV: \${{ secrets.OPSCREW_BUILD_ENV }}
        run: |
          set -euo pipefail
          # pack uploads the whole folder. .git holds every committed file, the removed secret files
          # too, so it waits outside while pack runs, and is back for the seal's provenance.
          git_dir="./.git"
          if [[ -e "$git_dir" ]]; then
            mv "$git_dir" "$RUNNER_TEMP/opscrew-git"
            trap 'mv "$RUNNER_TEMP/opscrew-git" "$git_dir"' EXIT
          fi
          settings=(--env BP_GO_VERSION=1.26)
          while IFS= read -r line; do
            [[ -z "$line" || "$line" == \\#* ]] && continue
            settings+=(--env "$line")
          done <<< "\${BUILD_ENV:-}"
          report="$RUNNER_TEMP/pack-report"
          mkdir -p "$report"
          pack build "$NAME:build-$GITHUB_SHA" --path "." \\
            --builder paketobuildpacks/ubuntu-noble-builder:0.0.203@sha256:ba79c24b55830210fc5ee06768237ab989dbaeec36adb60a986bcb8e70e4d7cd \\
            --run-image paketobuildpacks/ubuntu-noble-run:0.0.145@sha256:577357bc2a59c962ce3f7d816f7ff401f408538832a1c56a9a87f6fc5829df97 \\
            "\${settings[@]}" --publish --cache-image "$NAME:buildcache" --report-output-dir "$report"
          digest="$(sed -nE 's/^[[:space:]]*digest = "(sha256:[0-9a-f]{64})".*/\\1/p' "$report/report.toml" | head -n 1)"
          if [[ -z "$digest" ]]; then
            echo "::error::pack did not report the digest of the image it pushed; re-run the workflow."
            exit 1
          fi
          echo "digest=$digest" >> "$GITHUB_OUTPUT"
      - name: Write the seal Dockerfile
        env:
          BASE: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}@\${{ steps.pack.outputs.digest }}
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/seal"
          printf '%s\\n' "FROM $BASE" > "$RUNNER_TEMP/seal/Dockerfile"
      - id: push
        name: Seal and push the image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          # The checkout is the context, so the provenance names its repository and commit; the
          # seal copies nothing from it.
          context: "."
          file: \${{ runner.temp }}/seal/Dockerfile
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha,scope=seal
          cache-to: type=gha,mode=min,scope=seal
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE""
`;

exports[`the build job > matches the snapshot for generated-dockerfile 1`] = `
"  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE""
`;

exports[`the build job > matches the snapshot for own-dockerfile 1`] = `
"  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE""
`;

exports[`the build job > matches the snapshot for railpack 1`] = `
"  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Install Railpack 0.42.0
        run: |
          set -euo pipefail
          curl -fsSL --retry 3 -o "$RUNNER_TEMP/railpack.tar.gz" https://github.com/railwayapp/railpack/releases/download/v0.42.0/railpack-v0.42.0-x86_64-unknown-linux-musl.tar.gz
          echo "81bca91d0577c7650378762609116d12d8630e2cfc1779e41d3ac3964fc7194b  $RUNNER_TEMP/railpack.tar.gz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/railpack"
          tar -xzf "$RUNNER_TEMP/railpack.tar.gz" -C "$RUNNER_TEMP/railpack"
          sudo install -m 0755 "$(find "$RUNNER_TEMP/railpack" -type f -name railpack | head -n 1)" /usr/local/bin/railpack
      - id: prepare
        name: Plan the Railpack build
        env:
          BUILD_ENV: \${{ secrets.OPSCREW_BUILD_ENV }}
          BUILD_SECRETS: \${{ secrets.OPSCREW_BUILD_SECRETS }}
        run: |
          set -euo pipefail
          # The plan lists the names; the build reads the values as BuildKit secrets. Railpack
          # never sees a secret value here, only its name.
          values=(--env RAILPACK_RUBY_VERSION=1.26)
          while IFS= read -r line; do
            [[ -z "$line" || "$line" == \\#* ]] && continue
            values+=(--env "$line")
          done <<< "\${BUILD_ENV:-}"
          while IFS= read -r line; do
            [[ -z "$line" || "$line" == \\#* ]] && continue
            values+=(--env "\${line%%=*}=")
          done <<< "\${BUILD_SECRETS:-}"
          for attempt in 1 2 3; do
            code=0
            railpack prepare "." --plan-out "$RUNNER_TEMP/railpack-plan.json" --info-out "$RUNNER_TEMP/railpack-info.json" "\${values[@]}" || code=$?
            # 75 is a temporary failure, such as a download; anything else is final.
            if [[ "$code" -ne 75 ]]; then break; fi
            sleep 10
          done
          if [[ "$code" -ne 0 ]]; then
            echo "::error::Railpack could not plan the build (exit code $code); its output above says why."
            exit 1
          fi
          echo "hash=$(printf '%s' "\${BUILD_ENV:-}" | sha256sum | cut -d ' ' -f 1)" >> "$GITHUB_OUTPUT"
      - id: railpack
        name: Build the image with Railpack
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: "."
          file: \${{ runner.temp }}/railpack-plan.json
          push: true
          tags: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}
          provenance: false
          build-args: |
            BUILDKIT_SYNTAX=ghcr.io/railwayapp/railpack-frontend:v0.42.0@sha256:a42a12399fa9e83a09e475f69dbf8a45a8a74ea38a4485fcb401356d84317a14
            secrets-hash=\${{ steps.prepare.outputs.hash }}
          # The frontend reads every value the plan lists as a secret, the runtime version too.
          secrets: |
            RAILPACK_RUBY_VERSION=1.26
            \${{ secrets.OPSCREW_BUILD_ENV }}
            \${{ secrets.OPSCREW_BUILD_SECRETS }}
          cache-from: type=gha,scope=railpack
          cache-to: type=gha,mode=min,scope=railpack
      - name: Write the seal Dockerfile
        env:
          BASE: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}@\${{ steps.railpack.outputs.digest }}
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/seal"
          printf '%s\\n' "FROM $BASE" 'RUN mkdir -p /app/tmp /app/log /app/storage /app/db && chown -R 10001:10001 /app/tmp /app/log /app/storage /app/db' 'USER 10001:10001' > "$RUNNER_TEMP/seal/Dockerfile"
      - id: push
        name: Seal and push the image
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          # The checkout is the context, so the provenance names its repository and commit; the
          # seal copies nothing from it.
          context: "."
          file: \${{ runner.temp }}/seal/Dockerfile
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha,scope=seal
          cache-to: type=gha,mode=min,scope=seal
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE""
`;
