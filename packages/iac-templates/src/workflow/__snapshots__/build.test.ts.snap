// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`an own Dockerfile with cron jobs > matches the snapshot 1`] = `
"  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: own
        name: Build the image from your Dockerfile
        uses: <pin:ACTIONS.buildPush>
        with:
          context: "."
          file: "Dockerfile"
          build-args: \${{ secrets.OPSCREW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}
          provenance: false
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - name: Write the seal Dockerfile
        env:
          BASE: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}@\${{ steps.own.outputs.digest }}
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/seal"
          printf '%s\\n' "FROM $BASE" 'ADD --checksum=sha256:<pin:TOOLS.supercronic.sha256.amd64> --chmod=755 https://github.com/aptible/supercronic/releases/download/v0.2.50/supercronic-linux-amd64 /usr/local/bin/supercronic' > "$RUNNER_TEMP/seal/Dockerfile"
      - id: push
        name: Seal and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          # The checkout is the context, so the provenance names its repository and commit; the
          # seal copies nothing from it.
          context: "."
          file: \${{ runner.temp }}/seal/Dockerfile
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha,scope=seal
          cache-to: type=gha,mode=min,scope=seal
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi"
`;

exports[`the build job > matches the snapshot for buildpacks 1`] = `
"  build:
    name: Build the image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Install pack <pin:TOOLS.pack.version>
        run: |
          set -euo pipefail
          curl -fsSL --retry 3 -o "$RUNNER_TEMP/pack.tar.gz" https://github.com/buildpacks/pack/releases/download/v0.40.9/pack-v0.40.9-linux.tgz
          echo "<pin:TOOLS.pack.sha256.amd64>  $RUNNER_TEMP/pack.tar.gz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/pack"
          tar -xzf "$RUNNER_TEMP/pack.tar.gz" -C "$RUNNER_TEMP/pack"
          sudo install -m 0755 "$(find "$RUNNER_TEMP/pack" -type f -name pack | head -n 1)" /usr/local/bin/pack
      - name: Keep secret files out of the Buildpacks build
        run: |
          set -euo pipefail
          while IFS= read -r -d '' file; do
            rm -f -- "$file"
            echo "removed \${file#./} from the build: Buildpacks does not read .dockerignore"
          done < <(find "." \\( -name node_modules -o -name .git \\) -prune -o -type f \\( -name '.env' -o -name '.env.*' -o -name '*.pem' -o -name '*.key' \\) ! -name '.env.example' -print0)
      - id: pack
        name: Build the image with Buildpacks
        env:
          NAME: \${{ steps.image.outputs.name }}
          BUILD_ENV: \${{ secrets.OPSCREW_BUILD_ENV }}
        run: |
          set -euo pipefail
          # pack uploads the whole folder. .git holds every committed file, the removed secret files
          # too, so it waits outside while pack runs, and is back for the seal's provenance.
          git_dir="./.git"
          if [[ -e "$git_dir" ]]; then
            mv "$git_dir" "$RUNNER_TEMP/opscrew-git"
            trap 'mv "$RUNNER_TEMP/opscrew-git" "$git_dir"' EXIT
          fi
          settings=(--env BP_GO_VERSION=1.26)
          while IFS= read -r line; do
            [[ -z "$line" || "$line" == \\#* ]] && continue
            settings+=(--env "$line")
          done <<< "\${BUILD_ENV:-}"
          report="$RUNNER_TEMP/pack-report"
          mkdir -p "$report"
          pack build "$NAME:build-$GITHUB_SHA" --path "." \\
            --builder <pin:IMAGES.paketoBuilder> \\
            --run-image <pin:IMAGES.paketoRun> \\
            "\${settings[@]}" --publish --cache-image "$NAME:buildcache" --report-output-dir "$report"
          digest="$(sed -nE 's/^[[:space:]]*digest = "(sha256:[0-9a-f]{64})".*/\\1/p' "$report/report.toml" | head -n 1)"
          if [[ -z "$digest" ]]; then
            echo "::error::pack did not report the digest of the image it pushed; re-run the workflow."
            exit 1
          fi
          echo "digest=$digest" >> "$GITHUB_OUTPUT"
      - name: Write the seal Dockerfile
        env:
          BASE: \${{ steps.image.outputs.name }}:build-\${{ github.sha }}@\${{ steps.pack.outputs.digest }}
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/seal"
          printf '%s\\n' "FROM $BASE" > "$RUNNER_TEMP/seal/Dockerfile"
      - id: push
        name: Seal and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          # The checkout is the context, so the provenance names its repository and commit; the
          # seal copies nothing from it.
          context: "."
          file: \${{ runner.temp }}/seal/Dockerfile
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha,scope=seal
          cache-to: type=gha,mode=min,scope=seal
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi"
`;

