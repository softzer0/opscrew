RUN mkdir -p /app/tmp /app/log /app/storage /app/db && chown -R 10001:10001 /app/tmp /app/log /app/storage /app/db
ADD --checksum=sha256:<pin:TOOLS.supercronic.sha256.amd64> --chmod=755 https://github.com/aptible/supercronic/releases/download/v0.2.50/supercronic-linux-amd64 /usr/local/bin/supercronic
