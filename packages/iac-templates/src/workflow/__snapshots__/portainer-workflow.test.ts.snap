// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderWorkflow for a Portainer target > matches the snapshots > cloudflare 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app image, pushes it to GitHub Container Registry and writes it to the
# opscrew-deploy branch, which your Portainer deploys. Secrets are set by \`opscrew provision\`;
# their values never appear in this file.
name: OpsCrew deploy

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - "Dockerfile"
      - "opscrew/runtime/compose.yaml"
      - ".github/workflows/opscrew-deploy.yml"
  workflow_dispatch:
    inputs:
      digest:
        description: For a rollback, the image to deploy, by its digest (sha256:…); \`opscrew rollback\` fills it in.
        required: false
        type: string
        default: ""
      tag:
        description: For a rollback, the image's commit tag (<commit>, or <commit>-<env> outside prod); \`opscrew rollback\` fills it in.
        required: false
        type: string
        default: ""
      rollback:
        description: Deploy the image without running the release command, for a rollback; \`opscrew rollback\` sets it.
        required: false
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ !(inputs.rollback) && contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/prod"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --resume --deploy\\\` deploys the branch's latest commit."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the image
    if: \${{ !inputs.rollback }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi

  verify:
    name: Check where the image was built
    if: \${{ inputs.rollback }}
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: read
    outputs:
      image: \${{ steps.provenance.outputs.image }}
      tag: \${{ steps.provenance.outputs.tag }}
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: provenance
        name: Check the image's provenance
        env:
          DIGEST: \${{ inputs.digest }}
          TAG: \${{ inputs.tag }}
          BUILD_BRANCH: "main"
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The digest input is not an image digest (sha256: and 64 hexadecimal digits). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          name="ghcr.io/\${GITHUB_REPOSITORY,,}"
          image="$name@$DIGEST"
          if ! provenance="$(docker buildx imagetools inspect "$image" --format '{{json .Provenance}}')"; then
            echo "::error::GitHub Container Registry has no image $image. Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which choose an image that is there."
            exit 1
          fi
          # buildx names the run that built the image in runDetails.builder.id (per platform).
          mapfile -t runs < <(jq -r '.. | .runDetails?.builder?.id? // empty' <<< "$provenance" | sort -u)
          if [[ "\${#runs[@]}" -ne 1 || ! "\${runs[0]}" =~ ^https://github\\.com/([^/]+/[^/]+)/actions/runs/([0-9]+)/attempts/[0-9]+$ ]]; then
            echo "::error::The image's build provenance does not name one GitHub Actions run, so OpsCrew cannot tell where it was built. OpsCrew deploys a digest only when this repository's deploy workflow built it."
            exit 1
          fi
          built_in="\${BASH_REMATCH[1]}"
          run_id="\${BASH_REMATCH[2]}"
          if [[ "\${built_in,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built by a run of $built_in, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if ! record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" --jq '"\\(.event) \\(.head_repository.full_name) \\(.head_branch) \\(.head_sha) \\(.path)"')"; then
            echo "::error::GitHub shows no run $run_id in this repository, which the image's provenance names as its build. OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          read -r event head_repo branch commit workflow <<< "$record"
          # The run's path can end with @<ref>, which the signing identity carries separately.
          workflow="\${workflow%%@*}"
          # A fork's pull request runs in this repository too, with its own branch name: only a push, or a
          # run started by hand, which takes write access (ADR 0023 D1), counts.
          if [[ "$event" != "push" && "$event" != "workflow_dispatch" ]]; then
            echo "::error::The image was built by a $event run, not by a push or a run started by hand. OpsCrew deploys a digest only when a push to $BUILD_BRANCH, or a run started by hand there, built it."
            exit 1
          fi
          if [[ "\${head_repo,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built from the commits of $head_repo, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if [[ "$branch" != "$BUILD_BRANCH" ]]; then
            echo "::error::The image was built from the branch $branch, not from $BUILD_BRANCH, the branch that builds this environment's images. OpsCrew deploys a digest only when a build on $BUILD_BRANCH made it."
            exit 1
          fi
          # prod's build tags its commit, another environment's <commit>-<env>.
          if [[ "$TAG" != "$commit" && ! "$TAG" =~ ^$commit-[a-z][a-z0-9-]*$ ]]; then
            echo "::error::The tag input is not a commit tag of the image's build ($commit, or $commit-<environment>). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          if [[ "$(docker buildx imagetools inspect "$name:$TAG" --format '{{.Manifest.Digest}}')" != "$DIGEST" ]]; then
            echo "::error::The image is not the one tagged with its build's commit ($TAG): a later build of that commit replaced the tag, or the image was pushed another way. \\\`opscrew rollback --list\\\` shows the versions to roll back to, and \\\`opscrew promote\\\` takes the image another environment runs."
            exit 1
          fi
          {
            echo "image=$image"
            echo "tag=$name:$TAG"
            echo "identity=https://github.com/$GITHUB_REPOSITORY/$workflow@refs/heads/$branch"
          } >> "$GITHUB_OUTPUT"
          echo "Deploying \\\`$image\\\`, built by run $run_id from \\\`$commit\\\` on \\\`$branch\\\`." >> "$GITHUB_STEP_SUMMARY"

  deploy:
    name: Deploy to Portainer
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"')) }}
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: write
    outputs:
      previous: \${{ steps.write.outputs.previous_image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: write
        name: Write the new version to the opscrew-deploy branch
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          if [[ ! -f opscrew/runtime/compose.yaml ]] || ! grep -qF __OPSCREW_APP_IMAGE__ opscrew/runtime/compose.yaml; then
            echo "::error::opscrew/runtime/compose.yaml does not mark the app's image (__OPSCREW_APP_IMAGE__); run \\\`opscrew provision\\\` to write it again."
            exit 1
          fi
          template="$(cat opscrew/runtime/compose.yaml)"
          digest="\${IMAGE##*@sha256:}"
          compose="\${template//__OPSCREW_APP_IMAGE__/"$IMAGE"}"
          compose="\${compose//__OPSCREW_APP_VERSION__/"\${digest:0:12}"}"
          if [[ "$MODE" == rollback ]]; then
            release=skip
            subject="Roll back to $IMAGE"
            body="Written by opscrew rollback through the OpsCrew deploy workflow: no build, and no release command."
          else
            release=run
            subject="Deploy $IMAGE"
            body="Built from $GITHUB_SHA by the OpsCrew deploy workflow."
          fi
          compose="\${compose//__OPSCREW_RELEASE__/"$release"}"
          printf '%s\\n' "$compose" > "$RUNNER_TEMP/compose.yaml"
          export GIT_AUTHOR_NAME='github-actions[bot]' GIT_AUTHOR_EMAIL='41898282+github-actions[bot]@users.noreply.github.com'
          export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
          tree="$(printf '100644 blob %s\\tcompose.yaml\\n' "$(git hash-object -w "$RUNNER_TEMP/compose.yaml")" | git mktree)"
          previous=""
          previous_image=""
          parent=()
          remote="$(git ls-remote origin refs/heads/opscrew-deploy)"
          if [[ -n "$remote" ]]; then
            git fetch --no-tags --depth=1 origin +refs/heads/opscrew-deploy:refs/remotes/origin/opscrew-deploy
            previous="$(git rev-parse refs/remotes/origin/opscrew-deploy)"
            parent=(-p "$previous")
            previous_image="$(git show "$previous:compose.yaml" | grep -o "\${IMAGE%@*}@sha256:[0-9a-f]\\{64\\}" | head -n 1 || true)"
          fi
          echo "previous_image=$previous_image" >> "$GITHUB_OUTPUT"
          if [[ -n "$previous" && "$(git rev-parse "$previous^{tree}")" == "$tree" ]]; then
            echo "The opscrew-deploy branch already holds this version."
            echo "changed=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          deployed="$(git commit-tree "$tree" "\${parent[@]}" -m "$subject" -m "$body")"
          git push origin "$deployed:refs/heads/opscrew-deploy"
          {
            echo "previous=$previous"
            echo "deployed=$deployed"
            echo "changed=true"
          } >> "$GITHUB_OUTPUT"
          echo "Wrote \\\`$IMAGE\\\` to the \\\`opscrew-deploy\\\` branch." >> "$GITHUB_STEP_SUMMARY"
      - id: redeploy
        name: Ask Portainer to deploy the new version
        if: steps.write.outputs.changed == 'true'
        env:
          WEBHOOK_URL: \${{ secrets.OPSCREW_PORTAINER_WEBHOOK_URL }}
          ACCESS_CLIENT_ID: \${{ secrets.OPSCREW_PORTAINER_ACCESS_CLIENT_ID }}
          ACCESS_CLIENT_SECRET: \${{ secrets.OPSCREW_PORTAINER_ACCESS_CLIENT_SECRET }}
        run: |
          set -euo pipefail
          headers="$RUNNER_TEMP/access-headers"
          (umask 077 && printf 'CF-Access-Client-Id: %s\\nCF-Access-Client-Secret: %s\\n' "$ACCESS_CLIENT_ID" "$ACCESS_CLIENT_SECRET" > "$headers")
          code="$(curl -sS --connect-timeout 20 --max-time 120 -X POST -H @"$headers" -o /dev/null -w '%{http_code}' "$WEBHOOK_URL" || true)"
          rm -f "$headers"
          case "$code" in
            2[0-9][0-9]) echo "Portainer accepted the redeploy." ;;
            401|403)
              echo "::error::Cloudflare Access refused the deploy workflow's service token (HTTP $code). Run \\\`opscrew provision\\\` again to set the deploy secrets."
              exit 1 ;;
            404)
              echo "::error::Portainer does not know this stack's webhook (HTTP 404). Run \\\`opscrew provision\\\` again to repair the stack's redeploy setting."
              exit 1 ;;
            *)
              echo "::warning::Portainer did not confirm the redeploy (HTTP \${code:-none}); OpsCrew still waits for the new version." ;;
          esac
      - id: health
        name: Wait until the new version answers
        env:
          URL: https://shop.example.com/api/health
          VERSION_URL: https://shop.example.com/.well-known/opscrew-version
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
        run: |
          set -euo pipefail
          digest="\${IMAGE##*@sha256:}"
          want="\${digest:0:12}"
          state=down
          for attempt in $(seq 1 30); do
            if ! seen="$(curl -fsS --max-time 10 "$VERSION_URL")"; then
              state=down
            elif [[ "$seen" != "$want" ]]; then
              state=previous
            elif curl -fsS --max-time 10 -o /dev/null "$URL"; then
              echo "The new version answers after $attempt attempt(s)."
              exit 0
            else
              state=down
            fi
            sleep 10
          done
          if [[ "$state" == previous ]]; then
            echo "::error::After 5 minutes the site at $URL still runs the previous version: Portainer did not deploy the new one. Portainer shows why under Stacks → opscrew-shop."
          else
            echo "::error::The new version did not answer at $URL within 5 minutes. Portainer shows why under Stacks → opscrew-shop."
          fi
          exit 1
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && steps.write.outputs.changed == 'true'
        env:
          PREVIOUS: \${{ steps.write.outputs.previous }}
          DEPLOYED: \${{ steps.write.outputs.deployed }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          WEBHOOK_URL: \${{ secrets.OPSCREW_PORTAINER_WEBHOOK_URL }}
          ACCESS_CLIENT_ID: \${{ secrets.OPSCREW_PORTAINER_ACCESS_CLIENT_ID }}
          ACCESS_CLIENT_SECRET: \${{ secrets.OPSCREW_PORTAINER_ACCESS_CLIENT_SECRET }}
        run: |
          set -uo pipefail
          if [[ -z "$PREVIOUS" ]]; then
            echo "::error::The deploy failed and the opscrew-deploy branch had no earlier version to restore. Fix the problem and push again."
            exit 1
          fi
          export GIT_AUTHOR_NAME='github-actions[bot]' GIT_AUTHOR_EMAIL='41898282+github-actions[bot]@users.noreply.github.com'
          export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
          if ! git show "$PREVIOUS:compose.yaml" | sed 's/^\\([[:space:]]*OPSCREW_RELEASE: \\)run$/\\1skip/' > "$RUNNER_TEMP/revert.yaml" ||
            ! tree="$(printf '100644 blob %s\\tcompose.yaml\\n' "$(git hash-object -w "$RUNNER_TEMP/revert.yaml")" | git mktree)" ||
            ! restored="$(git commit-tree "$tree" -p "$DEPLOYED" -m "Roll back to the previous version" -m "$IMAGE did not come up; OpsCrew wrote the version before it back, without its release command.")" ||
            ! git push origin "$restored:refs/heads/opscrew-deploy"; then
            echo "::error::The deploy failed and OpsCrew could not write the previous version back to the opscrew-deploy branch. Write the compose.yaml of the commit before the newest one back to that branch by hand."
            exit 1
          fi
          headers="$RUNNER_TEMP/access-headers"
          (umask 077 && printf 'CF-Access-Client-Id: %s\\nCF-Access-Client-Secret: %s\\n' "$ACCESS_CLIENT_ID" "$ACCESS_CLIENT_SECRET" > "$headers")
          code="$(curl -sS --connect-timeout 20 --max-time 120 -X POST -H @"$headers" -o /dev/null -w '%{http_code}' "$WEBHOOK_URL" || true)"
          rm -f "$headers"
          if [[ "$code" == 2[0-9][0-9] ]]; then
            echo "::error::The deploy failed; OpsCrew wrote the previous version back to the opscrew-deploy branch and asked Portainer to deploy it."
          else
            echo "::error::The deploy failed; OpsCrew wrote the previous version back to the opscrew-deploy branch, but Portainer did not confirm the redeploy (HTTP \${code:-none}). Redeploy the stack in Portainer, or run the workflow again."
          fi
          exit 1

  prune:
    name: Delete old images
    needs: [build, deploy]
    if: \${{ !cancelled() && needs.build.result == 'success' && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: write
    steps:
      - name: Keep the newest 10 images; delete older, intermediate and old pull request images
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
          KEEP: "10"
        run: |
          // OpsCrew image retention (opscrew/plan.yaml, cicd.imageRetention): deletes old versions of
          // this repository's image from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions: [{ id, digest, tags, created }], as the GitHub API lists them.
           * children: by digest, the digests an image index lists (its platform manifests and attestations).
           * keep: how many <commit> versions to keep, newest first; undefined (retention off) deletes only
           * the build-<commit> intermediates, old pull requests' images and what only they list.
           * protect: digests never deleted: the running and the previous image.
           * recent: a time (milliseconds since 1970): an untagged version created since then stays unless
           * a version deleted here lists it, since another environment's build may be pushing it right now.
           * environments: the names of the app's environments (prod and each one beside it).
           * previewsBefore: a time (milliseconds since 1970): a version whose every tag is a pull request's
           * (pr-<n>-<commit>, build-pr-<n>-<commit>) created before then goes, retention on or off.
           *
           * Kept: the protected digests, every version the label tags of one of the environments mark
           * (opscrew-<env>, the image it runs, and opscrew-<env>-previous, the one before), the newest keep
           * <commit> versions, versions with a tag this environment's builds did not push and that is no
           * other opscrew-* tag (yours, Buildpacks' caches, another environment's images, pull requests'
           * images until previewsBefore), signatures of kept images, and whatever a kept index lists, tagged
           * or not. Deleted: build-<commit> intermediates, older <commit> versions with their
           * signatures, old pull requests' images, and untagged versions nothing kept lists, once they are
           * older than recent.
           */
          function prunable(versions, children, keep, protect, recent, environments, previewsBefore) {
            const commit = (tag) => /^[0-9a-f]{40}$/.test(tag);
            const build = (tag) => /^build-[0-9a-f]{40}$/.test(tag);
            const pull = (tag) => /^(?:build-)?pr-([1-9][0-9]{0,5})-[0-9a-f]{40}$/.test(tag);
            const oldPull = (v) => v.tags.length > 0 && v.tags.every(pull) && Date.parse(v.created) < previewsBefore;
            const labels = new Set(environments.flatMap((env) => ["opscrew-" + env, "opscrew-" + env + "-previous"]));
            const label = (tag) => labels.has(tag);
            // An opscrew-* tag that labels none of the environments (one removed since, a stray one).
            const strayLabel = (tag) => /^opscrew-[a-z][a-z0-9-]*$/.test(tag) && !label(tag);
            const subject = (tag) => {
              const match = /^sha256-([0-9a-f]{64})(\\.[a-z]+)?$/.exec(tag);
              return match ? "sha256:" + match[1] : undefined;
            };
            const ours = (tag) => commit(tag) || build(tag) || subject(tag) !== undefined || strayLabel(tag);
            const listed = (digests) => new Set([...digests].flatMap((digest) => children[digest] || []));

            const kept = new Set(protect);
            for (const v of versions) if (v.tags.some(label)) kept.add(v.digest);
            if (keep === undefined) {
              for (const v of versions) if (!v.tags.every(build) && !oldPull(v)) kept.add(v.digest);
            } else {
              const deployed = versions
                .filter((v) => v.tags.some(commit))
                .sort((a, b) => b.created.localeCompare(a.created) || b.id - a.id);
              for (const v of deployed.slice(0, keep)) kept.add(v.digest);
              for (const v of versions) if (!v.tags.every(ours) && !oldPull(v)) kept.add(v.digest);
              for (const v of versions) if (v.tags.some((tag) => kept.has(subject(tag)))) kept.add(v.digest);
            }

            // Everything a kept version lists, and what that lists in turn, stays.
            const reach = (digests) => {
              const seen = new Set(digests);
              const queue = [...digests];
              while (queue.length > 0) {
                for (const digest of children[queue.pop()] || []) {
                  if (!seen.has(digest)) {
                    seen.add(digest);
                    queue.push(digest);
                  }
                }
              }
              return seen;
            };
            const reachable = reach(kept);
            const goes = (v) => !reachable.has(v.digest);
            const listedByDeleted = listed(versions.filter((v) => v.tags.length > 0 && goes(v)).map((v) => v.digest));
            // Another environment's build pushes its platform manifests and attestations untagged, moments
            // before the index that lists them: until then nothing lists them, so a recent one stays.
            const old = (v) => Date.parse(v.created) < recent;
            return versions
              .filter((v) => goes(v) && (v.tags.length > 0 || listedByDeleted.has(v.digest) || (keep !== undefined && old(v))))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const digestOf = (ref) => (digestRef.test(ref) ? ref.split("@")[1] : undefined);
            const running = digestOf(process.env.IMAGE || "");
            const previous = process.env.PREVIOUS ? digestOf(process.env.PREVIOUS) : null;
            if (running === undefined || previous === undefined) {
              fail("OpsCrew could not tell which images the server runs, so it deleted none. The deploy itself succeeded.");
              return;
            }
            const protect = previous === null ? [running] : [running, previous];
            const keep = process.env.KEEP ? Number(process.env.KEEP) : undefined;
            // Untagged versions younger than 30 minutes stay: another environment may be pushing them.
            const recent = Date.now() - 30 * 60 * 1000;
            // Pull requests' images older than this go: no preview runs one that old.
            const previewsBefore = Date.now() - 31 * 24 * 60 * 60 * 1000;
            const [owner, repo] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            // The app's own package: ghcr.io/<owner>/<repo>.
            const name = repo;
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) {
                throw Object.assign(new Error(what + " answered HTTP " + response.status), { status: response.status });
              }
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });
            const pages = async (path, what, field) => {
              const all = [];
              for (let page = 1; ; page++) {
                const body = await read(await github("GET", path + (path.includes("?") ? "&" : "?") + "per_page=100&page=" + page), what);
                const batch = field === undefined ? body : body[field];
                all.push(...batch);
                if (batch.length < 100) return all;
              }
            };
            const packageVersions = async () => {
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              return (
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions"
              );
            };
            // The package's versions, and what each tagged or protected one lists.
            const survey = async (base, protect) => {
              const versions = (await pages(base, "The GitHub packages API")).map((v) => ({
                id: v.id,
                digest: v.name,
                tags: v.metadata.container.tags,
                created: v.created_at,
              }));
              const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
              const scope = "repository:" + owner + "/" + name + ":pull";
              const login = await read(
                await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                "GitHub Container Registry",
              );
              const children = {};
              const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
              for (const digest of new Set([...protect, ...tagged])) {
                const manifest = await read(
                  await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                    headers: {
                      Authorization: "Bearer " + login.token,
                      Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                    },
                  }),
                  "GitHub Container Registry",
                );
                children[digest] = (manifest.manifests || []).map((m) => m.digest);
              }
              return { versions, children };
            };
            // Another run may delete versions while this one reads them (one merge runs several
            // environments' workflows): the registry then answers 404 for a version the list still has.
            // Read it all again; a 404 that stays still stops, so nothing is deleted on a guess.
            const readPackage = async (base, protect) => {
              for (let attempt = 1; ; attempt++) {
                try {
                  return await survey(base, protect);
                } catch (error) {
                  if (error.status !== 404 || attempt === 3) throw error;
                  console.log("A version went while OpsCrew read the package (HTTP 404); reading it again in 20 s.");
                  await new Promise((resolve) => setTimeout(resolve, 20000));
                }
              }
            };
            const deleteVersions = async (base, versions, ids) => {
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else if (response.status === 404) {
                  // Another run deleted it first.
                  console.log("Already deleted: " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              return failed;
            };

            let deleting = false;
            try {
              // The app's environments: each has its OpsCrew deploy workflow, named "OpsCrew deploy" (prod)
              // or "OpsCrew deploy (<env>)".
              const environments = [];
              const workflows = await pages("/repos/" + owner + "/" + repo + "/actions/workflows", "The GitHub workflows API", "workflows");
              for (const w of workflows) {
                const match = /^OpsCrew deploy(?: \\(([a-z][a-z0-9-]*)\\))?$/.exec(w.name);
                if (match && w.state !== "deleted") environments.push(match[1] || "prod");
              }
              // None found means the workflows were renamed: no environment's labels could be kept.
              if (environments.length === 0) {
                fail(
                  'OpsCrew found no workflow named "OpsCrew deploy" in this repository, so it cannot tell which images the environments run, and it deleted none. The deploy itself succeeded; run "opscrew provision" to write the deploy workflow again.',
                );
                return;
              }
              const base = await packageVersions();
              const { versions, children } = await readPackage(base, protect);
              const ids = new Set(prunable(versions, children, keep, protect, recent, environments, previewsBefore));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + ".");
              deleting = true;
              const failed = await deleteVersions(base, versions, ids);
              if (failed > 0) {
                fail(failed + " image versions were not deleted; the next deploy tries again. The deploy itself succeeded.");
              }
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting old images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The deploy itself succeeded; the next deploy tries again.",
              );
            }
          }
          main();

  label:
    name: Label the deployed image
    needs: [build, verify, deploy]
    if: \${{ !cancelled() && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-prod, and the one before it opscrew-prod-previous
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-prod" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-prod\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-prod-previous" "$PREVIOUS"
          fi
"
`;

exports[`renderWorkflow for a Portainer target > matches the snapshots > updater 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app image, pushes it to GitHub Container Registry and writes it to the
# opscrew-deploy branch, which your Portainer deploys. Secrets are set by \`opscrew provision\`;
# their values never appear in this file.
name: OpsCrew deploy

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - "Dockerfile"
      - "opscrew/runtime/compose.yaml"
      - ".github/workflows/opscrew-deploy.yml"
  workflow_dispatch:
    inputs:
      digest:
        description: For a rollback, the image to deploy, by its digest (sha256:…); \`opscrew rollback\` fills it in.
        required: false
        type: string
        default: ""
      tag:
        description: For a rollback, the image's commit tag (<commit>, or <commit>-<env> outside prod); \`opscrew rollback\` fills it in.
        required: false
        type: string
        default: ""
      rollback:
        description: Deploy the image without running the release command, for a rollback; \`opscrew rollback\` sets it.
        required: false
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: opscrew-deploy
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ !(inputs.rollback) && contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/prod"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --resume --deploy\\\` deploys the branch's latest commit."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the image
    if: \${{ !inputs.rollback }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    outputs:
      image: \${{ steps.final.outputs.ref }}
      tag: \${{ steps.image.outputs.image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: image
        name: Choose the image name
        run: |
          set -euo pipefail
          repo="\${GITHUB_REPOSITORY,,}"
          echo "name=ghcr.io/\${repo}" >> "$GITHUB_OUTPUT"
          echo "image=ghcr.io/\${repo}:\${GITHUB_SHA}" >> "$GITHUB_OUTPUT"
      # Keeps the GitHub event (commit messages, emails) out of the provenance; it still names the
      # workflow run, and the repository and commit of the checkout.
      - name: Set up Docker Buildx
        uses: <pin:ACTIONS.setupBuildx>
        with:
          driver-opts: provenance-add-gha=false
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: push
        name: Build and push the image
        uses: <pin:ACTIONS.buildPush>
        with:
          context: "."
          file: "Dockerfile"
          # The provenance records build arguments: only non-secret values go there.
          build-args: \${{ secrets.OPSCREW_BUILD_ENV }}
          secrets: \${{ secrets.OPSCREW_BUILD_SECRETS }}
          push: true
          tags: \${{ steps.image.outputs.image }}
          provenance: mode=max
          sbom: true
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - id: final
        name: Record the image digest
        env:
          NAME: \${{ steps.image.outputs.name }}
          DIGEST: \${{ steps.push.outputs.digest }}
        run: |
          set -euo pipefail
          ref="$NAME@$DIGEST"
          if [[ ! "$ref" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::Could not read the digest of the pushed image; re-run the workflow."
            exit 1
          fi
          echo "ref=$ref" >> "$GITHUB_OUTPUT"
          echo "Pushed \\\`$NAME:$GITHUB_SHA\\\` as \\\`$ref\\\`." >> "$GITHUB_STEP_SUMMARY"
      # The scan runs after the registry logout, so it never holds the job's packages: write token.
      - name: Scan the image (report only)
        env:
          IMAGE: \${{ steps.final.outputs.ref }}
        run: |
          set -euo pipefail
          docker pull --quiet "$IMAGE"
          docker logout ghcr.io
          if ! docker run --rm -v /var/run/docker.sock:/var/run/docker.sock <pin:IMAGES.trivy> image --no-progress --severity HIGH,CRITICAL --exit-code 0 "$IMAGE"; then
            echo "::warning::The image scan (Trivy) could not run, so this build has no scan report. The deploy goes on: the scan only reports."
          fi

  verify:
    name: Check where the image was built
    if: \${{ inputs.rollback }}
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: read
    outputs:
      image: \${{ steps.provenance.outputs.image }}
      tag: \${{ steps.provenance.outputs.tag }}
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: provenance
        name: Check the image's provenance
        env:
          DIGEST: \${{ inputs.digest }}
          TAG: \${{ inputs.tag }}
          BUILD_BRANCH: "main"
          GH_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The digest input is not an image digest (sha256: and 64 hexadecimal digits). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          name="ghcr.io/\${GITHUB_REPOSITORY,,}"
          image="$name@$DIGEST"
          if ! provenance="$(docker buildx imagetools inspect "$image" --format '{{json .Provenance}}')"; then
            echo "::error::GitHub Container Registry has no image $image. Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which choose an image that is there."
            exit 1
          fi
          # buildx names the run that built the image in runDetails.builder.id (per platform).
          mapfile -t runs < <(jq -r '.. | .runDetails?.builder?.id? // empty' <<< "$provenance" | sort -u)
          if [[ "\${#runs[@]}" -ne 1 || ! "\${runs[0]}" =~ ^https://github\\.com/([^/]+/[^/]+)/actions/runs/([0-9]+)/attempts/[0-9]+$ ]]; then
            echo "::error::The image's build provenance does not name one GitHub Actions run, so OpsCrew cannot tell where it was built. OpsCrew deploys a digest only when this repository's deploy workflow built it."
            exit 1
          fi
          built_in="\${BASH_REMATCH[1]}"
          run_id="\${BASH_REMATCH[2]}"
          if [[ "\${built_in,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built by a run of $built_in, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if ! record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run_id" --jq '"\\(.event) \\(.head_repository.full_name) \\(.head_branch) \\(.head_sha) \\(.path)"')"; then
            echo "::error::GitHub shows no run $run_id in this repository, which the image's provenance names as its build. OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          read -r event head_repo branch commit workflow <<< "$record"
          # The run's path can end with @<ref>, which the signing identity carries separately.
          workflow="\${workflow%%@*}"
          # A fork's pull request runs in this repository too, with its own branch name: only a push, or a
          # run started by hand, which takes write access (ADR 0023 D1), counts.
          if [[ "$event" != "push" && "$event" != "workflow_dispatch" ]]; then
            echo "::error::The image was built by a $event run, not by a push or a run started by hand. OpsCrew deploys a digest only when a push to $BUILD_BRANCH, or a run started by hand there, built it."
            exit 1
          fi
          if [[ "\${head_repo,,}" != "\${GITHUB_REPOSITORY,,}" ]]; then
            echo "::error::The image was built from the commits of $head_repo, not of this repository ($GITHUB_REPOSITORY). OpsCrew deploys a digest only when this repository built it."
            exit 1
          fi
          if [[ "$branch" != "$BUILD_BRANCH" ]]; then
            echo "::error::The image was built from the branch $branch, not from $BUILD_BRANCH, the branch that builds this environment's images. OpsCrew deploys a digest only when a build on $BUILD_BRANCH made it."
            exit 1
          fi
          # prod's build tags its commit, another environment's <commit>-<env>.
          if [[ "$TAG" != "$commit" && ! "$TAG" =~ ^$commit-[a-z][a-z0-9-]*$ ]]; then
            echo "::error::The tag input is not a commit tag of the image's build ($commit, or $commit-<environment>). Start this workflow with \\\`opscrew promote\\\` or \\\`opscrew rollback\\\`, which fill it in."
            exit 1
          fi
          if [[ "$(docker buildx imagetools inspect "$name:$TAG" --format '{{.Manifest.Digest}}')" != "$DIGEST" ]]; then
            echo "::error::The image is not the one tagged with its build's commit ($TAG): a later build of that commit replaced the tag, or the image was pushed another way. \\\`opscrew rollback --list\\\` shows the versions to roll back to, and \\\`opscrew promote\\\` takes the image another environment runs."
            exit 1
          fi
          {
            echo "image=$image"
            echo "tag=$name:$TAG"
            echo "identity=https://github.com/$GITHUB_REPOSITORY/$workflow@refs/heads/$branch"
          } >> "$GITHUB_OUTPUT"
          echo "Deploying \\\`$image\\\`, built by run $run_id from \\\`$commit\\\` on \\\`$branch\\\`." >> "$GITHUB_STEP_SUMMARY"

  deploy:
    name: Deploy to Portainer
    needs: [build, verify]
    if: \${{ !cancelled() && (needs.build.result == 'success' || needs.verify.result == 'success') && (inputs.rollback || !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/prod"')) }}
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: write
    outputs:
      previous: \${{ steps.write.outputs.previous_image }}
    steps:
      - uses: <pin:ACTIONS.checkout>
      - id: write
        name: Write the new version to the opscrew-deploy branch
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          MODE: \${{ inputs.rollback && 'rollback' || 'deploy' }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          if [[ ! -f opscrew/runtime/compose.yaml ]] || ! grep -qF __OPSCREW_APP_IMAGE__ opscrew/runtime/compose.yaml; then
            echo "::error::opscrew/runtime/compose.yaml does not mark the app's image (__OPSCREW_APP_IMAGE__); run \\\`opscrew provision\\\` to write it again."
            exit 1
          fi
          template="$(cat opscrew/runtime/compose.yaml)"
          digest="\${IMAGE##*@sha256:}"
          compose="\${template//__OPSCREW_APP_IMAGE__/"$IMAGE"}"
          compose="\${compose//__OPSCREW_APP_VERSION__/"\${digest:0:12}"}"
          if [[ "$MODE" == rollback ]]; then
            release=skip
            subject="Roll back to $IMAGE"
            body="Written by opscrew rollback through the OpsCrew deploy workflow: no build, and no release command."
          else
            release=run
            subject="Deploy $IMAGE"
            body="Built from $GITHUB_SHA by the OpsCrew deploy workflow."
          fi
          compose="\${compose//__OPSCREW_RELEASE__/"$release"}"
          printf '%s\\n' "$compose" > "$RUNNER_TEMP/compose.yaml"
          export GIT_AUTHOR_NAME='github-actions[bot]' GIT_AUTHOR_EMAIL='41898282+github-actions[bot]@users.noreply.github.com'
          export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
          tree="$(printf '100644 blob %s\\tcompose.yaml\\n' "$(git hash-object -w "$RUNNER_TEMP/compose.yaml")" | git mktree)"
          previous=""
          previous_image=""
          parent=()
          remote="$(git ls-remote origin refs/heads/opscrew-deploy)"
          if [[ -n "$remote" ]]; then
            git fetch --no-tags --depth=1 origin +refs/heads/opscrew-deploy:refs/remotes/origin/opscrew-deploy
            previous="$(git rev-parse refs/remotes/origin/opscrew-deploy)"
            parent=(-p "$previous")
            previous_image="$(git show "$previous:compose.yaml" | grep -o "\${IMAGE%@*}@sha256:[0-9a-f]\\{64\\}" | head -n 1 || true)"
          fi
          echo "previous_image=$previous_image" >> "$GITHUB_OUTPUT"
          if [[ -n "$previous" && "$(git rev-parse "$previous^{tree}")" == "$tree" ]]; then
            echo "The opscrew-deploy branch already holds this version."
            echo "changed=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          deployed="$(git commit-tree "$tree" "\${parent[@]}" -m "$subject" -m "$body")"
          git push origin "$deployed:refs/heads/opscrew-deploy"
          {
            echo "previous=$previous"
            echo "deployed=$deployed"
            echo "changed=true"
          } >> "$GITHUB_OUTPUT"
          echo "Wrote \\\`$IMAGE\\\` to the \\\`opscrew-deploy\\\` branch." >> "$GITHUB_STEP_SUMMARY"
      - id: health
        name: Wait until the new version answers
        env:
          URL: https://shop.example.com/api/health
          VERSION_URL: https://shop.example.com/.well-known/opscrew-version
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
        run: |
          set -euo pipefail
          digest="\${IMAGE##*@sha256:}"
          want="\${digest:0:12}"
          state=down
          for attempt in $(seq 1 60); do
            if ! seen="$(curl -fsS --max-time 10 "$VERSION_URL")"; then
              state=down
            elif [[ "$seen" != "$want" ]]; then
              state=previous
            elif curl -fsS --max-time 10 -o /dev/null "$URL"; then
              echo "The new version answers after $attempt attempt(s)."
              exit 0
            else
              state=down
            fi
            sleep 10
          done
          if [[ "$state" == previous ]]; then
            echo "::error::After 10 minutes the site at $URL still runs the previous version: Portainer did not deploy the new one. Portainer shows why under Stacks → opscrew-shop."
          else
            echo "::error::The new version did not answer at $URL within 10 minutes. Portainer shows why under Stacks → opscrew-shop."
          fi
          exit 1
      - name: Roll back to the previous version
        if: (failure() || cancelled()) && steps.write.outputs.changed == 'true'
        env:
          PREVIOUS: \${{ steps.write.outputs.previous }}
          DEPLOYED: \${{ steps.write.outputs.deployed }}
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
        run: |
          set -uo pipefail
          if [[ -z "$PREVIOUS" ]]; then
            echo "::error::The deploy failed and the opscrew-deploy branch had no earlier version to restore. Fix the problem and push again."
            exit 1
          fi
          export GIT_AUTHOR_NAME='github-actions[bot]' GIT_AUTHOR_EMAIL='41898282+github-actions[bot]@users.noreply.github.com'
          export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
          if ! git show "$PREVIOUS:compose.yaml" | sed 's/^\\([[:space:]]*OPSCREW_RELEASE: \\)run$/\\1skip/' > "$RUNNER_TEMP/revert.yaml" ||
            ! tree="$(printf '100644 blob %s\\tcompose.yaml\\n' "$(git hash-object -w "$RUNNER_TEMP/revert.yaml")" | git mktree)" ||
            ! restored="$(git commit-tree "$tree" -p "$DEPLOYED" -m "Roll back to the previous version" -m "$IMAGE did not come up; OpsCrew wrote the version before it back, without its release command.")" ||
            ! git push origin "$restored:refs/heads/opscrew-deploy"; then
            echo "::error::The deploy failed and OpsCrew could not write the previous version back to the opscrew-deploy branch. Write the compose.yaml of the commit before the newest one back to that branch by hand."
            exit 1
          fi
          echo "::error::The deploy failed; OpsCrew wrote the previous version back to the opscrew-deploy branch, and Portainer's updater deploys it within about a minute."
          exit 1

  prune:
    name: Delete old images
    needs: [build, deploy]
    if: \${{ !cancelled() && needs.build.result == 'success' && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      actions: read
      packages: write
    steps:
      - name: Keep the newest 10 images; delete older, intermediate and old pull request images
        shell: node {0}
        env:
          TOKEN: \${{ secrets.GITHUB_TOKEN }}
          IMAGE: \${{ needs.build.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
          KEEP: "10"
        run: |
          // OpsCrew image retention (opscrew/plan.yaml, cicd.imageRetention): deletes old versions of
          // this repository's image from GitHub Container Registry.

          /**
           * The ids of the package versions to delete.
           * versions: [{ id, digest, tags, created }], as the GitHub API lists them.
           * children: by digest, the digests an image index lists (its platform manifests and attestations).
           * keep: how many <commit> versions to keep, newest first; undefined (retention off) deletes only
           * the build-<commit> intermediates, old pull requests' images and what only they list.
           * protect: digests never deleted: the running and the previous image.
           * recent: a time (milliseconds since 1970): an untagged version created since then stays unless
           * a version deleted here lists it, since another environment's build may be pushing it right now.
           * environments: the names of the app's environments (prod and each one beside it).
           * previewsBefore: a time (milliseconds since 1970): a version whose every tag is a pull request's
           * (pr-<n>-<commit>, build-pr-<n>-<commit>) created before then goes, retention on or off.
           *
           * Kept: the protected digests, every version the label tags of one of the environments mark
           * (opscrew-<env>, the image it runs, and opscrew-<env>-previous, the one before), the newest keep
           * <commit> versions, versions with a tag this environment's builds did not push and that is no
           * other opscrew-* tag (yours, Buildpacks' caches, another environment's images, pull requests'
           * images until previewsBefore), signatures of kept images, and whatever a kept index lists, tagged
           * or not. Deleted: build-<commit> intermediates, older <commit> versions with their
           * signatures, old pull requests' images, and untagged versions nothing kept lists, once they are
           * older than recent.
           */
          function prunable(versions, children, keep, protect, recent, environments, previewsBefore) {
            const commit = (tag) => /^[0-9a-f]{40}$/.test(tag);
            const build = (tag) => /^build-[0-9a-f]{40}$/.test(tag);
            const pull = (tag) => /^(?:build-)?pr-([1-9][0-9]{0,5})-[0-9a-f]{40}$/.test(tag);
            const oldPull = (v) => v.tags.length > 0 && v.tags.every(pull) && Date.parse(v.created) < previewsBefore;
            const labels = new Set(environments.flatMap((env) => ["opscrew-" + env, "opscrew-" + env + "-previous"]));
            const label = (tag) => labels.has(tag);
            // An opscrew-* tag that labels none of the environments (one removed since, a stray one).
            const strayLabel = (tag) => /^opscrew-[a-z][a-z0-9-]*$/.test(tag) && !label(tag);
            const subject = (tag) => {
              const match = /^sha256-([0-9a-f]{64})(\\.[a-z]+)?$/.exec(tag);
              return match ? "sha256:" + match[1] : undefined;
            };
            const ours = (tag) => commit(tag) || build(tag) || subject(tag) !== undefined || strayLabel(tag);
            const listed = (digests) => new Set([...digests].flatMap((digest) => children[digest] || []));

            const kept = new Set(protect);
            for (const v of versions) if (v.tags.some(label)) kept.add(v.digest);
            if (keep === undefined) {
              for (const v of versions) if (!v.tags.every(build) && !oldPull(v)) kept.add(v.digest);
            } else {
              const deployed = versions
                .filter((v) => v.tags.some(commit))
                .sort((a, b) => b.created.localeCompare(a.created) || b.id - a.id);
              for (const v of deployed.slice(0, keep)) kept.add(v.digest);
              for (const v of versions) if (!v.tags.every(ours) && !oldPull(v)) kept.add(v.digest);
              for (const v of versions) if (v.tags.some((tag) => kept.has(subject(tag)))) kept.add(v.digest);
            }

            // Everything a kept version lists, and what that lists in turn, stays.
            const reach = (digests) => {
              const seen = new Set(digests);
              const queue = [...digests];
              while (queue.length > 0) {
                for (const digest of children[queue.pop()] || []) {
                  if (!seen.has(digest)) {
                    seen.add(digest);
                    queue.push(digest);
                  }
                }
              }
              return seen;
            };
            const reachable = reach(kept);
            const goes = (v) => !reachable.has(v.digest);
            const listedByDeleted = listed(versions.filter((v) => v.tags.length > 0 && goes(v)).map((v) => v.digest));
            // Another environment's build pushes its platform manifests and attestations untagged, moments
            // before the index that lists them: until then nothing lists them, so a recent one stays.
            const old = (v) => Date.parse(v.created) < recent;
            return versions
              .filter((v) => goes(v) && (v.tags.length > 0 || listedByDeleted.has(v.digest) || (keep !== undefined && old(v))))
              .map((v) => v.id);
          }

          async function main() {
            const fail = (message) => {
              console.log("::error::" + message);
              process.exitCode = 1;
            };
            const digestRef = new RegExp("^ghcr\\\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$");
            const digestOf = (ref) => (digestRef.test(ref) ? ref.split("@")[1] : undefined);
            const running = digestOf(process.env.IMAGE || "");
            const previous = process.env.PREVIOUS ? digestOf(process.env.PREVIOUS) : null;
            if (running === undefined || previous === undefined) {
              fail("OpsCrew could not tell which images the server runs, so it deleted none. The deploy itself succeeded.");
              return;
            }
            const protect = previous === null ? [running] : [running, previous];
            const keep = process.env.KEEP ? Number(process.env.KEEP) : undefined;
            // Untagged versions younger than 30 minutes stay: another environment may be pushing them.
            const recent = Date.now() - 30 * 60 * 1000;
            // Pull requests' images older than this go: no preview runs one that old.
            const previewsBefore = Date.now() - 31 * 24 * 60 * 60 * 1000;
            const [owner, repo] = process.env.GITHUB_REPOSITORY.toLowerCase().split("/");
            // The app's own package: ghcr.io/<owner>/<repo>.
            const name = repo;
            const token = process.env.TOKEN;
            const read = async (response, what) => {
              if (!response.ok) {
                throw Object.assign(new Error(what + " answered HTTP " + response.status), { status: response.status });
              }
              return response.json();
            };
            const github = (method, path) =>
              fetch("https://api.github.com" + path, {
                method,
                headers: {
                  Accept: "application/vnd.github+json",
                  Authorization: "Bearer " + token,
                  "X-GitHub-Api-Version": "2022-11-28",
                },
              });
            const pages = async (path, what, field) => {
              const all = [];
              for (let page = 1; ; page++) {
                const body = await read(await github("GET", path + (path.includes("?") ? "&" : "?") + "per_page=100&page=" + page), what);
                const batch = field === undefined ? body : body[field];
                all.push(...batch);
                if (batch.length < 100) return all;
              }
            };
            const packageVersions = async () => {
              const user = await read(await github("GET", "/users/" + owner), "The GitHub users API");
              return (
                (user.type === "Organization" ? "/orgs/" : "/users/") +
                owner + "/packages/container/" + encodeURIComponent(name) + "/versions"
              );
            };
            // The package's versions, and what each tagged or protected one lists.
            const survey = async (base, protect) => {
              const versions = (await pages(base, "The GitHub packages API")).map((v) => ({
                id: v.id,
                digest: v.name,
                tags: v.metadata.container.tags,
                created: v.created_at,
              }));
              const basic = Buffer.from(process.env.GITHUB_ACTOR + ":" + token).toString("base64");
              const scope = "repository:" + owner + "/" + name + ":pull";
              const login = await read(
                await fetch("https://ghcr.io/token?service=ghcr.io&scope=" + scope, { headers: { Authorization: "Basic " + basic } }),
                "GitHub Container Registry",
              );
              const children = {};
              const tagged = versions.filter((v) => v.tags.length > 0).map((v) => v.digest);
              for (const digest of new Set([...protect, ...tagged])) {
                const manifest = await read(
                  await fetch("https://ghcr.io/v2/" + owner + "/" + name + "/manifests/" + digest, {
                    headers: {
                      Authorization: "Bearer " + login.token,
                      Accept: "application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json",
                    },
                  }),
                  "GitHub Container Registry",
                );
                children[digest] = (manifest.manifests || []).map((m) => m.digest);
              }
              return { versions, children };
            };
            // Another run may delete versions while this one reads them (one merge runs several
            // environments' workflows): the registry then answers 404 for a version the list still has.
            // Read it all again; a 404 that stays still stops, so nothing is deleted on a guess.
            const readPackage = async (base, protect) => {
              for (let attempt = 1; ; attempt++) {
                try {
                  return await survey(base, protect);
                } catch (error) {
                  if (error.status !== 404 || attempt === 3) throw error;
                  console.log("A version went while OpsCrew read the package (HTTP 404); reading it again in 20 s.");
                  await new Promise((resolve) => setTimeout(resolve, 20000));
                }
              }
            };
            const deleteVersions = async (base, versions, ids) => {
              let failed = 0;
              for (const v of versions.filter((version) => ids.has(version.id))) {
                const response = await github("DELETE", base + "/" + v.id);
                const what = v.digest + (v.tags.length > 0 ? " (" + v.tags.join(", ") + ")" : "");
                if (response.ok) {
                  console.log("Deleted " + what);
                } else if (response.status === 404) {
                  // Another run deleted it first.
                  console.log("Already deleted: " + what);
                } else {
                  failed++;
                  console.log("::warning::GitHub did not delete " + what + ": HTTP " + response.status + ".");
                }
              }
              return failed;
            };

            let deleting = false;
            try {
              // The app's environments: each has its OpsCrew deploy workflow, named "OpsCrew deploy" (prod)
              // or "OpsCrew deploy (<env>)".
              const environments = [];
              const workflows = await pages("/repos/" + owner + "/" + repo + "/actions/workflows", "The GitHub workflows API", "workflows");
              for (const w of workflows) {
                const match = /^OpsCrew deploy(?: \\(([a-z][a-z0-9-]*)\\))?$/.exec(w.name);
                if (match && w.state !== "deleted") environments.push(match[1] || "prod");
              }
              // None found means the workflows were renamed: no environment's labels could be kept.
              if (environments.length === 0) {
                fail(
                  'OpsCrew found no workflow named "OpsCrew deploy" in this repository, so it cannot tell which images the environments run, and it deleted none. The deploy itself succeeded; run "opscrew provision" to write the deploy workflow again.',
                );
                return;
              }
              const base = await packageVersions();
              const { versions, children } = await readPackage(base, protect);
              const ids = new Set(prunable(versions, children, keep, protect, recent, environments, previewsBefore));
              console.log("The package has " + versions.length + " image versions; deleting " + ids.size + ".");
              deleting = true;
              const failed = await deleteVersions(base, versions, ids);
              if (failed > 0) {
                fail(failed + " image versions were not deleted; the next deploy tries again. The deploy itself succeeded.");
              }
            } catch (error) {
              fail(
                (deleting ? "OpsCrew stopped deleting old images: " : "OpsCrew could not list the images, so it deleted none: ") +
                  error.message + ". The deploy itself succeeded; the next deploy tries again.",
              );
            }
          }
          main();

  label:
    name: Label the deployed image
    needs: [build, verify, deploy]
    if: \${{ !cancelled() && needs.deploy.result == 'success' }}
    runs-on: ubuntu-latest
    permissions:
      packages: write
    steps:
      - name: Log in to GitHub Container Registry
        uses: <pin:ACTIONS.login>
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - name: Tag the image opscrew-prod, and the one before it opscrew-prod-previous
        env:
          IMAGE: \${{ needs.build.outputs.image || needs.verify.outputs.image }}
          PREVIOUS: \${{ needs.deploy.outputs.previous }}
        run: |
          set -euo pipefail
          if [[ ! "$IMAGE" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ ]]; then
            echo "::error::The build job did not report the image digest; re-run the workflow."
            exit 1
          fi
          name="\${IMAGE%@*}"
          # Tag-only: the image keeps its digest, so its provenance and signature stay valid. The
          # running label first, so a failed previous label never leaves it stale.
          docker buildx imagetools create --tag "$name:opscrew-prod" "$IMAGE"
          echo "Labelled \\\`$IMAGE\\\` as \\\`opscrew-prod\\\`." >> "$GITHUB_STEP_SUMMARY"
          if [[ "\${PREVIOUS:-}" =~ ^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$ && "$PREVIOUS" != "$IMAGE" ]]; then
            docker buildx imagetools create --tag "$name:opscrew-prod-previous" "$PREVIOUS"
          fi
"
`;
