// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Alloy with monitoring > renders both destinations, on the app's server (snapshot) 1`] = `
{
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Grafana Alloy sends the app's logs, masked, to the monitoring stack, with the figures of
# the server, its containers, Caddy and Postgres.
# It also sends the logs and the server's figures to your Grafana Cloud stack.
# It reads Docker only through OpsCrew's read-only proxy, and the server's files read-only.
# The Grafana Cloud token is in a file beside this one that only the deploy user can read.
# Postgres's monitoring login is in a file beside this one that only the deploy user can read.
name: opscrew-alloy
services:
  proxy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 0:\${OPSCREW_DEPLOY_GID}
    network_mode: none
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_ro:/run/opscrew-docker-ro
    read_only: true
    tmpfs:
      - /data
      - /config
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 32m
    memswap_limit: 32m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  alloy:
    image: <pin:IMAGES.alloy>
    restart: unless-stopped
    hostname: opscrew-alloy-shop
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    command:
      - run
      - --storage.path=/var/lib/opscrew-alloy
      - --disable-reporting
      - --server.http.listen-addr=127.0.0.1:12345
      - /etc/alloy/config.alloy
    environment:
      GOMEMLIMIT: 204MiB
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - ./grafana_cloud_credential:/etc/alloy/grafana_cloud_credential:ro
      - ./postgres_monitor_credential:/etc/alloy/postgres_monitor_credential:ro
      - ./data:/var/lib/opscrew-alloy
      - docker_ro:/run/opscrew-docker-ro
      - /:/rootfs:ro
      - /sys:/sys:ro
    depends_on:
      - proxy
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 256m
    memswap_limit: 256m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - default
      - opscrew-edge
      - shop_internal
networks:
  default: {}
  opscrew-edge:
    external: true
  shop_internal:
    external: true
volumes:
  docker_ro: {}
",
  "config.alloy": "// Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.

// ---- The app's logs, from its Compose project's containers, through the read-only proxy ----
discovery.docker "app" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=shop"]
  }
}

discovery.relabel "app" {
  targets = discovery.docker.app.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "app" {
  host       = "unix:///run/opscrew-docker-ro/docker.sock"
  targets    = discovery.relabel.app.output
  labels     = { app = "shop", env = "prod", server = "app" }
  forward_to = [loki.process.mask.receiver]
}

// ---- Masking, before anything leaves the server ----
// The app's known values: each deploy writes them beside app.env as one RE2 alternation.
local.file "mask" {
  filename       = "/rootfs/srv/apps/shop/mask.re"
  is_secret      = true
  poll_frequency = "10s"
}

loki.process "mask" {
  // Values shaped like known kinds of token (OpsCrew's own patterns).
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(gh[pousr]_[A-Za-z0-9]{36,251})"
    replace    = "<opscrew:github-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(github_pat_[A-Za-z0-9_]{22,255})"
    replace    = "<opscrew:github-pat>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-ant-[A-Za-z0-9_-]{20,})"
    replace    = "<opscrew:anthropic-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{32,}))"
    replace    = "<opscrew:openai-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9])((?:AKIA|ASIA)[A-Z0-9]{16})"
    replace    = "<opscrew:aws-access-key-id>"
  }
  stage.replace {
    expression = "(?i)aws_?secret_?access_?key[\\"']?\\\\s*[=:]\\\\s*[\\"']?([A-Za-z0-9/+=]{40})"
    replace    = "<opscrew:aws-secret-access-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])((?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,})"
    replace    = "<opscrew:stripe-secret-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(xox[abposr]-[A-Za-z0-9-]{10,})"
    replace    = "<opscrew:slack-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(do[por]_v1_[0-9a-f]{64})"
    replace    = "<opscrew:digitalocean-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(AIza[0-9A-Za-z_-]{35})"
    replace    = "<opscrew:google-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(eyJ[A-Za-z0-9_-]{5,}\\\\.eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{10,})"
    replace    = "<opscrew:jwt>"
  }
  stage.replace {
    expression = convert.nonsensitive(local.file.mask.content)
    replace    = "<opscrew:known-value>"
  }
  forward_to = [loki.secretfilter.default.receiver]
}

// Gitleaks' rules, after OpsCrew's own. Then every masked line to the monitoring stack,
// and through the sampling (on Grafana Cloud's branch only) to Grafana Cloud.
loki.secretfilter "default" {
  redact_with = "<secretfilter:$SECRET_NAME>"
  forward_to  = [loki.write.monitoring.receiver, loki.process.grafana_cloud.receiver]
}

loki.process "grafana_cloud" {
  // 25% of the log lines (grafanaCloud.logSampling in the plan).
  stage.sampling {
    rate = 0.25
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

// ---- The server's CPU, load, memory and root filesystem ----
// Alloy's own /proc shows the whole server's; / and /sys are mounted read-only at /rootfs and /sys.
prometheus.exporter.unix "host" {
  rootfs_path    = "/rootfs"
  sysfs_path     = "/sys"
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem"]
  filesystem {
    mount_points_exclude = "^/.+"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.allow.receiver]
}

prometheus.relabel "allow" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_seconds_total|node_load(1|5|15)|node_memory_(MemTotal|MemAvailable)_bytes|node_filesystem_(size|avail)_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(nice|irq|softirq|guest|guest_nice)"
    action        = "drop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver, prometheus.remote_write.grafana_cloud.receiver]
}

// ---- Each container's figures: cAdvisor on the cgroups only ----
// Its Docker integration is off (a socket that doesn't exist): it would need containerd's socket
// or /var/lib/docker. The containers' names and Compose services come from discovery.docker,
// through the read-only proxy.
prometheus.exporter.cadvisor "containers" {
  docker_host                 = "unix:///nonexistent/docker.sock"
  docker_only                 = true
  raw_cgroup_prefix_allowlist = ["/docker/", "/system.slice/docker-"]
  enabled_metrics             = ["cpu", "memory", "oom_event", "network"]
  store_container_labels      = false
}

// One target per container of the app's Compose project and OpsCrew's own, each reading
// cAdvisor's figures on Alloy's own HTTP server and keeping that container's only.
discovery.docker "containers" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "shop|opscrew-edge|opscrew-beszel|opscrew-alloy|opscrew-monitoring"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    target_label = "__address__"
    replacement  = "127.0.0.1:12345"
  }
  rule {
    target_label = "__metrics_path__"
    replacement  = "/api/v0/component/prometheus.exporter.cadvisor.containers/metrics"
  }
  rule {
    target_label = "instance"
    replacement  = "opscrew-alloy-shop"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/cadvisor"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
  // The container's id from its cgroup: /docker/<id> (cgroupfs) or /system.slice/docker-<id>.scope
  // (systemd); kept only when it is this target's container.
  rule {
    source_labels = ["id"]
    regex         = ".*(?:/|docker-)([0-9a-f]{64})(?:[.]scope)?"
    target_label  = "cgroup_container_id"
  }
  rule {
    source_labels = ["cgroup_container_id"]
    target_label  = "container_id"
    action        = "keepequal"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|start_time_seconds|oom_events_total)"
    action        = "keep"
  }
  rule {
    regex  = "cgroup_container_id|id"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- The server's network traffic ----
// cAdvisor's root cgroup reads /rootfs/proc/1/net/dev (the server's network); Alloy's own
// /proc/net/dev is its bridge's.
prometheus.scrape "host_network" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  job_name        = "integrations/cadvisor_host"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.host_network.receiver]
}

prometheus.relabel "host_network" {
  rule {
    source_labels = ["__name__", "id"]
    regex         = "container_network_(receive|transmit)_bytes_total;/"
    action        = "keep"
  }
  // Loopback, Docker's bridges and container ends, and WireGuard (its traffic also crosses the
  // physical interface).
  rule {
    source_labels = ["interface"]
    regex         = "lo|veth.*|br-.*|docker.*|wg.*"
    action        = "drop"
  }
  rule {
    regex  = "id"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Caddy's figures, from its metrics site on the edge's network ----
prometheus.scrape "caddy" {
  targets         = [{ __address__ = "caddy:9180" }]
  job_name        = "caddy"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.caddy.receiver]
}

prometheus.relabel "caddy" {
  rule {
    source_labels = ["__name__"]
    regex         = "caddy_http_request_duration_seconds_(bucket|sum|count)|caddy_http_requests_in_flight|caddy_http_request_errors_total|process_(resident_memory_bytes|cpu_seconds_total)|up"
    action        = "keep"
  }
  // This app's hostnames only: the edge serves every OpsCrew app on the server. Series with no
  // host (Caddy's process) are kept.
  rule {
    source_labels = ["host"]
    regex         = "(|example\\\\.com|www\\\\.example\\\\.com)(:[0-9]+)?"
    action        = "keep"
  }
  // The metrics site's own requests (these scrapes).
  rule {
    source_labels = ["handler"]
    regex         = "metrics"
    action        = "drop"
  }
  // Caddy's own \`server\` label (srv0, srv1 …) would hide OpsCrew's: a series keeps its own label
  // over an external one. Renamed.
  rule {
    source_labels = ["server"]
    target_label  = "caddy_server"
  }
  rule {
    regex  = "server"
    action = "labeldrop"
  }
  // Its Compose service, as on its container's figures, so its process figures are told apart.
  rule {
    target_label = "service"
    replacement  = "caddy"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Postgres's figures, as opscrew_monitor (it can log in and read the statistics only) ----
local.file "postgres" {
  filename  = "/etc/alloy/postgres_monitor_credential"
  is_secret = true
}

prometheus.exporter.postgres "postgres" {
  data_source_names  = [local.file.postgres.content]
  enabled_collectors = ["database", "stat_database"]
}

prometheus.scrape "postgres" {
  targets         = prometheus.exporter.postgres.postgres.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.postgres.receiver]
}

prometheus.relabel "postgres" {
  rule {
    source_labels = ["__name__"]
    regex         = "pg_up|pg_settings_max_connections|pg_stat_activity_count|pg_stat_activity_max_tx_duration|pg_stat_database_(numbackends|xact_commit|xact_rollback|blks_hit|blks_read|deadlocks)|pg_database_size_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["datname"]
    regex         = "template[01]"
    action        = "drop"
  }
  // postgres_exporter's own \`server\` label (host:port, on pg_stat_activity_* and pg_settings_*)
  // would hide OpsCrew's, as Caddy's does. Renamed.
  rule {
    source_labels = ["server"]
    target_label  = "pg_server"
  }
  rule {
    regex  = "server"
    action = "labeldrop"
  }
  rule {
    target_label = "service"
    replacement  = "db"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Sending to the monitoring stack: its front, on the private network, with no login ----
loki.write "monitoring" {
  endpoint {
    url                 = "http://10.200.4.2:9091/loki/api/v1/push"
    // Lines wait in memory while the stack is away: 40 tries 30 seconds apart keep each batch
    // about 20 minutes, and send it within 30 seconds of the stack's return.
    max_backoff_period  = "30s"
    max_backoff_retries = 40
  }
}

prometheus.remote_write "monitoring" {
  external_labels = { app = "shop", env = "prod", server = "app" }
  endpoint {
    url = "http://10.200.4.2:9091/api/v1/write"
    // One shard: resharding while the stack is away drops the samples queued in the old shards.
    // The write-ahead log keeps the figures for up to 8 hours.
    queue_config {
      max_shards = 1
    }
  }
}

// ---- Sending to your Grafana Cloud stack ----
local.file "token" {
  filename  = "/etc/alloy/grafana_cloud_credential"
  is_secret = true
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-eu-west-0.grafana.net/loki/api/v1/push"
    basic_auth {
      username = "654321"
      password = local.file.token.content
    }
  }
}

prometheus.remote_write "grafana_cloud" {
  external_labels = { app = "shop", env = "prod" }
  endpoint {
    url = "https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push"
    basic_auth {
      username = "123456"
      password = local.file.token.content
    }
  }
}
",
}
`;

exports[`Alloy with monitoring > renders monitoring only, on an extra server with Postgres (snapshot) 1`] = `
{
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Grafana Alloy sends the app's logs, masked, to the monitoring stack, with the figures of
# the server, its containers and Postgres.
# It reads Docker only through OpsCrew's read-only proxy, and the server's files read-only.
# Postgres's monitoring login is in a file beside this one that only the deploy user can read.
name: opscrew-alloy
services:
  proxy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 0:\${OPSCREW_DEPLOY_GID}
    network_mode: none
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_ro:/run/opscrew-docker-ro
    read_only: true
    tmpfs:
      - /data
      - /config
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 32m
    memswap_limit: 32m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  alloy:
    image: <pin:IMAGES.alloy>
    restart: unless-stopped
    hostname: opscrew-alloy-shop
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    command:
      - run
      - --storage.path=/var/lib/opscrew-alloy
      - --disable-reporting
      - --server.http.listen-addr=127.0.0.1:12345
      - /etc/alloy/config.alloy
    environment:
      GOMEMLIMIT: 204MiB
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - ./postgres_monitor_credential:/etc/alloy/postgres_monitor_credential:ro
      - ./data:/var/lib/opscrew-alloy
      - docker_ro:/run/opscrew-docker-ro
      - /:/rootfs:ro
      - /sys:/sys:ro
    depends_on:
      - proxy
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 256m
    memswap_limit: 256m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - default
      - shop_internal
networks:
  default: {}
  shop_internal:
    external: true
volumes:
  docker_ro: {}
",
  "config.alloy": "// Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.

// ---- The app's logs, from its Compose project's containers, through the read-only proxy ----
discovery.docker "app" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=shop"]
  }
}

discovery.relabel "app" {
  targets = discovery.docker.app.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "app" {
  host       = "unix:///run/opscrew-docker-ro/docker.sock"
  targets    = discovery.relabel.app.output
  labels     = { app = "shop", env = "prod", server = "db1" }
  forward_to = [loki.process.mask.receiver]
}

// ---- Masking, before anything leaves the server ----
// The app's known values: each deploy writes them beside app.env as one RE2 alternation.
local.file "mask" {
  filename       = "/rootfs/srv/apps/shop/mask.re"
  is_secret      = true
  poll_frequency = "10s"
}

loki.process "mask" {
  // Values shaped like known kinds of token (OpsCrew's own patterns).
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(gh[pousr]_[A-Za-z0-9]{36,251})"
    replace    = "<opscrew:github-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(github_pat_[A-Za-z0-9_]{22,255})"
    replace    = "<opscrew:github-pat>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-ant-[A-Za-z0-9_-]{20,})"
    replace    = "<opscrew:anthropic-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{32,}))"
    replace    = "<opscrew:openai-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9])((?:AKIA|ASIA)[A-Z0-9]{16})"
    replace    = "<opscrew:aws-access-key-id>"
  }
  stage.replace {
    expression = "(?i)aws_?secret_?access_?key[\\"']?\\\\s*[=:]\\\\s*[\\"']?([A-Za-z0-9/+=]{40})"
    replace    = "<opscrew:aws-secret-access-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])((?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,})"
    replace    = "<opscrew:stripe-secret-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(xox[abposr]-[A-Za-z0-9-]{10,})"
    replace    = "<opscrew:slack-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(do[por]_v1_[0-9a-f]{64})"
    replace    = "<opscrew:digitalocean-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(AIza[0-9A-Za-z_-]{35})"
    replace    = "<opscrew:google-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(eyJ[A-Za-z0-9_-]{5,}\\\\.eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{10,})"
    replace    = "<opscrew:jwt>"
  }
  stage.replace {
    expression = convert.nonsensitive(local.file.mask.content)
    replace    = "<opscrew:known-value>"
  }
  forward_to = [loki.secretfilter.default.receiver]
}

// Gitleaks' rules, after OpsCrew's own. Then every masked line to the monitoring stack.
loki.secretfilter "default" {
  redact_with = "<secretfilter:$SECRET_NAME>"
  forward_to  = [loki.write.monitoring.receiver]
}

// ---- The server's CPU, load, memory and root filesystem ----
// Alloy's own /proc shows the whole server's; / and /sys are mounted read-only at /rootfs and /sys.
prometheus.exporter.unix "host" {
  rootfs_path    = "/rootfs"
  sysfs_path     = "/sys"
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem"]
  filesystem {
    mount_points_exclude = "^/.+"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.allow.receiver]
}

prometheus.relabel "allow" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_seconds_total|node_load(1|5|15)|node_memory_(MemTotal|MemAvailable)_bytes|node_filesystem_(size|avail)_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(nice|irq|softirq|guest|guest_nice)"
    action        = "drop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Each container's figures: cAdvisor on the cgroups only ----
// Its Docker integration is off (a socket that doesn't exist): it would need containerd's socket
// or /var/lib/docker. The containers' names and Compose services come from discovery.docker,
// through the read-only proxy.
prometheus.exporter.cadvisor "containers" {
  docker_host                 = "unix:///nonexistent/docker.sock"
  docker_only                 = true
  raw_cgroup_prefix_allowlist = ["/docker/", "/system.slice/docker-"]
  enabled_metrics             = ["cpu", "memory", "oom_event", "network"]
  store_container_labels      = false
}

// One target per container of the app's Compose project and OpsCrew's own, each reading
// cAdvisor's figures on Alloy's own HTTP server and keeping that container's only.
discovery.docker "containers" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "shop|opscrew-edge|opscrew-beszel|opscrew-alloy|opscrew-monitoring"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    target_label = "__address__"
    replacement  = "127.0.0.1:12345"
  }
  rule {
    target_label = "__metrics_path__"
    replacement  = "/api/v0/component/prometheus.exporter.cadvisor.containers/metrics"
  }
  rule {
    target_label = "instance"
    replacement  = "opscrew-alloy-shop"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/cadvisor"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
  // The container's id from its cgroup: /docker/<id> (cgroupfs) or /system.slice/docker-<id>.scope
  // (systemd); kept only when it is this target's container.
  rule {
    source_labels = ["id"]
    regex         = ".*(?:/|docker-)([0-9a-f]{64})(?:[.]scope)?"
    target_label  = "cgroup_container_id"
  }
  rule {
    source_labels = ["cgroup_container_id"]
    target_label  = "container_id"
    action        = "keepequal"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|start_time_seconds|oom_events_total)"
    action        = "keep"
  }
  rule {
    regex  = "cgroup_container_id|id"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- The server's network traffic ----
// cAdvisor's root cgroup reads /rootfs/proc/1/net/dev (the server's network); Alloy's own
// /proc/net/dev is its bridge's.
prometheus.scrape "host_network" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  job_name        = "integrations/cadvisor_host"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.host_network.receiver]
}

prometheus.relabel "host_network" {
  rule {
    source_labels = ["__name__", "id"]
    regex         = "container_network_(receive|transmit)_bytes_total;/"
    action        = "keep"
  }
  // Loopback, Docker's bridges and container ends, and WireGuard (its traffic also crosses the
  // physical interface).
  rule {
    source_labels = ["interface"]
    regex         = "lo|veth.*|br-.*|docker.*|wg.*"
    action        = "drop"
  }
  rule {
    regex  = "id"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Postgres's figures, as opscrew_monitor (it can log in and read the statistics only) ----
local.file "postgres" {
  filename  = "/etc/alloy/postgres_monitor_credential"
  is_secret = true
}

prometheus.exporter.postgres "postgres" {
  data_source_names  = [local.file.postgres.content]
  enabled_collectors = ["database", "stat_database"]
}

prometheus.scrape "postgres" {
  targets         = prometheus.exporter.postgres.postgres.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.postgres.receiver]
}

prometheus.relabel "postgres" {
  rule {
    source_labels = ["__name__"]
    regex         = "pg_up|pg_settings_max_connections|pg_stat_activity_count|pg_stat_activity_max_tx_duration|pg_stat_database_(numbackends|xact_commit|xact_rollback|blks_hit|blks_read|deadlocks)|pg_database_size_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["datname"]
    regex         = "template[01]"
    action        = "drop"
  }
  // postgres_exporter's own \`server\` label (host:port, on pg_stat_activity_* and pg_settings_*)
  // would hide OpsCrew's, as Caddy's does. Renamed.
  rule {
    source_labels = ["server"]
    target_label  = "pg_server"
  }
  rule {
    regex  = "server"
    action = "labeldrop"
  }
  rule {
    target_label = "service"
    replacement  = "db"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Sending to the monitoring stack: its front, on the private network, with no login ----
loki.write "monitoring" {
  endpoint {
    url                 = "http://10.200.4.2:9091/loki/api/v1/push"
    // Lines wait in memory while the stack is away: 40 tries 30 seconds apart keep each batch
    // about 20 minutes, and send it within 30 seconds of the stack's return.
    max_backoff_period  = "30s"
    max_backoff_retries = 40
  }
}

prometheus.remote_write "monitoring" {
  external_labels = { app = "shop", env = "prod", server = "db1" }
  endpoint {
    url = "http://10.200.4.2:9091/api/v1/write"
    // One shard: resharding while the stack is away drops the samples queued in the old shards.
    // The write-ahead log keeps the figures for up to 8 hours.
    queue_config {
      max_shards = 1
    }
  }
}
",
}
`;

exports[`Alloy with monitoring > renders monitoring only, on the app's server (snapshot) 1`] = `
{
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Grafana Alloy sends the app's logs, masked, to the monitoring stack, with the figures of
# the server, its containers and Caddy.
# It reads Docker only through OpsCrew's read-only proxy, and the server's files read-only.
name: opscrew-alloy
services:
  proxy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 0:\${OPSCREW_DEPLOY_GID}
    network_mode: none
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_ro:/run/opscrew-docker-ro
    read_only: true
    tmpfs:
      - /data
      - /config
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 32m
    memswap_limit: 32m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  alloy:
    image: <pin:IMAGES.alloy>
    restart: unless-stopped
    hostname: opscrew-alloy-shop
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    command:
      - run
      - --storage.path=/var/lib/opscrew-alloy
      - --disable-reporting
      - --server.http.listen-addr=127.0.0.1:12345
      - /etc/alloy/config.alloy
    environment:
      GOMEMLIMIT: 204MiB
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - ./data:/var/lib/opscrew-alloy
      - docker_ro:/run/opscrew-docker-ro
      - /:/rootfs:ro
      - /sys:/sys:ro
    depends_on:
      - proxy
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 256m
    memswap_limit: 256m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - default
      - opscrew-edge
networks:
  default: {}
  opscrew-edge:
    external: true
volumes:
  docker_ro: {}
",
  "config.alloy": "// Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.

// ---- The app's logs, from its Compose project's containers, through the read-only proxy ----
discovery.docker "app" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=shop"]
  }
}

discovery.relabel "app" {
  targets = discovery.docker.app.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "app" {
  host       = "unix:///run/opscrew-docker-ro/docker.sock"
  targets    = discovery.relabel.app.output
  labels     = { app = "shop", env = "prod", server = "app" }
  forward_to = [loki.process.mask.receiver]
}

// ---- Masking, before anything leaves the server ----
// The app's known values: each deploy writes them beside app.env as one RE2 alternation.
local.file "mask" {
  filename       = "/rootfs/srv/apps/shop/mask.re"
  is_secret      = true
  poll_frequency = "10s"
}

loki.process "mask" {
  // Values shaped like known kinds of token (OpsCrew's own patterns).
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(gh[pousr]_[A-Za-z0-9]{36,251})"
    replace    = "<opscrew:github-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(github_pat_[A-Za-z0-9_]{22,255})"
    replace    = "<opscrew:github-pat>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-ant-[A-Za-z0-9_-]{20,})"
    replace    = "<opscrew:anthropic-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{32,}))"
    replace    = "<opscrew:openai-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9])((?:AKIA|ASIA)[A-Z0-9]{16})"
    replace    = "<opscrew:aws-access-key-id>"
  }
  stage.replace {
    expression = "(?i)aws_?secret_?access_?key[\\"']?\\\\s*[=:]\\\\s*[\\"']?([A-Za-z0-9/+=]{40})"
    replace    = "<opscrew:aws-secret-access-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])((?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,})"
    replace    = "<opscrew:stripe-secret-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(xox[abposr]-[A-Za-z0-9-]{10,})"
    replace    = "<opscrew:slack-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(do[por]_v1_[0-9a-f]{64})"
    replace    = "<opscrew:digitalocean-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(AIza[0-9A-Za-z_-]{35})"
    replace    = "<opscrew:google-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(eyJ[A-Za-z0-9_-]{5,}\\\\.eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{10,})"
    replace    = "<opscrew:jwt>"
  }
  stage.replace {
    expression = convert.nonsensitive(local.file.mask.content)
    replace    = "<opscrew:known-value>"
  }
  forward_to = [loki.secretfilter.default.receiver]
}

// Gitleaks' rules, after OpsCrew's own. Then every masked line to the monitoring stack.
loki.secretfilter "default" {
  redact_with = "<secretfilter:$SECRET_NAME>"
  forward_to  = [loki.write.monitoring.receiver]
}

// ---- The server's CPU, load, memory and root filesystem ----
// Alloy's own /proc shows the whole server's; / and /sys are mounted read-only at /rootfs and /sys.
prometheus.exporter.unix "host" {
  rootfs_path    = "/rootfs"
  sysfs_path     = "/sys"
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem"]
  filesystem {
    mount_points_exclude = "^/.+"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.allow.receiver]
}

prometheus.relabel "allow" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_seconds_total|node_load(1|5|15)|node_memory_(MemTotal|MemAvailable)_bytes|node_filesystem_(size|avail)_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(nice|irq|softirq|guest|guest_nice)"
    action        = "drop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Each container's figures: cAdvisor on the cgroups only ----
// Its Docker integration is off (a socket that doesn't exist): it would need containerd's socket
// or /var/lib/docker. The containers' names and Compose services come from discovery.docker,
// through the read-only proxy.
prometheus.exporter.cadvisor "containers" {
  docker_host                 = "unix:///nonexistent/docker.sock"
  docker_only                 = true
  raw_cgroup_prefix_allowlist = ["/docker/", "/system.slice/docker-"]
  enabled_metrics             = ["cpu", "memory", "oom_event", "network"]
  store_container_labels      = false
}

// One target per container of the app's Compose project and OpsCrew's own, each reading
// cAdvisor's figures on Alloy's own HTTP server and keeping that container's only.
discovery.docker "containers" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "shop|opscrew-edge|opscrew-beszel|opscrew-alloy|opscrew-monitoring"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    target_label = "__address__"
    replacement  = "127.0.0.1:12345"
  }
  rule {
    target_label = "__metrics_path__"
    replacement  = "/api/v0/component/prometheus.exporter.cadvisor.containers/metrics"
  }
  rule {
    target_label = "instance"
    replacement  = "opscrew-alloy-shop"
  }
  rule {
    target_label = "job"
    replacement  = "integrations/cadvisor"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

prometheus.relabel "containers" {
  // The container's id from its cgroup: /docker/<id> (cgroupfs) or /system.slice/docker-<id>.scope
  // (systemd); kept only when it is this target's container.
  rule {
    source_labels = ["id"]
    regex         = ".*(?:/|docker-)([0-9a-f]{64})(?:[.]scope)?"
    target_label  = "cgroup_container_id"
  }
  rule {
    source_labels = ["cgroup_container_id"]
    target_label  = "container_id"
    action        = "keepequal"
  }
  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|start_time_seconds|oom_events_total)"
    action        = "keep"
  }
  rule {
    regex  = "cgroup_container_id|id"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- The server's network traffic ----
// cAdvisor's root cgroup reads /rootfs/proc/1/net/dev (the server's network); Alloy's own
// /proc/net/dev is its bridge's.
prometheus.scrape "host_network" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  job_name        = "integrations/cadvisor_host"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.host_network.receiver]
}

prometheus.relabel "host_network" {
  rule {
    source_labels = ["__name__", "id"]
    regex         = "container_network_(receive|transmit)_bytes_total;/"
    action        = "keep"
  }
  // Loopback, Docker's bridges and container ends, and WireGuard (its traffic also crosses the
  // physical interface).
  rule {
    source_labels = ["interface"]
    regex         = "lo|veth.*|br-.*|docker.*|wg.*"
    action        = "drop"
  }
  rule {
    regex  = "id"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Caddy's figures, from its metrics site on the edge's network ----
prometheus.scrape "caddy" {
  targets         = [{ __address__ = "caddy:9180" }]
  job_name        = "caddy"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.caddy.receiver]
}

prometheus.relabel "caddy" {
  rule {
    source_labels = ["__name__"]
    regex         = "caddy_http_request_duration_seconds_(bucket|sum|count)|caddy_http_requests_in_flight|caddy_http_request_errors_total|process_(resident_memory_bytes|cpu_seconds_total)|up"
    action        = "keep"
  }
  // This app's hostnames only: the edge serves every OpsCrew app on the server. Series with no
  // host (Caddy's process) are kept.
  rule {
    source_labels = ["host"]
    regex         = "(|example\\\\.com|www\\\\.example\\\\.com)(:[0-9]+)?"
    action        = "keep"
  }
  // The metrics site's own requests (these scrapes).
  rule {
    source_labels = ["handler"]
    regex         = "metrics"
    action        = "drop"
  }
  // Caddy's own \`server\` label (srv0, srv1 …) would hide OpsCrew's: a series keeps its own label
  // over an external one. Renamed.
  rule {
    source_labels = ["server"]
    target_label  = "caddy_server"
  }
  rule {
    regex  = "server"
    action = "labeldrop"
  }
  // Its Compose service, as on its container's figures, so its process figures are told apart.
  rule {
    target_label = "service"
    replacement  = "caddy"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ---- Sending to the monitoring stack: its front, on the private network, with no login ----
loki.write "monitoring" {
  endpoint {
    url                 = "http://10.200.4.2:9091/loki/api/v1/push"
    // Lines wait in memory while the stack is away: 40 tries 30 seconds apart keep each batch
    // about 20 minutes, and send it within 30 seconds of the stack's return.
    max_backoff_period  = "30s"
    max_backoff_retries = 40
  }
}

prometheus.remote_write "monitoring" {
  external_labels = { app = "shop", env = "prod", server = "app" }
  endpoint {
    url = "http://10.200.4.2:9091/api/v1/write"
    // One shard: resharding while the stack is away drops the samples queued in the old shards.
    // The write-ahead log keeps the figures for up to 8 hours.
    queue_config {
      max_shards = 1
    }
  }
}
",
}
`;
