// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderAddon > renders Beszel, agent mode (snapshot) 1`] = `
{
  "Caddyfile": "# Generated by OpsCrew: Docker's API for the add-on, read-only. Only GET and HEAD on the paths
# below reach Docker; anything else (starting, stopping, exec, files, images, volumes) gets 403.
{
	admin off
	auto_https off
	persist_config off
}

http:// {
	bind unix//run/opscrew-docker-ro/docker.sock|0660
	@allowed {
		method GET HEAD
		path_regexp ^(/v1\\.[0-9]+)?/(_ping|version|info|containers/json|containers/[A-Za-z0-9][A-Za-z0-9_.-]*/(stats))$
	}
	handle @allowed {
		reverse_proxy unix//var/run/docker.sock {
			flush_interval -1
		}
	}
	handle {
		respond 403
	}
}
",
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew addon enable beszel\` regenerates it.
# Beszel's agent, connected out to your hub at https://beszel.example.org. It reads Docker
# only through OpsCrew's read-only proxy. Its secrets are in files beside this one that only the
# deploy user can read, never in this file.
name: opscrew-beszel
services:
  proxy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 0:\${OPSCREW_DEPLOY_GID}
    network_mode: none
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_ro:/run/opscrew-docker-ro
    read_only: true
    tmpfs:
      - /data
      - /config
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 32m
    memswap_limit: 32m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  agent:
    image: <pin:IMAGES.beszelAgent>
    restart: unless-stopped
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    network_mode: host
    env_file:
      - agent.env
    environment:
      HUB_URL: https://beszel.example.org
      KEY: ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
      DISABLE_SSH: "true"
      DOCKER_HOST: unix:///run/opscrew-docker-ro/docker.sock
      DOCKER_IMAGE_CHECK: "false"
      DATA_DIR: /var/lib/beszel-agent
    volumes:
      - docker_ro:/run/opscrew-docker-ro
      - ./agent_data:/var/lib/beszel-agent
    depends_on:
      - proxy
    read_only: true
    mem_limit: 64m
    memswap_limit: 64m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
volumes:
  docker_ro: {}
",
}
`;

exports[`renderAddon > renders Beszel, hub mode (snapshot) 1`] = `
{
  "Caddyfile": "# Generated by OpsCrew: Docker's API for the add-on, read-only. Only GET and HEAD on the paths
# below reach Docker; anything else (starting, stopping, exec, files, images, volumes) gets 403.
{
	admin off
	auto_https off
	persist_config off
}

http:// {
	bind unix//run/opscrew-docker-ro/docker.sock|0660
	@allowed {
		method GET HEAD
		path_regexp ^(/v1\\.[0-9]+)?/(_ping|version|info|containers/json|containers/[A-Za-z0-9][A-Za-z0-9_.-]*/(stats))$
	}
	handle @allowed {
		reverse_proxy unix//var/run/docker.sock {
			flush_interval -1
		}
	}
	handle {
		respond 403
	}
}
",
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew addon enable beszel\` regenerates it.
# Beszel's hub (its dashboard, on this server's loopback only) and its agent, which reads Docker
# only through OpsCrew's read-only proxy. Its secrets are in files beside this one that only the
# deploy user can read, never in this file.
name: opscrew-beszel
services:
  proxy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 0:\${OPSCREW_DEPLOY_GID}
    network_mode: none
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_ro:/run/opscrew-docker-ro
    read_only: true
    tmpfs:
      - /data
      - /config
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 32m
    memswap_limit: 32m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  hub:
    image: <pin:IMAGES.beszel>
    restart: unless-stopped
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    ports:
      - 127.0.0.1:8090:8090
    env_file:
      - hub.env
    environment:
      CONTAINER_DETAILS: "false"
      DISABLE_SSH: "true"
    volumes:
      - ./data:/beszel_data
      - ./config.yml:/beszel_data/config.yml:ro
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 128m
    memswap_limit: 128m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  agent:
    image: <pin:IMAGES.beszelAgent>
    restart: unless-stopped
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    network_mode: host
    env_file:
      - agent.env
    environment:
      HUB_URL: http://127.0.0.1:8090
      DISABLE_SSH: "true"
      DOCKER_HOST: unix:///run/opscrew-docker-ro/docker.sock
      DOCKER_IMAGE_CHECK: "false"
      DATA_DIR: /var/lib/beszel-agent
    volumes:
      - docker_ro:/run/opscrew-docker-ro
      - ./agent_data:/var/lib/beszel-agent
    depends_on:
      - proxy
      - hub
    read_only: true
    mem_limit: 64m
    memswap_limit: 64m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
volumes:
  docker_ro: {}
",
  "config.yml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew addon enable beszel\` regenerates it.
# On the server, OpsCrew writes the agent's token in place of \${BESZEL_TOKEN}.
systems:
  - name: "shop"
    host: localhost
    port: 45876
    token: "\${BESZEL_TOKEN}"
",
}
`;

exports[`renderAddon > renders Grafana Cloud (snapshot) 1`] = `
{
  "Caddyfile": "# Generated by OpsCrew: Docker's API for the add-on, read-only. Only GET and HEAD on the paths
# below reach Docker; anything else (starting, stopping, exec, files, images, volumes) gets 403.
{
	admin off
	auto_https off
	persist_config off
}

http:// {
	bind unix//run/opscrew-docker-ro/docker.sock|0660
	@allowed {
		method GET HEAD
		path_regexp ^(/v1\\.[0-9]+)?/(_ping|version|info|containers/json|networks|containers/[A-Za-z0-9][A-Za-z0-9_.-]*/(stats|logs|json))$
	}
	handle @allowed {
		reverse_proxy unix//var/run/docker.sock {
			flush_interval -1
		}
	}
	handle {
		respond 403
	}
}
",
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew addon enable grafana-cloud\` regenerates it.
# Grafana Alloy sends the app's logs, masked, and the server's CPU, load, memory and disk to your
# Grafana Cloud stack. It reads Docker only through OpsCrew's read-only proxy, and the server's
# files read-only. The token is in a file beside this one that only the deploy user can read.
name: opscrew-alloy
services:
  proxy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 0:\${OPSCREW_DEPLOY_GID}
    network_mode: none
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_ro:/run/opscrew-docker-ro
    read_only: true
    tmpfs:
      - /data
      - /config
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 32m
    memswap_limit: 32m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  alloy:
    image: <pin:IMAGES.alloy>
    restart: unless-stopped
    hostname: opscrew-alloy-shop
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    command:
      - run
      - --storage.path=/var/lib/opscrew-alloy
      - --disable-reporting
      - /etc/alloy/config.alloy
    environment:
      GOMEMLIMIT: 153MiB
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - ./grafana_cloud_credential:/etc/alloy/grafana_cloud_credential:ro
      - ./data:/var/lib/opscrew-alloy
      - docker_ro:/run/opscrew-docker-ro
      - /:/host/root:ro
      - /sys:/host/sys:ro
    depends_on:
      - proxy
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 192m
    memswap_limit: 192m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
volumes:
  docker_ro: {}
",
  "config.alloy": "// Generated by OpsCrew from opscrew/plan.yaml; \`opscrew addon enable grafana-cloud\` regenerates it.

// ---- The app's logs, from its Compose project's containers, through the read-only proxy ----
discovery.docker "app" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=shop"]
  }
}

discovery.relabel "app" {
  targets = discovery.docker.app.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "app" {
  host       = "unix:///run/opscrew-docker-ro/docker.sock"
  targets    = discovery.relabel.app.output
  labels     = { app = "shop", env = "prod" }
  forward_to = [loki.process.mask.receiver]
}

// ---- Masking, before anything leaves the server ----
// The app's known values: each deploy writes them beside app.env as one RE2 alternation.
local.file "mask" {
  filename       = "/host/root/srv/apps/shop/mask.re"
  is_secret      = true
  poll_frequency = "10s"
}

loki.process "mask" {
  // Values shaped like known kinds of token (OpsCrew's own patterns).
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(gh[pousr]_[A-Za-z0-9]{36,251})"
    replace    = "<opscrew:github-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(github_pat_[A-Za-z0-9_]{22,255})"
    replace    = "<opscrew:github-pat>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-ant-[A-Za-z0-9_-]{20,})"
    replace    = "<opscrew:anthropic-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{32,}))"
    replace    = "<opscrew:openai-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9])((?:AKIA|ASIA)[A-Z0-9]{16})"
    replace    = "<opscrew:aws-access-key-id>"
  }
  stage.replace {
    expression = "(?i)aws_?secret_?access_?key[\\"']?\\\\s*[=:]\\\\s*[\\"']?([A-Za-z0-9/+=]{40})"
    replace    = "<opscrew:aws-secret-access-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])((?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,})"
    replace    = "<opscrew:stripe-secret-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(xox[abposr]-[A-Za-z0-9-]{10,})"
    replace    = "<opscrew:slack-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(do[por]_v1_[0-9a-f]{64})"
    replace    = "<opscrew:digitalocean-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(AIza[0-9A-Za-z_-]{35})"
    replace    = "<opscrew:google-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(eyJ[A-Za-z0-9_-]{5,}\\\\.eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{10,})"
    replace    = "<opscrew:jwt>"
  }
  stage.replace {
    expression = convert.nonsensitive(local.file.mask.content)
    replace    = "<opscrew:known-value>"
  }
  forward_to = [loki.secretfilter.default.receiver]
}

// Gitleaks' rules, after OpsCrew's own.
loki.secretfilter "default" {
  redact_with = "<secretfilter:$SECRET_NAME>"
  forward_to  = [loki.write.grafana_cloud.receiver]
}

// ---- Sending to your Grafana Cloud stack ----
local.file "token" {
  filename  = "/etc/alloy/grafana_cloud_credential"
  is_secret = true
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-eu-west-0.grafana.net/loki/api/v1/push"
    basic_auth {
      username = "654321"
      password = local.file.token.content
    }
  }
}

// ---- The server's CPU, load, memory and root filesystem ----
// Alloy's own /proc shows the whole server's; / and /sys are mounted read-only under /host.
prometheus.exporter.unix "host" {
  rootfs_path    = "/host/root"
  sysfs_path     = "/host/sys"
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem"]
  filesystem {
    mount_points_exclude = "^/.+"
  }
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.allow.receiver]
}

prometheus.relabel "allow" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_seconds_total|node_load(1|5|15)|node_memory_(MemTotal|MemAvailable)_bytes|node_filesystem_(size|avail)_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(nice|irq|softirq|guest|guest_nice)"
    action        = "drop"
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  external_labels = { app = "shop", env = "prod" }
  endpoint {
    url = "https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push"
    basic_auth {
      username = "123456"
      password = local.file.token.content
    }
  }
}
",
}
`;

exports[`renderAddon > renders Grafana Cloud, sampled (snapshot) 1`] = `
{
  "Caddyfile": "# Generated by OpsCrew: Docker's API for the add-on, read-only. Only GET and HEAD on the paths
# below reach Docker; anything else (starting, stopping, exec, files, images, volumes) gets 403.
{
	admin off
	auto_https off
	persist_config off
}

http:// {
	bind unix//run/opscrew-docker-ro/docker.sock|0660
	@allowed {
		method GET HEAD
		path_regexp ^(/v1\\.[0-9]+)?/(_ping|version|info|containers/json|networks|containers/[A-Za-z0-9][A-Za-z0-9_.-]*/(stats|logs|json))$
	}
	handle @allowed {
		reverse_proxy unix//var/run/docker.sock {
			flush_interval -1
		}
	}
	handle {
		respond 403
	}
}
",
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew addon enable grafana-cloud\` regenerates it.
# Grafana Alloy sends the app's logs, masked, and the server's CPU, load, memory and disk to your
# Grafana Cloud stack. It reads Docker only through OpsCrew's read-only proxy, and the server's
# files read-only. The token is in a file beside this one that only the deploy user can read.
name: opscrew-alloy
services:
  proxy:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 0:\${OPSCREW_DEPLOY_GID}
    network_mode: none
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - /var/run/docker.sock:/var/run/docker.sock
      - docker_ro:/run/opscrew-docker-ro
    read_only: true
    tmpfs:
      - /data
      - /config
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 32m
    memswap_limit: 32m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  alloy:
    image: <pin:IMAGES.alloy>
    restart: unless-stopped
    hostname: opscrew-alloy-shop
    user: \${OPSCREW_DEPLOY_UID}:\${OPSCREW_DEPLOY_GID}
    command:
      - run
      - --storage.path=/var/lib/opscrew-alloy
      - --disable-reporting
      - /etc/alloy/config.alloy
    environment:
      GOMEMLIMIT: 153MiB
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - ./grafana_cloud_credential:/etc/alloy/grafana_cloud_credential:ro
      - ./data:/var/lib/opscrew-alloy
      - docker_ro:/run/opscrew-docker-ro
      - /:/host/root:ro
      - /sys:/host/sys:ro
    depends_on:
      - proxy
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 192m
    memswap_limit: 192m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
volumes:
  docker_ro: {}
",
  "config.alloy": "// Generated by OpsCrew from opscrew/plan.yaml; \`opscrew addon enable grafana-cloud\` regenerates it.

// ---- The app's logs, from its Compose project's containers, through the read-only proxy ----
discovery.docker "app" {
  host = "unix:///run/opscrew-docker-ro/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=shop"]
  }
}

discovery.relabel "app" {
  targets = discovery.docker.app.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "app" {
  host       = "unix:///run/opscrew-docker-ro/docker.sock"
  targets    = discovery.relabel.app.output
  labels     = { app = "shop", env = "prod" }
  forward_to = [loki.process.mask.receiver]
}

// ---- Masking, before anything leaves the server ----
// The app's known values: each deploy writes them beside app.env as one RE2 alternation.
local.file "mask" {
  filename       = "/host/root/srv/apps/shop/mask.re"
  is_secret      = true
  poll_frequency = "10s"
}

loki.process "mask" {
  // Values shaped like known kinds of token (OpsCrew's own patterns).
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(gh[pousr]_[A-Za-z0-9]{36,251})"
    replace    = "<opscrew:github-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(github_pat_[A-Za-z0-9_]{22,255})"
    replace    = "<opscrew:github-pat>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-ant-[A-Za-z0-9_-]{20,})"
    replace    = "<opscrew:anthropic-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(sk-(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{32,}))"
    replace    = "<opscrew:openai-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9])((?:AKIA|ASIA)[A-Z0-9]{16})"
    replace    = "<opscrew:aws-access-key-id>"
  }
  stage.replace {
    expression = "(?i)aws_?secret_?access_?key[\\"']?\\\\s*[=:]\\\\s*[\\"']?([A-Za-z0-9/+=]{40})"
    replace    = "<opscrew:aws-secret-access-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])((?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,})"
    replace    = "<opscrew:stripe-secret-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(xox[abposr]-[A-Za-z0-9-]{10,})"
    replace    = "<opscrew:slack-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_])(do[por]_v1_[0-9a-f]{64})"
    replace    = "<opscrew:digitalocean-token>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(AIza[0-9A-Za-z_-]{35})"
    replace    = "<opscrew:google-api-key>"
  }
  stage.replace {
    expression = "(?:^|[^A-Za-z0-9_-])(eyJ[A-Za-z0-9_-]{5,}\\\\.eyJ[A-Za-z0-9_-]{5,}\\\\.[A-Za-z0-9_-]{10,})"
    replace    = "<opscrew:jwt>"
  }
  stage.replace {
    expression = convert.nonsensitive(local.file.mask.content)
    replace    = "<opscrew:known-value>"
  }
  // 25% of the log lines (grafanaCloud.logSampling in the plan).
  stage.sampling {
    rate = 0.25
  }
  forward_to = [loki.secretfilter.default.receiver]
}

// Gitleaks' rules, after OpsCrew's own.
loki.secretfilter "default" {
  redact_with = "<secretfilter:$SECRET_NAME>"
  forward_to  = [loki.write.grafana_cloud.receiver]
}

// ---- Sending to your Grafana Cloud stack ----
local.file "token" {
  filename  = "/etc/alloy/grafana_cloud_credential"
  is_secret = true
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-eu-west-0.grafana.net/loki/api/v1/push"
    basic_auth {
      username = "654321"
      password = local.file.token.content
    }
  }
}

// ---- The server's CPU, load, memory and root filesystem ----
// Alloy's own /proc shows the whole server's; / and /sys are mounted read-only under /host.
prometheus.exporter.unix "host" {
  rootfs_path    = "/host/root"
  sysfs_path     = "/host/sys"
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem"]
  filesystem {
    mount_points_exclude = "^/.+"
  }
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.allow.receiver]
}

prometheus.relabel "allow" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_seconds_total|node_load(1|5|15)|node_memory_(MemTotal|MemAvailable)_bytes|node_filesystem_(size|avail)_bytes"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(nice|irq|softirq|guest|guest_nice)"
    action        = "drop"
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  external_labels = { app = "shop", env = "prod" }
  endpoint {
    url = "https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push"
    basic_auth {
      username = "123456"
      password = local.file.token.content
    }
  }
}
",
}
`;
