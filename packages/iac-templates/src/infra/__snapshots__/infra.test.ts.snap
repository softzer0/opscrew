// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderInfra > adds Cloudflare DNS and restricts web ports to Cloudflare when proxied 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

module "server" {
  source = "../modules/hetzner-vps"

  name               = var.app_name
  location           = var.location
  server_type        = var.server_type
  image              = var.image
  backups            = var.backups
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  labels             = { "managed-by" = "opscrew", app = var.app_name }
}

module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id            = var.cloudflare_zone_id
  domain             = var.domain
  ipv4               = module.server.ipv4_address
  ipv6               = module.server.ipv6_address
  proxied            = var.proxied
  www                = var.www
  manage_config_rule = var.manage_config_rule
  manage_waf_rules   = var.manage_waf_rules
}
"
`;

exports[`renderInfra > renders a server-only root module without a domain 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

module "server" {
  source = "../modules/hetzner-vps"

  name               = var.app_name
  location           = var.location
  server_type        = var.server_type
  image              = var.image
  backups            = var.backups
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  labels             = { "managed-by" = "opscrew", app = var.app_name }
}
"
`;

exports[`renderInfra > renders a server-only root module without a domain 2`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.70"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
"
`;
