// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderInfra for a Portainer target, redeploy mode cloudflare > is dialect-neutral and matches the snapshot 1`] = `
{
  "opscrew/infra/prod/main.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# Your existing Portainer: OpsCrew creates no server and changes nothing on the host, and the
# app's own DNS records stay yours. This configuration has only Cloudflare Tunnels: the one
# that serves the app, or the one that lets the deploy workflow reach Portainer's webhook
# behind Cloudflare Access, or both.
#
# Portainer's address is never committed: OpsCrew passes it from its local state
# (.opscrew/server.json) as TF_VAR_portainer_origin.

# A tunnel for Portainer's webhook: its connector runs as its own stack in Portainer and
# reaches Portainer at TF_VAR_portainer_origin (Portainer's own certificate is self-signed, so
# the connector does not check it). It serves only the webhook paths; every other path gets a
# 404. Its token is the sensitive output portainer_tunnel_token.
module "portainer_tunnel" {
  source = "../modules/cloudflare-tunnel"

  account_id = var.cloudflare_account_id
  zone_id    = var.cloudflare_zone_id
  name       = "opscrew-\${var.app_name}-portainer"

  routes = [
    {
      hostname      = var.portainer_hostname
      path          = "^/api/stacks/webhooks/"
      service       = var.portainer_origin
      no_tls_verify = true
    },
  ]

  # Portainer's hostname gets its Access application before its route and DNS record, and
  # loses it only after them, so the webhook is never reachable without Access in front of it.
  depends_on = [module.access]
}

# Cloudflare Access in front of Portainer's whole hostname: a Service Auth policy that lets only
# the deploy workflow's service token through (the module's service-token hostname).
module "access" {
  source = "../modules/cloudflare-access"

  account_id               = var.cloudflare_account_id
  app_name                 = var.app_name
  create_organization      = var.create_zero_trust_organization
  organization_auth_domain = var.zero_trust_auth_domain
  service_hostname         = var.portainer_hostname
  service_label            = "Portainer webhook"
}
",
  "opscrew/infra/prod/outputs.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "portainer_hostname" {
  value = var.portainer_hostname
}

output "portainer_tunnel_id" {
  value = module.portainer_tunnel.tunnel_id
}

# The webhook connector's token: it goes only into its stack's environment in Portainer.
output "portainer_tunnel_token" {
  value     = module.portainer_tunnel.token
  sensitive = true
}

# The deploy workflow's Access service token: it goes only into the deploy secrets.
output "deploy_service_token_client_id" {
  value     = module.access.ssh_service_token_client_id
  sensitive = true
}

output "deploy_service_token_client_secret" {
  value     = module.access.ssh_service_token_client_secret
  sensitive = true
}
",
  "opscrew/infra/prod/terraform.tfvars.json": "{
  "app_name": "shop",
  "cloudflare_zone_id": "0123456789abcdef0123456789abcdef",
  "cloudflare_account_id": "fedcba9876543210fedcba9876543210",
  "create_zero_trust_organization": true,
  "zero_trust_auth_domain": "example-com-opscrew.cloudflareaccess.com",
  "portainer_hostname": "portainer-shop.example.com"
}
",
  "opscrew/infra/prod/variables.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "cloudflare_account_id" {
  description = "Cloudflare account id (the tunnels and Access belong to it)."
  type        = string
}

variable "create_zero_trust_organization" {
  description = "Create the account's Zero Trust organization (only when the account has none, or this configuration created it)."
  type        = bool
}

variable "zero_trust_auth_domain" {
  description = "Team domain of the Zero Trust organization OpsCrew creates."
  type        = string
  default     = null
}

variable "portainer_hostname" {
  description = "Hostname the deploy workflow reaches Portainer's webhook on, behind Cloudflare Access."
  type        = string
}

variable "portainer_origin" {
  description = "Portainer's address as the tunnel connector reaches it, for example https://192.168.1.10:9443. OpsCrew passes it as TF_VAR_portainer_origin from .opscrew/server.json; it is never written to a committed file."
  type        = string
  sensitive   = true
}
",
  "opscrew/infra/prod/versions.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.27"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
",
}
`;

exports[`renderInfra for a Portainer target, web mode tunnel > is dialect-neutral and matches the snapshot 1`] = `
{
  "opscrew/infra/prod/main.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# Your existing Portainer: OpsCrew creates no server and changes nothing on the host, and the
# app's own DNS records stay yours. This configuration has only Cloudflare Tunnels: the one
# that serves the app, or the one that lets the deploy workflow reach Portainer's webhook
# behind Cloudflare Access, or both.

# A Cloudflare Tunnel for the app: the cloudflared service of the app's stack dials out to
# Cloudflare and reaches Caddy on the stack's network, so the host opens no port. Its token is
# the sensitive output tunnel_token.
module "tunnel" {
  source = "../modules/cloudflare-tunnel"

  account_id       = var.cloudflare_account_id
  zone_id          = var.cloudflare_zone_id
  name             = "opscrew-\${var.app_name}"
  manage_waf_rules = var.manage_waf_rules
  waf_hostnames    = [var.domain, "www.\${var.domain}"]

  routes = [
    { hostname = var.domain, service = "http://caddy:80" },
    { hostname = "www.\${var.domain}", service = "http://caddy:80" },
  ]
}
",
  "opscrew/infra/prod/outputs.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "url" {
  value = "https://\${var.domain}"
}

output "tunnel_id" {
  value = module.tunnel.tunnel_id
}

# The app stack's connector token: it goes only into the stack's environment in Portainer.
output "tunnel_token" {
  value     = module.tunnel.token
  sensitive = true
}

# The zone's entrypoint rulesets this deployment manages, by phase: OpsCrew leaves the ones
# another deployment holds alone. Tunnel mode has no configuration rule.
output "cloudflare_rulesets" {
  value = {
    http_config_settings         = null
    http_request_firewall_custom = module.tunnel.waf_ruleset_id
  }
}
",
  "opscrew/infra/prod/terraform.tfvars.json": "{
  "app_name": "shop",
  "domain": "example.com",
  "cloudflare_zone_id": "0123456789abcdef0123456789abcdef",
  "manage_waf_rules": true,
  "cloudflare_account_id": "fedcba9876543210fedcba9876543210"
}
",
  "opscrew/infra/prod/variables.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "manage_waf_rules" {
  description = "Manage the WAF custom rule."
  type        = bool
}

variable "cloudflare_account_id" {
  description = "Cloudflare account id (the tunnels and Access belong to it)."
  type        = string
}
",
  "opscrew/infra/prod/versions.tf": "# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.27"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
",
}
`;
