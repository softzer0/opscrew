// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the preview environment's root > keeps the root of previews in a zone of their own as it was, with no certificate pack > hetzner main.tf 1`] = `
"# Generated by OpsCrew from opscrew/environments/preview/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

module "server" {
  source = "../modules/hetzner-vps"

  name               = var.app_name
  location           = var.location
  server_type        = var.server_type
  image              = var.image
  backups            = var.backups
  delete_protection  = var.delete_protection
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  labels             = { "managed-by" = "opscrew", app = var.app_name }
}

# The previews' wildcard record, through Cloudflare's proxy: each preview is
# pr-<number>-<random>.<base>, a name in no public certificate.
module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id     = var.cloudflare_zone_id
  domain      = "*.\${var.preview_domain}"
  ipv4        = module.server.ipv4_address
  ipv6        = module.server.ipv6_address
  proxied     = true
  www         = false
  caa_issuers = []
}
"
`;

exports[`the preview environment's root > keeps the root of previews in a zone of their own as it was, with no certificate pack > hetzner outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/environments/preview/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "server_ipv4" {
  value = module.server.ipv4_address
}

output "server_ipv6" {
  value = module.server.ipv6_address
}

output "server_id" {
  value = module.server.server_id
}

output "server_name" {
  value = module.server.server_name
}

output "url" {
  value = "http://\${module.server.ipv4_address}"
}

# Every server by provider. During a move to another provider, OpsCrew tells the server being
# replaced from the new one by their providers.
output "servers" {
  value = {
    hetzner = {
      ipv4 = module.server.ipv4_address
      ipv6 = module.server.ipv6_address
      id   = module.server.server_id
    }
  }
}
"
`;

exports[`the preview environment's root > keeps the root of previews in a zone of their own as it was, with no certificate pack > own main.tf 1`] = `
"# Generated by OpsCrew from opscrew/environments/preview/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# A server you already own: OpsCrew neither creates nor deletes it, so this configuration has no
# server resources, only what Cloudflare needs to send traffic to it.
#
# The server's addresses are never committed: OpsCrew passes them from its local state
# (.opscrew/server.json) as TF_VAR_server_ipv4 and TF_VAR_server_ipv6 when it runs the engine.

# The previews' wildcard record, through Cloudflare's proxy: each preview is
# pr-<number>-<random>.<base>, a name in no public certificate.
module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id     = var.cloudflare_zone_id
  domain      = "*.\${var.preview_domain}"
  ipv4        = var.server_ipv4
  ipv6        = var.server_ipv6
  ipv6_record = false
  proxied     = true
  www         = false
  caa_issuers = []
}
"
`;

exports[`the preview environment's root > keeps the root of previews in a zone of their own as it was, with no certificate pack > own outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/environments/preview/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "server_ipv4" {
  value = var.server_ipv4
}

output "server_ipv6" {
  value = var.server_ipv6
}

output "url" {
  value = "http://\${var.server_ipv4}"
}

# Same shape as on OpsCrew-created servers, keyed by provider; an own server has no id.
output "servers" {
  value = {
    own = {
      ipv4 = var.server_ipv4
      ipv6 = var.server_ipv6
    }
  }
}
"
`;
