exports[`renderPagesVerification > renders GitHub's verification record in a root of its own, beside the site's > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# GitHub's domain verification record for the site's domain, quoted as Cloudflare takes TXT
# content. It has a root of its own, so destroying the site keeps the domain verified for the
# GitHub account.
resource "cloudflare_dns_record" "verification" {
  zone_id = var.cloudflare_zone_id
  name    = "_github-pages-challenge-\${var.github_owner}.\${var.domain}"
  type    = "TXT"
  content = "\\"\${var.verification}\\""
  ttl     = 1
  proxied = false
  comment = "Managed by OpsCrew"
}
"
`;

exports[`renderPagesVerification > renders GitHub's verification record in a root of its own, beside the site's > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "github_owner" {
  description = "GitHub account that owns the repository, in lower case: its GitHub Pages host is <owner>.github.io."
  type        = string
}

variable "verification" {
  description = "The value of GitHub's verification record, from the GitHub account's Pages settings (public in DNS, not a secret)."
  type        = string
}
"
`;

exports[`renderPagesVerification > renders GitHub's verification record in a root of its own, beside the site's > versions.tf 1`] = `
