exports[`renderInfra on Cloudflare's hosting > renders the Worker's root and vendors only the cloudflare-workers module > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# The app on Cloudflare's hosting: a Worker with the site's files, and a custom domain for each
# hostname. This configuration creates the Worker's shell once; OpsCrew's deploy workflow
# uploads its code, files and secrets with Wrangler, and its settings are in the Wrangler config.
module "worker" {
  source = "../modules/cloudflare-workers"

  account_id   = var.cloudflare_account_id
  zone_id      = var.cloudflare_zone_id
  worker       = var.worker
  domain       = var.domain
  www          = var.www
  workers_dev  = var.workers_dev
  preview_urls = var.preview_urls
}
"
`;

exports[`renderInfra on Cloudflare's hosting > renders the Worker's root and vendors only the cloudflare-workers module > outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "url" {
  value = module.worker.url
}
"
`;

exports[`renderInfra on Cloudflare's hosting > renders the Worker's root and vendors only the cloudflare-workers module > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "www" {
  description = "Also serve www.<domain>."
  type        = bool
}

variable "cloudflare_account_id" {
  description = "Cloudflare account id (the Worker belongs to it)."
  type        = string
}

variable "worker" {
  description = "Name of the Worker, unique in the Cloudflare account."
  type        = string
}

variable "workers_dev" {
  description = "Serve the Worker on its workers.dev address."
  type        = bool
}

variable "preview_urls" {
  description = "Give each version of the Worker its own preview URL."
  type        = bool
}
"
`;

exports[`renderInfra on Cloudflare's hosting > renders the Worker's root and vendors only the cloudflare-workers module > versions.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.27"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
"
`;

exports[`renderInfra on GitHub Pages > renders the site's root with only the GitHub Pages DNS module > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# The site on GitHub Pages: its DNS records, all DNS only, since Cloudflare's proxy would stop
# GitHub from issuing and renewing the site's certificate. GitHub's domain verification record
# has a root of its own (opscrew/infra/github-pages-verification), so destroying this one keeps it.
module "dns" {
  source = "../modules/cloudflare-dns/github-pages"

  zone_id = var.cloudflare_zone_id
  domain  = var.domain
  apex    = var.apex
  owner   = var.github_owner
  www     = var.www
}
"
`;

exports[`renderInfra on GitHub Pages > renders the site's root with only the GitHub Pages DNS module > outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "url" {
  value = module.dns.url
}
"
`;

