exports[`a network with no extra server (devices only) > matches its snapshots > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "location" {
  description = "Hetzner Cloud location."
  type        = string
}

variable "server_type" {
  description = "Hetzner Cloud server type."
  type        = string
}

variable "image" {
  description = "Operating system image."
  type        = string
}

variable "backups" {
  description = "Hetzner automated backups."
  type        = bool
}

variable "delete_protection" {
  description = "Protect the server against accidental deletion and rebuilds; \`opscrew destroy\` passes false."
  type        = bool
  default     = true
}

variable "deploy_ssh_public_key" {
  description = "Public half of the deploy key."
  type        = string
}

variable "ssh_allowed_cidrs" {
  description = "Networks allowed to reach SSH."
  type        = list(string)
}

variable "http_allowed_cidrs" {
  description = "Networks allowed to reach ports 80 and 443."
  type        = list(string)
}
"
`;

exports[`a network with no extra server (devices only) > matches its snapshots > versions.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "~> 1.70"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
"
`;

exports[`an extra server on another provider (Hetzner app plus DigitalOcean db) > matches its snapshots > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

# Token from the DIGITALOCEAN_TOKEN environment variable (never stored in files or state).
provider "digitalocean" {}

module "server" {
  source = "../modules/hetzner-vps"

  name               = var.app_name
  location           = var.location
  server_type        = var.server_type
  image              = var.image
  backups            = var.backups
  delete_protection  = var.delete_protection
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  labels             = { "managed-by" = "opscrew", app = var.app_name }
  wireguard_port     = 51820
}

# The deploy key and the app's tag of the app's Droplets, kept here so that removing a Droplet
# never deletes them (DigitalOcean refuses the same key twice). The Droplets get the key's id
# through coalesce, whose result is known not to be null before apply, so their own key's count
# is known.
resource "digitalocean_ssh_key" "deploy" {
  name       = "\${var.app_name}-deploy"
  public_key = var.deploy_ssh_public_key
}

resource "digitalocean_tag" "app" {
  name = "opscrew-app:\${var.app_name}"
}

# The db Droplet: no web traffic, only its services on the private network.
module "server_db" {
  source = "../modules/digitalocean-droplet"

  name              = "\${var.app_name}-db"
  region            = var.db_location
  size              = var.db_server_type
  image             = var.db_image
  backups           = var.db_backups
  ssh_public_key    = var.deploy_ssh_public_key
  ssh_allowed_cidrs = var.ssh_allowed_cidrs
  shared_tags       = [digitalocean_tag.app.name, "managed-by:opscrew"]
  web               = false
  wireguard_port    = 51820
  ssh_key_id        = coalesce(digitalocean_ssh_key.deploy.id)
}
"
`;

