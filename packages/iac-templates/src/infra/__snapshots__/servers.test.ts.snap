exports[`an own app server plus a Hetzner db > matches its snapshots > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "server_ipv4" {
  description = "Public IPv4 address of your server. OpsCrew passes it as TF_VAR_server_ipv4 from .opscrew/server.json; it is never written to a committed file."
  type        = string
}

variable "server_ipv6" {
  description = "Public IPv6 address of your server, or null when it has none (no AAAA record). OpsCrew passes it as TF_VAR_server_ipv6 from .opscrew/server.json; it is never written to a committed file."
  type        = string
  default     = null
}

variable "db-1_location" {
  description = "Hetzner Cloud location of the db-1 server."
  type        = string
}

variable "db-1_server_type" {
  description = "Hetzner Cloud server type of the db-1 server."
  type        = string
}

variable "db-1_image" {
  description = "Operating system image of the db-1 server."
  type        = string
}

variable "db-1_backups" {
  description = "Hetzner automated backups of the db-1 server."
  type        = bool
}

variable "db-1_delete_protection" {
  description = "Protect the db-1 server against accidental deletion and rebuilds; \`opscrew destroy\` passes false."
  type        = bool
  default     = true
}

variable "deploy_ssh_public_key" {
  description = "Public half of the deploy key."
  type        = string
}

variable "ssh_allowed_cidrs" {
  description = "Networks allowed to reach SSH."
  type        = list(string)
}
"
`;

