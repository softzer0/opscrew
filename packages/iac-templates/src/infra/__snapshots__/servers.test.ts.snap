exports[`an own app server plus a Hetzner db > matches its snapshots > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

# The app's server is one you already own: OpsCrew neither creates nor deletes it. The app's
# extra servers below are ones OpsCrew creates.
#
# The server's addresses are never committed: OpsCrew passes them from its local state
# (.opscrew/server.json) as TF_VAR_server_ipv4 and TF_VAR_server_ipv6 when it runs the engine.

# The deploy key of the app's servers on Hetzner Cloud, kept here so that removing a server
# never deletes it (Hetzner refuses the same key twice). The servers get its id through
# coalesce, whose result is known not to be null before apply, so their own key's count is known.
resource "hcloud_ssh_key" "deploy" {
  name       = "\${var.app_name}-deploy"
  public_key = var.deploy_ssh_public_key
  labels     = { "managed-by" = "opscrew", app = var.app_name }
}

# The db-1 server: no web traffic, only its services on the private network.
module "server_db-1" {
  source = "../modules/hetzner-vps"

  name              = "\${var.app_name}-db-1"
  location          = var.db-1_location
  server_type       = var.db-1_server_type
  image             = var.db-1_image
  backups           = var.db-1_backups
  delete_protection = var.db-1_delete_protection
  ssh_public_key    = var.deploy_ssh_public_key
  ssh_allowed_cidrs = var.ssh_allowed_cidrs
  labels            = { "managed-by" = "opscrew", app = var.app_name }
  web               = false
  wireguard_port    = 51820
  ssh_key_id        = coalesce(hcloud_ssh_key.deploy.id)
}
"
`;

exports[`an own app server plus a Hetzner db > matches its snapshots > outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "server_ipv4" {
  value = var.server_ipv4
}

output "server_ipv6" {
  value = var.server_ipv6
}

output "url" {
  value = "http://\${var.server_ipv4}"
}

# Same shape as on OpsCrew-created servers, keyed by provider; an own server has no id.
output "servers" {
  value = {
    own = {
      ipv4 = var.server_ipv4
      ipv6 = var.server_ipv6
    }
  }
}

# The app's extra servers (the plan's servers) by name.
output "extra_servers" {
  value = {
    db-1 = {
      ipv4 = module.server_db-1.ipv4_address
      ipv6 = module.server_db-1.ipv6_address
      id   = module.server_db-1.server_id
      name = module.server_db-1.server_name
    }
  }
}
"
`;

