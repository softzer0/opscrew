// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a network with no extra server (devices only) > matches its snapshots > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

module "server" {
  source = "../modules/hetzner-vps"

  name               = var.app_name
  location           = var.location
  server_type        = var.server_type
  image              = var.image
  backups            = var.backups
  delete_protection  = var.delete_protection
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  labels             = { "managed-by" = "opscrew", app = var.app_name }
  wireguard_port     = 51820
}
"
`;

exports[`a network with no extra server (devices only) > matches its snapshots > outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "server_ipv4" {
  value = module.server.ipv4_address
}

output "server_ipv6" {
  value = module.server.ipv6_address
}

output "server_id" {
  value = module.server.server_id
}

output "server_name" {
  value = module.server.server_name
}

output "url" {
  value = "http://\${module.server.ipv4_address}"
}

# Every server by provider. During a move to another provider, OpsCrew tells the server being
# replaced from the new one by their providers.
output "servers" {
  value = {
    hetzner = {
      ipv4 = module.server.ipv4_address
      ipv6 = module.server.ipv6_address
      id   = module.server.server_id
    }
  }
}
"
`;

