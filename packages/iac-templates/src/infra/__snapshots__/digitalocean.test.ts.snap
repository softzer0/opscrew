// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderInfra for DigitalOcean > adds Cloudflare DNS next to the Droplet and restricts web ports to Cloudflare > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the DIGITALOCEAN_TOKEN environment variable (never stored in files or state).
provider "digitalocean" {}

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

module "server" {
  source = "../modules/digitalocean-droplet"

  name               = var.app_name
  region             = var.location
  size               = var.server_type
  image              = var.image
  backups            = var.backups
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  app_tag            = "opscrew-app:\${var.app_name}"
  shared_tags        = ["managed-by:opscrew"]
}

module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id            = var.cloudflare_zone_id
  domain             = var.domain
  ipv4               = module.server.ipv4_address
  ipv6               = module.server.ipv6_address
  proxied            = var.proxied
  www                = var.www
  manage_config_rule = var.manage_config_rule
  manage_waf_rules   = var.manage_waf_rules
}
"
`;

exports[`renderInfra for DigitalOcean > adds Cloudflare DNS next to the Droplet and restricts web ports to Cloudflare > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "location" {
  description = "DigitalOcean region."
  type        = string
}

variable "server_type" {
  description = "DigitalOcean Droplet size."
  type        = string
}

variable "image" {
  description = "Operating system image."
  type        = string
}

variable "backups" {
  description = "DigitalOcean daily backups."
  type        = bool
}

variable "deploy_ssh_public_key" {
  description = "Public half of the deploy key."
  type        = string
}

variable "ssh_allowed_cidrs" {
  description = "Networks allowed to reach SSH."
  type        = list(string)
}

variable "http_allowed_cidrs" {
  description = "Networks allowed to reach ports 80 and 443."
  type        = list(string)
}

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "proxied" {
  description = "Proxy traffic through Cloudflare."
  type        = bool
}

variable "www" {
  description = "Also serve www.<domain>."
  type        = bool
}

variable "manage_config_rule" {
  description = "Manage the TLS configuration rule."
  type        = bool
}

variable "manage_waf_rules" {
  description = "Manage the WAF custom rule."
  type        = bool
}
"
`;

exports[`renderInfra for DigitalOcean > adds Cloudflare DNS next to the Droplet and restricts web ports to Cloudflare > versions.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.106"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.27"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
"
`;

