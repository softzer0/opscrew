// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderInfra for a server the user owns (public) > renders no server resources and vendors only the DNS module > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# A server you already own: OpsCrew neither creates nor deletes it, so this configuration has no
# server resources, only what Cloudflare needs to send traffic to it.
#
# The server's addresses are never committed: OpsCrew passes them from its local state
# (.opscrew/server.json) as TF_VAR_server_ipv4 and TF_VAR_server_ipv6 when it runs the engine.

module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id            = var.cloudflare_zone_id
  domain             = var.domain
  ipv4               = var.server_ipv4
  ipv6               = var.server_ipv6
  ipv6_record        = var.server_ipv6 != null
  proxied            = var.proxied
  www                = var.www
  manage_config_rule = var.manage_config_rule
  manage_waf_rules   = var.manage_waf_rules
}
"
`;

exports[`renderInfra for a server the user owns (public) > renders no server resources and vendors only the DNS module > outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "server_ipv4" {
  value = var.server_ipv4
}

output "server_ipv6" {
  value = var.server_ipv6
}

output "url" {
  value = module.dns.url
}

# Same shape as on OpsCrew-created servers, keyed by provider; an own server has no id.
output "servers" {
  value = {
    own = {
      ipv4 = var.server_ipv4
      ipv6 = var.server_ipv6
    }
  }
}

# The zone's entrypoint rulesets this deployment manages, by phase: OpsCrew leaves the ones
# another deployment holds alone.
output "cloudflare_rulesets" {
  value = module.dns.ruleset_ids
}
"
`;

exports[`renderInfra for a server the user owns (public) > renders no server resources and vendors only the DNS module > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "server_ipv4" {
  description = "Public IPv4 address of your server. OpsCrew passes it as TF_VAR_server_ipv4 from .opscrew/server.json; it is never written to a committed file."
  type        = string
}

variable "server_ipv6" {
  description = "Public IPv6 address of your server, or null when it has none (no AAAA record). OpsCrew passes it as TF_VAR_server_ipv6 from .opscrew/server.json; it is never written to a committed file."
  type        = string
  default     = null
}

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "proxied" {
  description = "Proxy traffic through Cloudflare."
  type        = bool
}

variable "www" {
  description = "Also serve www.<domain>."
  type        = bool
}

variable "manage_config_rule" {
  description = "Manage the TLS configuration rule."
  type        = bool
}

variable "manage_waf_rules" {
  description = "Manage the WAF custom rule."
  type        = bool
}
"
`;

exports[`renderInfra for a server the user owns (public) > renders no server resources and vendors only the DNS module > versions.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5.27"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
"
`;

exports[`renderInfra for a server the user owns (tunnel) > adds Portainer behind Access with the listed emails when opted in > main.tf with Portainer 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# A server you already own: OpsCrew neither creates nor deletes it, so this configuration has no
# server resources, only what Cloudflare needs to send traffic to it.

# A Cloudflare Tunnel: the connector on the server dials out to Cloudflare, so these hostnames
# need no open port. Its token is the sensitive output tunnel_token.
module "tunnel" {
  source = "../modules/cloudflare-tunnel"

  account_id       = var.cloudflare_account_id
  zone_id          = var.cloudflare_zone_id
  name             = "opscrew-\${var.app_name}"
  manage_waf_rules = var.manage_waf_rules
  waf_hostnames    = [var.domain]

  routes = [
    { hostname = var.domain, service = "http://localhost:18080" },
    { hostname = var.ssh_hostname, service = "ssh://localhost:\${var.ssh_port}" },
    { hostname = var.portainer_hostname, service = "https://localhost:9443", no_tls_verify = true },
  ]

  # Every hostname gets its Access application before its route and DNS record, and loses it
  # only after them, so nothing is reachable without Access in front of it.
  depends_on = [module.access]
}

# Cloudflare Access in front of the tunnel's SSH and Portainer hostnames.
module "access" {
  source = "../modules/cloudflare-access"

  account_id                        = var.cloudflare_account_id
  app_name                          = var.app_name
  create_organization               = var.create_zero_trust_organization
  organization_auth_domain          = var.zero_trust_auth_domain
  ssh_hostname                      = var.ssh_hostname
  portainer_hostname                = var.portainer_hostname
  portainer_allowed_emails          = var.portainer_allowed_emails
  one_time_pin_identity_provider_id = var.one_time_pin_identity_provider_id
}
"
`;

exports[`renderInfra for a server the user owns (tunnel) > serves the app and SSH through the tunnel and Access, without DNS records to an address > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# A server you already own: OpsCrew neither creates nor deletes it, so this configuration has no
# server resources, only what Cloudflare needs to send traffic to it.

# A Cloudflare Tunnel: the connector on the server dials out to Cloudflare, so these hostnames
# need no open port. Its token is the sensitive output tunnel_token.
module "tunnel" {
  source = "../modules/cloudflare-tunnel"

  account_id       = var.cloudflare_account_id
  zone_id          = var.cloudflare_zone_id
  name             = "opscrew-\${var.app_name}"
  manage_waf_rules = var.manage_waf_rules
  waf_hostnames    = [var.domain]

  routes = [
    { hostname = var.domain, service = "http://localhost:18080" },
    { hostname = var.ssh_hostname, service = "ssh://localhost:\${var.ssh_port}" },
  ]

  # Every hostname gets its Access application before its route and DNS record, and loses it
  # only after them, so nothing is reachable without Access in front of it.
  depends_on = [module.access]
}

# Cloudflare Access in front of the tunnel's SSH and Portainer hostnames.
module "access" {
  source = "../modules/cloudflare-access"

  account_id               = var.cloudflare_account_id
  app_name                 = var.app_name
  create_organization      = var.create_zero_trust_organization
  organization_auth_domain = var.zero_trust_auth_domain
  ssh_hostname             = var.ssh_hostname
}
"
`;

exports[`renderInfra for a server the user owns (tunnel) > serves the app and SSH through the tunnel and Access, without DNS records to an address > outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "url" {
  value = "https://\${var.domain}"
}

output "tunnel_id" {
  value = module.tunnel.tunnel_id
}

# The connector's token: it goes only into a root-only file on the server.
output "tunnel_token" {
  value     = module.tunnel.token
  sensitive = true
}

output "ssh_hostname" {
  value = var.ssh_hostname
}

# The deploy workflow's Access service token: it goes only into the deploy secrets.
output "deploy_service_token_client_id" {
  value     = module.access.ssh_service_token_client_id
  sensitive = true
}

output "deploy_service_token_client_secret" {
  value     = module.access.ssh_service_token_client_secret
  sensitive = true
}

# The zone's entrypoint rulesets this deployment manages, by phase: OpsCrew leaves the ones
# another deployment holds alone. Tunnel mode has no configuration rule.
output "cloudflare_rulesets" {
  value = {
    http_config_settings         = null
    http_request_firewall_custom = module.tunnel.waf_ruleset_id
  }
}
"
`;

exports[`renderInfra for a server the user owns (tunnel) > serves the app and SSH through the tunnel and Access, without DNS records to an address > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "manage_waf_rules" {
  description = "Manage the WAF custom rule."
  type        = bool
}

variable "cloudflare_account_id" {
  description = "Cloudflare account id (the tunnel and Access belong to it)."
  type        = string
}

variable "create_zero_trust_organization" {
  description = "Create the account's Zero Trust organization (only when the account has none, or this configuration created it)."
  type        = bool
}

variable "zero_trust_auth_domain" {
  description = "Team domain of the Zero Trust organization OpsCrew creates."
  type        = string
  default     = null
}

variable "ssh_hostname" {
  description = "Hostname the deploy workflow reaches SSH on, through the tunnel and Access."
  type        = string
}

variable "ssh_port" {
  description = "Port sshd listens on, on the server."
  type        = number
}
"
`;
