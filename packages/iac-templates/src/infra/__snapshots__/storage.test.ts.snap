// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderStorage > renders the digitalocean root with CORS > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# OpsCrew never creates storage keys: the provider reads yours from the AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY environment variables, so it is never stored in files, plans or state.
provider "aws" {
  # Spaces creates buckets only with us-east-1 here; the endpoint picks the real region.
  region = "us-east-1"

  endpoints {
    s3 = "https://\${var.region}.digitaloceanspaces.com"
  }

  # DigitalOcean Spaces speaks S3 but is not AWS: no AWS account, region or key checks.
  s3_use_path_style           = true
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
  skip_requesting_account_id  = true
}

# Never destroyed by a plan: OpsCrew deletes the bucket and its files only when you ask it to
# delete data.
resource "aws_s3_bucket" "this" {
  bucket = var.bucket

  lifecycle {
    prevent_destroy = true
  }
}

# Browser uploads with presigned links, from the app's own origins only.
resource "aws_s3_bucket_cors_configuration" "this" {
  bucket = aws_s3_bucket.this.id

  cors_rule {
    allowed_headers = ["*"]
    allowed_methods = ["GET", "PUT", "POST"]
    allowed_origins = var.cors_origins
    expose_headers  = ["ETag"]
  }
}
"
`;

exports[`renderStorage > renders the digitalocean root with CORS > terraform.tfvars.json 1`] = `
"{
  "bucket": "shop-uploads",
  "region": "fra1",
  "cors_origins": [
    "https://example.com",
    "https://www.example.com"
  ]
}
"
`;

exports[`renderStorage > renders the digitalocean root with CORS > variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "bucket" {
  description = "Name of the bucket."
  type        = string
}

variable "region" {
  description = "Spaces region of the bucket, for example fra1."
  type        = string
}

variable "cors_origins" {
  description = "The app's own origins, allowed to upload from the browser."
  type        = list(string)
}
"
`;

exports[`renderStorage > renders the digitalocean root with CORS > versions.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.69"
    }
  }

  # State lives outside the repository; OpsCrew passes the path with -backend-config at init.
  backend "local" {}
}
"
`;

