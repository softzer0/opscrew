exports[`renderStorage > renders the r2 root with CORS > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# The app's bucket on Cloudflare R2. OpsCrew never creates storage keys: you create an R2
# token limited to this bucket after it exists.
# Never destroyed by a plan: OpsCrew deletes the bucket and its files only when you ask it to
# delete data.
resource "cloudflare_r2_bucket" "this" {
  account_id = var.cloudflare_account_id
  name       = var.bucket

  lifecycle {
    prevent_destroy = true
  }
}

# Browser uploads with presigned links, from the app's own origins only.
resource "cloudflare_r2_bucket_cors" "this" {
  account_id  = var.cloudflare_account_id
  bucket_name = cloudflare_r2_bucket.this.name

  rules = [{
    allowed = {
      methods = ["GET", "PUT", "POST"]
      origins = var.cors_origins
      headers = ["*"]
    }
    expose_headers = ["ETag"]
  }]
}
"
`;

