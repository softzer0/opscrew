exports[`renderInfra move layouts (snapshots) > digitalocean to hetzner > renders the switched layout > main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# A move to another provider is in progress: \`opscrew retarget\` manages these files until the
# move is finished (\`opscrew retarget --finish\`) or aborted (\`opscrew retarget --abort\`).

# Token from the DIGITALOCEAN_TOKEN environment variable (never stored in files or state).
provider "digitalocean" {}

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

module "server" {
  source = "../modules/hetzner-vps"

  name               = var.app_name
  location           = var.location
  server_type        = var.server_type
  image              = var.image
  backups            = var.backups
  delete_protection  = var.delete_protection
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  labels             = { "managed-by" = "opscrew", app = var.app_name }
}

# The previous Droplet, kept until the move is finished or aborted.
module "server_previous" {
  source = "../modules/digitalocean-droplet"

  name               = var.app_name
  region             = var.previous_location
  size               = var.previous_server_type
  image              = var.previous_image
  backups            = var.previous_backups
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  app_tag            = "opscrew-app:\${var.app_name}"
  shared_tags        = ["managed-by:opscrew"]
}

module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id     = var.cloudflare_zone_id
  domain      = var.domain
  ipv4        = module.server.ipv4_address
  ipv6        = module.server.ipv6_address
  proxied     = var.proxied
  www         = var.www
  caa_issuers = var.caa_issuers
}
"
`;

exports[`renderInfra move layouts (snapshots) > digitalocean to hetzner > renders the switched layout > outputs.tf 1`] = `
