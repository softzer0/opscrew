"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "location" {
  description = "DigitalOcean region."
  type        = string
}

variable "server_type" {
  description = "DigitalOcean Droplet size."
  type        = string
}

variable "image" {
  description = "Operating system image."
  type        = string
}

variable "backups" {
  description = "DigitalOcean daily backups."
  type        = bool
}

variable "previous_location" {
  description = "Hetzner Cloud location of the previous server."
  type        = string
}

variable "previous_server_type" {
  description = "Hetzner Cloud server type of the previous server."
  type        = string
}

variable "previous_image" {
  description = "Operating system image of the previous server."
  type        = string
}

variable "previous_backups" {
  description = "Hetzner automated backups of the previous server."
  type        = bool
}

variable "previous_delete_protection" {
  description = "Protect the previous server against accidental deletion and rebuilds; \`opscrew retarget --finish\` passes false."
  type        = bool
  default     = true
}

variable "deploy_ssh_public_key" {
  description = "Public half of the deploy key."
  type        = string
}

variable "ssh_allowed_cidrs" {
  description = "Networks allowed to reach SSH."
  type        = list(string)
}

variable "http_allowed_cidrs" {
  description = "Networks allowed to reach ports 80 and 443."
  type        = list(string)
}

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "proxied" {
  description = "Proxy traffic through Cloudflare."
  type        = bool
}

variable "www" {
  description = "Also serve www.<domain>."
  type        = bool
}

variable "caa_issuers" {
  description = "Certificate authorities named in CAA records at the domain (DNS only)."
  type        = list(string)
}
"
`;

