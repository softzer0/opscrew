// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderInfra adopting a Portainer side's records > matches the snapshot 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# A move to another server is in progress: \`opscrew retarget\` manages these files until the
# move is finished (\`opscrew retarget --finish\`) or aborted (\`opscrew retarget --abort\`).

# Token from the DIGITALOCEAN_TOKEN environment variable (never stored in files or state).
provider "digitalocean" {}

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

module "server" {
  source = "../modules/digitalocean-droplet"

  name               = var.app_name
  region             = var.location
  size               = var.server_type
  image              = var.image
  backups            = var.backups
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  app_tag            = "opscrew-app:\${var.app_name}"
  shared_tags        = ["managed-by:opscrew"]
}

module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id     = var.cloudflare_zone_id
  domain      = var.domain
  ipv4        = module.server.ipv4_address
  ipv6        = module.server.ipv6_address
  ipv6_record = var.previous_server_ipv6 != null
  proxied     = var.proxied
  www         = var.www
  caa_issuers = var.caa_issuers
}

# The app's DNS records were yours: OpsCrew adopts them into the DNS module, so that the move
# switches them in place. Importing a record changes nothing in Cloudflare.
import {
  to = module.dns.cloudflare_dns_record.a
  id = "0123456789abcdef0123456789abcdef/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

import {
  to = module.dns.cloudflare_dns_record.aaaa[0]
  id = "0123456789abcdef0123456789abcdef/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
}

import {
  to = module.dns.cloudflare_dns_record.www[0]
  id = "0123456789abcdef0123456789abcdef/cccccccccccccccccccccccccccccccc"
}
"
`;

exports[`renderInfra with an address side > matches the snapshots > hetzner to own, switched, main.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

# A move to another server is in progress: \`opscrew retarget\` manages these files until the
# move is finished (\`opscrew retarget --finish\`) or aborted (\`opscrew retarget --abort\`).

# Token from the HCLOUD_TOKEN environment variable (never stored in files or state).
provider "hcloud" {}

# Token from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

# The previous server, kept until the move is finished or aborted.
module "server_previous" {
  source = "../modules/hetzner-vps"

  name               = var.app_name
  location           = var.previous_location
  server_type        = var.previous_server_type
  image              = var.previous_image
  backups            = var.previous_backups
  delete_protection  = var.previous_delete_protection
  ssh_public_key     = var.deploy_ssh_public_key
  ssh_allowed_cidrs  = var.ssh_allowed_cidrs
  http_allowed_cidrs = var.http_allowed_cidrs
  labels             = { "managed-by" = "opscrew", app = var.app_name }
}

module "dns" {
  source = "../modules/cloudflare-dns"

  zone_id     = var.cloudflare_zone_id
  domain      = var.domain
  ipv4        = var.server_ipv4
  ipv6        = var.server_ipv6
  ipv6_record = var.server_ipv6 != null
  proxied     = var.proxied
  www         = var.www
  caa_issuers = var.caa_issuers
}
"
`;

exports[`renderInfra with an address side > matches the snapshots > hetzner to own, switched, outputs.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

output "server_ipv4" {
  value = var.server_ipv4
}

output "server_ipv6" {
  value = var.server_ipv6
}

output "url" {
  value = module.dns.url
}

# Every server by provider. During a move to another provider, OpsCrew tells the server being
# replaced from the new one by their providers.
output "servers" {
  value = {
    hetzner = {
      ipv4 = module.server_previous.ipv4_address
      ipv6 = module.server_previous.ipv6_address
      id   = module.server_previous.server_id
    }
  }
}
"
`;

exports[`renderInfra with an address side > matches the snapshots > hetzner to own, switched, terraform.tfvars.json 1`] = `
"{
  "app_name": "shop",
  "previous_location": "nbg1",
  "previous_server_type": "cx23",
  "previous_image": "ubuntu-24.04",
  "previous_backups": true,
  "deploy_ssh_public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE opscrew-deploy",
  "ssh_allowed_cidrs": [
    "0.0.0.0/0",
    "::/0"
  ],
  "http_allowed_cidrs": [
    "0.0.0.0/0",
    "::/0"
  ],
  "domain": "example.com",
  "cloudflare_zone_id": "0123456789abcdef0123456789abcdef",
  "proxied": false,
  "www": true,
  "caa_issuers": []
}
"
`;

exports[`renderInfra with an address side > matches the snapshots > hetzner to own, switched, variables.tf 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml. You own this code, but \`opscrew provision\`
# regenerates this file; change the plan (or the vendored modules) instead.

variable "app_name" {
  description = "App name, used for resource names."
  type        = string
}

variable "server_ipv4" {
  description = "Public IPv4 address of your server. OpsCrew passes it as TF_VAR_server_ipv4 from .opscrew/server.json; it is never written to a committed file."
  type        = string
}

variable "server_ipv6" {
  description = "Public IPv6 address of your server, or null when it has none (no AAAA record). OpsCrew passes it as TF_VAR_server_ipv6 from .opscrew/server.json; it is never written to a committed file."
  type        = string
  default     = null
}

variable "previous_location" {
  description = "Hetzner Cloud location of the previous server."
  type        = string
}

variable "previous_server_type" {
  description = "Hetzner Cloud server type of the previous server."
  type        = string
}

variable "previous_image" {
  description = "Operating system image of the previous server."
  type        = string
}

variable "previous_backups" {
  description = "Hetzner automated backups of the previous server."
  type        = bool
}

variable "previous_delete_protection" {
  description = "Protect the previous server against accidental deletion and rebuilds; \`opscrew retarget --finish\` passes false."
  type        = bool
  default     = true
}

variable "deploy_ssh_public_key" {
  description = "Public half of the deploy key."
  type        = string
}

variable "ssh_allowed_cidrs" {
  description = "Networks allowed to reach SSH."
  type        = list(string)
}

variable "http_allowed_cidrs" {
  description = "Networks allowed to reach ports 80 and 443."
  type        = list(string)
}

variable "domain" {
  description = "Hostname of the app."
  type        = string
}

variable "cloudflare_zone_id" {
  description = "Cloudflare zone id."
  type        = string
}

variable "proxied" {
  description = "Proxy traffic through Cloudflare."
  type        = bool
}

variable "www" {
  description = "Also serve www.<domain>."
  type        = bool
}

variable "caa_issuers" {
  description = "Certificate authorities named in CAA records at the domain (DNS only)."
  type        = list(string)
}
"
`;

