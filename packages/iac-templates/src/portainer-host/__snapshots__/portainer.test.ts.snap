// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderPortainerCompose > matches the snapshot 1`] = `
"# Generated by OpsCrew and shared by every OpsCrew app on this server; any app's \`opscrew provision\` regenerates it.
# Portainer CE listens only on the server itself: open it through an SSH tunnel (\`opscrew portainer
# status\` prints the command) or, when you opted in, its Cloudflare Access subdomain. It controls
# Docker through the socket, which is root on this server: never publish its port.
# First start: Portainer creates its admin from ./admin_password, which is then deleted.
# Portainer CE 2.33.1 (portainer.version in the plan) is pinned by tag only, not by digest.
name: opscrew-portainer
services:
  portainer:
    image: portainer/portainer-ce:2.33.1
    restart: unless-stopped
    command:
      - --http-disabled
      - --admin-password-file
      - /run/secrets/portainer_admin_password
    ports:
      - 127.0.0.1:9443:9443
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    secrets:
      - portainer_admin_password
volumes:
  portainer_data: {}
secrets:
  portainer_admin_password:
    file: ./admin_password
"
`;
