// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderCheck > renders a private repository's server runner, Portainer environment and Cloudflare app 1`] = `
"# Generated by OpsCrew from every plan with the scheduled check on (observability.check);
# \`opscrew provision\` regenerates it. It runs opscrew/check/check.mjs, which checks what
# opscrew/check/check.json lists: each hostname's health path over HTTPS and its certificate,
# and each server's disk. A failing check opens a GitHub issue labelled opscrew-check, which
# closes when the check passes again.
name: OpsCrew check

on:
  schedule:
    # Every 60 minutes, never on the hour: GitHub delays the runs at the top of each hour.
    - cron: "58 * * * *"
  workflow_dispatch: {}

permissions:
  contents: read
  issues: write

jobs:
  check:
    name: Check the hostnames, certificates and disks
    if: github.repository == 'example-org/example-app'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    concurrency:
      group: opscrew-check
      cancel-in-progress: false
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          sparse-checkout: opscrew/check
          persist-credentials: false
      - name: Run the check
        env:
          GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          OPSCREW_CHECK_PAUSED: \${{ vars.OPSCREW_CHECK_PAUSED }}
          OPSCREW_CHECK_WEBHOOK: \${{ secrets.OPSCREW_CHECK_WEBHOOK }}
          OPSCREW_CHECK_NTFY_TOKEN: \${{ secrets.OPSCREW_CHECK_NTFY_TOKEN }}
        run: node opscrew/check/check.mjs

  disk-own-shop:
    name: Check the disk of own-shop
    if: github.repository == 'example-org/example-app'
    runs-on: [self-hosted, opscrew-shop-prod]
    timeout-minutes: 5
    concurrency:
      group: opscrew-check-disk-own-shop
      cancel-in-progress: false
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          sparse-checkout: opscrew/check
          persist-credentials: false
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "24"
      - name: Run the check
        env:
          GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          OPSCREW_CHECK_PAUSED: \${{ vars.OPSCREW_CHECK_PAUSED }}
          OPSCREW_CHECK_WEBHOOK: \${{ secrets.OPSCREW_CHECK_WEBHOOK }}
          OPSCREW_CHECK_NTFY_TOKEN: \${{ secrets.OPSCREW_CHECK_NTFY_TOKEN }}
        run: node opscrew/check/check.mjs --only disk:own-shop
"
`;

exports[`renderCheck > renders a private repository's server runner, Portainer environment and Cloudflare app 2`] = `
"{
  "version": 1,
  "intervalMinutes": 60,
  "thresholds": {
    "diskWarn": 85,
    "diskHigh": 95,
    "certDays": 14,
    "tries": 3,
    "retrySeconds": 30,
    "timeoutSeconds": 10
  },
  "webhook": "ntfy",
  "public": false,
  "environments": [
    {
      "key": "shop/prod",
      "hosts": [
        {
          "hostname": "shop.example.com",
          "healthPath": "/api/health"
        }
      ],
      "server": {
        "id": "own-shop",
        "via": "own-runner"
      }
    },
    {
      "key": "docs/prod",
      "hosts": [
        {
          "hostname": "portal.example.com",
          "healthPath": "/api/health"
        }
      ]
    },
    {
      "key": "site/prod",
      "hosts": [
        {
          "hostname": "docs.example.com",
          "healthPath": "/"
        }
      ]
    }
  ]
}
"
`;

exports[`renderCheck > renders the workflow, check.json and check.mjs for a public repository with one cloud environment 1`] = `
"# Generated by OpsCrew from every plan with the scheduled check on (observability.check);
# \`opscrew provision\` regenerates it. It runs opscrew/check/check.mjs, which checks what
# opscrew/check/check.json lists: each hostname's health path over HTTPS and its certificate,
# and each server's disk. A failing check opens a GitHub issue labelled opscrew-check, which
# closes when the check passes again.
name: OpsCrew check

on:
  schedule:
    # Every 15 minutes, never on the hour: GitHub delays the runs at the top of each hour.
    - cron: "11,26,41,56 * * * *"
  workflow_dispatch: {}

permissions:
  contents: read
  issues: write

jobs:
  check:
    name: Check the hostnames, certificates and disks
    if: github.repository == 'example-org/example-app'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    concurrency:
      group: opscrew-check
      cancel-in-progress: false
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          sparse-checkout: opscrew/check
          persist-credentials: false
      - name: Run the check
        env:
          GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          OPSCREW_CHECK_PAUSED: \${{ vars.OPSCREW_CHECK_PAUSED }}
          OPSCREW_CHECK_SSH_KEY: \${{ secrets.OPSCREW_CHECK_SSH_KEY }}
          OPSCREW_CHECK_SERVER: \${{ secrets.OPSCREW_CHECK_SERVER }}
        run: node opscrew/check/check.mjs
"
`;

exports[`renderCheck > renders the workflow, check.json and check.mjs for a public repository with one cloud environment 2`] = `
"{
  "version": 1,
  "intervalMinutes": 15,
  "thresholds": {
    "diskWarn": 85,
    "diskHigh": 95,
    "certDays": 14,
    "tries": 3,
    "retrySeconds": 30,
    "timeoutSeconds": 10
  },
  "public": true,
  "environments": [
    {
      "key": "shop/prod",
      "hosts": [
        {
          "hostname": "example.com",
          "healthPath": "/api/health"
        },
        {
          "hostname": "www.example.com",
          "healthPath": "/api/health"
        }
      ],
      "server": {
        "id": "hetzner-shop",
        "secret": "OPSCREW_CHECK_SERVER",
        "via": "github"
      }
    }
  ]
}
"
`;
