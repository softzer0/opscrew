// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderNextConnectorStacks > renders the app's tunnel connector on the app stack's network, and the webhook's > opscrew-shop-portainer-tunnel-next 1`] = `
"# Generated by OpsCrew. While the app moves to another Cloudflare account, the connector of that
# account's tunnel to Portainer's webhook, beside the current one. Its token is in this stack's
# environment in Portainer, never in a file. It opens no port.
name: opscrew-shop-portainer-tunnel-next
services:
  cloudflared:
    image: <pin:IMAGES.cloudflared>
    restart: unless-stopped
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 127.0.0.1:20241
      - run
    environment:
      TUNNEL_TOKEN: \${TUNNEL_TOKEN}
    extra_hosts:
      - host.docker.internal:host-gateway
    mem_limit: 32m
    memswap_limit: 32m
    read_only: true
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
"
`;

exports[`renderNextConnectorStacks > renders the app's tunnel connector on the app stack's network, and the webhook's > opscrew-shop-tunnel-next 1`] = `
"# Generated by OpsCrew. While the app moves to another Cloudflare account, the connector of that
# account's tunnel for the app, beside the app stack's own, on that stack's network (it reaches
# Caddy at http://caddy:80). Its token is in this stack's
# environment in Portainer, never in a file. It opens no port.
name: opscrew-shop-tunnel-next
services:
  cloudflared:
    image: <pin:IMAGES.cloudflared>
    restart: unless-stopped
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 127.0.0.1:20241
      - run
    environment:
      TUNNEL_TOKEN: \${TUNNEL_TOKEN}
    mem_limit: 32m
    memswap_limit: 32m
    read_only: true
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
    networks:
      - internal
networks:
  internal:
    name: opscrew-shop_internal
    external: true
"
`;
