// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Next.js with a release command > keeps the migration tool and the app's files in the standalone image 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (next-standalone). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Builds with or without \`output: "standalone"\` in next.config.* (OpsCrew adds it as a code
# change). With it, the image ships only the standalone server, .next/static and public;
# without it, the image holds the whole built app with its dependencies and runs
# \`next start\`. The build stage gathers what runs into /out, with /out/opscrew-start.sh as
# the entry point.

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build && mkdir -p public
# The standalone server when the build made one, otherwise the whole app with \`next start\`.
RUN mkdir -p /out \\
  && if [ -f .next/standalone/server.js ]; then \\
    cp -a .next/standalone/. /out/ \\
    && mkdir -p /out/.next \\
    && cp -a .next/static /out/.next/static \\
    && cp -a public /out/public \\
    && printf '#!/bin/sh\\nexec node "%s"\\n' /app/server.js > /out/opscrew-start.sh; \\
  else \\
    rm -rf .next/cache && cp -a . /out/ \\
    && NEXT_BIN="$(node -p "require.resolve('next/dist/bin/next')")" && [ -n "$NEXT_BIN" ] \\
    && printf '#!/bin/sh\\ncd "%s"\\nexec node "%s" start --hostname "\${HOSTNAME:-0.0.0.0}" --port "\${PORT:-3000}"\\n' \\
      /app "$NEXT_BIN" > /out/opscrew-start.sh; \\
  fi
# The release command runs prisma: the image gets it, at the version this stage
# installed, with the app folder's files for its configuration and migrations.
# ts-node, tsx, typescript stay too when installed, for TypeScript configs and migrations.
COPY <<'EOF' /tmp/opscrew-release-tools.cjs
// OpsCrew: the npm packages the release command's migration tool needs.
const fs = require("fs");
const BINS = {"prisma":["prisma"],"drizzle-kit":["drizzle-kit"],"typeorm-ts-node-commonjs":["typeorm","ts-node"],"typeorm-ts-node-esm":["typeorm","ts-node"],"typeorm":["typeorm"],"sequelize":["sequelize-cli"],"sequelize-cli":["sequelize-cli"],"knex":["knex"],"mikro-orm":["@mikro-orm/cli"],"kysely":["kysely-ctl"],"node-pg-migrate":["node-pg-migrate"],"db-migrate":["db-migrate"],"payload":["payload"],"medusa":["@medusajs/cli"]};
const [mode, dir, script, ...packages] = process.argv.slice(2);
const manifests = [...new Set([dir + "/package.json", "package.json"])].filter((f) => fs.existsSync(f));
const read = (file) => JSON.parse(fs.readFileSync(file, "utf8"));
if (script !== "-") {
  const text = manifests.map((f) => read(f).scripts?.[script]).find((s) => s !== undefined);
  if (text === undefined) throw new Error("No package.json in " + dir + " has a script " + script);
  for (const command of text.split(/&&|\\|\\||;/)) {
    const words = command.trim().split(/\\s+/).filter((w) => !/^[A-Za-z_]\\w*=/.test(w));
    const bin = (words[0] === "npx" ? words[1] : words[0]) ?? "";
    packages.push(...(BINS[bin.replace(/@.*$/, "")] ?? []));
  }
}
const wanted = [...new Set(packages)];
// TypeScript runners a tool needs for a TypeScript config or migrations: kept with it when there.
const TS = ["ts-node","tsx","typescript"].filter((t) => wanted.length > 0 && !wanted.includes(t));
const installed = (name) => [dir + "/node_modules/" + name + "/package.json", "node_modules/" + name + "/package.json"].find((f) => fs.existsSync(f));
if (mode === "move") {
  for (const name of wanted) {
    const listed = manifests.some((f) => { const p = read(f); return p.dependencies?.[name] !== undefined || p.devDependencies?.[name] !== undefined; });
    if (!listed) throw new Error("The release command needs " + name + ", which package.json does not list: add it.");
  }
  for (const file of manifests) {
    const p = read(file);
    const dev = p.devDependencies ?? {};
    const kept = [...wanted, ...TS].filter((t) => t in dev);
    if (kept.length === 0) continue;
    p.dependencies ??= {};
    for (const t of kept) { p.dependencies[t] = dev[t]; delete dev[t]; }
    fs.writeFileSync(file, JSON.stringify(p, null, 2) + "\\n");
  }
} else {
  for (const name of wanted) {
    if (installed(name) === undefined) throw new Error("The release command needs " + name + ", which is not installed: add it to package.json.");
  }
  const all = [...wanted, ...TS.filter((t) => installed(t) !== undefined)];
  console.log(all.map((name) => name + "@" + read(installed(name)).version).join(" "));
}
EOF
RUN tools="$(node /tmp/opscrew-release-tools.cjs versions . - prisma)" \\
  && if [ -n "$tools" ]; then mkdir -p /tmp/release-tools /out/node_modules && cd /tmp/release-tools \\
    && echo '{"private":true}' > package.json && npm install --no-audit --no-fund $tools \\
    && cp -a /out/node_modules/. node_modules/ && rm -rf /out/node_modules \\
    && mv node_modules /out/node_modules; fi \\
  && for tool in $tools; do name="\${tool%@*}"; [ -f "/out/node_modules/$name/package.json" ] \\
    || { echo "The image lacks $name, which the release command runs." >&2; exit 1; }; done \\
  && mkdir -p /out && cd /app \\
  && find . -mindepth 1 -maxdepth 1 ! -name node_modules ! -name .next -exec cp -an {} /out/ \\;

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /out ./
USER node
EXPOSE 3000
CMD ["sh", "/app/opscrew-start.sh"]
"
`;
