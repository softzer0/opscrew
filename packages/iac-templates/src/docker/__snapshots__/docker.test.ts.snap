exports[`pnpm and Yarn without corepack (T1219) > renders pnpmMemberApi on Node 24 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (node-server). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# The image is built from the repository root so the root lockfile and workspace packages
# are available; the app lives in apps/api.

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@12.14.0");process.exit(1)}const v=m?m[1]:"12.14.0";console.log("pnpm@"+v)')" && npm install -g --no-audit --no-fund "$spec" && if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
# Only production dependencies go into the image: development ones (TypeScript, test tools)
# stay in this stage.
RUN find . -name node_modules -type d -prune -exec rm -rf {} + && if [ -f pnpm-lock.yaml ]; then pnpm install --prod --frozen-lockfile; else pnpm install --prod; fi

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=4001 HOST=0.0.0.0
COPY --from=build --chown=node:node /app ./
# npm runs the script of the app in apps/api: the build stops if \`--filter api\` names another package.
RUN node -e 'const n=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).name;if(n!==process.argv[2]){console.error("The start command runs pnpm --filter "+process.argv[2]+", but the app in "+process.argv[3]+" is named "+n+": change the CMD line of this Dockerfile to the command that starts the app.");process.exit(1)}' apps/api/package.json api apps/api
# The app starts with npm, so the image needs no pnpm, unless the \`start\` script (or its
# pre or post script) calls it; then it is installed here, at the build stage's version.
RUN if node -e 'const s=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).scripts||{};const n=process.argv[2];process.exit(["pre"+n,n,"post"+n].some((k)=>/(^|[\\s;&|(])(pnpm|pnpx)(\\s|$)/.test(s[k]))?0:1)' apps/api/package.json start; then spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@12.14.0");process.exit(1)}const v=m?m[1]:"12.14.0";console.log("pnpm@"+v)')" && npm install -g --no-audit --no-fund "$spec" && rm -rf /root/.npm; fi
USER node
EXPOSE 4001
CMD ["sh", "-c", "cd apps/api && npm run start"]
"
`;

