exports[`pnpm and Yarn without corepack (T1219) > renders pnpmMemberApi with a pnpm release command on Node 26 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (node-server). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# The image is built from the repository root so the root lockfile and workspace packages
# are available; the app lives in apps/api.

FROM node:26-alpine@sha256:abababababababababababababababababababababababababababababababab AS build
WORKDIR /app
COPY . .
RUN spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@12.14.0");process.exit(1)}const v=m?m[1]:"12.14.0";console.log("pnpm@"+v)')" && npm install -g --no-audit --no-fund "$spec" && if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
# Only production dependencies go into the image: development ones (TypeScript, test tools)
# stay in this stage. The image keeps the tool the \`migrate\` script runs, which the release command runs.
# ts-node, tsx, typescript stay too when installed, for TypeScript configs and migrations.
COPY <<'EOF' /tmp/opscrew-release-tools.cjs
// OpsCrew: the npm packages the release command's migration tool needs.
const fs = require("fs");
const BINS = {"prisma":["prisma"],"drizzle-kit":["drizzle-kit"],"typeorm-ts-node-commonjs":["typeorm","ts-node"],"typeorm-ts-node-esm":["typeorm","ts-node"],"typeorm":["typeorm"],"sequelize":["sequelize-cli"],"sequelize-cli":["sequelize-cli"],"knex":["knex"],"mikro-orm":["@mikro-orm/cli"],"kysely":["kysely-ctl"],"node-pg-migrate":["node-pg-migrate"],"db-migrate":["db-migrate"],"payload":["payload"],"medusa":["@medusajs/cli"]};
const [mode, dir, script, ...packages] = process.argv.slice(2);
const manifests = [...new Set([dir + "/package.json", "package.json"])].filter((f) => fs.existsSync(f));
const read = (file) => JSON.parse(fs.readFileSync(file, "utf8"));
if (script !== "-") {
  const text = manifests.map((f) => read(f).scripts?.[script]).find((s) => s !== undefined);
  if (text === undefined) throw new Error("No package.json in " + dir + " has a script " + script);
  for (const command of text.split(/&&|\\|\\||;/)) {
    const words = command.trim().split(/\\s+/).filter((w) => !/^[A-Za-z_]\\w*=/.test(w));
    const bin = (words[0] === "npx" ? words[1] : words[0]) ?? "";
    packages.push(...(BINS[bin.replace(/@.*$/, "")] ?? []));
  }
}
const wanted = [...new Set(packages)];
// TypeScript runners a tool needs for a TypeScript config or migrations: kept with it when there.
const TS = ["ts-node","tsx","typescript"].filter((t) => wanted.length > 0 && !wanted.includes(t));
const installed = (name) => [dir + "/node_modules/" + name + "/package.json", "node_modules/" + name + "/package.json"].find((f) => fs.existsSync(f));
if (mode === "move") {
  for (const name of wanted) {
    const listed = manifests.some((f) => { const p = read(f); return p.dependencies?.[name] !== undefined || p.devDependencies?.[name] !== undefined; });
    if (!listed) throw new Error("The release command needs " + name + ", which package.json does not list: add it.");
  }
  for (const file of manifests) {
    const p = read(file);
    const dev = p.devDependencies ?? {};
    const kept = [...wanted, ...TS].filter((t) => t in dev);
    if (kept.length === 0) continue;
    p.dependencies ??= {};
    for (const t of kept) { p.dependencies[t] = dev[t]; delete dev[t]; }
    fs.writeFileSync(file, JSON.stringify(p, null, 2) + "\\n");
  }
} else {
  for (const name of wanted) {
    if (installed(name) === undefined) throw new Error("The release command needs " + name + ", which is not installed: add it to package.json.");
  }
  const all = [...wanted, ...TS.filter((t) => installed(t) !== undefined)];
  console.log(all.map((name) => name + "@" + read(installed(name)).version).join(" "));
}
EOF
RUN node /tmp/opscrew-release-tools.cjs move apps/api migrate && find . -name node_modules -type d -prune -exec rm -rf {} + && pnpm install --prod --no-frozen-lockfile

FROM node:26-alpine@sha256:abababababababababababababababababababababababababababababababab AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=4001 HOST=0.0.0.0
COPY --from=build --chown=node:node /app ./
# npm runs the script of the app in apps/api: the build stops if \`--filter api\` names another package.
RUN node -e 'const n=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).name;if(n!==process.argv[2]){console.error("The start command runs pnpm --filter "+process.argv[2]+", but the app in "+process.argv[3]+" is named "+n+": change the CMD line of this Dockerfile to the command that starts the app.");process.exit(1)}' apps/api/package.json api apps/api
# pnpm runs the start or release command, so it is installed here, at the build stage's
# version: nothing is downloaded when the container starts.
RUN spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@12.14.0");process.exit(1)}const v=m?m[1]:"12.14.0";console.log("pnpm@"+v)')" && npm install -g --no-audit --no-fund "$spec" && rm -rf /root/.npm
USER node
EXPOSE 4001
CMD ["sh", "-c", "cd apps/api && npm run start"]
"
`;

