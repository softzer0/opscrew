"
`;

exports[`renderDockerAssets > renders viteApp 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (static-spa). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Builds the site with Node, then serves the static files with Caddy on port 8080 as an
# unprivileged user (OpsCrew's outer Caddy terminates TLS in front of it).

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN corepack enable && { grep -q '"packageManager"' package.json || corepack prepare pnpm@12.14.0 --activate; } && if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
# Values baked into the frontend at build time (public by design; never put secrets here).
ARG VITE_SUPABASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
RUN pnpm run build

FROM caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
COPY --from=build /app/dist /srv
RUN printf '%s\\n' '{' '	auto_https off' '	admin off' '}' ':8080 {' '	root * /srv' '	encode zstd gzip' '	try_files {path} /index.html' '	file_server' '}' > /etc/caddy/Caddyfile \\
  && chown -R 65534:65534 /data /config \\
  && cp /usr/bin/caddy /usr/local/bin/caddy
USER 65534
EXPOSE 8080
CMD ["/usr/local/bin/caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
"
`;

exports[`renderDockerAssets for an app in a subfolder (facts.appDir) > renders npmWorkspaceApi into its folder 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (node-server). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# The image is built from the repository root so the root lockfile and workspace packages
# are available; the app lives in apps/api.

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
# Only production dependencies go into the image: development ones (TypeScript, test tools)
# stay in this stage.
RUN npm prune --omit=dev

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=4000 HOST=0.0.0.0
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 4000
CMD ["sh", "-c", "npm run start --workspace apps/api"]
"
`;

exports[`renderDockerAssets for an app in a subfolder (facts.appDir) > renders pnpmWorkspaceSite into its folder 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (static-spa). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Builds the site with Node, then serves the static files with Caddy on port 8080 as an
# unprivileged user (OpsCrew's outer Caddy terminates TLS in front of it).
# The image is built from the repository root so the root lockfile and workspace packages
# are available; the app lives in apps/site.

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN corepack enable && { grep -q '"packageManager"' package.json || corepack prepare pnpm@12.14.0 --activate; } && if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
