exports[`the SQLite folder in the image of an app on SQLite > matches the snapshot of a Node.js server image 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (node-server). You own this file: edit it freely; OpsCrew only creates it
