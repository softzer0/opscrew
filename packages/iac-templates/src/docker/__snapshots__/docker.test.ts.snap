exports[`renderDockerAssets > renders djangoApp 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (python-django). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.

FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8000
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY pyproject.toml poetry.lock* ./
RUN pip install poetry==2.5.1 && poetry config virtualenvs.create false && poetry install --only main --no-root
COPY --chown=app:app . .
# gunicorn serves the app; it is added (pinned) only when the dependencies do not install it.
RUN python -c "import gunicorn" 2>/dev/null || pip install gunicorn==26.2.0
ENV DJANGO_WSGI_MODULE=shop_site.wsgi
# Collects static files at build time when the settings set STATIC_ROOT (skipped otherwise).
# The key below is a throwaway value for this step only; the real SECRET_KEY is set when the
# container runs.
RUN export SECRET_KEY=build-only-placeholder-not-secret DJANGO_SECRET_KEY=build-only-placeholder-not-secret && static_root="$(python manage.py shell --verbosity 0 -c 'from django.conf import settings; print(settings.STATIC_ROOT or "")')" && if [ -n "$static_root" ]; then python manage.py collectstatic --noinput; else echo "collectstatic skipped: STATIC_ROOT is not set"; fi
USER app
EXPOSE 8000
# Run migrations as part of your release process (for example \`python manage.py migrate\`).
CMD ["sh", "-c", "gunicorn \${DJANGO_WSGI_MODULE} --bind 0.0.0.0:\${PORT}"]
"
`;

exports[`renderDockerAssets > renders expressApp 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (node-server). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN corepack enable && { grep -q '"packageManager"' package.json || corepack prepare yarn@1.22.22 --activate; } && if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else yarn install; fi
# Only production dependencies go into the image: development ones (TypeScript, test tools)
# stay in this stage.
RUN if [ "$(yarn --version | cut -d. -f1)" = 1 ]; then if [ -f yarn.lock ]; then yarn install --production --frozen-lockfile; else yarn install --production; fi; elif yarn workspaces focus --help > /dev/null 2>&1; then yarn workspaces focus --all --production; else echo 'OpsCrew leaves the development dependencies out of the image with yarn workspaces focus, which Yarn 2 and 3 have only with the workspace-tools plugin: run "yarn plugin import workspace-tools" and commit .yarnrc.yml and .yarn/plugins, or move to Yarn 4 ("yarn set version stable").' >&2; exit 1; fi

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=4000 HOST=0.0.0.0
RUN corepack enable
COPY --from=build --chown=node:node /app ./
USER node
# corepack keeps OpsCrew's pinned Yarn for the app's user when package.json names no packageManager.
RUN grep -q '"packageManager"' package.json || corepack prepare yarn@1.22.22 --activate
EXPOSE 4000
CMD ["sh", "-c", "node server.js"]
"
`;

exports[`renderDockerAssets > renders fastapiApp 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (python-fastapi). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# python:3.12-slim is pinned by tag only: OpsCrew could not look up its digest. Pin it by adding
# @sha256:<digest> to the FROM lines (\`docker buildx imagetools inspect python:3.12-slim\` shows it).

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8000
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY requirements*.txt ./
RUN pip install -r requirements.txt
COPY --chown=app:app . .
# uvicorn serves the app; it is added (pinned) only when the dependencies do not install it.
RUN python -c "import uvicorn" 2>/dev/null || pip install uvicorn==0.54.0
USER app
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:api --host 0.0.0.0 --port \${PORT}"]
"
`;

exports[`renderDockerAssets > renders nextApp 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (next-standalone). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Builds with or without \`output: "standalone"\` in next.config.* (OpsCrew adds it as a code
# change). With it, the image ships only the standalone server, .next/static and public;
# without it, the image holds the whole built app with its dependencies and runs
# \`next start\`. The build stage gathers what runs into /out, with /out/opscrew-start.sh as
# the entry point.

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
ENV NEXT_TELEMETRY_DISABLED=1
# Values baked into the frontend at build time (public by design; never put secrets here).
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
RUN npm run build && mkdir -p public
# The standalone server when the build made one, otherwise the whole app with \`next start\`.
RUN mkdir -p /out \\
  && if [ -f .next/standalone/server.js ]; then \\
    cp -a .next/standalone/. /out/ \\
    && mkdir -p /out/.next \\
    && cp -a .next/static /out/.next/static \\
    && cp -a public /out/public \\
    && printf '#!/bin/sh\\nexec node "%s"\\n' /app/server.js > /out/opscrew-start.sh; \\
  else \\
    rm -rf .next/cache && cp -a . /out/ \\
    && NEXT_BIN="$(node -p "require.resolve('next/dist/bin/next')")" && [ -n "$NEXT_BIN" ] \\
    && printf '#!/bin/sh\\ncd "%s"\\nexec node "%s" start --hostname "\${HOSTNAME:-0.0.0.0}" --port "\${PORT:-3000}"\\n' \\
      /app "$NEXT_BIN" > /out/opscrew-start.sh; \\
  fi

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /out ./
USER node
EXPOSE 3000
CMD ["sh", "/app/opscrew-start.sh"]
"
`;

exports[`renderDockerAssets > renders nextMonorepoApp 1`] = `
"# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Generated by OpsCrew (next-standalone). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Builds with or without \`output: "standalone"\` in apps/web/next.config.*. Because the app
# lives in a monorepo, the standalone output also needs \`outputFileTracingRoot\` pointing at
# the repository root, for example
# \`outputFileTracingRoot: path.join(__dirname, "../../")\` (OpsCrew adds both as a code change).
# With them, the image ships only the standalone server (started from apps/web/server.js),
# .next/static and public; without them, the image holds the whole built workspace with its
# dependencies and runs \`next start\` in the app folder. The build stage gathers what runs
# into /out, with /out/opscrew-start.sh as the entry point. The image is built from the
# repository root so the root lockfile and workspace packages are available.

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY . .
RUN corepack enable && { grep -q '"packageManager"' package.json || corepack prepare pnpm@12.14.0 --activate; } && if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
ENV NEXT_TELEMETRY_DISABLED=1
# Values baked into the frontend at build time (public by design; never put secrets here).
ARG NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
RUN pnpm --filter web run build && mkdir -p apps/web/public
# The standalone server when the build made one, otherwise the whole app with \`next start\`.
RUN mkdir -p /out \\
  && if [ -f apps/web/.next/standalone/apps/web/server.js ]; then \\
    cp -a apps/web/.next/standalone/. /out/ \\
    && mkdir -p /out/apps/web/.next \\
    && cp -a apps/web/.next/static /out/apps/web/.next/static \\
    && cp -a apps/web/public /out/apps/web/public \\
    && printf '#!/bin/sh\\nexec node "%s"\\n' /app/apps/web/server.js > /out/opscrew-start.sh; \\
  elif [ -f apps/web/.next/standalone/server.js ]; then \\
    cp -a apps/web/.next/standalone/. /out/ \\
    && mkdir -p /out/.next \\
    && cp -a apps/web/.next/static /out/.next/static \\
    && cp -a apps/web/public /out/public \\
    && printf '#!/bin/sh\\nexec node "%s"\\n' /app/server.js > /out/opscrew-start.sh; \\
  else \\
    rm -rf apps/web/.next/cache && cp -a . /out/ \\
    && NEXT_BIN="$(cd apps/web && node -p "require.resolve('next/dist/bin/next')")" && [ -n "$NEXT_BIN" ] \\
    && printf '#!/bin/sh\\ncd "%s"\\nexec node "%s" start --hostname "\${HOSTNAME:-0.0.0.0}" --port "\${PORT:-4000}"\\n' \\
      /app/apps/web "$NEXT_BIN" > /out/opscrew-start.sh; \\
  fi

FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=4000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /out ./
USER node
EXPOSE 4000
CMD ["sh", "/app/opscrew-start.sh"]
"
`;

