exports[`renderDockerAssets > renders djangoApp 1`] = `
"# syntax=docker/dockerfile:1
# Generated by OpsCrew (python-django). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8000
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY pyproject.toml poetry.lock* ./
RUN pip install poetry && poetry config virtualenvs.create false && poetry install --only main --no-root
COPY --chown=app:app . .
RUN pip install gunicorn
ENV DJANGO_WSGI_MODULE=shop_site.wsgi
# Collects static files at build time (settings need STATIC_ROOT). The key below is a
# throwaway value for this step only; the real SECRET_KEY is set when the container runs.
RUN SECRET_KEY=build-only-placeholder-not-secret DJANGO_SECRET_KEY=build-only-placeholder-not-secret python manage.py collectstatic --noinput
USER app
EXPOSE 8000
# Run migrations as part of your release process (for example \`python manage.py migrate\`).
CMD ["sh", "-c", "gunicorn \${DJANGO_WSGI_MODULE} --bind 0.0.0.0:\${PORT}"]
"
`;

exports[`renderDockerAssets > renders expressApp 1`] = `
"# syntax=docker/dockerfile:1
# Generated by OpsCrew (node-server). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.

FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN corepack enable && if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else yarn install; fi

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=4000
RUN corepack enable
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 4000
CMD ["sh", "-c", "node server.js"]
"
`;

exports[`renderDockerAssets > renders fastapiApp 1`] = `
"# syntax=docker/dockerfile:1
# Generated by OpsCrew (python-fastapi). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8000
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY requirements*.txt ./
RUN pip install -r requirements.txt
COPY --chown=app:app . .
RUN pip install uvicorn
USER app
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:api --host 0.0.0.0 --port \${PORT}"]
"
`;

exports[`renderDockerAssets > renders nextApp 1`] = `
"# syntax=docker/dockerfile:1
# Generated by OpsCrew (next-standalone). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Requires \`output: "standalone"\` in next.config.* (OpsCrew adds it as a code change).

FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
ENV NEXT_TELEMETRY_DISABLED=1
# Values baked into the frontend at build time (public by design; never put secrets here).
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
RUN npm run build && mkdir -p public

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
"
`;

exports[`renderDockerAssets > renders nextMonorepoApp 1`] = `
"# syntax=docker/dockerfile:1
# Generated by OpsCrew (next-standalone). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Requires \`output: "standalone"\` in apps/web/next.config.* and, because the app lives in a
# monorepo, \`outputFileTracingRoot\` pointing at the repository root, for example
# \`outputFileTracingRoot: path.join(__dirname, "../../")\` (OpsCrew adds both as a code change).
# The image is built from the repository root so the root lockfile and workspace packages
# are available; the server starts from apps/web/server.js.

FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN corepack enable && if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
ENV NEXT_TELEMETRY_DISABLED=1
# Values baked into the frontend at build time (public by design; never put secrets here).
ARG NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
RUN pnpm --filter web run build && mkdir -p apps/web/public

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=4000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 4000
CMD ["node", "apps/web/server.js"]
"
`;

exports[`renderDockerAssets > renders pythonApp 1`] = `
"# syntax=docker/dockerfile:1
# Generated by OpsCrew (python-generic). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=3000
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY pyproject.toml uv.lock* ./
RUN pip install uv && uv pip install --system -r pyproject.toml
COPY --chown=app:app . .
USER app
EXPOSE 3000
CMD ["sh", "-c", "python main.py"]
"
`;

exports[`renderDockerAssets > renders viteApp 1`] = `
"# syntax=docker/dockerfile:1
# Generated by OpsCrew (static-spa). You own this file: edit it freely; OpsCrew only creates it
# when it is missing.
# Builds the site with Node, then serves the static files with Caddy on port 8080 as an
# unprivileged user (OpsCrew's outer Caddy terminates TLS in front of it).

FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN corepack enable && if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
# Values baked into the frontend at build time (public by design; never put secrets here).
ARG VITE_SUPABASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
RUN pnpm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
RUN printf '%s\\n' '{' '	auto_https off' '	admin off' '}' ':8080 {' '	root * /srv' '	encode zstd gzip' '	try_files {path} /index.html' '	file_server' '}' > /etc/caddy/Caddyfile \\
  && chown -R 65534:65534 /data /config
USER 65534
EXPOSE 8080
"
`;
