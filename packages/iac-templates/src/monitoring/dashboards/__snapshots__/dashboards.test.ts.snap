          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(node_load1{app=~\\"$app\\"}, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "opscrew-prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(node_load1{app=~\\"$app\\", env=~\\"$env\\"}, server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(node_load1{app=~\\"$app\\", env=~\\"$env\\"}, server)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "sum by (app, env, server, service) (pg_stat_database_numbackends{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"})",
          "legendFormat": "in use {{server}} {{service}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "max by (app, env, server, service) (pg_settings_max_connections{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"})",
          "legendFormat": "max_connections {{server}} {{service}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Transactions",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "sum by (app, env, server, service, datname) (rate(pg_stat_database_xact_commit{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval]) + rate(pg_stat_database_xact_rollback{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval]))",
          "legendFormat": "{{server}} {{service}} {{datname}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "sum by (app, env, server, service, datname) (rate(pg_stat_database_blks_hit{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval])) / (sum by (app, env, server, service, datname) (rate(pg_stat_database_blks_hit{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval])) + sum by (app, env, server, service, datname) (rate(pg_stat_database_blks_read{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval])))",
          "legendFormat": "{{server}} {{service}} {{datname}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Size",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "max by (app, env, server, service, datname) (pg_database_size_bytes{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"})",
          "legendFormat": "{{server}} {{service}} {{datname}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Deadlocks",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "sum by (app, env, server, service, datname) (increase(pg_stat_database_deadlocks{app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__range]))",
          "legendFormat": "{{server}} {{service}} {{datname}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Oldest running query",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "max by (app, env, server, service) (pg_stat_activity_max_tx_duration{state=\\"active\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"})",
          "legendFormat": "{{server}} {{service}}",
          "range": true
        }
      ]
    }
  ]
}
"
`;

