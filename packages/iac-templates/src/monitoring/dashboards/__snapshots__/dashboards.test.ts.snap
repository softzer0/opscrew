      "id": 1,
      "type": "timeseries",
      "title": "CPU in use",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
