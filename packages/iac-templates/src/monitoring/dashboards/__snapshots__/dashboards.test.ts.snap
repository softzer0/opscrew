        "datasource": {
          "type": "prometheus",
          "uid": "opscrew-prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(node_load1{app=~\\"$app\\"}, env)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(node_load1{app=~\\"$app\\"}, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
