        "hide": 0
      },
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "opscrew-prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(node_load1{app=~\\"$app\\", env=~\\"$env\\"}, server)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(node_load1{app=~\\"$app\\", env=~\\"$env\\"}, server)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "sum by (app, env, server) (caddy_http_requests_in_flight{service=\\"caddy\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"})",
          "legendFormat": "{{app}} {{env}} {{server}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
