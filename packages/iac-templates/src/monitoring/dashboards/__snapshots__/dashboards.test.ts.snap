          "expr": "(sum by (host) (rate(caddy_http_request_duration_seconds_count{handler!=\\"metrics\\", code=~\\"4..\\", service=\\"caddy\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval])) or 0 * sum by (host) (rate(caddy_http_request_duration_seconds_count{handler!=\\"metrics\\", service=\\"caddy\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval]))) / sum by (host) (rate(caddy_http_request_duration_seconds_count{handler!=\\"metrics\\", service=\\"caddy\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx share",
      "datasource": {
        "type": "prometheus",
        "uid": "opscrew-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opscrew-prometheus"
          },
          "expr": "(sum by (host) (rate(caddy_http_request_duration_seconds_count{handler!=\\"metrics\\", code=~\\"5..\\", service=\\"caddy\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval])) or 0 * sum by (host) (rate(caddy_http_request_duration_seconds_count{handler!=\\"metrics\\", service=\\"caddy\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval]))) / sum by (host) (rate(caddy_http_request_duration_seconds_count{handler!=\\"metrics\\", service=\\"caddy\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval]))",
