            "uid": "opscrew-prometheus"
          },
          "expr": "1 - avg by (app, env, server) (rate(node_cpu_seconds_total{mode=\\"idle\\", app=~\\"$app\\", env=~\\"$env\\", server=~\\"$server\\"}[$__rate_interval]))",
          "legendFormat": "{{app}} {{env}} {{server}}",
          "range": true
        }
