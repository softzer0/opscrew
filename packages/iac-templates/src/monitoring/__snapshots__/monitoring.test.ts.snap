// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderMonitoringStack > renders a monitoring server on one network (snapshot) 1`] = `
{
  "Caddyfile": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's monitoring front: only the two push paths, POST only. Grafana reads Prometheus and
# Loki on the stack's own network; their query APIs are never reachable here.
{
	admin off
	auto_https off
	persist_config off
}

:9091 {
	# Alloy's batches stay under 1 MiB on the wire; past 8 MiB the front answers 413.
	request_body {
		max_size 8MiB
	}

	@metrics {
		method POST
		path /api/v1/write
	}
	handle @metrics {
		rewrite * /api/v1/write
		reverse_proxy prometheus:9090
	}

	@logs {
		method POST
		path /loki/api/v1/push
	}
	handle @logs {
		rewrite * /loki/api/v1/push
		reverse_proxy loki:3100
	}

	handle {
		respond 403
	}
}
",
  "compose.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's monitoring stack: Prometheus and Loki keep what the servers' Alloy pushes through the
# front, and Grafana shows it. Prometheus and Loki have no route out and no published port.
# The front passes only the two push paths, on 10.200.4.2.
# Grafana is on 127.0.0.1, and for your devices on 10.200.4.2 (the filter admits devices only).
# Grafana's admin password is in grafana_admin_credential beside this file, never in it.
name: opscrew-monitoring
services:
  prometheus:
    image: <pin:IMAGES.prometheus>
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
      - --storage.tsdb.retention.size=24GB
      - --web.enable-remote-write-receiver
    environment:
      GOMEMLIMIT: 153MiB
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus:/prometheus
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 30s
    networks:
      - stack
    read_only: true
    mem_limit: 192m
    memswap_limit: 192m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  loki:
    image: <pin:IMAGES.loki>
    restart: unless-stopped
    command:
      - -config.file=/etc/loki/loki.yaml
    environment:
      GOMEMLIMIT: 307MiB
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki:/loki
    networks:
      - stack
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 384m
    memswap_limit: 384m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  grafana:
    image: <pin:IMAGES.grafana>
    restart: unless-stopped
    environment:
      GOMEMLIMIT: 332MiB
      GF_SECURITY_ADMIN_PASSWORD: $$__file{/run/opscrew/grafana_admin_credential}
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_USERS_ALLOW_ORG_CREATE: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_SNAPSHOTS_EXTERNAL_ENABLED: "false"
      GF_PUBLIC_DASHBOARDS_ENABLED: "false"
      GF_METRICS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
      GF_PLUGINS_PUBLIC_KEY_RETRIEVAL_DISABLED: "true"
      GF_PLUGINS_PLUGIN_ADMIN_ENABLED: "false"
      GF_GRAFANA_COM_URL: http://127.0.0.1:9
      GF_GRAFANA_COM_API_URL: http://127.0.0.1:9/api
      GF_PLUGINS_DISABLE_PLUGINS: cloudwatch,elasticsearch,grafana-postgresql-datasource,grafana-pyroscope-datasource,influxdb,jaeger,mssql,mysql,opentsdb,stackdriver,tempo,zipkin
    volumes:
      - ./grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ./grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
      - ./grafana_admin_credential:/run/opscrew/grafana_admin_credential:ro
      - grafana:/var/lib/grafana
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:3000/api/health
      interval: 30s
      timeout: 5s
      start_period: 60s
    ports:
      - 127.0.0.1:3000:3000
      - 10.200.4.2:3000:3000
    networks:
      - stack
      - published
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 416m
    memswap_limit: 416m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  front:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 65534:65534
    environment:
      GOMEMLIMIT: 76MiB
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://loki:3100/ready && wget -q -O /dev/null http://prometheus:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 60s
    ports:
      - 10.200.4.2:9091:9091
    networks:
      - stack
      - published
      - push
    depends_on:
      - prometheus
      - loki
    read_only: true
    tmpfs:
      - /data:uid=65534,gid=65534,mode=0700
      - /config:uid=65534,gid=65534,mode=0700
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 96m
    memswap_limit: 96m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
networks:
  stack:
    internal: true
  published: {}
  push:
    name: opscrew-monitoring-push
volumes:
  prometheus: {}
  loki: {}
  grafana: {}
",
  "grafana/dashboards/http.json": "{"uid":"opscrew-http","caddy":true}
",
  "grafana/dashboards/servers.json": "{"uid":"opscrew-servers"}
",
  "grafana/provisioning/dashboards/opscrew.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's dashboards, from the JSON files in grafana/dashboards, in the folder OpsCrew. They
# can't be saved from Grafana, only copied; your copies and own dashboards are kept.
apiVersion: 1
providers:
  - name: opscrew
    orgId: 1
    folder: OpsCrew
    folderUid: opscrew
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/dashboards
      foldersFromFilesStructure: false
",
  "grafana/provisioning/datasources/opscrew.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's two data sources, read-only in Grafana. Grafana reaches both on the stack's own
# network; neither query API is published.
apiVersion: 1
prune: true
datasources:
  - name: Prometheus
    uid: opscrew-prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      # Alloy sends every 15 seconds: $__rate_interval is built from it.
      timeInterval: 15s
      prometheusType: Prometheus
  - name: Loki
    uid: opscrew-loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false
    jsonData:
      maxLines: 1000
",
  "loki.yaml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Loki for OpsCrew's monitoring stack: one process, files on disk under /loki (the \`loki\`
# volume), no auth (one tenant; only the front's push path reaches it), schema v13 on tsdb with
# a 24-hour index, and retention by the compactor.
auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9095
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules

schema_config:
  configs:
    - from: "2026-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

storage_config:
  tsdb_shipper:
    active_index_directory: /loki/tsdb-index
    cache_location: /loki/tsdb-cache

compactor:
  working_directory: /loki/compactor
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 150
  delete_request_store: filesystem

limits_config:
  # monitoring.retention.logsDays (7) in hours.
  retention_period: 168h
  # Lines older than the retention are refused at push, so a late batch never outlives it.
  reject_old_samples: true
  reject_old_samples_max_age: 168h
  # Only the labels Alloy sends: no service_name copied from service.
  discover_service_name: []
  # A small server: about 4 MB/s sustained (all servers together), bursts of 8 MB.
  ingestion_rate_mb: 4
  ingestion_burst_size_mb: 8
  per_stream_rate_limit: 2MB
  per_stream_rate_limit_burst: 8MB
  max_global_streams_per_user: 5000
  max_line_size: 256KB
  max_line_size_truncate: true
  allow_structured_metadata: true
  volume_enabled: true
  max_query_series: 1000
  max_entries_limit_per_query: 5000

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 50

ruler:
  enable_api: false

# No usage reports to stats.grafana.org.
analytics:
  reporting_enabled: false
",
  "prometheus.yml": "# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# Prometheus for OpsCrew's monitoring stack: no scrape jobs and no external labels. Every figure
# arrives by remote write from the servers' Alloy, through the front, already labelled app, env
# and server. Retention (time and size) is on the command line in compose.yaml.
global: {}

storage:
  tsdb:
    # Samples up to 4 hours behind the newest are still accepted, so a server cut off from the
    # stack sends what Alloy kept for it once it is back (without it: 400, and Alloy drops them).
    out_of_order_time_window: 4h
",
}
`;

exports[`renderMonitoringStack > renders a monitoring server shared by two networks's compose.yaml (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's monitoring stack: Prometheus and Loki keep what the servers' Alloy pushes through the
# front, and Grafana shows it. Prometheus and Loki have no route out and no published port.
# The front passes only the two push paths, on 10.200.4.2, 10.205.40.3.
# Grafana is on 127.0.0.1, and for your devices on 10.200.4.2, 10.205.40.3 (the filter admits devices only).
# Grafana's admin password is in grafana_admin_credential beside this file, never in it.
name: opscrew-monitoring
services:
  prometheus:
    image: <pin:IMAGES.prometheus>
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
      - --storage.tsdb.retention.size=24GB
      - --web.enable-remote-write-receiver
    environment:
      GOMEMLIMIT: 153MiB
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus:/prometheus
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 30s
    networks:
      - stack
    read_only: true
    mem_limit: 192m
    memswap_limit: 192m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  loki:
    image: <pin:IMAGES.loki>
    restart: unless-stopped
    command:
      - -config.file=/etc/loki/loki.yaml
    environment:
      GOMEMLIMIT: 307MiB
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki:/loki
    networks:
      - stack
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 384m
    memswap_limit: 384m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  grafana:
    image: <pin:IMAGES.grafana>
    restart: unless-stopped
    environment:
      GOMEMLIMIT: 332MiB
      GF_SECURITY_ADMIN_PASSWORD: $$__file{/run/opscrew/grafana_admin_credential}
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_USERS_ALLOW_ORG_CREATE: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_SNAPSHOTS_EXTERNAL_ENABLED: "false"
      GF_PUBLIC_DASHBOARDS_ENABLED: "false"
      GF_METRICS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
      GF_PLUGINS_PUBLIC_KEY_RETRIEVAL_DISABLED: "true"
      GF_PLUGINS_PLUGIN_ADMIN_ENABLED: "false"
      GF_GRAFANA_COM_URL: http://127.0.0.1:9
      GF_GRAFANA_COM_API_URL: http://127.0.0.1:9/api
      GF_PLUGINS_DISABLE_PLUGINS: cloudwatch,elasticsearch,grafana-postgresql-datasource,grafana-pyroscope-datasource,influxdb,jaeger,mssql,mysql,opentsdb,stackdriver,tempo,zipkin
    volumes:
      - ./grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ./grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
      - ./grafana_admin_credential:/run/opscrew/grafana_admin_credential:ro
      - grafana:/var/lib/grafana
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:3000/api/health
      interval: 30s
      timeout: 5s
      start_period: 60s
    ports:
      - 127.0.0.1:3000:3000
      - 10.200.4.2:3000:3000
      - 10.205.40.3:3000:3000
    networks:
      - stack
      - published
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 416m
    memswap_limit: 416m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  front:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 65534:65534
    environment:
      GOMEMLIMIT: 76MiB
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://loki:3100/ready && wget -q -O /dev/null http://prometheus:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 60s
    ports:
      - 10.200.4.2:9091:9091
      - 10.205.40.3:9091:9091
    networks:
      - stack
      - published
      - push
    depends_on:
      - prometheus
      - loki
    read_only: true
    tmpfs:
      - /data:uid=65534,gid=65534,mode=0700
      - /config:uid=65534,gid=65534,mode=0700
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 96m
    memswap_limit: 96m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
networks:
  stack:
    internal: true
  published: {}
  push:
    name: opscrew-monitoring-push
volumes:
  prometheus: {}
  loki: {}
  grafana: {}
"
`;

exports[`renderMonitoringStack > renders kind "app" with a device's compose.yaml (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's monitoring stack: Prometheus and Loki keep what the servers' Alloy pushes through the
# front, and Grafana shows it. Prometheus and Loki have no route out and no published port.
# The front passes only the two push paths, on 10.200.4.1.
# Grafana is on 127.0.0.1, and for your devices on 10.200.4.1 (the filter admits devices only).
# Grafana's admin password is in grafana_admin_credential beside this file, never in it.
name: opscrew-monitoring
services:
  prometheus:
    image: <pin:IMAGES.prometheus>
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
      - --storage.tsdb.retention.size=24GB
      - --web.enable-remote-write-receiver
    environment:
      GOMEMLIMIT: 153MiB
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus:/prometheus
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 30s
    networks:
      - stack
    read_only: true
    mem_limit: 192m
    memswap_limit: 192m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  loki:
    image: <pin:IMAGES.loki>
    restart: unless-stopped
    command:
      - -config.file=/etc/loki/loki.yaml
    environment:
      GOMEMLIMIT: 307MiB
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki:/loki
    networks:
      - stack
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 384m
    memswap_limit: 384m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  grafana:
    image: <pin:IMAGES.grafana>
    restart: unless-stopped
    environment:
      GOMEMLIMIT: 332MiB
      GF_SECURITY_ADMIN_PASSWORD: $$__file{/run/opscrew/grafana_admin_credential}
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_USERS_ALLOW_ORG_CREATE: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_SNAPSHOTS_EXTERNAL_ENABLED: "false"
      GF_PUBLIC_DASHBOARDS_ENABLED: "false"
      GF_METRICS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
      GF_PLUGINS_PUBLIC_KEY_RETRIEVAL_DISABLED: "true"
      GF_PLUGINS_PLUGIN_ADMIN_ENABLED: "false"
      GF_GRAFANA_COM_URL: http://127.0.0.1:9
      GF_GRAFANA_COM_API_URL: http://127.0.0.1:9/api
      GF_PLUGINS_DISABLE_PLUGINS: cloudwatch,elasticsearch,grafana-postgresql-datasource,grafana-pyroscope-datasource,influxdb,jaeger,mssql,mysql,opentsdb,stackdriver,tempo,zipkin
    volumes:
      - ./grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ./grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
      - ./grafana_admin_credential:/run/opscrew/grafana_admin_credential:ro
      - grafana:/var/lib/grafana
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:3000/api/health
      interval: 30s
      timeout: 5s
      start_period: 60s
    ports:
      - 127.0.0.1:3000:3000
      - 10.200.4.1:3000:3000
    networks:
      - stack
      - published
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 416m
    memswap_limit: 416m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  front:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 65534:65534
    environment:
      GOMEMLIMIT: 76MiB
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://loki:3100/ready && wget -q -O /dev/null http://prometheus:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 60s
    ports:
      - 10.200.4.1:9091:9091
    networks:
      - stack
      - published
      - push
    depends_on:
      - prometheus
      - loki
    read_only: true
    tmpfs:
      - /data:uid=65534,gid=65534,mode=0700
      - /config:uid=65534,gid=65534,mode=0700
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 96m
    memswap_limit: 96m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
networks:
  stack:
    internal: true
  published: {}
  push:
    name: opscrew-monitoring-push
volumes:
  prometheus: {}
  loki: {}
  grafana: {}
"
`;

exports[`renderMonitoringStack > renders kind "app" with no network and no devices's compose.yaml (snapshot) 1`] = `
"# Generated by OpsCrew from opscrew/plan.yaml; \`opscrew provision\` regenerates it.
# OpsCrew's monitoring stack: Prometheus and Loki keep what the servers' Alloy pushes through the
# front, and Grafana shows it. Prometheus and Loki have no route out and no published port.
# The front passes only the two push paths, on this server's push network only.
# Grafana is on 127.0.0.1 only.
# Grafana's admin password is in grafana_admin_credential beside this file, never in it.
name: opscrew-monitoring
services:
  prometheus:
    image: <pin:IMAGES.prometheus>
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
      - --storage.tsdb.retention.size=24GB
      - --web.enable-remote-write-receiver
    environment:
      GOMEMLIMIT: 153MiB
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus:/prometheus
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 30s
    networks:
      - stack
    read_only: true
    mem_limit: 192m
    memswap_limit: 192m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  loki:
    image: <pin:IMAGES.loki>
    restart: unless-stopped
    command:
      - -config.file=/etc/loki/loki.yaml
    environment:
      GOMEMLIMIT: 307MiB
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki:/loki
    networks:
      - stack
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 384m
    memswap_limit: 384m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  grafana:
    image: <pin:IMAGES.grafana>
    restart: unless-stopped
    environment:
      GOMEMLIMIT: 332MiB
      GF_SECURITY_ADMIN_PASSWORD: $$__file{/run/opscrew/grafana_admin_credential}
      GF_SECURITY_DISABLE_GRAVATAR: "true"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_USERS_ALLOW_ORG_CREATE: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_SNAPSHOTS_EXTERNAL_ENABLED: "false"
      GF_PUBLIC_DASHBOARDS_ENABLED: "false"
      GF_METRICS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
      GF_PLUGINS_PUBLIC_KEY_RETRIEVAL_DISABLED: "true"
      GF_PLUGINS_PLUGIN_ADMIN_ENABLED: "false"
      GF_GRAFANA_COM_URL: http://127.0.0.1:9
      GF_GRAFANA_COM_API_URL: http://127.0.0.1:9/api
      GF_PLUGINS_DISABLE_PLUGINS: cloudwatch,elasticsearch,grafana-postgresql-datasource,grafana-pyroscope-datasource,influxdb,jaeger,mssql,mysql,opentsdb,stackdriver,tempo,zipkin
    volumes:
      - ./grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
      - ./grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
      - ./grafana_admin_credential:/run/opscrew/grafana_admin_credential:ro
      - grafana:/var/lib/grafana
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:3000/api/health
      interval: 30s
      timeout: 5s
      start_period: 60s
    ports:
      - 127.0.0.1:3000:3000
    networks:
      - stack
      - published
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 416m
    memswap_limit: 416m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
  front:
    image: <pin:IMAGES.caddy>
    restart: unless-stopped
    user: 65534:65534
    environment:
      GOMEMLIMIT: 76MiB
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://loki:3100/ready && wget -q -O /dev/null http://prometheus:9090/-/ready
      interval: 30s
      timeout: 5s
      start_period: 60s
    networks:
      - stack
      - published
      - push
    depends_on:
      - prometheus
      - loki
    read_only: true
    tmpfs:
      - /data:uid=65534,gid=65534,mode=0700
      - /config:uid=65534,gid=65534,mode=0700
    cap_add:
      - NET_BIND_SERVICE
    mem_limit: 96m
    memswap_limit: 96m
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    cap_drop:
      - ALL
networks:
  stack:
    internal: true
  published: {}
  push:
    name: opscrew-monitoring-push
volumes:
  prometheus: {}
  loki: {}
  grafana: {}
"
`;
