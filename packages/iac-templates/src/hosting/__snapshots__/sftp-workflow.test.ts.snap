// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderSftpWorkflow > renders the environment's deploy workflow for a PHP app and a static site > php 1`] = `
"# Generated by OpsCrew from opscrew/environments/staging/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app and uploads each release over SFTP to its own folder on your host, switches
# staging-shop.example.com to it in one step, checks it, and switches back on a failure. The SFTP key is
# a secret of the staging environment's deploys, which can change every file of that SFTP user.
name: OpsCrew deploy (staging)

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - ".github/workflows/opscrew-deploy-staging.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy-shop-staging
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/staging"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --env staging --resume --deploy\\\` deploys the branch's latest commit."
          elif [[ "$(field reason)" == rotation ]]; then
            text="Deploys of $KEY are paused since $since for a credential rotation's window: \\\`opscrew rotate --env staging\\\` with its services, or with \\\`--undo\\\`, ends it."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision --env staging\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the release
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - name: Install the app's PHP packages with Composer in PHP 8.3
        working-directory: "."
        env:
          PHP_IMAGE: <pin:IMAGES.php83Cli>
          COMPOSER_IMAGE: <pin:IMAGES.composer>
        run: |
          set -euo pipefail
          if [[ ! -f composer.json ]]; then
            echo "The app has no composer.json: no PHP packages to install."
            exit 0
          fi
          docker create --name opscrew-composer "$COMPOSER_IMAGE" > /dev/null
          docker cp opscrew-composer:/usr/bin/composer "$RUNNER_TEMP/composer"
          docker rm opscrew-composer > /dev/null
          # The PHP image has neither unzip nor PHP's zip extension, one of which Composer unpacks with.
          # The container runs as root: vendor/ goes back to the runner's user, so a self-hosted runner's next checkout can clean it.
          docker run --rm -e COMPOSER_ALLOW_SUPERUSER=1 -e OWNER="$(id -u):$(id -g)" -v "$PWD:/app" -v "$RUNNER_TEMP/composer:/usr/local/bin/composer:ro" -w /app "$PHP_IMAGE" \\
            bash -c 'apt-get update -qq && apt-get install -y -qq --no-install-recommends unzip > /dev/null && composer install --no-dev --optimize-autoloader --no-interaction --no-progress --ignore-platform-req="ext-*" && chown -R "$OWNER" vendor'
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "24"
      - name: Build the app's assets
        working-directory: "."
        run: |
          set -euo pipefail
          if [[ ! -f package.json ]] || ! node -e 'process.exit(require("./package.json").scripts?.build ? 0 : 1)'; then
            echo "package.json has no build script: nothing to build."
            exit 0
          fi
          if [[ -f pnpm-lock.yaml ]]; then
            spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@<pin:PACKAGE_MANAGERS.pnpm>");process.exit(1)}const v=m?m[1]:"<pin:PACKAGE_MANAGERS.pnpm>";console.log("pnpm@"+v)')"
            npm install -g --no-audit --no-fund "$spec"
            pm=pnpm
            pnpm install --frozen-lockfile
          elif [[ -f yarn.lock ]]; then
            spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^yarn@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("yarn@")){console.error("package.json\\x27s packageManager must name an exact version, such as yarn@<pin:PACKAGE_MANAGERS.yarn>");process.exit(1)}const v=m?m[1]:"<pin:PACKAGE_MANAGERS.yarn>";console.log((/^1\\./.test(v)?"yarn@":"@yarnpkg/cli-dist@")+v)')"
            npm install -g --no-audit --no-fund "$spec"
            pm=yarn
            yarn install --frozen-lockfile
          elif [[ -f package-lock.json ]]; then
            pm=npm
            npm ci
          else
            pm=npm
            npm install
          fi
          "$pm" run build
      - name: Keep the release
        run: |
          set -euo pipefail
          tar -cf "$RUNNER_TEMP/release.tar" -C '.' --exclude=.git --exclude=node_modules --exclude=./.github --exclude=./opscrew .
      - uses: <pin:ACTIONS.uploadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}/release.tar
          if-no-files-found: error
          retention-days: 1

  deploy:
    name: Upload the release over SFTP and switch staging-shop.example.com to it
    needs: build
    if: \${{ !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    environment: staging
    permissions: {}
    steps:
      - uses: <pin:ACTIONS.downloadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}
      - name: Upload, switch and check the release
        timeout-minutes: 30
        env:
          SFTP_URL: \${{ secrets.OPSCREW_STAGING_SFTP_URL }}
          SFTP_KEY: \${{ secrets.OPSCREW_STAGING_SFTP_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_STAGING_SFTP_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          release="$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          work="$RUNNER_TEMP/opscrew-sftp"
          mkdir -p "$work/release"
          tar -xf "$RUNNER_TEMP/release.tar" -C "$work/release"
          # The key and the host key the user confirmed, the runner's user's only.
          umask 077
          printf '%s\\n' "$SFTP_KEY" > "$work/key"
          printf '%s\\n' "$KNOWN_HOSTS" > "$work/known_hosts"
          umask 022
          # The login and the app's folder from the app's URL (sftpUrl); the host is hidden in the log.
          rest=\${SFTP_URL#sftp://}
          if [[ $rest != *@*/?* ]]; then
            echo "::error::The deploy environment has no SFTP URL (OPSCREW_STAGING_SFTP_URL): run \\\`opscrew provision --env staging\\\`, which sets it."
            exit 1
          fi
          login="sftp://\${rest%%/*}"
          host=\${rest%%/*}
          host=\${host#*@}
          echo "::add-mask::\${host%:*}"
          FOLDER=$(printf '%b' "$(printf '%s' "\${rest#*/}" | sed 's/%\\([0-9A-Fa-f][0-9A-Fa-f]\\)/\\\\x\\1/g')")
          # Runs the batch on its standard input on the host, with that key and host key only.
          on_host() {
            sftp -b - -o BatchMode=yes -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=\\"$work/known_hosts\\"" -o IdentitiesOnly=yes -i "$work/key" "$login"
          }
          # $1 in double quotes for a batch line, its \\ and " escaped (sftp's own quoting).
          q() {
            printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\\\"]/\\\\&/g')"
          }
          # $1 on one line.
          one_line() {
            printf '%s' "$1" | tr '\\r\\n' '  '
          }
          # The releases on the host, newest first: <run id>-<attempt> folders, by run id then attempt.
          release_ids() {
            local listing
            listing=$(printf '@ls -1a %s\\n' "$(q "$FOLDER/releases")" | on_host) || return 1
            printf '%s\\n' "$listing" | sed 's|.*/||' | grep -E '^[1-9][0-9]*-[1-9][0-9]*$' | sort -t - -k 1,1nr -k 2,2nr || true
          }
          # True when release $1 is newer than release $2.
          newer() {
            local r1=\${1%-*} a1=\${1#*-} r2=\${2%-*} a2=\${2#*-}
            ((10#$r1 > 10#$r2 || (10#$r1 == 10#$r2 && 10#$a1 > 10#$a2)))
          }
          # Points current at $1 (from the app's folder) in one rename of a new link beside it.
          switch_to() {
            local link="$FOLDER/.opscrew-$release.link"
            printf -- '-@rm %s\\n@ln -s %s %s\\n@rename %s %s\\n' "$(q "$link")" "$(q "$1")" "$(q "$link")" "$(q "$link")" "$(q "$FOLDER/current")" | on_host > /dev/null
          }
          # Removes the folder $1 on the host with everything in it: listed a level at a time (one
          # connection each, links never followed), then its files and links, then its folders deepest first.
          remove_tree() {
            local level=("$1") folders=("$1") files=() next listing kind path i
            while [ "\${#level[@]}" -gt 0 ]; do
              listing=$(for path in "\${level[@]}"; do printf '@ls -lan %s\\n' "$(q "$path")"; done | on_host) || return 1
              next=()
              while IFS=$'\\t' read -r kind path; do
                case $path in */. | */..) continue ;; esac
                if [ "$kind" = d ]; then next+=("$path"); else files+=("$path"); fi
              done < <(printf '%s\\n' "$listing" | sed -nE 's/^(.)[^ ]* +[^ ]+ +[^ ]+ +[^ ]+ +[0-9]+ +[^ ]+ +[0-9]+ +[^ ]+ (.*)$/\\1\\t\\2/p')
              folders+=("\${next[@]}")
              level=("\${next[@]}")
            done
            {
              for path in "\${files[@]}"; do printf '@rm %s\\n' "$(q "$path")"; done
              for ((i = \${#folders[@]} - 1; i >= 0; i--)); do printf '@rmdir %s\\n' "$(q "\${folders[i]}")"; done
            } | on_host > /dev/null
          }
          # Writes state/status: the running release $1, the newest kept one older than it, the others kept,
          # and the attempt (release $2, its result $3, its reason $4), as the opscrew CLI reads it.
          write_status() {
            local previous="" kept="" id ids
            ids=$(release_ids) || return 1
            for id in $ids; do
              [ "$id" != "$1" ] || continue
              kept=\${kept:+$kept,}$id
              if [ -z "$previous" ] && [ -n "$1" ] && newer "$1" "$id"; then previous=$id; fi
            done
            printf 'running=%s\\nprevious=%s\\nkept=%s\\nattempt=%s\\nresult=%s\\nreason=%s\\nat=%s\\n' \\
              "$1" "$previous" "$kept" "$2" "$3" "$(one_line "$4")" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$work/status.next"
            local next="$FOLDER/state/status.next"
            printf '@put %s %s\\n@chmod 600 %s\\n@rename %s %s\\n' "$(q "$work/status.next")" "$(q "$next")" "$(q "$next")" "$(q "$next")" "$(q "$FOLDER/state/status")" | on_host > /dev/null
          }
          # Ends an attempt that failed ($2 refused): says why ($1), records it, and fails the job.
          failed() {
            local result=\${2:-failed}
            write_status "$running" "$release" "$result" "$1" || echo "::warning::OpsCrew couldn't write the host's state/status."
            echo "::error::Release $release $result: $1. Run \\\`opscrew status --env staging\\\` to see what runs."
            exit 1
          }

          # 1. What runs now, and the lines that load the app's settings (none for a static site).
          {
            printf -- '-@get %s %s\\n' "$(q "$FOLDER/state/status")" "$(q "$work/status")"
            printf -- '-@get %s %s\\n' "$(q "$FOLDER/shared/env.htaccess")" "$(q "$work/env.htaccess")"
            printf -- '-@get %s %s\\n' "$(q "$FOLDER/shared/env.user.ini")" "$(q "$work/env.user.ini")"
          } | on_host > /dev/null 2> "$work/sftp.err" || { cat "$work/sftp.err" >&2; exit 1; }
          running=$(sed -n 's/^running=//p' "$work/status" 2> /dev/null || true)
          [[ $running =~ ^[1-9][0-9]*-[1-9][0-9]*$ ]] || running=""
          # A re-run of an earlier workflow run never deploys over a newer release (ADR 0030).
          if [ -n "$running" ] && ! newer "$release" "$running"; then
            failed "it is older than release $running, which runs" refused
          fi

          # 2. The release's .htaccess and .user.ini: OpsCrew's block, then the app's own. HTTPS is forced
          # once the hostname's certificate verifies.
          https=no
          if curl -sS -o /dev/null --max-time 15 'https://staging-shop.example.com/' 2> /dev/null; then https=yes; fi
          served="$work/release/"'public'
          mkdir -p "$served"
          {
            printf '%s\\n' '# BEGIN OpsCrew' 'RewriteEngine On' 'RewriteCond %{HTTP_HOST} !^staging-shop\\.example\\.com(:[0-9]+)?$ [NC]' 'RewriteRule ^ - [F]'
            if [ "$https" = yes ]; then printf '%s\\n' 'RewriteCond %{HTTPS} !=on' 'RewriteRule ^ https://staging-shop.example.com%{REQUEST_URI} [R=301,L]'; fi
            printf '%s\\n' 'Options -Indexes' '<FilesMatch "^\\.">' 'Require all denied' '</FilesMatch>' 'Header always set X-Content-Type-Options "nosniff"' 'Header always set X-Frame-Options "SAMEORIGIN"' 'Header always set Referrer-Policy "strict-origin-when-cross-origin"'
            if [ "$https" = yes ]; then printf '%s\\n' 'Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"'; fi
            printf 'Header always set X-OpsCrew-Release "%s"\\n' "$release"
            if [ -f "$work/env.htaccess" ]; then cat "$work/env.htaccess"; fi
            printf '%s\\n' '# END OpsCrew'
            if [ -s "$served/.htaccess" ]; then
              printf '%s\\n' '# BEGIN OpsCrew: app'
              sed '$a\\' "$served/.htaccess"
              printf '%s\\n' '# END OpsCrew: app'
            fi
          } > "$work/htaccess"
          mv "$work/htaccess" "$served/.htaccess"
          if [ -f "$work/env.user.ini" ]; then
            {
              cat "$work/env.user.ini"
              if [ -s "$served/.user.ini" ]; then
                printf '%s\\n' '; BEGIN OpsCrew: app'
                sed '$a\\' "$served/.user.ini"
                printf '%s\\n' '; END OpsCrew: app'
              fi
            } > "$work/user.ini"
            mv "$work/user.ini" "$served/.user.ini"
          fi

          # 3. The upload into its own folder, then the switch.
          if ! printf '@put -r %s %s\\n' "$(q "$work/release")" "$(q "$FOLDER/releases/$release")" | on_host > /dev/null; then
            remove_tree "$FOLDER/releases/$release" || true
            failed "the upload over SFTP failed; \${running:-nothing} still runs"
          fi
          # A failed switch keeps the release: the rename may have happened before the connection broke.
          if ! switch_to "releases/$release"; then
            failed "the switch over SFTP failed; \${running:-nothing} still runs unless the rename went through"
          fi

          # 4. The hostname asked every 5 seconds, for up to 125 seconds, until it answers 2xx or 3xx with
          # the release: behind LiteSpeed the first such answer counts, as does a static site's; a PHP app
          # elsewhere needs one past PHP's realpath cache (120 seconds), which until then can keep the old
          # release. CHECK_SAID holds the last answer.
          scheme=http; if [ "$https" = yes ]; then scheme=https; fi
          header_of() {
            printf '%s\\n' "$1" | tr -d '\\r' | sed -n "s/^$2:[[:space:]]*//Ip" | tail -n 1
          }
          check() {
            local try answer code served
            CHECK_SAID="no answer"
            for ((try = 1; try <= 26; try++)); do
              if [ "$try" -gt 1 ]; then sleep 5; fi
              if answer=$(curl -sS -o /dev/null -D - --max-time 30 "$scheme://"'staging-shop.example.com/api/health' 2>&1); then
                code=$(printf '%s\\n' "$answer" | head -n 1 | cut -d ' ' -f 2)
                served=$(header_of "$answer" X-OpsCrew-Release)
                CHECK_SAID="it answered $code with release \${served:-none}"
                if [[ $code =~ ^[23][0-9][0-9]$ ]] && [ "$served" = "$release" ]; then
                  case $(header_of "$answer" Server) in LiteSpeed*) return 0 ;; esac
                  if [ "$try" -ge 25 ]; then return 0; fi
                fi
              else
                CHECK_SAID=$(one_line "$answer")
              fi
            done
            return 1
          }
          if ! check; then
            before="releases/\${running:-0-0}"
            if switch_to "$before"; then
              remove_tree "$FOLDER/releases/$release" || true
            else
              echo "::warning::OpsCrew couldn't switch back to $before, so release $release stays on the host."
            fi
            failed 'staging-shop.example.com/api/health'" didn't answer 2xx or 3xx with it ($CHECK_SAID); switched back to \${running:-nothing}"
          fi

          # The release serves: recorded first, so nothing after it can leave the status behind.
          write_status "$release" "$release" deployed ""
          echo "::notice::Release $release serves on the host."

          # 5. The 3 newest releases kept besides the running one; after the first, the placeholder goes.
          # One the SFTP user can't remove stays, with a warning; the status then lists what is left.
          kept=0
          removed=no
          for id in $(release_ids); do
            [ "$id" != "$release" ] || continue
            kept=$((kept + 1))
            [ "$kept" -gt 3 ] || continue
            if remove_tree "$FOLDER/releases/$id"; then
              removed=yes
            else
              echo "::warning::OpsCrew couldn't remove release $id from the host; remove $FOLDER/releases/$id there yourself."
            fi
          done
          if [ -z "$running" ]; then remove_tree "$FOLDER/releases/0-0" 2> /dev/null || true; fi
          if [ "$removed" = yes ]; then
            write_status "$release" "$release" deployed "" || echo "::warning::OpsCrew couldn't list the kept releases in the host's state/status."
          fi
"
`;

exports[`renderSftpWorkflow > renders the environment's deploy workflow for a PHP app and a static site > static 1`] = `
"# Generated by OpsCrew from opscrew/environments/staging/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app and uploads each release over SFTP to its own folder on your host, switches
# staging-shop.example.com to it in one step, checks it, and switches back on a failure. The SFTP key is
# a secret of the staging environment's deploys, which can change every file of that SFTP user.
name: OpsCrew deploy (staging)

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - ".github/workflows/opscrew-deploy-staging.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy-shop-staging
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/staging"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --env staging --resume --deploy\\\` deploys the branch's latest commit."
          elif [[ "$(field reason)" == rotation ]]; then
            text="Deploys of $KEY are paused since $since for a credential rotation's window: \\\`opscrew rotate --env staging\\\` with its services, or with \\\`--undo\\\`, ends it."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision --env staging\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the release
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "24"
      - name: Install the site's dependencies
        working-directory: "."
        run: |
          set -euo pipefail
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
      - name: Build the site
        working-directory: "."
        run: |
          set -euo pipefail
          npm run build
      - name: Check the built site
        run: |
          set -euo pipefail
          if [[ ! -d 'dist' ]]; then
            echo "::error::The build left no folder dist, where opscrew/environments/staging/plan.yaml expects the site's files (target.site.outputDir): change target.site in opscrew/environments/staging/plan.yaml to what the build writes, then run \\\`opscrew provision --env staging\\\` again."
            exit 1
          fi
      - name: Keep the release
        run: |
          set -euo pipefail
          tar -cf "$RUNNER_TEMP/release.tar" -C 'dist' --exclude=.git --exclude=node_modules --exclude=./.github --exclude=./opscrew .
      - uses: <pin:ACTIONS.uploadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}/release.tar
          if-no-files-found: error
          retention-days: 1

  deploy:
    name: Upload the release over SFTP and switch staging-shop.example.com to it
    needs: build
    if: \${{ !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    environment: staging
    permissions: {}
    steps:
      - uses: <pin:ACTIONS.downloadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}
      - name: Upload, switch and check the release
        timeout-minutes: 30
        env:
          SFTP_URL: \${{ secrets.OPSCREW_STAGING_SFTP_URL }}
          SFTP_KEY: \${{ secrets.OPSCREW_STAGING_SFTP_PRIVATE_KEY }}
          KNOWN_HOSTS: \${{ secrets.OPSCREW_STAGING_SFTP_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          release="$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          work="$RUNNER_TEMP/opscrew-sftp"
          mkdir -p "$work/release"
          tar -xf "$RUNNER_TEMP/release.tar" -C "$work/release"
          # The key and the host key the user confirmed, the runner's user's only.
          umask 077
          printf '%s\\n' "$SFTP_KEY" > "$work/key"
          printf '%s\\n' "$KNOWN_HOSTS" > "$work/known_hosts"
          umask 022
          # The login and the app's folder from the app's URL (sftpUrl); the host is hidden in the log.
          rest=\${SFTP_URL#sftp://}
          if [[ $rest != *@*/?* ]]; then
            echo "::error::The deploy environment has no SFTP URL (OPSCREW_STAGING_SFTP_URL): run \\\`opscrew provision --env staging\\\`, which sets it."
            exit 1
          fi
          login="sftp://\${rest%%/*}"
          host=\${rest%%/*}
          host=\${host#*@}
          echo "::add-mask::\${host%:*}"
          FOLDER=$(printf '%b' "$(printf '%s' "\${rest#*/}" | sed 's/%\\([0-9A-Fa-f][0-9A-Fa-f]\\)/\\\\x\\1/g')")
          # Runs the batch on its standard input on the host, with that key and host key only.
          on_host() {
            sftp -b - -o BatchMode=yes -o StrictHostKeyChecking=yes -o "UserKnownHostsFile=\\"$work/known_hosts\\"" -o IdentitiesOnly=yes -i "$work/key" "$login"
          }
          # $1 in double quotes for a batch line, its \\ and " escaped (sftp's own quoting).
          q() {
            printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\\\"]/\\\\&/g')"
          }
          # $1 on one line.
          one_line() {
            printf '%s' "$1" | tr '\\r\\n' '  '
          }
          # The releases on the host, newest first: <run id>-<attempt> folders, by run id then attempt.
          release_ids() {
            local listing
            listing=$(printf '@ls -1a %s\\n' "$(q "$FOLDER/releases")" | on_host) || return 1
            printf '%s\\n' "$listing" | sed 's|.*/||' | grep -E '^[1-9][0-9]*-[1-9][0-9]*$' | sort -t - -k 1,1nr -k 2,2nr || true
          }
          # True when release $1 is newer than release $2.
          newer() {
            local r1=\${1%-*} a1=\${1#*-} r2=\${2%-*} a2=\${2#*-}
            ((10#$r1 > 10#$r2 || (10#$r1 == 10#$r2 && 10#$a1 > 10#$a2)))
          }
          # Points current at $1 (from the app's folder) in one rename of a new link beside it.
          switch_to() {
            local link="$FOLDER/.opscrew-$release.link"
            printf -- '-@rm %s\\n@ln -s %s %s\\n@rename %s %s\\n' "$(q "$link")" "$(q "$1")" "$(q "$link")" "$(q "$link")" "$(q "$FOLDER/current")" | on_host > /dev/null
          }
          # Removes the folder $1 on the host with everything in it: listed a level at a time (one
          # connection each, links never followed), then its files and links, then its folders deepest first.
          remove_tree() {
            local level=("$1") folders=("$1") files=() next listing kind path i
            while [ "\${#level[@]}" -gt 0 ]; do
              listing=$(for path in "\${level[@]}"; do printf '@ls -lan %s\\n' "$(q "$path")"; done | on_host) || return 1
              next=()
              while IFS=$'\\t' read -r kind path; do
                case $path in */. | */..) continue ;; esac
                if [ "$kind" = d ]; then next+=("$path"); else files+=("$path"); fi
              done < <(printf '%s\\n' "$listing" | sed -nE 's/^(.)[^ ]* +[^ ]+ +[^ ]+ +[^ ]+ +[0-9]+ +[^ ]+ +[0-9]+ +[^ ]+ (.*)$/\\1\\t\\2/p')
              folders+=("\${next[@]}")
              level=("\${next[@]}")
            done
            {
              for path in "\${files[@]}"; do printf '@rm %s\\n' "$(q "$path")"; done
              for ((i = \${#folders[@]} - 1; i >= 0; i--)); do printf '@rmdir %s\\n' "$(q "\${folders[i]}")"; done
            } | on_host > /dev/null
          }
          # Writes state/status: the running release $1, the newest kept one older than it, the others kept,
          # and the attempt (release $2, its result $3, its reason $4), as the opscrew CLI reads it.
          write_status() {
            local previous="" kept="" id ids
            ids=$(release_ids) || return 1
            for id in $ids; do
              [ "$id" != "$1" ] || continue
              kept=\${kept:+$kept,}$id
              if [ -z "$previous" ] && [ -n "$1" ] && newer "$1" "$id"; then previous=$id; fi
            done
            printf 'running=%s\\nprevious=%s\\nkept=%s\\nattempt=%s\\nresult=%s\\nreason=%s\\nat=%s\\n' \\
              "$1" "$previous" "$kept" "$2" "$3" "$(one_line "$4")" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$work/status.next"
            local next="$FOLDER/state/status.next"
            printf '@put %s %s\\n@chmod 600 %s\\n@rename %s %s\\n' "$(q "$work/status.next")" "$(q "$next")" "$(q "$next")" "$(q "$next")" "$(q "$FOLDER/state/status")" | on_host > /dev/null
          }
          # Ends an attempt that failed ($2 refused): says why ($1), records it, and fails the job.
          failed() {
            local result=\${2:-failed}
            write_status "$running" "$release" "$result" "$1" || echo "::warning::OpsCrew couldn't write the host's state/status."
            echo "::error::Release $release $result: $1. Run \\\`opscrew status --env staging\\\` to see what runs."
            exit 1
          }

          # 1. What runs now, and the lines that load the app's settings (none for a static site).
          {
            printf -- '-@get %s %s\\n' "$(q "$FOLDER/state/status")" "$(q "$work/status")"
            printf -- '-@get %s %s\\n' "$(q "$FOLDER/shared/env.htaccess")" "$(q "$work/env.htaccess")"
            printf -- '-@get %s %s\\n' "$(q "$FOLDER/shared/env.user.ini")" "$(q "$work/env.user.ini")"
          } | on_host > /dev/null 2> "$work/sftp.err" || { cat "$work/sftp.err" >&2; exit 1; }
          running=$(sed -n 's/^running=//p' "$work/status" 2> /dev/null || true)
          [[ $running =~ ^[1-9][0-9]*-[1-9][0-9]*$ ]] || running=""
          # A re-run of an earlier workflow run never deploys over a newer release (ADR 0030).
          if [ -n "$running" ] && ! newer "$release" "$running"; then
            failed "it is older than release $running, which runs" refused
          fi

          # 2. The release's .htaccess and .user.ini: OpsCrew's block, then the app's own. HTTPS is forced
          # once the hostname's certificate verifies.
          https=no
          if curl -sS -o /dev/null --max-time 15 'https://staging-shop.example.com/' 2> /dev/null; then https=yes; fi
          served="$work/release/"'.'
          mkdir -p "$served"
          {
            printf '%s\\n' '# BEGIN OpsCrew' 'RewriteEngine On' 'RewriteCond %{HTTP_HOST} !^staging-shop\\.example\\.com(:[0-9]+)?$ [NC]' 'RewriteRule ^ - [F]'
            if [ "$https" = yes ]; then printf '%s\\n' 'RewriteCond %{HTTPS} !=on' 'RewriteRule ^ https://staging-shop.example.com%{REQUEST_URI} [R=301,L]'; fi
            printf '%s\\n' 'RewriteRule ^(vendor|storage|composer\\.json|composer\\.lock)(/|$) - [F]' 'Options -Indexes' '<FilesMatch "^\\.">' 'Require all denied' '</FilesMatch>' 'Header always set X-Content-Type-Options "nosniff"' 'Header always set X-Frame-Options "SAMEORIGIN"' 'Header always set Referrer-Policy "strict-origin-when-cross-origin"'
            if [ "$https" = yes ]; then printf '%s\\n' 'Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"'; fi
            printf 'Header always set X-OpsCrew-Release "%s"\\n' "$release"
            if [ -f "$work/env.htaccess" ]; then cat "$work/env.htaccess"; fi
            printf '%s\\n' '# END OpsCrew'
            if [ -s "$served/.htaccess" ]; then
              printf '%s\\n' '# BEGIN OpsCrew: app'
              sed '$a\\' "$served/.htaccess"
              printf '%s\\n' '# END OpsCrew: app'
            fi
          } > "$work/htaccess"
          mv "$work/htaccess" "$served/.htaccess"
          if [ -f "$work/env.user.ini" ]; then
            {
              cat "$work/env.user.ini"
              if [ -s "$served/.user.ini" ]; then
                printf '%s\\n' '; BEGIN OpsCrew: app'
                sed '$a\\' "$served/.user.ini"
                printf '%s\\n' '; END OpsCrew: app'
              fi
            } > "$work/user.ini"
            mv "$work/user.ini" "$served/.user.ini"
          fi

          # 3. The upload into its own folder, then the switch.
          if ! printf '@put -r %s %s\\n' "$(q "$work/release")" "$(q "$FOLDER/releases/$release")" | on_host > /dev/null; then
            remove_tree "$FOLDER/releases/$release" || true
            failed "the upload over SFTP failed; \${running:-nothing} still runs"
          fi
          # A failed switch keeps the release: the rename may have happened before the connection broke.
          if ! switch_to "releases/$release"; then
            failed "the switch over SFTP failed; \${running:-nothing} still runs unless the rename went through"
          fi

          # 4. The hostname asked every 5 seconds, for up to 125 seconds, until it answers 2xx or 3xx with
          # the release: behind LiteSpeed the first such answer counts, as does a static site's; a PHP app
          # elsewhere needs one past PHP's realpath cache (120 seconds), which until then can keep the old
          # release. CHECK_SAID holds the last answer.
          scheme=http; if [ "$https" = yes ]; then scheme=https; fi
          header_of() {
            printf '%s\\n' "$1" | tr -d '\\r' | sed -n "s/^$2:[[:space:]]*//Ip" | tail -n 1
          }
          check() {
            local try answer code served
            CHECK_SAID="no answer"
            for ((try = 1; try <= 26; try++)); do
              if [ "$try" -gt 1 ]; then sleep 5; fi
              if answer=$(curl -sS -o /dev/null -D - --max-time 30 "$scheme://"'staging-shop.example.com/api/health' 2>&1); then
                code=$(printf '%s\\n' "$answer" | head -n 1 | cut -d ' ' -f 2)
                served=$(header_of "$answer" X-OpsCrew-Release)
                CHECK_SAID="it answered $code with release \${served:-none}"
                if [[ $code =~ ^[23][0-9][0-9]$ ]] && [ "$served" = "$release" ]; then
                  return 0
                fi
              else
                CHECK_SAID=$(one_line "$answer")
              fi
            done
            return 1
          }
          if ! check; then
            before="releases/\${running:-0-0}"
            if switch_to "$before"; then
              remove_tree "$FOLDER/releases/$release" || true
            else
              echo "::warning::OpsCrew couldn't switch back to $before, so release $release stays on the host."
            fi
            failed 'staging-shop.example.com/api/health'" didn't answer 2xx or 3xx with it ($CHECK_SAID); switched back to \${running:-nothing}"
          fi

          # The release serves: recorded first, so nothing after it can leave the status behind.
          write_status "$release" "$release" deployed ""
          echo "::notice::Release $release serves on the host."

          # 5. The 3 newest releases kept besides the running one; after the first, the placeholder goes.
          # One the SFTP user can't remove stays, with a warning; the status then lists what is left.
          kept=0
          removed=no
          for id in $(release_ids); do
            [ "$id" != "$release" ] || continue
            kept=$((kept + 1))
            [ "$kept" -gt 3 ] || continue
            if remove_tree "$FOLDER/releases/$id"; then
              removed=yes
            else
              echo "::warning::OpsCrew couldn't remove release $id from the host; remove $FOLDER/releases/$id there yourself."
            fi
          done
          if [ -z "$running" ]; then remove_tree "$FOLDER/releases/0-0" 2> /dev/null || true; fi
          if [ "$removed" = yes ]; then
            write_status "$release" "$release" deployed "" || echo "::warning::OpsCrew couldn't list the kept releases in the host's state/status."
          fi
"
`;
