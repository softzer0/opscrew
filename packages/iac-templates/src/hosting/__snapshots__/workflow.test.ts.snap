// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderHostingWorkflow > renders the environment's deploy workflow per kind of app > node 1`] = `
"# Generated by OpsCrew from opscrew/environments/staging/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app and publishes each release, signed, on the branch opscrew/release/staging. The OpsCrew agent
# on the hosting account checks the signature and deploys it; the last job waits for the account
# to serve it. The signing key is the only secret here: no credential of the account is in GitHub.
name: OpsCrew deploy (staging)

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - ".github/workflows/opscrew-deploy-staging.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy-shop-staging
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/staging"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --env staging --resume --deploy\\\` deploys the branch's latest commit."
          elif [[ "$(field reason)" == rotation ]]; then
            text="Deploys of $KEY are paused since $since for a credential rotation's window: \\\`opscrew rotate --env staging\\\` with its services, or with \\\`--undo\\\`, ends it."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision --env staging\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the release
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "22"
      - name: Build the app
        working-directory: "."
        run: |
          set -euo pipefail
          if [[ ! -f package.json ]] || ! node -e 'process.exit(require("./package.json").scripts?.build ? 0 : 1)'; then
            echo "package.json has no build script: nothing to build."
            exit 0
          fi
          if [[ -f pnpm-lock.yaml ]]; then
            spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@<pin:PACKAGE_MANAGERS.pnpm>");process.exit(1)}const v=m?m[1]:"<pin:PACKAGE_MANAGERS.pnpm>";console.log("pnpm@"+v)')"
            npm install -g --no-audit --no-fund "$spec"
            pm=pnpm
            pnpm install --frozen-lockfile
          elif [[ -f yarn.lock ]]; then
            spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^yarn@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("yarn@")){console.error("package.json\\x27s packageManager must name an exact version, such as yarn@<pin:PACKAGE_MANAGERS.yarn>");process.exit(1)}const v=m?m[1]:"<pin:PACKAGE_MANAGERS.yarn>";console.log((/^1\\./.test(v)?"yarn@":"@yarnpkg/cli-dist@")+v)')"
            npm install -g --no-audit --no-fund "$spec"
            pm=yarn
            yarn install --frozen-lockfile
          elif [[ -f package-lock.json ]]; then
            pm=npm
            npm ci
          else
            pm=npm
            npm install
          fi
          "$pm" run build
      - name: Keep the release
        run: |
          set -euo pipefail
          tar -cf "$RUNNER_TEMP/release.tar" -C '.' --exclude=.git --exclude=node_modules --exclude=./.github --exclude=./opscrew .
      - uses: <pin:ACTIONS.uploadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}/release.tar
          if-no-files-found: error
          retention-days: 1

  publish:
    name: Publish the release on opscrew/release/staging
    needs: build
    if: \${{ !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    environment: staging
    permissions:
      contents: write
    outputs:
      release: \${{ steps.publish.outputs.release }}
    steps:
      - uses: <pin:ACTIONS.downloadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}
      - id: publish
        name: Sign the release and push it
        env:
          ENVIRONMENT: staging
          BRANCH: opscrew/release/staging
          SIGNING_KEY: \${{ secrets.OPSCREW_STAGING_RELEASE_SIGNING_KEY }}
          TOKEN: \${{ github.token }}
          GIT_AUTHOR_NAME: github-actions[bot]
          GIT_AUTHOR_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
          GIT_COMMITTER_NAME: github-actions[bot]
          GIT_COMMITTER_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
        run: |
          set -euo pipefail
          if [[ -z "$SIGNING_KEY" ]]; then
            echo "::error::The deploy environment has no release signing key (OPSCREW_STAGING_RELEASE_SIGNING_KEY): run \\\`opscrew provision --env staging\\\`, which sets it."
            exit 1
          fi
          release="$RUNNER_TEMP/release"
          mkdir -p "$release"
          tar -xf "$RUNNER_TEMP/release.tar" -C "$release"
          git init -q --bare "$RUNNER_TEMP/release.git"
          export GIT_DIR="$RUNNER_TEMP/release.git" GIT_WORK_TREE="$release" GIT_INDEX_FILE="$RUNNER_TEMP/release.index"
          remote="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY.git"
          auth="$(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)"
          echo "::add-mask::$auth"
          git config "http.$GITHUB_SERVER_URL/.extraheader" "AUTHORIZATION: basic $auth"
          found=0
          git ls-remote --exit-code "$remote" "refs/heads/$BRANCH" > /dev/null || found=$?
          if [[ "$found" -eq 0 ]]; then
            git fetch -q --depth=1 --no-tags "$remote" "+refs/heads/$BRANCH:refs/remotes/origin/release"
          elif [[ "$found" -ne 2 ]]; then
            echo "::error::GitHub did not answer whether $BRANCH exists; re-run the workflow."
            exit 1
          fi
          # No attribute of the app's .gitattributes may rewrite a file: the release is kept byte for byte.
          printf '* -text -eol -filter -ident\\n' > "$GIT_DIR/info/attributes"
          git add --force --all .
          tree="$(git write-tree)"
          # mktemp makes the file 0600, the runner's user's only.
          key="$(mktemp)"
          trap 'rm -f "$key"' EXIT
          printf '%s\\n' "$SIGNING_KEY" > "$key"
          signature="$(printf '%s' "$tree $GITHUB_RUN_ID $GITHUB_RUN_ATTEMPT $ENVIRONMENT" | openssl dgst -sha256 -sign "$key" | base64 -w0)"
          rm -f "$key"
          commit="$(git commit-tree "$tree" \\
            -m "OpsCrew release of \${GITHUB_SHA:0:7} for $ENVIRONMENT" \\
            -m "Built by $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID from $GITHUB_SHA." \\
            -m "OpsCrew-Release: $GITHUB_RUN_ID $GITHUB_RUN_ATTEMPT $ENVIRONMENT $signature")"
          git push -q --force "$remote" "$commit:refs/heads/$BRANCH"
          echo "release=$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >> "$GITHUB_OUTPUT"
          echo "::notice::Published release $GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT on $BRANCH; the account deploys it within about a minute."

  wait:
    name: Wait for staging-shop.example.com to serve the release
    needs: publish
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Wait for the account to switch to the release
        timeout-minutes: 12
        env:
          URL: https://staging-shop.example.com/
          RELEASE: \${{ needs.publish.outputs.release }}
        run: |
          set -uo pipefail
          for attempt in $(seq 1 40); do
            served="$(curl -sS --max-time 5 -o /dev/null -D - "$URL" 2> /dev/null | tr -d '\\r' | awk 'tolower($0) ~ /^x-opscrew-release:/ { sub(/^[^:]*: */, ""); print; exit }')"
            if [[ "$served" == "$RELEASE" ]]; then
              echo "The account serves release $RELEASE."
              exit 0
            fi
            sleep 10
          done
          echo "::error::The account didn't switch to this release: run \\\`opscrew status --env staging\\\` to see why."
          exit 1
"
`;

exports[`renderHostingWorkflow > renders the environment's deploy workflow per kind of app > php 1`] = `
"# Generated by OpsCrew from opscrew/environments/staging/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app and publishes each release, signed, on the branch opscrew/release/staging. The OpsCrew agent
# on the hosting account checks the signature and deploys it; the last job waits for the account
# to serve it. The signing key is the only secret here: no credential of the account is in GitHub.
name: OpsCrew deploy (staging)

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - ".github/workflows/opscrew-deploy-staging.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy-shop-staging
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/staging"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --env staging --resume --deploy\\\` deploys the branch's latest commit."
          elif [[ "$(field reason)" == rotation ]]; then
            text="Deploys of $KEY are paused since $since for a credential rotation's window: \\\`opscrew rotate --env staging\\\` with its services, or with \\\`--undo\\\`, ends it."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision --env staging\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the release
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - name: Install the app's PHP packages with Composer in PHP 8.3
        working-directory: "."
        env:
          PHP_IMAGE: <pin:IMAGES.php83Cli>
          COMPOSER_IMAGE: <pin:IMAGES.composer>
        run: |
          set -euo pipefail
          if [[ ! -f composer.json ]]; then
            echo "The app has no composer.json: no PHP packages to install."
            exit 0
          fi
          docker create --name opscrew-composer "$COMPOSER_IMAGE" > /dev/null
          docker cp opscrew-composer:/usr/bin/composer "$RUNNER_TEMP/composer"
          docker rm opscrew-composer > /dev/null
          # The PHP image has neither unzip nor PHP's zip extension, one of which Composer unpacks with.
          # The container runs as root: vendor/ goes back to the runner's user, so a self-hosted runner's next checkout can clean it.
          docker run --rm -e COMPOSER_ALLOW_SUPERUSER=1 -e OWNER="$(id -u):$(id -g)" -v "$PWD:/app" -v "$RUNNER_TEMP/composer:/usr/local/bin/composer:ro" -w /app "$PHP_IMAGE" \\
            bash -c 'apt-get update -qq && apt-get install -y -qq --no-install-recommends unzip > /dev/null && composer install --no-dev --optimize-autoloader --no-interaction --no-progress --ignore-platform-req="ext-*" && chown -R "$OWNER" vendor'
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "24"
      - name: Build the app's assets
        working-directory: "."
        run: |
          set -euo pipefail
          if [[ ! -f package.json ]] || ! node -e 'process.exit(require("./package.json").scripts?.build ? 0 : 1)'; then
            echo "package.json has no build script: nothing to build."
            exit 0
          fi
          if [[ -f pnpm-lock.yaml ]]; then
            spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^pnpm@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("pnpm@")){console.error("package.json\\x27s packageManager must name an exact version, such as pnpm@<pin:PACKAGE_MANAGERS.pnpm>");process.exit(1)}const v=m?m[1]:"<pin:PACKAGE_MANAGERS.pnpm>";console.log("pnpm@"+v)')"
            npm install -g --no-audit --no-fund "$spec"
            pm=pnpm
            pnpm install --frozen-lockfile
          elif [[ -f yarn.lock ]]; then
            spec="$(node -e 'const p=require("./package.json").packageManager||"";const m=/^yarn@(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?)(?:\\+.*)?$/.exec(p);if(!m&&p.startsWith("yarn@")){console.error("package.json\\x27s packageManager must name an exact version, such as yarn@<pin:PACKAGE_MANAGERS.yarn>");process.exit(1)}const v=m?m[1]:"<pin:PACKAGE_MANAGERS.yarn>";console.log((/^1\\./.test(v)?"yarn@":"@yarnpkg/cli-dist@")+v)')"
            npm install -g --no-audit --no-fund "$spec"
            pm=yarn
            yarn install --frozen-lockfile
          elif [[ -f package-lock.json ]]; then
            pm=npm
            npm ci
          else
            pm=npm
            npm install
          fi
          "$pm" run build
      - name: Keep the release
        run: |
          set -euo pipefail
          tar -cf "$RUNNER_TEMP/release.tar" -C '.' --exclude=.git --exclude=node_modules --exclude=./.github --exclude=./opscrew .
      - uses: <pin:ACTIONS.uploadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}/release.tar
          if-no-files-found: error
          retention-days: 1

  publish:
    name: Publish the release on opscrew/release/staging
    needs: build
    if: \${{ !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    environment: staging
    permissions:
      contents: write
    outputs:
      release: \${{ steps.publish.outputs.release }}
    steps:
      - uses: <pin:ACTIONS.downloadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}
      - id: publish
        name: Sign the release and push it
        env:
          ENVIRONMENT: staging
          BRANCH: opscrew/release/staging
          SIGNING_KEY: \${{ secrets.OPSCREW_STAGING_RELEASE_SIGNING_KEY }}
          TOKEN: \${{ github.token }}
          GIT_AUTHOR_NAME: github-actions[bot]
          GIT_AUTHOR_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
          GIT_COMMITTER_NAME: github-actions[bot]
          GIT_COMMITTER_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
        run: |
          set -euo pipefail
          if [[ -z "$SIGNING_KEY" ]]; then
            echo "::error::The deploy environment has no release signing key (OPSCREW_STAGING_RELEASE_SIGNING_KEY): run \\\`opscrew provision --env staging\\\`, which sets it."
            exit 1
          fi
          release="$RUNNER_TEMP/release"
          mkdir -p "$release"
          tar -xf "$RUNNER_TEMP/release.tar" -C "$release"
          git init -q --bare "$RUNNER_TEMP/release.git"
          export GIT_DIR="$RUNNER_TEMP/release.git" GIT_WORK_TREE="$release" GIT_INDEX_FILE="$RUNNER_TEMP/release.index"
          remote="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY.git"
          auth="$(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)"
          echo "::add-mask::$auth"
          git config "http.$GITHUB_SERVER_URL/.extraheader" "AUTHORIZATION: basic $auth"
          found=0
          git ls-remote --exit-code "$remote" "refs/heads/$BRANCH" > /dev/null || found=$?
          if [[ "$found" -eq 0 ]]; then
            git fetch -q --depth=1 --no-tags "$remote" "+refs/heads/$BRANCH:refs/remotes/origin/release"
          elif [[ "$found" -ne 2 ]]; then
            echo "::error::GitHub did not answer whether $BRANCH exists; re-run the workflow."
            exit 1
          fi
          # No attribute of the app's .gitattributes may rewrite a file: the release is kept byte for byte.
          printf '* -text -eol -filter -ident\\n' > "$GIT_DIR/info/attributes"
          git add --force --all .
          tree="$(git write-tree)"
          # mktemp makes the file 0600, the runner's user's only.
          key="$(mktemp)"
          trap 'rm -f "$key"' EXIT
          printf '%s\\n' "$SIGNING_KEY" > "$key"
          signature="$(printf '%s' "$tree $GITHUB_RUN_ID $GITHUB_RUN_ATTEMPT $ENVIRONMENT" | openssl dgst -sha256 -sign "$key" | base64 -w0)"
          rm -f "$key"
          commit="$(git commit-tree "$tree" \\
            -m "OpsCrew release of \${GITHUB_SHA:0:7} for $ENVIRONMENT" \\
            -m "Built by $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID from $GITHUB_SHA." \\
            -m "OpsCrew-Release: $GITHUB_RUN_ID $GITHUB_RUN_ATTEMPT $ENVIRONMENT $signature")"
          git push -q --force "$remote" "$commit:refs/heads/$BRANCH"
          echo "release=$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >> "$GITHUB_OUTPUT"
          echo "::notice::Published release $GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT on $BRANCH; the account deploys it within about a minute."

  wait:
    name: Wait for staging-shop.example.com to serve the release
    needs: publish
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Wait for the account to switch to the release
        timeout-minutes: 12
        env:
          URL: https://staging-shop.example.com/
          RELEASE: \${{ needs.publish.outputs.release }}
        run: |
          set -uo pipefail
          for attempt in $(seq 1 40); do
            served="$(curl -sS --max-time 5 -o /dev/null -D - "$URL" 2> /dev/null | tr -d '\\r' | awk 'tolower($0) ~ /^x-opscrew-release:/ { sub(/^[^:]*: */, ""); print; exit }')"
            if [[ "$served" == "$RELEASE" ]]; then
              echo "The account serves release $RELEASE."
              exit 0
            fi
            sleep 10
          done
          echo "::error::The account didn't switch to this release: run \\\`opscrew status --env staging\\\` to see why."
          exit 1
"
`;

exports[`renderHostingWorkflow > renders the environment's deploy workflow per kind of app > static 1`] = `
"# Generated by OpsCrew from opscrew/environments/staging/plan.yaml; \`opscrew provision\` regenerates it.
# Builds the app and publishes each release, signed, on the branch opscrew/release/staging. The OpsCrew agent
# on the hosting account checks the signature and deploys it; the last job waits for the account
# to serve it. The signing key is the only secret here: no credential of the account is in GitHub.
name: OpsCrew deploy (staging)

on:
  push:
    branches: ["main"]
    # A push starts it only when it changes one of these paths, which the run reads.
    paths:
      - "**"
      - "!opscrew/**"
      - "!.github/workflows/opscrew-deploy*.yml"
      - "!.github/workflows/opscrew-preview*.yml"
      - ".github/workflows/opscrew-deploy-staging.yml"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: opscrew-deploy-shop-staging
  cancel-in-progress: false

jobs:
  paused:
    name: Report the deploy pause
    if: \${{ contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Say why this run does not deploy
        env:
          KEY: "shop/staging"
          PAUSED: \${{ vars.OPSCREW_DEPLOY_PAUSED }}
        run: |
          set -euo pipefail
          field() { jq -r --arg key "$KEY" --arg field "$1" '.[$key][$field] // empty' <<< "$PAUSED"; }
          since="$(field since)"
          if [[ "$(field reason)" == rollback ]]; then
            commit="$(field commit)"
            image="$(field image)"
            if [[ "$image" == sha256:* ]]; then image="\${image:0:19}"; fi
            text="Deploys of $KEY are paused since $since: \\\`opscrew rollback\\\` pinned it to \${commit:0:7} (\${image}). This run built \${GITHUB_SHA:0:7} but didn't deploy it. \\\`opscrew rollback --env staging --resume --deploy\\\` deploys the branch's latest commit."
          elif [[ "$(field reason)" == rotation ]]; then
            text="Deploys of $KEY are paused since $since for a credential rotation's window: \\\`opscrew rotate --env staging\\\` with its services, or with \\\`--undo\\\`, ends it."
          else
            text="Deploys of $KEY are paused since $since while a service moves between the app's servers; \\\`opscrew provision --env staging\\\` resumes them."
          fi
          echo "::notice::$text"
          echo "$text" >> "$GITHUB_STEP_SUMMARY"

  build:
    name: Build the release
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: <pin:ACTIONS.checkout>
        with:
          persist-credentials: false
      - uses: <pin:ACTIONS.setupNode>
        with:
          node-version: "24"
      - name: Install the site's dependencies
        working-directory: "."
        run: |
          set -euo pipefail
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
      - name: Build the site
        working-directory: "."
        run: |
          set -euo pipefail
          npm run build
      - name: Check the built site
        run: |
          set -euo pipefail
          if [[ ! -d 'dist' ]]; then
            echo "::error::The build left no folder dist, where opscrew/environments/staging/plan.yaml expects the site's files (target.site.outputDir): change target.site in opscrew/environments/staging/plan.yaml to what the build writes, then run \\\`opscrew provision --env staging\\\` again."
            exit 1
          fi
      - name: Keep the release
        run: |
          set -euo pipefail
          tar -cf "$RUNNER_TEMP/release.tar" -C 'dist' --exclude=.git --exclude=node_modules --exclude=./.github --exclude=./opscrew .
      - uses: <pin:ACTIONS.uploadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}/release.tar
          if-no-files-found: error
          retention-days: 1

  publish:
    name: Publish the release on opscrew/release/staging
    needs: build
    if: \${{ !contains(vars.OPSCREW_DEPLOY_PAUSED, '"shop/staging"') }}
    runs-on: ubuntu-latest
    environment: staging
    permissions:
      contents: write
    outputs:
      release: \${{ steps.publish.outputs.release }}
    steps:
      - uses: <pin:ACTIONS.downloadArtifact>
        with:
          name: opscrew-release
          path: \${{ runner.temp }}
      - id: publish
        name: Sign the release and push it
        env:
          ENVIRONMENT: staging
          BRANCH: opscrew/release/staging
          SIGNING_KEY: \${{ secrets.OPSCREW_STAGING_RELEASE_SIGNING_KEY }}
          TOKEN: \${{ github.token }}
          GIT_AUTHOR_NAME: github-actions[bot]
          GIT_AUTHOR_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
          GIT_COMMITTER_NAME: github-actions[bot]
          GIT_COMMITTER_EMAIL: 41898282+github-actions[bot]@users.noreply.github.com
        run: |
          set -euo pipefail
          if [[ -z "$SIGNING_KEY" ]]; then
            echo "::error::The deploy environment has no release signing key (OPSCREW_STAGING_RELEASE_SIGNING_KEY): run \\\`opscrew provision --env staging\\\`, which sets it."
            exit 1
          fi
          release="$RUNNER_TEMP/release"
          mkdir -p "$release"
          tar -xf "$RUNNER_TEMP/release.tar" -C "$release"
          git init -q --bare "$RUNNER_TEMP/release.git"
          export GIT_DIR="$RUNNER_TEMP/release.git" GIT_WORK_TREE="$release" GIT_INDEX_FILE="$RUNNER_TEMP/release.index"
          remote="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY.git"
          auth="$(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)"
          echo "::add-mask::$auth"
          git config "http.$GITHUB_SERVER_URL/.extraheader" "AUTHORIZATION: basic $auth"
          found=0
          git ls-remote --exit-code "$remote" "refs/heads/$BRANCH" > /dev/null || found=$?
          if [[ "$found" -eq 0 ]]; then
            git fetch -q --depth=1 --no-tags "$remote" "+refs/heads/$BRANCH:refs/remotes/origin/release"
          elif [[ "$found" -ne 2 ]]; then
            echo "::error::GitHub did not answer whether $BRANCH exists; re-run the workflow."
            exit 1
          fi
          # No attribute of the app's .gitattributes may rewrite a file: the release is kept byte for byte.
          printf '* -text -eol -filter -ident\\n' > "$GIT_DIR/info/attributes"
          git add --force --all .
          tree="$(git write-tree)"
          # mktemp makes the file 0600, the runner's user's only.
          key="$(mktemp)"
          trap 'rm -f "$key"' EXIT
          printf '%s\\n' "$SIGNING_KEY" > "$key"
          signature="$(printf '%s' "$tree $GITHUB_RUN_ID $GITHUB_RUN_ATTEMPT $ENVIRONMENT" | openssl dgst -sha256 -sign "$key" | base64 -w0)"
          rm -f "$key"
          commit="$(git commit-tree "$tree" \\
            -m "OpsCrew release of \${GITHUB_SHA:0:7} for $ENVIRONMENT" \\
            -m "Built by $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID from $GITHUB_SHA." \\
            -m "OpsCrew-Release: $GITHUB_RUN_ID $GITHUB_RUN_ATTEMPT $ENVIRONMENT $signature")"
          git push -q --force "$remote" "$commit:refs/heads/$BRANCH"
          echo "release=$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" >> "$GITHUB_OUTPUT"
          echo "::notice::Published release $GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT on $BRANCH; the account deploys it within about a minute."

  wait:
    name: Wait for staging-shop.example.com to serve the release
    needs: publish
    runs-on: ubuntu-latest
    permissions: {}
    steps:
      - name: Wait for the account to switch to the release
        timeout-minutes: 12
        env:
          URL: https://staging-shop.example.com/
          RELEASE: \${{ needs.publish.outputs.release }}
        run: |
          set -uo pipefail
          for attempt in $(seq 1 40); do
            served="$(curl -sS --max-time 5 -o /dev/null -D - "$URL" 2> /dev/null | tr -d '\\r' | awk 'tolower($0) ~ /^x-opscrew-release:/ { sub(/^[^:]*: */, ""); print; exit }')"
            if [[ "$served" == "$RELEASE" ]]; then
              echo "The account serves release $RELEASE."
              exit 0
            fi
            sleep 10
          done
          echo "::error::The account didn't switch to this release: run \\\`opscrew status --env staging\\\` to see why."
          exit 1
"
`;
