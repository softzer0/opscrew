  if [ -L "$1" ]; then fail "$1 is a symbolic link; OpsCrew does not follow it."; fi
  install -d -m "\${2:-0700}" "$1"
  if [ -n "$owner" ]; then chown "$owner" "$1"; fi
}
all_running() {
  want=$(compose config --services 2>/dev/null | sort) || return 1
  have=$(compose ps --services --status running 2>/dev/null | sort) || return 1
  [ -n "$want" ] && [ "$want" = "$have" ]
}
sums_ok() {
  for entry in $MANIFEST; do [ "$(sum_of "$DIR/\${entry%%:*}")" = "\${entry#*:}" ] || return 1; done
}
files_ok() {
  [ -f "$DIR/.opscrew-files" ] && [ "$(cat "$DIR/.opscrew-files")" = "$MANIFEST" ] || return 1
  sums_ok || return 1
  c="$DIR/$CREDENTIAL"
  [ -s "$c" ] && [ ! -L "$c" ] && [ "$(stat -c '%u:%g:%a' "$c")" = 0:0:640 ]
}
verify_state() {
  files_ok || return 1
  all_running
}
if [ -e "$DIR/compose.yaml" ]; then echo prev.installed=true; else echo prev.installed=false; fi
if verify_state >/dev/null 2>&1; then echo state=in-place; else echo state=change; fi
",
  "remove apply": "# opscrew-host: monitoring.remove.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
DIR='/home/deploy/opscrew/addons/monitoring'
PARENT='/home/deploy/opscrew/addons'
PROJECT='opscrew-monitoring'
REMOVE_DATA='true'
ADDONS_ROOT='/srv/opscrew'
RUN_AS='login'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
label_ids() {
  docker "$1" ls -q --filter "label=com.docker.compose.project=$2" 2>/dev/null || true
}
remove_project() {
  if ! command -v docker >/dev/null 2>&1; then return 0; fi
  if ! systemctl is-active --quiet docker; then
    systemctl start docker >/dev/null 2>&1 || fail 'Docker is not running, so OpsCrew cannot remove the containers. Start Docker, then try again.'
  fi
  if [ -f "$2" ]; then
    if [ "$4" = true ]; then
      docker compose -p "$1" --project-directory "$3" -f "$2" down --remove-orphans --volumes >/dev/null 2>&1 || true
    else
      docker compose -p "$1" --project-directory "$3" -f "$2" down --remove-orphans >/dev/null 2>&1 || true
    fi
  fi
  ids=$(docker ps -aq --filter "label=com.docker.compose.project=$1" 2>/dev/null) || ids=''
  # shellcheck disable=SC2086 # ids are one word each.
  if [ -n "$ids" ]; then docker rm -f $ids >/dev/null; fi
  nets=$(label_ids network "$1")
  # shellcheck disable=SC2086
  if [ -n "$nets" ]; then docker network rm $nets >/dev/null 2>&1 || true; fi
  if [ "$4" = true ]; then
    vols=$(label_ids volume "$1")
    # shellcheck disable=SC2086
    if [ -n "$vols" ]; then docker volume rm $vols >/dev/null; fi
  fi
  return 0
}
project_gone() {
  if ! command -v docker >/dev/null 2>&1; then return 0; fi
  systemctl is-active --quiet docker || return 1
  [ -z "$(docker ps -aq --filter "label=com.docker.compose.project=$1" 2>/dev/null)" ] || return 1
  if [ "$2" = true ]; then [ -z "$(label_ids volume "$1")" ] || return 1; fi
  return 0
}
remove_project "$PROJECT" "$DIR/compose.yaml" "$DIR" "$REMOVE_DATA"
rm -rf "$DIR"
# The add-ons' parent goes too once it is empty, and on a server the user owns OpsCrew's root.
if [ -d "$PARENT" ] && [ -z "$(ls -A "$PARENT")" ]; then rmdir "$PARENT"; fi
if [ "$RUN_AS" = root ] && [ -d "$ADDONS_ROOT" ] && [ -z "$(ls -A "$ADDONS_ROOT")" ]; then
  rmdir "$ADDONS_ROOT"
fi
",
  "remove verify": "# opscrew-host: monitoring.remove.verify
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
