exports[`Grafana Cloud's Alloy without monitoring > keeps today's plan text, on a server the user owns and on one OpsCrew created 1`] = `
{
  "created": {
    "app": "shop",
    "findings": [],
    "purpose": "setup",
    "schemaVersion": 1,
    "steps": [
      {
        "id": "alloy",
        "params": {
          "file:Caddyfile": "{
	admin off
}
",
          "file:compose.yaml": "name: opscrew-alloy
services:
  alloy:
    volumes: [./grafana_cloud_credential:/etc/alloy/grafana_cloud_credential:ro]
  proxy: {}
",
          "file:config.alloy": "local.file "token" {
  filename = "/etc/alloy/grafana_cloud_credential"
  is_secret = true
}
",
          "runAs": "login",
        },
        "reason": "Grafana Alloy runs as its own Compose project opscrew-alloy in /home/deploy/opscrew/addons/alloy, and reads Docker only through OpsCrew's read-only proxy. Its Grafana Cloud token is written at apply time to files only the deploy user can read, never part of this plan.",
        "scope": "shared",
        "state": "change",
        "title": "Run Grafana Alloy as the deploy user, sending the logs of "shop" (masked) and the server's metrics to your Grafana Cloud stack",
      },
    ],
  },
  "off": {
    "app": "shop",
    "findings": [],
    "purpose": "setup",
    "schemaVersion": 1,
    "steps": [
      {
        "id": "alloy",
        "params": {
          "keepData": false,
          "remove": true,
          "runAs": "login",
        },
        "reason": "Its Compose project opscrew-alloy, and /home/deploy/opscrew/addons/alloy with everything in it, its secret files included.",
        "scope": "shared",
        "state": "change",
        "title": "Remove Grafana Alloy, its buffered data and the masking file of "shop"",
      },
    ],
  },
  "own": {
    "app": "shop",
    "findings": [],
    "purpose": "setup",
    "schemaVersion": 1,
    "steps": [
      {
        "id": "alloy",
        "params": {
          "file:Caddyfile": "{
	admin off
}
",
          "file:compose.yaml": "name: opscrew-alloy
services:
  alloy:
    volumes: [./grafana_cloud_credential:/etc/alloy/grafana_cloud_credential:ro]
  proxy: {}
",
          "file:config.alloy": "local.file "token" {
  filename = "/etc/alloy/grafana_cloud_credential"
  is_secret = true
}
",
          "runAs": "root",
        },
        "reason": "Grafana Alloy runs as its own Compose project opscrew-alloy in /srv/opscrew/addons/alloy, and reads Docker only through OpsCrew's read-only proxy. Its Grafana Cloud token is written at apply time to files only the deploy user can read, never part of this plan.",
        "scope": "shared",
        "state": "change",
        "title": "Run Grafana Alloy as the deploy user, sending the logs of "shop" (masked) and the server's metrics to your Grafana Cloud stack",
      },
    ],
  },
}
`;

exports[`the monitoring stack's scripts in a real shell (docker stubbed) > match their snapshot 1`] = `
{
  "apply": "# opscrew-host: monitoring.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
DIR='/srv/opscrew/addons/monitoring'
PARENT='/srv/opscrew/addons'
RUN_AS='root'
USER_NAME='deploy'
PROJECT='opscrew-monitoring'
CREDENTIAL='grafana_admin_credential'
PATHS='Caddyfile compose.yaml grafana/dashboards/servers.json grafana/provisioning/dashboards/opscrew.yaml grafana/provisioning/datasources/opscrew.yaml loki.yaml prometheus.yml'
DIRS='grafana grafana/dashboards grafana/provisioning grafana/provisioning/dashboards grafana/provisioning/datasources'
MANIFEST='Caddyfile:41efde35bd4819cd8c844d214497de99c89cc16d299a62e5ea3af5a50f0677c2 compose.yaml:4e445d7ca8149709e9ead07716dedcfd41cf3ba6478a56a163636fca046350d3 grafana/dashboards/servers.json:add9289ce43dc2c7886cb2dbb6d701660e16969686cca6c0cc5abb7f1d86a633 grafana/provisioning/dashboards/opscrew.yaml:91863bafca7e667fd49cdbbe826f66ec350d91a53ad263ed48efc5843f21a45e grafana/provisioning/datasources/opscrew.yaml:409c3f717e5e456302adc88f82242bbb8f9a8b971d978325223da7076908699e loki.yaml:470ec796de94ebc56ff4a25e567cc1100fbe7a675f5fd10d8b2b02784e477952 prometheus.yml:68df12ad8474fcda0cd34fd4ae499834a5b9a82a55f364f16b79884ff52cf904'
ROTATE='false'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
compose() { docker compose -p "$PROJECT" -f "$DIR/compose.yaml" "$@"; }
sum_of() { sha256sum "$1" 2>/dev/null | cut -d ' ' -f 1; }
put() {
  if [ -L "$1" ]; then fail "$1 is a symbolic link; OpsCrew does not follow it."; fi
  write_file "$1" "\${2:-0600}" "$owner"
}
own_dir() {
  if [ -L "$1" ]; then fail "$1 is a symbolic link; OpsCrew does not follow it."; fi
  install -d -m "\${2:-0700}" "$1"
  if [ -n "$owner" ]; then chown "$owner" "$1"; fi
}
all_running() {
  want=$(compose config --services 2>/dev/null | sort) || return 1
  have=$(compose ps --services --status running 2>/dev/null | sort) || return 1
  [ -n "$want" ] && [ "$want" = "$have" ]
}
sums_ok() {
  for entry in $MANIFEST; do [ "$(sum_of "$DIR/\${entry%%:*}")" = "\${entry#*:}" ] || return 1; done
}
files_ok() {
  [ -f "$DIR/.opscrew-files" ] && [ "$(cat "$DIR/.opscrew-files")" = "$MANIFEST" ] || return 1
  sums_ok || return 1
  c="$DIR/$CREDENTIAL"
  [ -s "$c" ] && [ ! -L "$c" ] && [ "$(stat -c '%u:%g:%a' "$c")" = 0:0:640 ]
}
umask 077
getent passwd "$USER_NAME" >/dev/null 2>&1 || fail "The $USER_NAME user is missing, so OpsCrew cannot set up the monitoring stack."
owner="$(id -u "$USER_NAME"):$(id -g "$USER_NAME")"
pw=''
IFS= read -r pw || true
case "$pw" in ''|*[!A-Za-z0-9_-]*) pw=''; fail 'No valid Grafana admin password arrived on standard input, so the monitoring stack was not set up.' ;; esac
# On a server the user owns the add-ons' parent is root's; on one OpsCrew created, the deploy user's.
if [ "$RUN_AS" = root ]; then
  install -d -m 0700 "$PARENT"
else
  for d in "$(dirname "$PARENT")" "$PARENT"; do own_dir "$d"; done
fi
own_dir "$DIR"
for d in $DIRS; do own_dir "$DIR/$d" 0755; done
# A rewritten file reaches a running service only when Compose recreates it: decided before
# anything is written, so a file edited on the server counts too. The list of files is written
# once the stack is up, so a failed start recreates it the next time.
recreate=''
files_ok || recreate=--force-recreate
# Grafana (user 472, group 0) reads its password through its group.
if [ -L "$DIR/$CREDENTIAL" ]; then fail "$DIR/$CREDENTIAL is a symbolic link; OpsCrew does not follow it."; fi
# Grafana reads the file only when it first makes its admin: in a rotation, a password other than
# the file's is set in the running Grafana first, through its CLI in its container, on stdin.
if [ "$ROTATE" = true ] && { [ ! -f "$DIR/$CREDENTIAL" ] || [ "$(cat "$DIR/$CREDENTIAL")" != "$pw" ]; }; then
  if ! printf '%s\\n' "$pw" | compose exec -T grafana grafana cli admin reset-admin-password --password-from-stdin >/dev/null 2>&1; then
    pw=''
    fail "The running Grafana did not take its new admin password (grafana cli admin reset-admin-password failed), so OpsCrew left its password file as it was. Check that the monitoring stack runs: docker compose -p $PROJECT ps on the server."
  fi
fi
printf '%s' "$pw" | write_file "$DIR/$CREDENTIAL" 0640 0:0
pw=''
# Then the files, one line of base64 each, in the order of $PATHS. None holds a secret.
for path in $PATHS; do
  b64=''
  IFS= read -r b64 || true
  [ -n "$b64" ] || fail "The monitoring stack's file $path did not arrive on standard input, so OpsCrew stopped."
  printf '%s' "$b64" | base64 -d | put "$DIR/$path" 0644
done
sums_ok || fail "The monitoring stack's files on the server are not the planned ones, so OpsCrew stopped."
# shellcheck disable=SC2086 # recreate is empty or one flag.
compose up -d --wait --wait-timeout 300 --remove-orphans --quiet-pull $recreate >/dev/null 2>&1 || fail "The monitoring stack was not up and healthy within five minutes (docker compose up --wait failed). See docker compose -p $PROJECT ps and logs on the server."
printf '%s\\n' "$MANIFEST" | put "$DIR/.opscrew-files"
",
