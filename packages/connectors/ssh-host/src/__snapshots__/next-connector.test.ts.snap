exports[`planNextTunnelConnectorRemoval > has scripts that match their snapshot 1`] = `
{
  "login": [
    {
      "apply": "# opscrew-host: tunnel-connector.remove.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
DIR='/home/deploy/opscrew/cloudflared-next'
PARENT='/home/deploy/opscrew'
PROJECT='shop-tunnel-next'
DELETE_DATA='false'
ADDONS_ROOT='/srv/opscrew'
RUN_AS='login'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
label_ids() {
  docker "$1" ls -q --filter "label=com.docker.compose.project=$2" 2>/dev/null || true
}
remove_project() {
  if ! command -v docker >/dev/null 2>&1; then return 0; fi
  if ! systemctl is-active --quiet docker; then
    systemctl start docker >/dev/null 2>&1 || fail 'Docker is not running, so OpsCrew cannot remove the containers. Start Docker, then try again.'
  fi
  if [ -f "$2" ]; then
    if [ "$4" = true ]; then
      docker compose -p "$1" --project-directory "$3" -f "$2" down --remove-orphans --volumes >/dev/null 2>&1 || true
    else
      docker compose -p "$1" --project-directory "$3" -f "$2" down --remove-orphans >/dev/null 2>&1 || true
    fi
  fi
  ids=$(docker ps -aq --filter "label=com.docker.compose.project=$1" 2>/dev/null) || ids=''
  # shellcheck disable=SC2086 # ids are one word each.
  if [ -n "$ids" ]; then docker rm -f $ids >/dev/null; fi
  nets=$(label_ids network "$1")
  # shellcheck disable=SC2086
  if [ -n "$nets" ]; then docker network rm $nets >/dev/null 2>&1 || true; fi
  if [ "$4" = true ]; then
    vols=$(label_ids volume "$1")
    # shellcheck disable=SC2086
    if [ -n "$vols" ]; then docker volume rm $vols >/dev/null; fi
  fi
  return 0
}
project_gone() {
  if ! command -v docker >/dev/null 2>&1; then return 0; fi
  systemctl is-active --quiet docker || return 1
  [ -z "$(docker ps -aq --filter "label=com.docker.compose.project=$1" 2>/dev/null)" ] || return 1
  if [ "$2" = true ]; then [ -z "$(label_ids volume "$1")" ] || return 1; fi
  return 0
}
remove_project "$PROJECT" "$DIR/compose.yaml" "$DIR" "$DELETE_DATA"
rm -rf "$DIR"
# OpsCrew's shared parents go too once they are empty.
if [ "$RUN_AS" = root ]; then
  for d in "$PARENT" "$ADDONS_ROOT"; do
    if [ -d "$d" ] && [ -z "$(ls -A "$d")" ]; then rmdir "$d"; fi
  done
fi
",
      "check": "# opscrew-host: tunnel-connector.remove.check
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
