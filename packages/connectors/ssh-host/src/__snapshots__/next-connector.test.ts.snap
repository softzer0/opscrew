// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`planNextTunnelConnector > has scripts that match their snapshot 1`] = `
{
  "login": [
    {
      "apply": "# opscrew-host: tunnel-connector.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
DIR='/home/deploy/opscrew/cloudflared-next'
PROJECT='shop-tunnel-next'
ADDONS_ROOT='/srv/opscrew'
TUNNELS_DIR='/srv/opscrew/cloudflared-next'
RUN_AS='login'
COMPOSE_B64=''
COMPOSE_SHA256='a9db417691e92531f52a348fb1fcbd43dbeceab6bbfeeca31363d5aa84bd411d'
TUNNEL_ID='7a2e1d3f-2222-4b6c-8d4e-123456789abc'
NEEDS_TOKEN='true'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
compose() { docker compose -p "$PROJECT" -f "$DIR/compose.yaml" "$@"; }
compose_is() { [ -f "$DIR/compose.yaml" ] && [ "$(sha256sum "$DIR/compose.yaml" | cut -d ' ' -f 1)" = "$1" ]; }
write_compose() { printf '%s' "$1" | base64 -d | write_file "$DIR/compose.yaml" 0600; }
running() { [ -n "$(compose ps --status running -q 2>/dev/null)" ]; }
umask 077
if [ "$RUN_AS" = root ]; then install -d -m 0700 "$ADDONS_ROOT" "$TUNNELS_DIR"; fi
install -d -m 0700 "$DIR"
token=''
IFS= read -r token || true
recreate=''
if [ -n "$token" ]; then
  case "$token" in
    *[!A-Za-z0-9+/=_.-]*) token=''; fail 'The tunnel token has unexpected characters, so it was not written.' ;;
  esac
  printf 'TUNNEL_TOKEN=%s\\n' "$token" | write_file "$DIR/tunnel.env" 0600
  token=''
  # A new token means a new connector container, so it really uses it.
  recreate=--force-recreate
elif [ "$NEEDS_TOKEN" = true ] || [ ! -s "$DIR/tunnel.env" ]; then
  fail 'No tunnel token arrived on standard input, so the tunnel connector was not set up.'
fi
# The tunnel id is not secret: it tells a later plan whether the tunnel was replaced.
printf '%s\\n' "$TUNNEL_ID" > "$DIR/tunnel.id"
write_compose "$COMPOSE_B64"
# shellcheck disable=SC2086 # recreate is empty or one flag.
compose up -d --remove-orphans --quiet-pull $recreate >/dev/null 2>&1 || fail 'The tunnel connector did not start (docker compose up failed).'
i=0
until compose logs --no-color --tail 300 2>/dev/null | grep -q 'Registered tunnel connection'; do
  i=$((i + 1))
  if [ "$i" -ge 45 ]; then fail 'The tunnel connector did not connect to Cloudflare within 90 seconds. Check that the server can reach Cloudflare on port 7844 (outbound) and that the tunnel still exists.'; fi
  sleep 2
done
",
      "check": "# opscrew-host: tunnel-connector.check
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
DIR='/home/deploy/opscrew/cloudflared-next'
PROJECT='shop-tunnel-next'
ADDONS_ROOT='/srv/opscrew'
TUNNELS_DIR='/srv/opscrew/cloudflared-next'
RUN_AS='login'
COMPOSE_B64=''
COMPOSE_SHA256='a9db417691e92531f52a348fb1fcbd43dbeceab6bbfeeca31363d5aa84bd411d'
TUNNEL_ID='7a2e1d3f-2222-4b6c-8d4e-123456789abc'
NEEDS_TOKEN='true'
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
compose() { docker compose -p "$PROJECT" -f "$DIR/compose.yaml" "$@"; }
compose_is() { [ -f "$DIR/compose.yaml" ] && [ "$(sha256sum "$DIR/compose.yaml" | cut -d ' ' -f 1)" = "$1" ]; }
write_compose() { printf '%s' "$1" | base64 -d | write_file "$DIR/compose.yaml" 0600; }
running() { [ -n "$(compose ps --status running -q 2>/dev/null)" ]; }
verify_state() {
  [ -s "$DIR/tunnel.env" ] || return 1
  [ "$(head -n 1 "$DIR/tunnel.id" 2>/dev/null)" = "$TUNNEL_ID" ] || return 1
  compose_is "$COMPOSE_SHA256" || return 1
  running || return 1
}
if [ -e "$DIR/compose.yaml" ]; then echo prev.installed=true; else echo prev.installed=false; fi
if verify_state >/dev/null 2>&1; then echo state=in-place; else echo state=change; fi
",
      "doing": "starting the Cloudflare Tunnel connector",
      "secrets": {
        "names": [
          "tunnelToken",
        ],
        "required": true,
      },
      "timeoutMs": 600000,
      "verify": "# opscrew-host: tunnel-connector.verify
