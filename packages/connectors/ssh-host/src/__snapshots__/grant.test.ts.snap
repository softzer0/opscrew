SERVICE='db'
LOGIN='laptop'
TITLE='MariaDB'
REMOVE='true'
WANT='YNNNNNNNNNNNYNNNNN'
ROOT_CLIENT='mariadb --defaults-extra-file=<(printf '\\''[client]\\nuser=root\\npassword=%s\\n'\\'' "$MARIADB_ROOT_PASSWORD") -N -B'
PRELUDE=''
STATE_QUERY='SELECT '\\''opscrew-read'\\''; SELECT CONCAT('\\''opscrew-login='\\'', IFNULL(CONCAT(d.Select_priv, d.Insert_priv, d.Update_priv, d.Delete_priv, d.Create_priv, d.Drop_priv, d.References_priv, d.Index_priv, d.Alter_priv, d.Create_tmp_table_priv, d.Lock_tables_priv, d.Create_view_priv, d.Show_view_priv, d.Create_routine_priv, d.Alter_routine_priv, d.Execute_priv, d.Event_priv, d.Trigger_priv), '\\''none'\\'')) FROM mysql.user u LEFT JOIN mysql.db d ON d.User = u.User AND d.Host = u.Host AND d.Db = '\\''app'\\'' WHERE u.User = '\\''laptop'\\'' AND u.Host = '\\''%'\\'';'
NEW_PRE='CREATE USER '\\''laptop'\\''@'\\''%'\\'' IDENTIFIED BY '\\'''
NEW_POST=''\\'';'
SET_PRE='ALTER USER '\\''laptop'\\''@'\\''%'\\'' IDENTIFIED BY '\\'''
SET_POST=''\\'';'
ACCESS='GRANT SELECT ON app.* TO '\\''laptop'\\''@'\\''%'\\''; REVOKE ALL PRIVILEGES ON app.* FROM '\\''laptop'\\''@'\\''%'\\''; GRANT SELECT, SHOW VIEW ON app.* TO '\\''laptop'\\''@'\\''%'\\'';'
DROP='DROP USER IF EXISTS '\\''laptop'\\''@'\\''%'\\'';'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
client() { docker compose -p "$PROJECT" exec -T "$SERVICE" bash -c "$ROOT_CLIENT"; }
# Sets $state to the login's state (- when it does not exist); fails when the engine was not read.
read_state() {
  out=$(printf '%s\\n' "$PRELUDE" "$STATE_QUERY" | client) || return 1
  case "$out" in *opscrew-read*) ;; *) return 1 ;; esac
  state=$(printf '%s\\n' "$out" | sed -n 's/^.*opscrew-login=//p' | head -n 1)
  [ -n "$state" ] || state=-
}
pw=''
if [ "$REMOVE" != true ]; then
  # The password, read before anything else can read the session's stdin. Only builtins see it.
  IFS= read -r pw || true
  case "$pw" in
    ''|*[!A-Za-z0-9]*) pw=''; fail "The login's password did not arrive on standard input, so OpsCrew changed nothing." ;;
  esac
fi
read_state || fail "OpsCrew could not read the logins of $SERVICE ($TITLE) with docker compose -p $PROJECT exec; check that the service is running, then try again."
if [ "$REMOVE" = true ]; then
  if [ "$state" != - ]; then
    printf '%s\\n' "$PRELUDE" "$DROP" | client >/dev/null || fail "OpsCrew could not remove the login $LOGIN from $SERVICE ($TITLE)."
  fi
  exit 0
fi
if [ "$state" = - ]; then
  pre=$NEW_PRE
  post=$NEW_POST
else
  pre=$SET_PRE
  post=$SET_POST
fi
if ! { printf '%s\\n' "$PRELUDE"; printf '%s%s%s\\n' "$pre" "$pw" "$post"; printf '%s\\n' "$ACCESS"; } | client >/dev/null; then
  pw=''
  fail "OpsCrew could not set up the login $LOGIN in $SERVICE ($TITLE)."
fi
pw=''
",
