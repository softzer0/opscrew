verify_state() {
  [ "$(systemctl is-enabled "$UNIT" 2>/dev/null)" != enabled ] || return 1
  ! systemctl is-active --quiet "$UNIT" || return 1
  ! ip link show "$IFACE" >/dev/null 2>&1 || return 1
