    ADDED=$(ufw_added)
    ! has_own_rule "$PORT/udp" "$UDP_COMMENT" || return 1
    [ -z "$(ssh_ports)" ] || return 1
    [ -z "$(local_rules)" ] || return 1
  fi
  if [ -n "$DROPIN_SHA256" ]; then file_is "$DROP_IN" "$DROPIN_SHA256"; else [ ! -e "$DROP_IN" ]; fi
}
verify_state || fail "$VERIFY_FAILED" 5
