  done
  printf '%s\\n' "$ADDED" | sed -n "s|^ufw allow from \\([0-9./]*\\) to \\([0-9.]*\\) port \\([0-9]*\\) proto tcp comment '$LOCAL_COMMENT'\\$|\\1 \\2 \\3|p" |
