// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the network step's scripts > match their snapshot (setup, removal, removal of the last interface) 1`] = `
{
  "inspection through Docker": "# opscrew-host: network.inspect
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
docker_up() { systemctl is-active --quiet docker 2>/dev/null; }
printf '\\n@@opscrew-section %s\\n' 'network'
{
# The file's SHA-256, or - when it is missing.
sum_or_dash() { if [ -f "$1" ]; then sha256sum "$1" | cut -d ' ' -f 1; else echo -; fi; }
# Whether the unit $2 is enabled and active: "$1 enabled yes|no", then "$1 active yes|no".
unit_state() {
  if [ "$(systemctl is-enabled "$2")" = enabled ]; then echo "$1 enabled yes"; else echo "$1 enabled no"; fi
  if systemctl is-active --quiet "$2"; then echo "$1 active yes"; else echo "$1 active no"; fi
}
echo "dropin $(sum_or_dash /etc/systemd/system/docker.service.d/opscrew-network.conf)"
for conf in /etc/wireguard/wg-opscrew*.conf; do
  [ -f "$conf" ] || continue
  name=\${conf##*/}
  name=\${name%.conf}
  case "\${name#wg-opscrew}" in ''|*[!0-9]*) continue ;; esac
  echo "iface $name config $(sum_or_dash "$conf")"
  pub=$(wg pubkey < "/etc/wireguard/$name.key") || pub=''
  echo "iface $name key \${pub:--}"
  unit_state "iface $name" "wg-quick@$name.service"
  ip -4 -o addr show dev "$name" | awk -v name="$name" '{ print "iface " name " address " $4 }'
  wg show "$name" peers | sed "s/^/iface $name peer /"
done
echo "filterunit $(sum_or_dash /etc/systemd/system/opscrew-network-filter@.service)"
for script in /usr/local/sbin/opscrew-network-filter-wg-opscrew*; do
  [ -f "$script" ] || continue
  name=\${script#/usr/local/sbin/opscrew-network-filter-}
  case "\${name#wg-opscrew}" in ''|*[!0-9]*) continue ;; esac
  echo "filter $name script $(sum_or_dash "$script")"
  echo "filter $name dropin $(sum_or_dash "/etc/systemd/system/docker.service.d/opscrew-network-filter-$name.conf")"
  unit_state "filter $name" "opscrew-network-filter@$name.service"
  if iptables -w -C DOCKER-USER -j "OPSCREW-$name" 2>/dev/null; then echo "filter $name jump yes"; else echo "filter $name jump no"; fi
  iptables -w -S "OPSCREW-$name" 2>/dev/null | sed "s/^/filter $name rule /"
done
} 2>/dev/null
printf '\\n@@opscrew-exit %s\\n' "$?"
printf '\\n@@opscrew-section %s\\n' 'ufw-added'
{
ufw show added
} 2>/dev/null
printf '\\n@@opscrew-exit %s\\n' "$?"
",
  "removal apply": "# opscrew-host: network.remove.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
IFACE='wg-opscrew0'
PORT='51820'
UNIT='wg-quick@wg-opscrew0.service'
WG_DIR='/etc/wireguard'
CONFIG='/etc/wireguard/wg-opscrew0.conf'
KEY_FILE='/etc/wireguard/wg-opscrew0.key'
OTHERS='wg-opscrew1'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-network.conf'
DROPIN_B64=''
DROPIN_SHA256='fc4787a946d0309a18201acfe72259cb02bb3ba10b83f8f748f3810622caae6d'
UDP_COMMENT='opscrew-network'
SSH_COMMENT='opscrew-network-ssh'
LOCAL_COMMENT='opscrew-network-local'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
ufw_active() { ufw status 2>/dev/null | grep -q '^Status: active'; }
ufw_added() { ufw show added 2>/dev/null || true; }
has_rule() { printf '%s\\n' "$ADDED" | grep -Eq "^ufw allow $1( comment .*)?\\$"; }
has_own_rule() { printf '%s\\n' "$ADDED" | grep -qxF "ufw allow $1 comment '$2'"; }
# The default policy ufw keeps in /etc/default/ufw, as a ufw word (allow, deny, reject).
ufw_policy() {
  sed -n "s/^DEFAULT_$1_POLICY=\\"\\{0,1\\}\\([A-Z]*\\)\\"\\{0,1\\}\\$/\\1/p" /etc/default/ufw 2>/dev/null | head -n 1 |
    sed -e 's/^ACCEPT$/allow/' -e 's/^DROP$/deny/' -e 's/^REJECT$/reject/'
}
# Lines for an undo script that put today's default policies back.
policy_lines() {
  for pair in INPUT:incoming OUTPUT:outgoing FORWARD:routed; do
    policy=$(ufw_policy "\${pair%%:*}")
    case "$policy" in allow|deny|reject) echo "ufw default $policy \${pair#*:} >/dev/null 2>&1 || true" ;; esac
  done
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
# The SSH ports of OpsCrew's rules on the interface (from ufw_added).
ssh_ports() {
  printf '%s\\n' "$ADDED" | sed -n "s/^ufw allow in on $IFACE to any port \\([0-9]*\\) proto tcp comment '$SSH_COMMENT'\\$/\\1/p"
}
# OpsCrew's rules that let Docker's networks reach an address no interface that stays has, as
# "<network> <address>" (from ufw_added).
local_rules() {
  kept=' '
  for other in $OTHERS; do
    [ -f "$WG_DIR/$other.conf" ] || continue
    kept="$kept$(sed -n 's/^Address = \\([0-9.]*\\)\\/[0-9]*$/\\1/p' "$WG_DIR/$other.conf") "
  done
  printf '%s\\n' "$ADDED" | sed -n "s|^ufw allow from \\([0-9./]*\\) to \\([0-9.]*\\) port \\([0-9]*\\) proto tcp comment '$LOCAL_COMMENT'\\$|\\1 \\2 \\3|p" |
    while read -r network address port; do
      case "$kept" in *" $address "*) ;; *) echo "$network $address $port" ;; esac
    done
}
systemctl disable --now --quiet "$UNIT" >/dev/null 2>&1 || true
if ip link show "$IFACE" >/dev/null 2>&1; then ip link delete "$IFACE"; fi
rm -f "$CONFIG" "$KEY_FILE"
# Only the rules OpsCrew added for this interface go; your own rules stay.
if command -v ufw >/dev/null 2>&1; then
  ADDED=$(ufw_added)
  if has_own_rule "$PORT/udp" "$UDP_COMMENT"; then ufw --force delete allow "$PORT/udp" >/dev/null; fi
  for port in $(ssh_ports); do
    ufw --force delete allow in on "$IFACE" to any port "$port" proto tcp >/dev/null
  done
  local_rules | while read -r network address port; do
    ufw --force delete allow from "$network" to "$address" port "$port" proto tcp >/dev/null
  done
fi
if [ -n "$DROPIN_B64" ]; then
  printf '%s' "$DROPIN_B64" | base64 -d | write_file "$DROP_IN" 0644
else
  rm -f "$DROP_IN"
fi
systemctl daemon-reload
",
  "removal check": "# opscrew-host: network.remove.check
