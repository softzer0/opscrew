  [ "$(systemctl is-enabled "$SERVICE" 2>/dev/null)" != enabled ] || return 1
  other_filters || [ ! -e "$UNIT_FILE" ] || return 1
  if command -v iptables >/dev/null 2>&1; then
    ! iptables -w -C DOCKER-USER -j "$CHAIN" 2>/dev/null || return 1
    ! iptables -w -n -L "$CHAIN" >/dev/null 2>&1 || return 1
  fi
}
verify_state || fail "$VERIFY_FAILED" 5
",
  "server script": "#!/bin/sh
# Managed by OpsCrew: on the private network wg-opscrew0, only the app's servers and the devices
# granted access reach what Docker publishes on 10.200.4.2, and nothing else is reachable
# there. opscrew-network-filter@wg-opscrew0.service
# runs this before Docker, and Docker requires that service: when the filter cannot be installed,
# Docker does not start. \`opscrew provision\` rewrites it; \`opscrew destroy\` removes it.
set -eu
# PATH comes from systemd (or from OpsCrew's step, which runs it once right away).
CHAIN='OPSCREW-wg-opscrew0'
fail() {
  echo "opscrew-network-filter: $1" >&2
  exit 1
}
# The chain's rules, one per line: per port, the addresses that may open it, then a drop; last,
# a drop of every other new connection to 10.200.4.2.
rules() {
  cat <<'OPSCREW_RULES'
-s 10.200.4.1/32 -p tcp -m conntrack --ctstate NEW --ctorigdst 10.200.4.2 --ctorigdstport 5432 --ctdir ORIGINAL -j ACCEPT
-s 10.200.4.100/32 -p tcp -m conntrack --ctstate NEW --ctorigdst 10.200.4.2 --ctorigdstport 5432 --ctdir ORIGINAL -j ACCEPT
-p tcp -m conntrack --ctstate NEW --ctorigdst 10.200.4.2 --ctorigdstport 5432 --ctdir ORIGINAL -j DROP
-s 10.200.4.1/32 -p tcp -m conntrack --ctstate NEW --ctorigdst 10.200.4.2 --ctorigdstport 6379 --ctdir ORIGINAL -j ACCEPT
-p tcp -m conntrack --ctstate NEW --ctorigdst 10.200.4.2 --ctorigdstport 6379 --ctdir ORIGINAL -j DROP
-m conntrack --ctstate NEW --ctorigdst 10.200.4.2 --ctdir ORIGINAL -j DROP
OPSCREW_RULES
}
# The chain holds exactly these rules, and DOCKER-USER jumps to it.
in_place() {
  iptables -w -C DOCKER-USER -j "$CHAIN" 2>/dev/null || return 1
  [ "$(iptables -w -S "$CHAIN" 2>/dev/null | grep -c '^-A ')" -eq "$(rules | grep -c .)" ] || return 1
  rules | while read -r spec; do
    # The rule's words are split on purpose.
    iptables -w -C "$CHAIN" $spec 2>/dev/null || exit 1
  done
}
if [ "\${1:-}" = --check ]; then
  if in_place; then exit 0; fi
  exit 1
fi
if [ -f /etc/docker/daemon.json ] && grep -Eq '"firewall-backend"[[:space:]]*:[[:space:]]*"nftables"' /etc/docker/daemon.json; then
  fail "Docker is set to its nftables firewall backend (/etc/docker/daemon.json), which has no DOCKER-USER chain, so OpsCrew's network filter cannot work."
fi
if [ -f /etc/docker/daemon.json ] && grep -Eq '"iptables"[[:space:]]*:[[:space:]]*false' /etc/docker/daemon.json; then
  fail "Docker does not manage iptables (\\"iptables\\": false in /etc/docker/daemon.json), so OpsCrew's network filter cannot work."
fi
docker_unit=$(systemctl show docker -p ExecStart -p Environment 2>/dev/null) || docker_unit=''
case "$docker_unit" in
  *firewall-backend=nftables* | *"firewall-backend nftables"* | *DOCKER_FIREWALL_BACKEND=nftables*)
    fail "Docker's service is set to its nftables firewall backend, which has no DOCKER-USER chain, so OpsCrew's network filter cannot work." ;;
  *--iptables=false*)
    fail "Docker's service does not manage iptables (--iptables=false), so OpsCrew's network filter cannot work." ;;
esac
command -v iptables >/dev/null 2>&1 || fail "iptables is not installed."
command -v iptables-restore >/dev/null 2>&1 || fail "iptables-restore is not installed."
# OpsCrew's chain in one atomic change.
{
  echo '*filter'
  echo ":$CHAIN - [0:0]"
  rules | sed "s/^/-A $CHAIN /"
  echo 'COMMIT'
} | iptables-restore -w --noflush
# Before Docker starts DOCKER-USER may not exist yet; Docker keeps it and its rules.
iptables -w -n -L DOCKER-USER >/dev/null 2>&1 || iptables -w -N DOCKER-USER
if ! iptables -w -C DOCKER-USER -j "$CHAIN" 2>/dev/null; then
  # Right after OpsCrew's web filter's jumps, which stay the first rules of DOCKER-USER.
  n=$(iptables -w -S DOCKER-USER | grep '^-A ' | awk '!/ -j OPSCREW-WEB$/ { exit } { n = NR } END { print n + 1 }')
  iptables -w -I DOCKER-USER "$n" -j "$CHAIN"
fi
",
  "setup apply": "# opscrew-host: network-filter.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
IFACE='wg-opscrew0'
SCRIPT='/usr/local/sbin/opscrew-network-filter-wg-opscrew0'
UNIT_FILE='/etc/systemd/system/opscrew-network-filter@.service'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-network-filter-wg-opscrew0.conf'
SERVICE='opscrew-network-filter@wg-opscrew0.service'
SCRIPT_B64=''
UNIT_B64=''
DROPIN_B64=''
SCRIPT_SHA256='e54f0e8f9fde27f503ba697b25888fe6b25475860596d1d2308b67c1289a7e04'
UNIT_SHA256='9f1de8772ffec24ef9becab5b12db63eda4ff2d1ef411f1b78193daa88c0f702'
DROPIN_SHA256='d3f8392536ebb5f8133717764e4c9172220eb42cec32b73f33715fa62e36431c'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
file_is() { [ -f "$1" ] && [ "$(sha256sum "$1" | cut -d ' ' -f 1)" = "$2" ]; }
if [ -f /etc/docker/daemon.json ] && grep -Eq '"firewall-backend"[[:space:]]*:[[:space:]]*"nftables"' /etc/docker/daemon.json; then
  fail "Docker is set to its nftables firewall backend (/etc/docker/daemon.json), which has no DOCKER-USER chain, so OpsCrew's network filter cannot work."
fi
if [ -f /etc/docker/daemon.json ] && grep -Eq '"iptables"[[:space:]]*:[[:space:]]*false' /etc/docker/daemon.json; then
  fail "Docker does not manage iptables (\\"iptables\\": false in /etc/docker/daemon.json), so OpsCrew's network filter cannot work."
fi
docker_unit=$(systemctl show docker -p ExecStart -p Environment 2>/dev/null) || docker_unit=''
case "$docker_unit" in
  *firewall-backend=nftables* | *"firewall-backend nftables"* | *DOCKER_FIREWALL_BACKEND=nftables*)
    fail "Docker's service is set to its nftables firewall backend, which has no DOCKER-USER chain, so OpsCrew's network filter cannot work." ;;
  *--iptables=false*)
    fail "Docker's service does not manage iptables (--iptables=false), so OpsCrew's network filter cannot work." ;;
esac
if systemctl is-active --quiet docker && ! iptables -w -n -L DOCKER-USER >/dev/null 2>&1; then
  fail "Docker is running but has no DOCKER-USER chain in iptables, so OpsCrew's network filter cannot work. Nothing was changed."
fi
install -d -m 0755 "$(dirname "$SCRIPT")" "$(dirname "$UNIT_FILE")"
printf '%s' "$SCRIPT_B64" | base64 -d | write_file "$SCRIPT" 0755
printf '%s' "$UNIT_B64" | base64 -d | write_file "$UNIT_FILE" 0644
"$SCRIPT" || fail "OpsCrew could not install its network filter on $IFACE (see the message above); Docker was not changed."
install -d -m 0755 "$(dirname "$DROP_IN")"
printf '%s' "$DROPIN_B64" | base64 -d | write_file "$DROP_IN" 0644
systemctl daemon-reload
systemctl enable "$SERVICE" >/dev/null 2>&1
# Starting the unit runs the script once more (no change); Docker is not restarted.
systemctl start "$SERVICE"
