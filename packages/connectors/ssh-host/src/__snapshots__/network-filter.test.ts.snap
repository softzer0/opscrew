// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the network filter's scripts > match their snapshot (the script on the server, the unit, the drop-in, setup and removal) 1`] = `
{
  "Docker's drop-in": "# Managed by OpsCrew: Docker starts only after OpsCrew's network filter on wg-opscrew0 is in place,
# and not at all when it fails (fail closed). \`opscrew destroy\` removes this file.
[Unit]
Requires=opscrew-network-filter@wg-opscrew0.service
After=opscrew-network-filter@wg-opscrew0.service
",
  "readNetworkFilter's read": "# opscrew-host: network-filter.read
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
CHAIN='OPSCREW-wg-opscrew0'
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
command -v iptables >/dev/null 2>&1 || fail 'iptables is not installed on the server.'
if iptables -w -C DOCKER-USER -j "$CHAIN" 2>/dev/null; then echo 'jump yes'; else echo 'jump no'; fi
if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then iptables -w -S "$CHAIN"; fi
",
  "removal apply": "# opscrew-host: network-filter.remove.apply
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
IFACE='wg-opscrew0'
SCRIPT='/usr/local/sbin/opscrew-network-filter-wg-opscrew0'
SCRIPT_PREFIX='/usr/local/sbin/opscrew-network-filter-'
UNIT_FILE='/etc/systemd/system/opscrew-network-filter@.service'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-network-filter-wg-opscrew0.conf'
SERVICE='opscrew-network-filter@wg-opscrew0.service'
CHAIN='OPSCREW-wg-opscrew0'
trap '' HUP PIPE
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
# Another interface's filter still uses the templated unit.
other_filters() {
  for other in "$SCRIPT_PREFIX"wg-opscrew*; do
    if [ -e "$other" ] && [ "$other" != "$SCRIPT" ]; then return 0; fi
  done
  return 1
}
rm -f "$DROP_IN"
systemctl daemon-reload
systemctl disable "$SERVICE" >/dev/null 2>&1 || true
systemctl stop "$SERVICE" >/dev/null 2>&1 || true
if command -v iptables >/dev/null 2>&1; then
  while iptables -w -C DOCKER-USER -j "$CHAIN" 2>/dev/null; do iptables -w -D DOCKER-USER -j "$CHAIN"; done
  if iptables -w -n -L "$CHAIN" >/dev/null 2>&1; then
    iptables -w -F "$CHAIN"
    iptables -w -X "$CHAIN" || fail "Another rule still jumps to OpsCrew's chain $CHAIN; remove that rule, then run the command again."
  fi
fi
rm -f "$SCRIPT"
if ! other_filters; then rm -f "$UNIT_FILE"; fi
systemctl daemon-reload
",
  "removal check": "# opscrew-host: network-filter.remove.check
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
DEBIAN_FRONTEND=noninteractive
export PATH LC_ALL LANG DEBIAN_FRONTEND
umask 022
IFACE='wg-opscrew0'
