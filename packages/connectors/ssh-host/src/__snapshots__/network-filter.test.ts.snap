SCRIPT_PREFIX='/usr/local/sbin/opscrew-network-filter-'
UNIT_FILE='/etc/systemd/system/opscrew-network-filter@.service'
DROP_IN='/etc/systemd/system/docker.service.d/opscrew-network-filter-wg-opscrew0.conf'
SERVICE='opscrew-network-filter@wg-opscrew0.service'
CHAIN='OPSCREW-wg-opscrew0'
apt_get() {
  install -d -m 0700 "$(dirname '/var/log/opscrew/apt.log')"
  if apt-get -q -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" >>'/var/log/opscrew/apt.log' 2>&1; then return 0; fi
  tail -n 5 '/var/log/opscrew/apt.log' >&2 2>/dev/null || true
  return 1
}
is_installed() {
  dpkg-query -W -f='\${Status}' "$1" 2>/dev/null | grep -q ' installed$'
}
fail() {
  printf 'opscrew: %s\\n' "$1" >&2
  exit "\${2:-3}"
}
write_file() {
  tmp=$(mktemp "$(dirname "$1")/.opscrew.XXXXXX")
  cat > "$tmp"
  if [ -n "\${3:-}" ]; then chown "$3" "$tmp"; fi
  chmod "$2" "$tmp"
  mv -f "$tmp" "$1"
}
# Another interface's filter still uses the templated unit.
other_filters() {
  for other in "$SCRIPT_PREFIX"wg-opscrew*; do
    if [ -e "$other" ] && [ "$other" != "$SCRIPT" ]; then return 0; fi
  done
  return 1
}
verify_state() {
  [ ! -e "$SCRIPT" ] && [ ! -e "$DROP_IN" ] || return 1
  [ "$(systemctl is-enabled "$SERVICE" 2>/dev/null)" != enabled ] || return 1
  other_filters || [ ! -e "$UNIT_FILE" ] || return 1
  if command -v iptables >/dev/null 2>&1; then
    ! iptables -w -C DOCKER-USER -j "$CHAIN" 2>/dev/null || return 1
    ! iptables -w -n -L "$CHAIN" >/dev/null 2>&1 || return 1
  fi
}

if verify_state >/dev/null 2>&1; then echo state=in-place; else echo state=change; fi
